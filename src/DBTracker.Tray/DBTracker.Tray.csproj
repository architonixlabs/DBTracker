<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.6.2 ships with Windows Server 2016 and later, so the tray app needs no runtime
       install (the .NET 10 Hosting Bundle doesn't include the Windows Desktop runtime). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <!-- 64-bit on 64-bit Windows, so %windir%\System32\inetsrv\appcmd.exe isn't redirected to SysWOW64. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DBTrackerTray</AssemblyName>
    <RootNamespace>DBTracker.Tray</RootNamespace>
    <ApplicationIcon>tray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>DBTracker Tray</Product>
    <Company>Architonix Labs LLP</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBTracker.Tray.Core\DBTracker.Tray.Core.csproj" />
  </ItemGroup>

</Project>
