<Project Sdk="Microsoft.NET.Sdk">

  <!-- net462 is what the tray app loads (a netstandard2.0 build would drag ~100 facade DLLs into a
       .NET Framework 4.6.x install); netstandard2.0 is what the net10 unit tests reference. -->
  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DBTracker.Tray.Core</RootNamespace>
    <AssemblyName>DBTracker.Tray.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
