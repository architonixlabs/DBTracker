<?xml version="1.0" encoding="utf-8"?>
<!-- Folder publish for IIS. Framework-dependent: install the .NET 10 Hosting Bundle on the server.
     Output: src\DBTracker.Web\bin\Release\net10.0\publish\ (git-ignored). No secrets belong here. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Release\net10.0\publish\</PublishDir>
    <PublishUrl>bin\Release\net10.0\publish\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
  </PropertyGroup>
</Project>
