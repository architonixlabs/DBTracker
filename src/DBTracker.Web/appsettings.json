{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DBTracker": "Server=localhost;Database=DBTracker;Integrated Security=True;TrustServerCertificate=True;"
  },
  "BackupScan": {
    "IntervalMinutes": 15,
    "StaleAfterMultiplier": 3
  },
  "Alerts": {
    "IntervalMinutes": 10,
    "NeverBackedUpGraceHours": 24,
    "EscalationIntervalMinutes": 240,
    "Webhook": {
      "Url": "",
      "Secret": ""
    }
  },
  "Email": {
    "Provider": "None",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "DBTracker"
    },
    "ArxMail": {
      "Endpoint": "https://mail.architonixlabs.com/v1/submit",
      "FromAddress": "",
      "ApiKey": ""
    }
  },
  "Reports": {
    "IntervalDays": 7,
    "DistributionList": ""
  },
  "RestoreTest": {
    "IntervalDays": 90
  },
  "CertificateExpiry": {
    "IntervalMinutes": 1440,
    "NoticeDaysThresholds": "365,180,90,30"
  }
}
