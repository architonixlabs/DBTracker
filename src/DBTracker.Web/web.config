<?xml version="1.0" encoding="utf-8"?>
<!-- IIS only. Kestrel (dotnet run, the E2E fixture) ignores this file. Publish replaces
     %LAUNCHER_PATH% and %LAUNCHER_ARGS% with the real executable, and this file is overwritten on
     every deploy, so re-apply any local edits after an upgrade. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- To troubleshoot a startup failure (HTTP 500.30), set stdoutLogEnabled="true", create a
           "logs" folder in the site root that the app pool identity can write to, recycle the app
           pool and reproduce. Set it back to "false" afterwards: stdout logs are never rotated. -->
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
