@implements IDisposable
@inject ToastService Toasts

<!--
    U20: toasts are the app's main "save succeeded / failed" feedback, but were purely visual —
    a screen-reader user got no announcement at all when one appeared and disappeared. role="status"
    (polite, non-interrupting) on the error-free stack announces success toasts; the separate
    role="alert" (assertive) region for error toasts means a failure is announced promptly rather
    than only when the user happens to be focused elsewhere and polite-queues behind other speech.
-->
<div class="toast-stack">
    @foreach (var (id, toast) in _active.ToList())
    {
        <div class="dbt-toast @(toast.IsError ? "error" : "")" @key="id" role="@(toast.IsError ? "alert" : "status")" aria-live="@(toast.IsError ? "assertive" : "polite")">
            <i class="bi @(toast.IsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
            <span>@toast.Text</span>
        </div>
    }
</div>

@code {
    private readonly Dictionary<int, ToastMessage> _active = new();
    private int _nextId;

    protected override void OnInitialized()
    {
        Toasts.OnShow += HandleShow;
    }

    private void HandleShow(ToastMessage toast)
    {
        var id = _nextId++;
        _active[id] = toast;
        InvokeAsync(StateHasChanged);

        _ = RemoveAfterDelay(id);
    }

    private async Task RemoveAfterDelay(int id)
    {
        await Task.Delay(3500);
        _active.Remove(id);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Toasts.OnShow -= HandleShow;
    }
}
