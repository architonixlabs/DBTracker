@using System.Security.Claims
@using DBTracker.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthProvider
@inject IDbContextFactory<DBTrackerDbContext> DbFactory
@inject NavigationManager Nav

@code {
    // Lives in MainLayout, so it runs on full page loads and on in-app navigation alike. It uses its own short-lived
    // context because the page underneath may be using the circuit's scoped one at the same moment.
    private const string ChangePasswordPath = "account/change-password";

    [Parameter] public string? CurrentUri { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (path.StartsWith(ChangePasswordPath, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrEmpty(userId))
        {
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var mustChange = await db.Users.AsNoTracking().Where(u => u.Id == userId).Select(u => u.MustChangePassword).FirstOrDefaultAsync();
        if (mustChange)
        {
            Nav.NavigateTo("/account/change-password?Required=true");
        }
    }
}
