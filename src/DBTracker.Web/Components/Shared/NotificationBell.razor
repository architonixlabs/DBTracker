@implements IDisposable
@inject NotificationService Notifications
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ILogger<NotificationBell> Logger
@inject IJSRuntime JS

@* G30: the menu is a popover="auto" placed right after its trigger: the browser gives it the top layer,
   light dismiss (click elsewhere or Esc) and focus return to the bell. It is a short list of buttons and
   links that Tab moves through, so it is not an ARIA menu and needs no arrow-key handling. Content renders
   only while open, so its buttons are not duplicated on the /notifications page. *@
<div class="notif-bell-wrap" @onkeydown="OnKeyDown">
    <button type="button" class="notif-bell-btn" @ref="_bellButtonRef" @onclick="OnBellClick" popovertarget="notif-dropdown"
            aria-expanded="@(_open ? "true" : "false")" aria-controls="notif-dropdown" aria-label="@BellLabel">
        <i class="bi @(_refreshError is not null ? "bi-bell-slash" : "bi-bell")" aria-hidden="true"></i>
        @if (_unreadCount > 0)
        {
            <span class="notif-badge" aria-hidden="true">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
        }
    </button>

    <div class="notif-dropdown dbt-anchored @(_open ? "is-open" : "")" id="notif-dropdown" popover="auto" @ref="_dropdownRef"
         role="region" aria-label="Recent notifications" data-loaded="@_open">
        @if (_open)
        {
            <div class="notif-dropdown-header">
                <span>Notifications</span>
                @if (_unreadCount > 0)
                {
                    <button type="button" class="notif-mark-read" @onclick="MarkAllRead">Mark all read</button>
                }
            </div>
            <div class="notif-dropdown-meta d-flex justify-content-between align-items-center px-3 py-1 small text-muted">
                <span role="status" data-testid="notif-updated">@UpdatedLabel</span>
                <span class="d-flex gap-1">
                    <button type="button" class="btn btn-link btn-sm p-1" data-testid="notif-pause" @onclick="TogglePause" aria-pressed="@(_paused ? "true" : "false")" aria-label="@(_paused ? "Resume auto-refresh" : "Pause auto-refresh")" title="@(_paused ? "Resume auto-refresh" : "Pause auto-refresh")">
                        <i class="bi @(_paused ? "bi-play-fill" : "bi-pause-fill")" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-link btn-sm p-1" @onclick="RefreshNow" aria-busy="@(_refreshing ? "true" : "false")" aria-label="Refresh notifications" title="Refresh notifications">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    </button>
                </span>
            </div>
            @if (_refreshError is not null)
            {
                <div class="px-3 py-2 small" role="alert" data-testid="notif-error" style="color:var(--dbt-failed)">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @ErrorLabel
                </div>
            }
            @if (_recent.Count == 0)
            {
                <div class="notif-empty">No notifications yet.</div>
            }
            else
            {
                @foreach (var n in _recent)
                {
                    <button type="button" class="notif-item @(n.IsRead ? "" : "unread")" @onclick="() => OpenItem(n)">
                        <span class="dot" style="background:@SeverityColor(n.Severity)" aria-hidden="true"></span>
                        <span>
                            <span class="visually-hidden-text">@SeverityLabel(n.Severity)@(n.IsRead ? "" : ", unread"): </span>
                            <span class="notif-message d-block">@n.Message</span>
                            <span class="notif-time d-block">@n.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                        </span>
                    </button>
                }
            }
            <div class="notif-dropdown-footer">
                <a href="/notifications">View all notifications and subscriptions</a>
            </div>
        }
    </div>
</div>

@code {
    private bool _open;
    private int _unreadCount;
    private List<NotificationInboxItem> _recent = new();
    private DateTime _lastUpdatedUtc;
    private bool _refreshing;
    private bool _paused;
    private string? _refreshError;
    private Timer? _autoRefreshTimer;
    private string? _userId;
    private ElementReference _bellButtonRef;
    private ElementReference _dropdownRef;
    private DotNetObjectReference<NotificationBell>? _jsRef;
    // Assumed until the browser says otherwise; without the Popover API the bell falls back to toggling here.
    private bool _popoverSupported = true;
    private bool _repositionPending;

    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        await Refresh();
        // Keeps the unread badge current even while the dropdown is closed, so a new alert shows
        // up without the user having to open and close it to force a reload.
        _autoRefreshTimer = new Timer(async _ => await AutoRefreshTickAsync(), null, AutoRefreshInterval, AutoRefreshInterval);
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _popoverSupported = await JS.InvokeAsync<bool>("dbtracker.popover.supported");
                _jsRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("dbtracker.popover.watch", _dropdownRef, _jsRef);
            }
            if (_repositionPending)
            {
                _repositionPending = false;
                await JS.InvokeVoidAsync("dbtracker.popover.reposition", _dropdownRef);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // The popover opens natively from popovertarget; this keeps the rendered content and aria-expanded in
    // step with it, including light dismiss and Esc, which close it without a click on the bell.
    [JSInvokable]
    public async Task OnPopoverToggle(bool open)
    {
        if (open == _open)
        {
            return;
        }

        _open = open;
        if (open)
        {
            _repositionPending = true;
            StateHasChanged();
            await Refresh();
            _repositionPending = true;
        }
        StateHasChanged();
    }

    private async Task HidePopoverAsync()
    {
        if (_popoverSupported)
        {
            await JS.InvokeVoidAsync("dbtracker.popover.hide", _dropdownRef);
        }
        else
        {
            _open = false;
        }
    }

    // The bell lives in the layout, so it outlives page navigation: close it when the user follows a link.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_open)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await HidePopoverAsync();
                StateHasChanged();
            }
            catch (JSDisconnectedException)
            {
            }
        });
    }

    private async Task Refresh()
    {
        if (string.IsNullOrEmpty(_userId))
        {
            return;
        }

        // A failed refresh keeps the last good list and says so, rather than showing an empty or stale bell as current.
        try
        {
            _unreadCount = await Notifications.UnreadCountAsync(_userId);
            _recent = await Notifications.GetRecentAsync(_userId);
            _lastUpdatedUtc = DateTime.UtcNow;
            _refreshError = null;
        }
        catch (Exception ex) when (ex is not ObjectDisposedException)
        {
            _refreshError = ex.Message;
            Logger.LogWarning(ex, "Notification bell refresh failed.");
        }
    }

    private void TogglePause() => _paused = !_paused;

    private string BellLabel =>
        "Notifications" +
        (_unreadCount > 0 ? $", {_unreadCount} unread" : "") +
        (_refreshError is not null ? ", last refresh failed" : "") +
        (_paused ? ", auto-refresh paused" : "");

    private string UpdatedLabel =>
        (_lastUpdatedUtc == default ? "Not loaded yet" : "Updated " + _lastUpdatedUtc.ToLocalTime().ToString("h:mm:ss tt")) +
        (_paused ? ". Auto-refresh paused" : "");

    private string ErrorLabel =>
        "Couldn't refresh notifications. Showing what loaded " +
        (_lastUpdatedUtc == default ? "earlier" : "at " + _lastUpdatedUtc.ToLocalTime().ToString("h:mm tt")) +
        ". Use refresh to try again.";

    // Runs on a thread-pool timer as async void: an escaping exception would crash the process.
    private async Task AutoRefreshTickAsync()
    {
        if (_paused)
        {
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                await Refresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Notification bell auto-refresh failed; retrying on the next tick.");
        }
    }

    // Not disabled while busy: disabling the focused button would drop keyboard focus to <body>.
    private async Task RefreshNow()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        await Refresh();
        _refreshing = false;
    }

    // Only the no-popover fallback toggles here; elsewhere popovertarget does it and OnPopoverToggle follows.
    private async Task OnBellClick()
    {
        if (_popoverSupported)
        {
            return;
        }

        _open = !_open;
        if (_open)
        {
            await Refresh();
        }
    }

    private async Task MarkAllRead()
    {
        if (string.IsNullOrEmpty(_userId))
        {
            return;
        }

        await Notifications.MarkAllReadAsync(_userId);
        await Refresh();
    }

    private async Task OpenItem(NotificationInboxItem n)
    {
        if (!string.IsNullOrEmpty(_userId) && !n.IsRead)
        {
            await Notifications.MarkReadAsync(_userId, n.Id);
            await Refresh();
        }

        if (n.DatabaseInstanceId is { } id)
        {
            await HidePopoverAsync();
            Nav.NavigateTo($"/instances/{id}");
        }
    }

    // No-popover fallback only (the popover handles Esc natively): Escape closes the dropdown and returns
    // focus to the bell, so a keyboard user keeps their place.
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_popoverSupported && _open && e.Key == "Escape")
        {
            _open = false;
            await _bellButtonRef.FocusAsync();
        }
    }

    private static string SeverityColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Critical => "var(--dbt-failed)",
        NotificationSeverity.Warning => "var(--dbt-overdue)",
        _ => "var(--dbt-never)"
    };

    private static string SeverityLabel(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Critical => "Critical",
        NotificationSeverity.Warning => "Warning",
        _ => "Info"
    };

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _autoRefreshTimer?.Dispose();
        _jsRef?.Dispose();
    }
}
