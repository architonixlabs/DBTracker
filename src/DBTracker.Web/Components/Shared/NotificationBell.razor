@inject NotificationService Notifications

<div class="notif-bell-wrap">
    <button type="button" class="notif-bell-btn" @onclick="Toggle" aria-haspopup="true" aria-expanded="@_open" aria-label="Notifications">
        <i class="bi bi-bell"></i>
        @if (_unreadCount > 0)
        {
            <span class="notif-badge">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
        }
    </button>

    @if (_open)
    {
        <div class="notif-dropdown">
            <div class="notif-dropdown-header">
                <span>Notifications</span>
                @if (_unreadCount > 0)
                {
                    <button type="button" class="notif-mark-read" @onclick="MarkAllRead">Mark all read</button>
                }
            </div>
            @if (_recent.Count == 0)
            {
                <div class="notif-empty">No notifications yet.</div>
            }
            else
            {
                @foreach (var n in _recent)
                {
                    <div class="notif-item @(n.IsRead ? "" : "unread")">
                        <span class="dot" style="background:@SeverityColor(n.Severity)"></span>
                        <div>
                            <div class="notif-message">@n.Message</div>
                            <div class="notif-time">@n.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private bool _open;
    private int _unreadCount;
    private List<Notification> _recent = new();

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        _unreadCount = await Notifications.UnreadCountAsync();
        _recent = await Notifications.GetRecentAsync();
    }

    private async Task Toggle()
    {
        _open = !_open;
        if (_open)
        {
            await Refresh();
        }
    }

    private async Task MarkAllRead()
    {
        await Notifications.MarkAllReadAsync();
        await Refresh();
    }

    private static string SeverityColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Critical => "var(--dbt-failed)",
        NotificationSeverity.Warning => "var(--dbt-overdue)",
        _ => "var(--dbt-never)"
    };
}
