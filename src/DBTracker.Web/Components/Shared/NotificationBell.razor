@implements IDisposable
@inject NotificationService Notifications
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ILogger<NotificationBell> Logger

<div class="notif-bell-wrap" @onkeydown="OnKeyDown">
    <button type="button" class="notif-bell-btn" @ref="_bellButtonRef" @onclick="Toggle" aria-expanded="@(_open ? "true" : "false")" aria-controls="notif-dropdown" aria-label="Notifications@(_unreadCount > 0 ? $", {_unreadCount} unread" : "")">
        <i class="bi bi-bell" aria-hidden="true"></i>
        @if (_unreadCount > 0)
        {
            <span class="notif-badge" aria-hidden="true">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
        }
    </button>

    @if (_open)
    {
        <div class="notif-dropdown" id="notif-dropdown" role="region" aria-label="Recent notifications">
            <div class="notif-dropdown-header">
                <span>Notifications</span>
                @if (_unreadCount > 0)
                {
                    <button type="button" class="notif-mark-read" @onclick="MarkAllRead">Mark all read</button>
                }
            </div>
            <div class="notif-dropdown-meta d-flex justify-content-between align-items-center px-3 py-1 small text-muted">
                <span>Updated @_lastUpdatedUtc.ToLocalTime().ToString("h:mm:ss tt")</span>
                <button type="button" class="btn btn-link btn-sm p-1" @onclick="RefreshNow" aria-busy="@(_refreshing ? "true" : "false")" aria-label="Refresh notifications" title="Refresh notifications">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                </button>
            </div>
            @if (_recent.Count == 0)
            {
                <div class="notif-empty">No notifications yet.</div>
            }
            else
            {
                @foreach (var n in _recent)
                {
                    <button type="button" class="notif-item @(n.IsRead ? "" : "unread")" @onclick="() => OpenItem(n)">
                        <span class="dot" style="background:@SeverityColor(n.Severity)" aria-hidden="true"></span>
                        <span>
                            <span class="visually-hidden-text">@SeverityLabel(n.Severity)@(n.IsRead ? "" : ", unread"): </span>
                            <span class="notif-message d-block">@n.Message</span>
                            <span class="notif-time d-block">@n.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                        </span>
                    </button>
                }
            }
            <div class="notif-dropdown-footer">
                <a href="/notifications">View all notifications and subscriptions</a>
            </div>
        </div>
    }
</div>

@code {
    private bool _open;
    private int _unreadCount;
    private List<NotificationInboxItem> _recent = new();
    private DateTime _lastUpdatedUtc;
    private bool _refreshing;
    private Timer? _autoRefreshTimer;
    private string? _userId;
    private ElementReference _bellButtonRef;

    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        await Refresh();
        // Keeps the unread badge current even while the dropdown is closed, so a new alert shows
        // up without the user having to open and close it to force a reload.
        _autoRefreshTimer = new Timer(async _ => await AutoRefreshTickAsync(), null, AutoRefreshInterval, AutoRefreshInterval);
    }

    private async Task Refresh()
    {
        if (string.IsNullOrEmpty(_userId))
        {
            return;
        }

        _unreadCount = await Notifications.UnreadCountAsync(_userId);
        _recent = await Notifications.GetRecentAsync(_userId);
        _lastUpdatedUtc = DateTime.UtcNow;
    }

    // Runs on a thread-pool timer as async void: an escaping exception would crash the process.
    private async Task AutoRefreshTickAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await Refresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Notification bell auto-refresh failed; retrying on the next tick.");
        }
    }

    // Not disabled while busy: disabling the focused button would drop keyboard focus to <body>.
    private async Task RefreshNow()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        await Refresh();
        _refreshing = false;
    }

    private async Task Toggle()
    {
        _open = !_open;
        if (_open)
        {
            await Refresh();
        }
    }

    private async Task MarkAllRead()
    {
        if (string.IsNullOrEmpty(_userId))
        {
            return;
        }

        await Notifications.MarkAllReadAsync(_userId);
        await Refresh();
    }

    private async Task OpenItem(NotificationInboxItem n)
    {
        if (!string.IsNullOrEmpty(_userId) && !n.IsRead)
        {
            await Notifications.MarkReadAsync(_userId, n.Id);
            await Refresh();
        }

        if (n.DatabaseInstanceId is { } id)
        {
            Nav.NavigateTo($"/instances/{id}");
        }
    }

    // Escape closes the dropdown and returns focus to the bell, so a keyboard user keeps their place.
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_open && e.Key == "Escape")
        {
            _open = false;
            await _bellButtonRef.FocusAsync();
        }
    }

    private static string SeverityColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Critical => "var(--dbt-failed)",
        NotificationSeverity.Warning => "var(--dbt-overdue)",
        _ => "var(--dbt-never)"
    };

    private static string SeverityLabel(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Critical => "Critical",
        NotificationSeverity.Warning => "Warning",
        _ => "Info"
    };

    public void Dispose() => _autoRefreshTimer?.Dispose();
}
