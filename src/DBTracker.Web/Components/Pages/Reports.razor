@page "/reports"
@attribute [Authorize]
@inject InstanceOverviewService OverviewService
@inject ComplianceReportService ReportService
@inject ToastService Toasts
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject DBTrackerDbContext Db
@inject IncidentService Incidents
@inject NavigationManager Nav
@inject AuditRecorder AuditLog
@inject ViewerTimeZone Viewer
@implements IDisposable

<PageTitle>Reports · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Reports</h1>
        <div class="subtitle">Generate and export operational, ownership and compliance reports from the same tracked data, without exporting to a spreadsheet first.</div>
    </div>
</div>

@if (_overviews is null)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else
{
    <div class="filter-bar">
        @foreach (var type in ReportTypeOrder)
        {
            <button type="button" class="btn @(type == _selected ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(type == _selected ? "true" : "false")" @onclick="() => SelectType(type)">
                @Label(type)
            </button>
        }
    </div>

    @switch (_selected)
    {
        case ReportType.BackupActivity:
        {
            <div class="filter-bar" style="padding-top:0;border-top:none;border-bottom:none;margin-bottom:6px;gap:12px;">
                @foreach (var days in new[] { 7, 30, 90 })
                {
                    <button type="button" class="btn btn-sm @(!_useCustomRange && days == _range.PresetDays ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(!_useCustomRange && days == _range.PresetDays ? "true" : "false")" @onclick="() => SelectPreset(days)">
                        Last @days d
                    </button>
                }
                <button type="button" class="btn btn-sm @(_useCustomRange ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(_useCustomRange ? "true" : "false")" data-testid="reports-range-custom" @onclick="SelectCustom">
                    Custom
                </button>
            </div>

            @if (_useCustomRange)
            {
                <div class="d-flex gap-2 align-items-end mb-3" style="flex-wrap:wrap;">
                    <div class="field">
                        <label for="reports-from-local-time" class="form-label small">From (@ZoneName)</label>
                        <input id="reports-from-local-time" type="date" class="form-control form-control-sm" @bind="_customFrom" @bind:after="ApplyCustomRange" aria-describedby="reports-range-error reports-range-zone" />
                    </div>
                    <div class="field">
                        <label for="reports-to-local-time-inclusive" class="form-label small">To (@ZoneName, inclusive)</label>
                        <input id="reports-to-local-time-inclusive" type="date" class="form-control form-control-sm" @bind="_customTo" @bind:after="ApplyCustomRange" aria-describedby="reports-range-error reports-range-zone" />
                    </div>
                </div>
                <div id="reports-range-error" class="small text-danger mb-2" role="alert">@_rangeError</div>
                <p class="small text-muted mb-3" id="reports-range-zone">Dates are whole days in @ZoneName, from 00:00 on the first day to the end of the last day.</p>
            }

            var rowsInRange = BackupActivityReportBuilder.InRange(_activityRows, _activityRangeUtc.FromUtc, _activityRangeUtc.ToUtc);
            var summary = BackupActivityReportBuilder.Summarize(rowsInRange);

            <div class="stat-strip">
                <div class="stat-cell Total"><div class="stat-label">Total runs</div><div class="stat-value">@summary.TotalRuns</div></div>
                <div class="stat-cell OnTrack"><div class="stat-label"><span class="stat-dot OnTrack"></span>Success</div><div class="stat-value">@summary.SuccessCount</div></div>
                <div class="stat-cell Failed"><div class="stat-label"><span class="stat-dot Failed"></span>Failed</div><div class="stat-value">@summary.FailedCount</div></div>
                <div class="stat-cell Overdue"><div class="stat-label"><span class="stat-dot Overdue"></span>Missed</div><div class="stat-value">@summary.MissedCount</div></div>
                <div class="stat-cell NeverBackedUp"><div class="stat-label">Total size</div><div class="stat-value" style="font-size:22px">@FormatMb(summary.TotalSizeMb)</div></div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small text-muted" data-testid="backup-activity-caption">Exports all @rowsInRange.Count matching row(s) @RangeCaption(), not just the rows rendered on screen. This link keeps the date range.</span>
                <button class="btn btn-outline-primary" @onclick="() => ExportBackupActivity(rowsInRange)" disabled="@(rowsInRange.Count == 0)">
                    <i aria-hidden="true" class="bi bi-download"></i> Export CSV
                </button>
            </div>

            @if (rowsInRange.Count == 0)
            {
                <div class="empty-state"><i aria-hidden="true" class="bi bi-inbox"></i>No backup runs in this window.</div>
            }
            else
            {
                <div class="dbt-table">
                    <table aria-label="Backup runs in range" class="table">
                        <thead><tr><th>When</th><th>Instance</th><th>Company / Dept</th><th>Engine</th><th>Type</th><th>Status</th><th>Size</th><th>Duration</th><th>Source</th><th>Evidence <Toggletip Label="About evidence levels" TestId="report-evidence-help"><EvidenceLevelsHelp /></Toggletip></th></tr></thead>
                        <tbody>
                            @foreach (var r in rowsInRange)
                            {
                                <tr>
                                    <td><LocalTime Utc="r.TimestampUtc" Format="MMM d, h:mm tt" ShowUtc="false" /></td>
                                    <td class="fw-semibold">@r.InstanceName</td>
                                    <td>@r.Company / @r.Department</td>
                                    <td>@r.Engine</td>
                                    <td>@r.Type</td>
                                    <td><span class="badge-health dot @StatusClass(r.Status)">@r.Status</span></td>
                                    <td>@(r.SizeMb is null ? "Not recorded" : $"{r.SizeMb:N0} MB")</td>
                                    <td>@(r.DurationMinutes is null ? "Not recorded" : $"{r.DurationMinutes:N0} min")</td>
                                    <td class="text-muted">@SourceLabel(r.Source)</td>
                                    <td>
                                        @if (r.Evidence is { } level)
                                        {
                                            <span class="badge-health dot @EvidenceClass(level)">@BackupEvidenceClassifier.Describe(level)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Not a success</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            break;
        }

        case ReportType.RestoreTesting:
        {
            var rows = RestoreTestingReportBuilder.Build(
                _overviews.Select(o => new RestoreTestingInput(
                    o.Instance.Name, o.Instance.Company, o.Instance.Department, o.Instance.Role, o.Instance.Environment,
                    o.Instance.RestoreEvents.ToList(), o.Instance.RestoreTestIntervalDaysOverride)),
                RestoreTestIntervalDaysDefault, DateTime.UtcNow);
            var untested = rows.Count(r => !r.RestoreTested);
            var expired = rows.Count(r => r.Recency == RestoreTestRecency.Overdue);

            <p class="text-muted mb-3">
                @untested of @rows.Count instance(s) have never had a <em>successful</em> restore proven. Auditors treat an untested backup as a finding.
                Separately, @expired instance(s) have <strong>expired restore-test coverage</strong> (last proven restore older than the @RestoreTestIntervalDaysDefault-day default policy, or a per-instance override). This is tracked separately from backup health.
            </p>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small text-muted">Exports all @rows.Count instance(s) shown: the full result, not one page.</span>
                <button class="btn btn-outline-primary" @onclick="() => ExportRestoreTesting(rows)" disabled="@(rows.Count == 0)">
                    <i aria-hidden="true" class="bi bi-download"></i> Export CSV
                </button>
            </div>

            <div class="dbt-table">
                <table aria-label="Restore testing by instance" class="table">
                    <thead><tr><th>Instance</th><th>Company / Dept</th><th>Role</th><th>Env</th><th>Restore tested</th><th>Last successful restore</th><th>Total attempts</th><th>Coverage</th><th>Next test due</th></tr></thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td class="fw-semibold">@r.InstanceName</td>
                                <td>@r.Company / @r.Department</td>
                                <td><span class="role-pill @r.Role">@r.Role</span></td>
                                <td>@r.Environment</td>
                                <td><span class="badge-health dot @(r.RestoreTested ? "OnTrack" : "Overdue")">@(r.RestoreTested ? "Yes" : "No")</span></td>
                                <td><LocalTime Utc="r.LastSuccessfulRestoreUtc" ShowUtc="false" /></td>
                                <td>@r.TotalAttempts</td>
                                <td><span class="badge-health dot @RecencyClass(r.Recency)">@RecencyLabel(r.Recency)</span></td>
                                <td class="small text-muted"><LocalTime Utc="r.NextDueUtc" ShowUtc="false" Empty="Not scheduled" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            break;
        }

        case ReportType.OwnershipRollup:
        {
            var rows = OwnershipRollupBuilder.Build(_overviews.Select(o =>
                new OwnershipRollupInput(o.Instance.Company, o.Instance.Department, o.Health, o.Instance.ContactName)));

            <p class="text-muted mb-3">Instance counts and backup health rolled up by company and department, showing who owns each instance and where risk is concentrated.</p>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small text-muted">Exports all @rows.Count row(s) shown: the full result, not one page.</span>
                <button class="btn btn-outline-primary" @onclick="() => ExportOwnershipRollup(rows)" disabled="@(rows.Count == 0)">
                    <i aria-hidden="true" class="bi bi-download"></i> Export CSV
                </button>
            </div>

            <div class="dbt-table">
                <table aria-label="Ownership roll-up" class="table">
                    <thead><tr><th>Company</th><th>Department</th><th>Instances</th><th>On track</th><th>Overdue</th><th>Failed</th><th>Never backed up</th><th>Primary contact(s)</th></tr></thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td class="fw-semibold">@r.Company</td>
                                <td>@r.Department</td>
                                <td>@r.InstanceCount</td>
                                <td style="color:var(--dbt-ontrack)">@r.OnTrack</td>
                                <td style="color:var(--dbt-overdue)">@r.Overdue</td>
                                <td style="color:var(--dbt-failed)">@r.Failed</td>
                                <td style="color:var(--dbt-never)">@r.NeverBackedUp</td>
                                <td class="text-muted">@r.PrimaryContacts</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            break;
        }

        case ReportType.ScanActivity:
        {
            var allScanRows = ScanActivityReportBuilder.Build(
                _overviews.Select(o => new ScanActivityInput(o.Instance.Name, o.Instance.BackupFileLocation, o.Instance.LastScanUtc, o.Instance.LastScanStatus, o.Instance.LastScanError, o.Instance.LastScanSuccessUtc, o.Instance.Id)),
                ScanIntervalMinutes, StaleAfterMultiplier, DateTime.UtcNow);
            var attentionRows = ScanActivityReportBuilder.NeedingAttention(allScanRows);
            var rows = _scanAttentionOnly ? attentionRows : allScanRows;

            <p class="text-muted mb-3">Shared-drive scan status for every instance with a backup file location configured, as evidence that the automated scan is actually running. A scan that hasn't succeeded in a while shows as <strong>Stale</strong> even if its last result was a success, because the scanner itself may have stopped.</p>

            @if (ScanIntervalMinutes <= 0)
            {
                <p class="small mb-3" role="status" data-testid="scan-background-off"><i aria-hidden="true" class="bi bi-pause-circle"></i> Background scanning is off (BackupScan:IntervalMinutes is 0), so instances only update when someone uses "Scan now". They show as <strong>Background scan off</strong> instead of Healthy.</p>
            }

            <div class="filter-bar" style="padding-top:0;border-top:none;border-bottom:none;margin-bottom:6px;gap:12px;">
                <button type="button" class="btn btn-sm @(_scanAttentionOnly ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(_scanAttentionOnly ? "true" : "false")" data-testid="scan-filter-attention" @onclick="() => SetScanFilter(true)">Needs attention (@attentionRows.Count)</button>
                <button type="button" class="btn btn-sm @(!_scanAttentionOnly ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(!_scanAttentionOnly ? "true" : "false")" data-testid="scan-filter-all" @onclick="() => SetScanFilter(false)">All configured (@allScanRows.Count)</button>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small text-muted">Exports all @rows.Count row(s) shown: the full result, not one page.</span>
                <button class="btn btn-outline-primary" @onclick="() => ExportScanActivity(rows)" disabled="@(rows.Count == 0)">
                    <i aria-hidden="true" class="bi bi-download"></i> Export CSV
                </button>
            </div>

            @if (rows.Count == 0 && _scanAttentionOnly && allScanRows.Count > 0)
            {
                <div class="empty-state" role="status"><i aria-hidden="true" class="bi bi-check-circle"></i>No scans need attention right now.</div>
            }
            else if (rows.Count == 0)
            {
                <div class="empty-state"><i aria-hidden="true" class="bi bi-inbox"></i>No instance has a backup file location configured yet. Set one on an instance's Edit page so the scanner can find its backup files.</div>
            }
            else
            {
                <div class="dbt-table">
                    <table aria-label="Scan activity by instance" class="table">
                        <thead><tr><th>Instance</th><th>Backup file location</th><th>Last attempt</th><th>Last success</th><th>Status</th><th>Next expected</th><th>Detail</th></tr></thead>
                        <tbody>
                            @foreach (var r in rows)
                            {
                                <tr id="scan-row-@r.InstanceId" data-testid="scan-activity-row">
                                    <td class="fw-semibold"><a href="/instances/@r.InstanceId">@r.InstanceName</a></td>
                                    <td class="text-muted">@r.BackupFileLocation</td>
                                    <td>@(r.LastScanUtc is null ? "Never" : r.LastScanUtc.Value.ToLocalTime().ToString("MMM d, h:mm tt"))</td>
                                    <td>@(r.Scanner.LastSuccessUtc is null ? "Never" : r.Scanner.LastSuccessUtc.Value.ToLocalTime().ToString("MMM d, h:mm tt"))</td>
                                    <td><span class="badge-health dot @ScannerFreshnessClass(r.Scanner.Freshness)">@ScannerStalenessClassifier.Describe(r.Scanner.Freshness)</span></td>
                                    <td class="small text-muted">@(r.Scanner.NextExpectedCheckUtc is null ? "Not scheduled" : r.Scanner.NextExpectedCheckUtc.Value.ToLocalTime().ToString("MMM d, h:mm tt"))</td>
                                    <td class="small @(r.LastScanStatus == ScanStatus.Error ? "text-danger" : "text-muted")">
                                        @if (r.LastScanStatus == ScanStatus.Error)
                                        {
                                            <span class="d-block">@r.LastScanError</span>
                                        }
                                        <span class="d-block @(r.LastScanStatus == ScanStatus.Error ? "text-muted" : "")">@r.Scanner.RecoveryHint</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            break;
        }

        case ReportType.ComplianceSnapshot:
        {
            <p class="text-muted mb-3">Point-in-time snapshot of last-backup age, health and restore-test status per instance. This is the detailed audit view, filterable by role and environment.</p>
            <a class="btn btn-outline-secondary" href="/compliance">
                <i aria-hidden="true" class="bi bi-clipboard-check"></i> Open Compliance snapshot
            </a>
            break;
        }

        case ReportType.Trends:
        {
            <p class="text-muted mb-3">
                Compares two time periods using saved <a href="/compliance">Compliance snapshots</a> for point-in-time
                health/restore-test coverage, and raw dated backup/restore/incident events for everything else. It never works by
                re-running today's health calculator against old data, which would misrepresent instances that didn't exist
                yet or whose policy has since changed. A period with no snapshot is flagged explicitly, not interpolated.
                Retention-days values alone are not evidence that backup files still exist on disk (tracked separately, future scope).
                Only a snapshot saved during a period counts as that period's evidence; an older one describes an earlier time.
                Dates are whole days in @ZoneName.
            </p>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted mb-2">Period A (earlier)</h2>
                        <div class="d-flex gap-2">
                            <div class="field"><label class="form-label small" for="trend-a-from">From</label><input id="trend-a-from" type="date" class="form-control form-control-sm" @bind="_trendAFrom" /></div>
                            <div class="field"><label class="form-label small" for="trend-a-to">To</label><input id="trend-a-to" type="date" class="form-control form-control-sm" @bind="_trendATo" /></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted mb-2">Period B (later)</h2>
                        <div class="d-flex gap-2">
                            <div class="field"><label class="form-label small" for="trend-b-from">From</label><input id="trend-b-from" type="date" class="form-control form-control-sm" @bind="_trendBFrom" /></div>
                            <div class="field"><label class="form-label small" for="trend-b-to">To</label><input id="trend-b-to" type="date" class="form-control form-control-sm" @bind="_trendBTo" /></div>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary mb-4" @onclick="RunTrendComparison" disabled="@_trendLoading">@(_trendLoading ? "Comparing…" : "Compare periods")</button>

            @if (_trendResult is not null)
            {
                var a = _trendResult.PeriodA;
                var b = _trendResult.PeriodB;

                <div class="dbt-table mb-4" role="region" aria-label="Trend comparison between the two selected periods" tabindex="0">
                    <table class="table table-sm">
                        <caption class="visually-hidden">Side-by-side comparison of health coverage, risk, and backup activity for Period A and Period B.</caption>
                        <thead><tr><th scope="col">Metric</th><th scope="col">Period A (@FormatRange(a))</th><th scope="col">Period B (@FormatRange(b))</th></tr></thead>
                        <tbody>
                            <tr>
                                <td class="small fw-semibold">Inventory (denominator)</td>
                                <td class="small">@EvidenceCell(a, r => r.InventoryCount?.ToString())</td>
                                <td class="small">@EvidenceCell(b, r => r.InventoryCount?.ToString())</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">On-track coverage</td>
                                <td class="small">
                                    @if (a.MissingEvidence || a.OnTrackPct is not { } onTrackPctA)
                                    {
                                        <span>No snapshot: missing evidence</span>
                                    }
                                    else
                                    {
                                        <span aria-hidden="true" style="display:inline-block;width:60px;height:8px;background:var(--dbt-line);vertical-align:middle;margin-right:6px;">
                                            <span style="display:block;height:8px;width:@(Math.Clamp(onTrackPctA, 0, 100).ToString("N0"))%;background:var(--dbt-ontrack);"></span>
                                        </span>
                                        <span>@onTrackPctA.ToString("N0")% on track (@a.OnTrackCount/@a.InventoryCount)</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (b.MissingEvidence || b.OnTrackPct is not { } onTrackPctB)
                                    {
                                        <span>No snapshot: missing evidence</span>
                                    }
                                    else
                                    {
                                        <span aria-hidden="true" style="display:inline-block;width:60px;height:8px;background:var(--dbt-line);vertical-align:middle;margin-right:6px;">
                                            <span style="display:block;height:8px;width:@(Math.Clamp(onTrackPctB, 0, 100).ToString("N0"))%;background:var(--dbt-ontrack);"></span>
                                        </span>
                                        <span>@onTrackPctB.ToString("N0")% on track (@b.OnTrackCount/@b.InventoryCount)</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">At-risk instances</td>
                                <td class="small">@EvidenceCell(a, r => r.AtRiskCount?.ToString())</td>
                                <td class="small">@EvidenceCell(b, r => r.AtRiskCount?.ToString())</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Restore-tested coverage</td>
                                <td class="small">@EvidenceCell(a, r => r.RestoreTestedPct is { } p ? $"{p:N0}%" : null)</td>
                                <td class="small">@EvidenceCell(b, r => r.RestoreTestedPct is { } p ? $"{p:N0}%" : null)</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Restore-test coverage at snapshot (current / expired / never tested)</td>
                                <td class="small" data-testid="trend-a-recency">@RecencyCell(a)</td>
                                <td class="small" data-testid="trend-b-recency">@RecencyCell(b)</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Backup policy changes in period</td>
                                <td class="small">@a.PolicyChanges.Count</td>
                                <td class="small">@b.PolicyChanges.Count</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Restore tests performed in period</td>
                                <td class="small">@a.RestoreTestsPerformed</td>
                                <td class="small">@b.RestoreTestsPerformed</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Repeated-failure instances (2+ failures)</td>
                                <td class="small">@a.RepeatedFailureInstanceCount</td>
                                <td class="small">@b.RepeatedFailureInstanceCount</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Avg backup duration</td>
                                <td class="small">@(a.AvgBackupDurationMinutes is { } ad ? $"{ad:N0} min" : "No data")</td>
                                <td class="small">@(b.AvgBackupDurationMinutes is { } bd ? $"{bd:N0} min" : "No data")</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Avg backup size</td>
                                <td class="small">@(a.AvgBackupSizeMb is { } asz ? FormatMb(asz) : "No data")</td>
                                <td class="small">@(b.AvgBackupSizeMb is { } bsz ? FormatMb(bsz) : "No data")</td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Avg outstanding-risk age</td>
                                <td class="small">@(a.AverageOutstandingRiskAgeHours is { } aage ? FormatHours(aage) : "No data")</td>
                                <td class="small">@(b.AverageOutstandingRiskAgeHours is { } bage ? FormatHours(bage) : "No data")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                @if (a.MissingEvidence || b.MissingEvidence)
                {
                    <div class="alert alert-danger mb-4" role="status" data-testid="trend-missing-evidence">
                        <i aria-hidden="true" class="bi bi-exclamation-triangle"></i>
                        @if (a.MissingEvidence) { <span>Period A: @a.MissingEvidenceReason </span> }
                        @if (b.MissingEvidence) { <span>Period B: @b.MissingEvidenceReason </span> }
                        Health-coverage and restore-tested percentages are not shown for that period rather than inferred from today's live inventory. Save a snapshot on the <a href="/compliance">Compliance page</a> during each period you want to compare.
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <h3 class="h6 text-muted mb-2">Period A: at-risk rows (drill-down)</h3>
                        @if (a.AtRiskRows.Count == 0)
                        {
                            <div class="text-muted small mb-3">None.</div>
                        }
                        else
                        {
                            <div class="dbt-table mb-3" role="region" aria-label="Period A at-risk instances" tabindex="0">
                                <table class="table table-sm">
                                    <thead><tr><th scope="col">Instance</th><th scope="col">Health</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in a.AtRiskRows)
                                        {
                                            <tr><td class="small">@InstanceLink(row.InstanceName, row.InstanceId)</td><td class="small">@row.Health</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @TrendExtras(a, "A")

                        <h3 class="h6 text-muted mb-2 mt-3">Period A: repeated failures</h3>
                        @if (a.RepeatedFailureRows.Count == 0)
                        {
                            <div class="text-muted small mb-3">None.</div>
                        }
                        else
                        {
                            <div class="dbt-table mb-3" role="region" aria-label="Period A repeated backup failures" tabindex="0">
                                <table class="table table-sm">
                                    <thead><tr><th scope="col">Instance</th><th scope="col">Failures</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in a.RepeatedFailureRows)
                                        {
                                            <tr><td class="small">@InstanceLink(row.InstanceName, null)</td><td class="small">@row.FailureCount</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <h3 class="h6 text-muted mb-2 mt-3">Period A: outstanding risk (open incidents as of period end)</h3>
                        @if (a.OutstandingRiskRows.Count == 0)
                        {
                            <div class="text-muted small mb-3">None open as of period end.</div>
                        }
                        else
                        {
                            <div class="dbt-table mb-3" role="region" aria-label="Period A outstanding risk" tabindex="0">
                                <table class="table table-sm">
                                    <thead><tr><th scope="col">Instance</th><th scope="col">Opened</th><th scope="col">Trigger</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in a.OutstandingRiskRows)
                                        {
                                            <tr><td class="small">@InstanceLink(row.InstanceName, null)</td><td class="small"><LocalTime Utc="row.OpenedAtUtc" ShowUtc="false" /></td><td class="small">@row.TriggerHealth</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <h3 class="h6 text-muted mb-2">Period B: at-risk rows (drill-down)</h3>
                        @if (b.AtRiskRows.Count == 0)
                        {
                            <div class="text-muted small mb-3">None.</div>
                        }
                        else
                        {
                            <div class="dbt-table mb-3" role="region" aria-label="Period B at-risk instances" tabindex="0">
                                <table class="table table-sm">
                                    <thead><tr><th scope="col">Instance</th><th scope="col">Health</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in b.AtRiskRows)
                                        {
                                            <tr><td class="small">@InstanceLink(row.InstanceName, row.InstanceId)</td><td class="small">@row.Health</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @TrendExtras(b, "B")

                        <h3 class="h6 text-muted mb-2 mt-3">Period B: repeated failures</h3>
                        @if (b.RepeatedFailureRows.Count == 0)
                        {
                            <div class="text-muted small mb-3">None.</div>
                        }
                        else
                        {
                            <div class="dbt-table mb-3" role="region" aria-label="Period B repeated backup failures" tabindex="0">
                                <table class="table table-sm">
                                    <thead><tr><th scope="col">Instance</th><th scope="col">Failures</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in b.RepeatedFailureRows)
                                        {
                                            <tr><td class="small">@InstanceLink(row.InstanceName, null)</td><td class="small">@row.FailureCount</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <h3 class="h6 text-muted mb-2 mt-3">Period B: outstanding risk (open incidents as of period end)</h3>
                        @if (b.OutstandingRiskRows.Count == 0)
                        {
                            <div class="text-muted small mb-3">None open as of period end.</div>
                        }
                        else
                        {
                            <div class="dbt-table mb-3" role="region" aria-label="Period B outstanding risk" tabindex="0">
                                <table class="table table-sm">
                                    <thead><tr><th scope="col">Instance</th><th scope="col">Opened</th><th scope="col">Trigger</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in b.OutstandingRiskRows)
                                        {
                                            <tr><td class="small">@InstanceLink(row.InstanceName, null)</td><td class="small"><LocalTime Utc="row.OpenedAtUtc" ShowUtc="false" /></td><td class="small">@row.TriggerHealth</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            break;
        }

        case ReportType.ManagementSummary:
        {
            <p class="text-muted mb-3">The same leadership-ready roll-up sent on schedule (<code>Reports:IntervalDays</code>) or on demand, as plain text ready to paste into an email or ticket.</p>

            <div class="d-flex gap-2 mb-3">
                <AuthorizeView Roles="@Roles.ReportingPolicy">
                    <Authorized>
                        <ReportSendPanel ButtonText="Send now" ButtonClass="btn-primary" FullScopeCount="@(_overviews?.Count ?? 0)" FilteredScope="null" />
                    </Authorized>
                </AuthorizeView>
                <button class="btn btn-outline-secondary" @onclick="CopySummary">
                    <i aria-hidden="true" class="bi bi-clipboard"></i> Copy to clipboard
                </button>
            </div>

            <pre style="background:var(--dbt-bg-raised);border:1px solid var(--dbt-border);padding:20px 24px;font-size:12.5px;line-height:1.6;white-space:pre-wrap;color:var(--dbt-text);">@SummaryPreview()</pre>
            break;
        }
    }
}

@code {
    private enum ReportType { BackupActivity, RestoreTesting, OwnershipRollup, ScanActivity, ComplianceSnapshot, Trends, ManagementSummary }

    private static readonly ReportType[] ReportTypeOrder =
    [
        ReportType.BackupActivity, ReportType.RestoreTesting, ReportType.OwnershipRollup,
        ReportType.ScanActivity, ReportType.ComplianceSnapshot, ReportType.Trends, ReportType.ManagementSummary
    ];

    // Lets the dashboard's scan-issue banner (and any other link) open this page directly on a
    // given report type (for example /reports?type=ScanActivity) instead of landing on the
    // default tab and making the user click again.
    [Parameter, SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }

    // U05: the Backup activity date window round-trips through the URL, so a shared or bookmarked
    // link reopens the same range. ReportRangeQuery validates it and falls back to the 7-day preset.
    [Parameter, SupplyParameterFromQuery(Name = "days")] public string? Days { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }

    // U02: "attention" narrows Scan activity to the rows the dashboard banner counted.
    [Parameter, SupplyParameterFromQuery(Name = "scan")] public string? Scan { get; set; }

    private List<InstanceOverview>? _overviews;
    private ReportType _selected = ReportType.BackupActivity;
    private ReportRangeQuery _range = ReportRangeQuery.Default(DateOnly.FromDateTime(DateTime.Today));
    private bool _useCustomRange;
    private DateTime _customFrom = DateTime.Today.AddDays(-7);
    private DateTime _customTo = DateTime.Today;
    private string? _rangeError;
    private bool _scanAttentionOnly;
    private List<BackupActivityRow> _activityRows = new();
    private (DateTime FromUtc, DateTime ToUtc) _activityRangeUtc;

    // U22: Period A/B default to two adjacent 30-day windows: "this period vs. the one before it".
    private DateTime _trendAFrom = DateTime.Today.AddDays(-60);
    private DateTime _trendATo = DateTime.Today.AddDays(-30);
    private DateTime _trendBFrom = DateTime.Today.AddDays(-30);
    private DateTime _trendBTo = DateTime.Today;
    private bool _trendLoading;
    private TrendComparisonResult? _trendResult;

    private int ScanIntervalMinutes => Configuration.GetValue("BackupScan:IntervalMinutes", 15);
    private int StaleAfterMultiplier => Configuration.GetValue("BackupScan:StaleAfterMultiplier", 3);
    private int RestoreTestIntervalDaysDefault => Configuration.GetValue("RestoreTest:IntervalDays", 90);

    protected override async Task OnInitializedAsync()
    {
        // U06: current state per instance without loading every backup history; Backup activity queries its own window below.
        _overviews = await OverviewService.GetAllLatestAsync();
        Viewer.Changed += OnViewerZoneChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQuery();
        await LoadBackupActivityAsync();
    }

    private void ApplyQuery()
    {
        if (Enum.TryParse<ReportType>(Type, true, out var requested))
        {
            _selected = requested;
        }

        _range = ReportRangeQuery.Parse(Days, From, To, DateOnly.FromDateTime(DateTime.Today));
        _useCustomRange = _range.IsCustom;
        if (_range.IsCustom)
        {
            _customFrom = _range.From.ToDateTime(TimeOnly.MinValue);
            _customTo = _range.To.ToDateTime(TimeOnly.MinValue);
        }
        _rangeError = null;
        _scanAttentionOnly = string.Equals(Scan, "attention", StringComparison.OrdinalIgnoreCase);
    }

    private string CurrentUrl(ReportType type) =>
        $"/reports?type={type}&{_range.ToQueryString()}{(_scanAttentionOnly ? "&scan=attention" : "")}";

    private void SelectType(ReportType type)
    {
        _selected = type;
        Nav.NavigateTo(CurrentUrl(type));
    }

    private async Task LoadBackupActivityAsync()
    {
        var (fromUtc, toUtc) = CurrentRangeUtc();
        _activityRows = await OverviewService.GetBackupActivityAsync(fromUtc, toUtc);
        _activityRangeUtc = (fromUtc, toUtc);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Viewer.Known)
        {
            await Viewer.EnsureLoadedAsync(JS);
        }
    }

    private void OnViewerZoneChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Viewer.Changed -= OnViewerZoneChanged;

    private string ZoneName => Viewer.ZoneId;

    /// <summary>Plain caption for the active window: "in the last 7 day(s)" for a preset, or the custom dates and zone.</summary>
    private string RangeCaption() =>
        _range.IsCustom
            ? $"from {_range.Describe()} ({ZoneName}, inclusive)"
            : $"for {_range.Describe()}";

    private static string SourceLabel(BackupSource source) => source switch
    {
        BackupSource.Discovered => "Discovered",
        BackupSource.Imported => "Imported",
        _ => "Logged"
    };

    private RenderFragment InstanceLink(string name, int? id) => builder =>
    {
        var resolved = id ?? _overviews?.FirstOrDefault(o => string.Equals(o.Instance.Name, name, StringComparison.OrdinalIgnoreCase))?.Instance.Id;
        if (resolved is { } instanceId)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/instances/{instanceId}");
            builder.AddContent(2, name);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(3, name);
        }
    };

    private static string RecencyCell(TrendPeriodResult r) =>
        r.MissingEvidence ? "No snapshot: missing evidence"
        : r.RestoreCurrentCount is null ? "Not recorded in this snapshot"
        : $"{r.RestoreCurrentCount} / {r.RestoreOverdueCount} / {r.RestoreNeverTestedCount}";

    private void SelectPreset(int days)
    {
        _useCustomRange = false;
        _rangeError = null;
        _range = ReportRangeQuery.Preset(days, DateOnly.FromDateTime(DateTime.Today));
        Nav.NavigateTo(CurrentUrl(_selected), replace: true);
    }

    private void SelectCustom()
    {
        _useCustomRange = true;
        ApplyCustomRange();
    }

    private void ApplyCustomRange()
    {
        var custom = ReportRangeQuery.Custom(DateOnly.FromDateTime(_customFrom), DateOnly.FromDateTime(_customTo));
        if (custom is null)
        {
            _rangeError = _customFrom > _customTo
                ? "From must be on or before To."
                : $"Choose a range of {ReportRangeQuery.MaxCustomDays} days or less.";
            return;
        }

        _rangeError = null;
        _range = custom;
        Nav.NavigateTo(CurrentUrl(_selected), replace: true);
    }

    private void SetScanFilter(bool attentionOnly)
    {
        _scanAttentionOnly = attentionOnly;
        Nav.NavigateTo(CurrentUrl(_selected), replace: true);
    }

    /// <summary>A custom range is whole calendar days in the viewer's zone, converted to UTC: start of the first day to the end of the last (inclusive).</summary>
    private (DateTime FromUtc, DateTime ToUtc) CurrentRangeUtc()
    {
        if (!_useCustomRange || !_range.IsCustom)
        {
            return (DateTime.UtcNow.AddDays(-_range.PresetDays), DateTime.UtcNow);
        }

        return ToUtcRange(_range.From.ToDateTime(TimeOnly.MinValue), _range.To.ToDateTime(TimeOnly.MinValue));
    }

    /// <summary>Whole calendar days in the viewer's zone, as UTC: 00:00 on the first day (inclusive) to the end of the last day (inclusive).</summary>
    private (DateTime FromUtc, DateTime ToUtc) ToUtcRange(DateTime fromLocal, DateTime toLocal) =>
        (DayStartUtc(fromLocal.Date), DayStartUtc(toLocal.Date.AddDays(1)).AddTicks(-1));

    /// <summary>Midnight in the viewer's zone. Where a daylight-saving change skips midnight, the first valid hour is used.</summary>
    private DateTime DayStartUtc(DateTime day)
    {
        for (var hour = 0; hour < 3; hour++)
        {
            if (Viewer.FromViewer(day.AddHours(hour)) is { Ok: true } result)
            {
                return result.Utc!.Value;
            }
        }
        return DateTime.SpecifyKind(day, DateTimeKind.Utc);
    }

    private async Task RunTrendComparison()
    {
        _trendLoading = true;
        var (aFromUtc, aToUtc) = ToUtcRange(_trendAFrom, _trendATo);
        var (bFromUtc, bToUtc) = ToUtcRange(_trendBFrom, _trendBTo);

        var inputA = await BuildTrendPeriodInputAsync(aFromUtc, aToUtc);
        var inputB = await BuildTrendPeriodInputAsync(bFromUtc, bToUtc);
        _trendResult = TrendsReportBuilder.Compare(inputA, inputB);
        _trendLoading = false;
    }

    /// <summary>
    /// Gathers one trend period's inputs (U22): the nearest saved Compliance snapshot at or before
    /// the period's end for point-in-time health/restore-tested coverage (null, meaning "missing evidence",
    /// if none exists), plus raw dated BackupRecord/RestoreEvent/Incident rows within the period.
    /// </summary>
    private async Task<TrendPeriodInput> BuildTrendPeriodInputAsync(DateTime fromUtc, DateTime toUtc)
    {
        var candidates = await Db.ComplianceSnapshots.AsNoTracking()
            .Where(s => s.EffectiveAsOfUtc <= toUtc)
            .OrderByDescending(s => s.EffectiveAsOfUtc)
            .Take(50)
            .Select(s => new TrendSnapshotCandidate(s.Id, s.EffectiveAsOfUtc))
            .ToListAsync();
        var choice = TrendsReportBuilder.SelectSnapshot(candidates, fromUtc, toUtc);
        var snapshot = choice.SnapshotId is { } snapshotId
            ? await Db.ComplianceSnapshots.AsNoTracking().FirstOrDefaultAsync(s => s.Id == snapshotId)
            : null;
        var snapshotRows = snapshot is null ? null : ComplianceSnapshotBuilder.Deserialize(snapshot.RowsJson);

        var policyChanges = (await AuditLog.ListByActionAsync(BackupPolicyService.PolicyChangeActions, fromUtc, toUtc))
            .Select(e => new TrendPolicyChange(e.TimestampUtc, e.TargetName, e.ActorName, PolicyChangeSummary(e)))
            .ToList();

        var backupEvents = await Db.BackupRecords.AsNoTracking()
            .Where(r => r.TimestampUtc >= fromUtc && r.TimestampUtc <= toUtc)
            .Select(r => new { r.DatabaseInstance!.Name, r.TimestampUtc, r.Status, r.SizeMb, r.DurationMinutes })
            .ToListAsync();

        var restoreTestTimestamps = await Db.RestoreEvents.AsNoTracking()
            .Where(r => r.Outcome == RestoreOutcome.Success && r.Source != BackupSource.Imported && r.TimestampUtc >= fromUtc && r.TimestampUtc <= toUtc)
            .Select(r => r.TimestampUtc)
            .ToListAsync();

        var openIncidents = await Incidents.ListOpenAsOfAsync(toUtc);

        return new TrendPeriodInput(
            fromUtc, toUtc, snapshotRows, snapshot?.EffectiveAsOfUtc,
            backupEvents.Select(e => new TrendBackupEvent(e.Name, e.TimestampUtc, e.Status, e.SizeMb, e.DurationMinutes)).ToList(),
            restoreTestTimestamps,
            openIncidents.Select(i => new TrendOutstandingRisk(i.DatabaseInstance?.Name ?? $"Instance #{i.DatabaseInstanceId}", i.OpenedAtUtc, i.TriggerHealth)).ToList(),
            policyChanges,
            choice.MissingReason);
    }

    private static string PolicyChangeSummary(AuditEvent e)
    {
        if (e.Action == "BackupPolicyCreated")
        {
            return "Created";
        }

        var changes = AuditDiffJson.Pair(e.BeforeJson, e.AfterJson)
            .Where(p => p.Field != "Version" && p.Before != p.After)
            .Select(p => $"{p.Field} {(p.Before.Length == 0 ? "(none)" : p.Before)} to {(p.After.Length == 0 ? "(none)" : p.After)}");
        var text = string.Join("; ", changes);
        return text.Length == 0 ? "Edited" : text;
    }

    private RenderFragment TrendExtras(TrendPeriodResult period, string label) => @<text>
        <h3 class="h6 text-muted mb-2 mt-3">Period @label: expired restore-test coverage at snapshot</h3>
        @if (period.RestoreOverdueRows.Count == 0)
        {
            <div class="text-muted small mb-3">@(period.MissingEvidence ? "No snapshot." : period.RestoreCurrentCount is null ? "Not recorded in this snapshot." : "None.")</div>
        }
        else
        {
            <div class="dbt-table mb-3" role="region" aria-label="Period @label expired restore-test coverage" tabindex="0">
                <table class="table table-sm">
                    <thead><tr><th scope="col">Instance</th><th scope="col">Last verified restore</th></tr></thead>
                    <tbody>
                        @foreach (var row in period.RestoreOverdueRows)
                        {
                            <tr><td class="small">@InstanceLink(row.InstanceName, row.InstanceId)</td><td class="small"><LocalTime Utc="row.LastVerifiedRestoreUtc" ShowUtc="false" /></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h3 class="h6 text-muted mb-2 mt-3">Period @label: backup policy changes</h3>
        @if (period.PolicyChanges.Count == 0)
        {
            <div class="text-muted small mb-3">No policy was created or edited in this period.</div>
        }
        else
        {
            <div class="dbt-table mb-3" role="region" aria-label="Period @label backup policy changes" tabindex="0">
                <table class="table table-sm">
                    <thead><tr><th scope="col">When</th><th scope="col">Policy</th><th scope="col">By</th><th scope="col">Change</th></tr></thead>
                    <tbody>
                        @foreach (var change in period.PolicyChanges)
                        {
                            <tr><td class="small"><LocalTime Utc="change.ChangedAtUtc" ShowUtc="false" /></td><td class="small">@change.PolicyName</td><td class="small">@change.ChangedBy</td><td class="small">@change.Summary</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </text>;

    private string FormatRange(TrendPeriodResult r)
    {
        var from = Viewer.ToViewer(r.FromUtc);
        var to = Viewer.ToViewer(r.ToUtc);
        return $"{from:MMM d} to {to:MMM d, yyyy}";
    }

    private static string FormatHours(double hours) =>
        hours >= 24 ? $"{hours / 24:N1} d" : $"{hours:N0} h";

    private static string EvidenceCell(TrendPeriodResult r, Func<TrendPeriodResult, string?> format) =>
        r.MissingEvidence ? "No snapshot: missing evidence" : format(r) ?? "No data";

    private static string RecencyClass(RestoreTestRecency recency) => recency switch
    {
        RestoreTestRecency.Current => "OnTrack",
        RestoreTestRecency.Overdue => "Overdue",
        _ => "NeverBackedUp"
    };

    private static string RecencyLabel(RestoreTestRecency recency) => recency switch
    {
        RestoreTestRecency.Current => "Current",
        RestoreTestRecency.Overdue => "Expired",
        _ => "Never tested"
    };

    private static string EvidenceClass(EvidenceLevel level) => level switch
    {
        EvidenceLevel.RestoreTested => "OnTrack",
        EvidenceLevel.ReportedSuccess => "Overdue",
        _ => "NeverBackedUp"
    };

    private static string ScannerFreshnessClass(ScannerFreshness freshness) => freshness switch
    {
        ScannerFreshness.Error => "Failed",
        ScannerFreshness.Stale => "Overdue",
        ScannerFreshness.Healthy => "OnTrack",
        _ => "NeverBackedUp"
    };

    private static string Label(ReportType type) => type switch
    {
        ReportType.BackupActivity => "Backup activity",
        ReportType.RestoreTesting => "Restore testing",
        ReportType.OwnershipRollup => "Ownership roll-up",
        ReportType.ScanActivity => "Scan activity",
        ReportType.ComplianceSnapshot => "Compliance snapshot",
        ReportType.Trends => "Trends",
        ReportType.ManagementSummary => "Management summary",
        _ => type.ToString()
    };

    private static string FormatMb(double totalMb) =>
        totalMb >= 1024 ? $"{totalMb / 1024:N1} GB" : $"{totalMb:N0} MB";

    private static string StatusClass(BackupStatus status) => status switch
    {
        BackupStatus.Success => "OnTrack",
        BackupStatus.Failed => "Failed",
        BackupStatus.Missed => "Failed",
        _ => "NeverBackedUp"
    };

    private string SummaryPreview()
    {
        var now = DateTime.UtcNow;
        var rows = (_overviews ?? []).Select(o => new ComplianceReportRow(
            o.Instance, o.Health, o.LastBackupUtc, RestoreEvidence.AnyVerified(o.Instance.RestoreEvents),
            BackupEvidenceClassifier.ClassifyLatestSuccess(o.Instance.BackupRecords.ToList(), o.Instance.RestoreEvents.ToList(), now))).ToList();
        return ComplianceReportBuilder.BuildPlainTextBody(rows, DateTime.UtcNow);
    }


    private async Task CopySummary()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", SummaryPreview());
        Toasts.Success("Report body copied to clipboard.");
    }

    private static string Csv(string value) =>
        value.Contains(',') || value.Contains('"')
            ? $"\"{value.Replace("\"", "\"\"")}\""
            : value;

    private async Task DownloadCsv(string fileName, string content) =>
        await JS.InvokeVoidAsync("dbtracker.downloadCsv", fileName, content);

    private Task ExportBackupActivity(IReadOnlyList<BackupActivityRow> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("TimestampUtc,Instance,Company,Department,Engine,Type,Status,SizeMb,DurationMinutes,Source,EvidenceLevel");
        foreach (var r in rows)
        {
            sb.AppendLine(string.Join(",", Csv(r.TimestampUtc.ToString("O")), Csv(r.InstanceName), Csv(r.Company), Csv(r.Department),
                Csv(r.Engine.ToString()), Csv(r.Type.ToString()), Csv(r.Status.ToString()),
                Csv(r.SizeMb?.ToString("N1") ?? ""), Csv(r.DurationMinutes?.ToString("N1") ?? ""), Csv(r.Source.ToString()),
                Csv(BackupEvidenceClassifier.DescribeOrEmpty(r.Evidence))));
        }
        return DownloadCsv($"dbtracker-backup-activity-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv", sb.ToString());
    }

    private Task ExportRestoreTesting(IReadOnlyList<RestoreTestingRow> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Instance,Company,Department,Role,Environment,RestoreTested,LastSuccessfulRestoreUtc,TotalAttempts,Coverage,NextTestDueUtc");
        foreach (var r in rows)
        {
            sb.AppendLine(string.Join(",", Csv(r.InstanceName), Csv(r.Company), Csv(r.Department), Csv(r.Role.ToString()), Csv(r.Environment.ToString()),
                Csv(r.RestoreTested ? "Yes" : "No"), Csv(r.LastSuccessfulRestoreUtc?.ToString("O") ?? ""), Csv(r.TotalAttempts.ToString()),
                Csv(r.Recency.ToString()), Csv(r.NextDueUtc?.ToString("O") ?? "")));
        }
        return DownloadCsv($"dbtracker-restore-testing-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv", sb.ToString());
    }

    private Task ExportOwnershipRollup(IReadOnlyList<OwnershipRollupRow> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Company,Department,Instances,OnTrack,Overdue,Failed,NeverBackedUp,PrimaryContacts");
        foreach (var r in rows)
        {
            sb.AppendLine(string.Join(",", Csv(r.Company), Csv(r.Department), Csv(r.InstanceCount.ToString()), Csv(r.OnTrack.ToString()),
                Csv(r.Overdue.ToString()), Csv(r.Failed.ToString()), Csv(r.NeverBackedUp.ToString()), Csv(r.PrimaryContacts)));
        }
        return DownloadCsv($"dbtracker-ownership-rollup-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv", sb.ToString());
    }

    private Task ExportScanActivity(IReadOnlyList<ScanActivityRow> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Instance,BackupFileLocation,LastScanUtc,LastScanSuccessUtc,Status,Freshness,Error");
        foreach (var r in rows)
        {
            sb.AppendLine(string.Join(",", Csv(r.InstanceName), Csv(r.BackupFileLocation), Csv(r.LastScanUtc?.ToString("O") ?? ""),
                Csv(r.Scanner.LastSuccessUtc?.ToString("O") ?? ""), Csv(r.LastScanStatus.ToString()), Csv(ScannerStalenessClassifier.Describe(r.Scanner.Freshness)), Csv(r.LastScanError)));
        }
        return DownloadCsv($"dbtracker-scan-activity-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv", sb.ToString());
    }
}
