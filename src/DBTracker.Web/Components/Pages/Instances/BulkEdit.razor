@page "/instances/bulk-edit"
@attribute [Authorize(Roles = Roles.CanEditPolicy)]
@inject InstanceBulkEditService BulkEditService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Bulk edit instances · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Bulk edit @_instanceIds.Count instance(s)</h1>
        <div class="subtitle">Changes owner, tags and retention only. Archiving stays a separate, individually-confirmed action.</div>
    </div>
    <a class="btn btn-outline-secondary" href="/instances">Cancel</a>
</div>

@if (_instanceIds.Count == 0)
{
    <div class="empty-state"><i class="bi bi-inbox" aria-hidden="true"></i> No instances selected. <a href="/instances">Select instances on the inventory list</a>.</div>
}
else
{
    <div class="dbt-card mb-4" style="max-width:760px;">
        <h2 class="h6 text-muted mb-3">Changes to apply</h2>

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="set-owner" @bind="_setOwner" />
            <label class="form-check-label" for="set-owner">Set owner (company / department / contact)</label>
        </div>
        @if (_setOwner)
        {
            <div class="row g-2 mb-3 ms-4" style="max-width:700px;">
                <div class="col-md-6"><label class="form-label small mb-1" for="bulk-company">Company</label><input id="bulk-company" class="form-control form-control-sm" placeholder="Company" @bind="_company" @bind:event="oninput" /></div>
                <div class="col-md-6"><label class="form-label small mb-1" for="bulk-department">Department</label><input id="bulk-department" class="form-control form-control-sm" placeholder="Department" @bind="_department" @bind:event="oninput" /></div>
                <div class="col-md-6"><label class="form-label small mb-1" for="bulk-contact-name">Contact name</label><input id="bulk-contact-name" class="form-control form-control-sm" placeholder="Contact name" @bind="_contactName" @bind:event="oninput" /></div>
                <div class="col-md-6"><label class="form-label small mb-1" for="bulk-contact-email">Contact email</label><input id="bulk-contact-email" class="form-control form-control-sm" placeholder="Contact email" @bind="_contactEmail" @bind:event="oninput" /></div>
            </div>
        }

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="set-tags" @bind="_setTags" />
            <label class="form-check-label" for="set-tags">Set tags</label>
        </div>
        @if (_setTags)
        {
            <div class="mb-3 ms-4" style="max-width:400px;">
                <label class="form-label small mb-1" for="bulk-tags">Tags, separated by commas</label>
                <input id="bulk-tags" class="form-control form-control-sm" placeholder="comma, separated, tags" @bind="_tags" @bind:event="oninput" />
            </div>
        }

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="set-retention" @bind="_setRetention" />
            <label class="form-check-label" for="set-retention">Set retention policy (days)</label>
        </div>
        @if (_setRetention)
        {
            <div class="mb-3 ms-4" style="max-width:200px;">
                <label class="form-label small mb-1" for="bulk-retention">Retention (days)</label>
                <input id="bulk-retention" type="number" min="1" class="form-control form-control-sm" @bind="_retentionDays" @bind:event="oninput" />
            </div>
        }

        <button type="button" class="btn btn-outline-secondary" @onclick="RefreshPreview" disabled="@(!AnyFieldSelected || _previewing)">
            <i class="bi bi-eye" aria-hidden="true"></i> @(_previewing ? "Building preview…" : "Preview changes")
        </button>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="empty-state mb-3" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_errorMessage</div>
    }

    @if (_preview is not null)
    {
        <div class="dbt-card" style="max-width:900px;">
            <h2 class="h6 text-muted mb-3">Before / after preview: @_preview.Rows.Count of @_instanceIds.Count instance(s) would change</h2>
            @if (_applyProblems.Count > 0)
            {
                <div class="mb-3" role="alert" data-testid="bulk-edit-problems">
                    <p class="small mb-1" style="color:var(--dbt-failed)"><strong>Nothing was saved.</strong></p>
                    <ul class="small mb-0">
                        @foreach (var problem in _applyProblems)
                        {
                            <li>@problem</li>
                        }
                    </ul>
                </div>
            }
            @if (_preview.Rows.Count == 0)
            {
                <div class="empty-state py-3"><i class="bi bi-inbox" aria-hidden="true"></i> No instance would change with these values.</div>
            }
            else
            {
                <table class="table table-sm dbt-table mb-3" aria-label="Before and after values for each instance that would change">
                    <thead><tr><th scope="col">Instance</th><th scope="col">Field</th><th scope="col">Before</th><th scope="col">After</th></tr></thead>
                    <tbody>
                        @foreach (var row in _preview.Rows)
                        {
                            @foreach (var change in row.Changes)
                            {
                                <tr>
                                    <td class="small">@row.InstanceName</td>
                                    <td class="small">@change.Field</td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(change.Before) ? "(empty)" : change.Before)</td>
                                    <td class="small">@(string.IsNullOrEmpty(change.After) ? "(empty)" : change.After)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-primary" @onclick="Apply" disabled="@_applying">@(_applying ? "Applying…" : $"Apply to {_preview.Rows.Count} instance(s)")</button>
                <p class="small text-muted mt-2 mb-0">Applies exactly the values previewed above. Change a value and preview again to apply something different.</p>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public string? Ids { get; set; }

    private List<int> _instanceIds = new();
    private bool _setOwner, _setTags, _setRetention;
    private string _company = "", _department = "", _contactName = "", _contactEmail = "", _tags = "";
    private int? _retentionDays;
    private BulkEditPreview? _preview;
    private BulkEditRequest? _previewedRequest;
    private List<string> _applyProblems = new();
    private bool _applying, _previewing;
    private string? _errorMessage;
    private string? _userId, _userName;

    private bool AnyFieldSelected => _setOwner || _setTags || _setRetention;

    protected override async Task OnInitializedAsync()
    {
        _instanceIds = (Ids ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var id) ? id : (int?)null)
            .Where(id => id is not null)
            .Select(id => id!.Value)
            .Distinct()
            .ToList();

        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _userName = state.User.Identity?.Name ?? "unknown";
    }

    private BulkEditRequest BuildRequest() => new(
        _setOwner, _company, _department, _contactName, _contactEmail,
        _setTags, _tags,
        _setRetention, _retentionDays);

    private async Task RefreshPreview()
    {
        _previewing = true;
        try
        {
            var request = BuildRequest();
            _preview = await BulkEditService.PreviewAsync(_instanceIds, request);
            _previewedRequest = request;
            _applyProblems = new();
            _errorMessage = null;
        }
        catch (Exception)
        {
            _errorMessage = "Couldn't build the preview. The database may be unreachable; try again.";
        }
        finally
        {
            _previewing = false;
        }
    }

    private async Task Apply()
    {
        if (_preview is null || _previewedRequest is null)
        {
            return;
        }

        _applying = true;
        BulkEditApplyResult result;
        try
        {
            result = await BulkEditService.ApplyAsync(_preview, _previewedRequest, _userId ?? "", _userName ?? "unknown");
        }
        catch (Exception)
        {
            _applying = false;
            _errorMessage = "Couldn't apply the changes. Nothing was saved; check the preview and try again.";
            return;
        }
        _applying = false;

        if (!result.Saved)
        {
            _applyProblems = result.ValidationErrors.ToList();
            return;
        }

        var skipped = new List<string>();
        if (result.SkippedArchivedCount > 0)
        {
            skipped.Add($"{result.SkippedArchivedCount} archived since the preview");
        }
        if (result.SkippedChangedSincePreview.Count > 0)
        {
            skipped.Add($"{result.SkippedChangedSincePreview.Count} edited by someone else since the preview ({string.Join(", ", result.SkippedChangedSincePreview)}); preview again to include them");
        }

        var message = $"Applied to {result.AppliedCount} instance(s) in batch {result.BatchId}.";
        if (skipped.Count > 0)
        {
            Toasts.Error(message + " Skipped " + string.Join("; ", skipped) + ".");
        }
        else
        {
            Toasts.Success(message);
        }
        Nav.NavigateTo("/instances");
    }
}
