                    </div>
                }
                else
                {
                    <div class="table-responsive" role="region" aria-label="Change history" tabindex="0">
                    <table class="table table-sm mb-0 dbt-table">
                        <thead>
                            <tr><th scope="col">When</th><th scope="col">By</th><th scope="col">Field</th><th scope="col">From</th><th scope="col">To</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in ChangeLogPage())
                            {
                                <tr>
                                    <td class="small"><LocalTime Utc="c.ChangedAtUtc" Format="MMM d, h:mm tt" ShowUtc="false" /></td>
                                    <td class="small">@c.ChangedBy</td>
                                    <td class="small">@c.FieldName</td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(c.OldValue) ? "(empty)" : c.OldValue)</td>
                                    <td class="small">@(string.IsNullOrEmpty(c.NewValue) ? "(empty)" : c.NewValue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @if (!ChangeLogFiltered().Any())
                    {
                        <div class="text-muted small py-2">No changes match this filter.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="small text-muted">Page @_changeLogPage of @ChangeLogTotalPages()</span>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Previous page of change history" disabled="@(_changeLogPage <= 1)" @onclick="() => _changeLogPage--">Prev</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Next page of change history" disabled="@(_changeLogPage >= ChangeLogTotalPages())" @onclick="() => _changeLogPage++">Next</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InstanceOverview? _overview;
    private BackupRecord _newRecord = new();
    private RestoreEvent _newRestore = new();
    private DateTime _newRecordOccurredLocal = DateTime.UtcNow;
    private DateTime _newRestoreOccurredLocal = DateTime.UtcNow;
    private DateTime _entryDefaultLocal = DateTime.UtcNow;
    private string _backupEntryZone = "viewer";
    private string _restoreEntryZone = "viewer";
    private int _newRestoreLinkedBackupId;
    private string? _backupFormError;
    private string? _restoreFormError;
    private List<InstanceChangeLog> _changeLog = new();
    private List<BackupRecordCorrection> _backupCorrections = new();
    private List<RestoreEventCorrection> _restoreCorrections = new();
    private int _correctingBackupId;
    private BackupStatus _correctedBackupStatus;
    private string _correctedBackupNotes = "";
    private string _correctionReason = "";
    private int _correctingRestoreId;
    private RestoreOutcome _correctedRestoreOutcome;
    private string _correctedRestoreNotes = "";
    private string _correctionReasonRestore = "";
    private string _maintenanceReason = "";
    private bool _scanning;
    private bool _testingConnection;
    private ConnectivityResult? _connectivityResult;
    private HealthExplanation? _explanation;
    private ScannerHealth? _scannerHealth;
    private Incident? _openIncident;
    private string _assigneeName = "";
    private string _ackNote = "";
    private string _ackTicket = "";
    private string? _userDisplayName;
    private string? _userId;
    private RestoreTestRecencyResult? _restoreTestRecency;
    private int _effectiveRestoreTestIntervalDays;
    private bool _loaded;
    private string? _connectivityEndpointDescription;
    private string? _connectivityDisabledReason;
    private bool _showArchiveConfirm;
    private IReadOnlyList<ArchiveImpactLine>? _archivePreview;
    private string _archiveReason = "";
    private string? _archiveError;
    private enum ArchiveKind { None, Mistake, Retirement }
    private ArchiveKind _archiveKind;

    // Ownership status and contact-correction requests.
    private OwnershipStatus _ownershipStatus;
    private bool _showCorrectionForm;
    private string _proposedContactName = "";
    private string _proposedContactEmail = "";
    private string _correctionNote = "";
    private List<ContactCorrectionRequest> _pendingCorrections = new();

    // History tables page and filter client-side over the already-loaded per-instance collection:
    // one instance's own history is bounded, unlike the cross-instance list queries.
    private const int HistoryPageSize = 10;
    private int _backupPage = 1, _restorePage = 1, _changeLogPage = 1;
    private string _backupStatusFilter = "";
    private string _restoreOutcomeFilter = "";
    private string _changeLogFieldFilter = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userDisplayName = state.User.Identity?.Name ?? "";
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        await Retry();
    }

    private bool _loadFailed;

    private async Task Retry()
    {
        _loadFailed = false;
        try
        {
            await Load();
            _loaded = true;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private async Task Load()
    {
        _overview = await OverviewService.GetByIdAsync(Id);
        _showArchiveConfirm = false;
        _archiveReason = "";
        _newRecord = new BackupRecord();
        _newRestore = new RestoreEvent();
        ResetEntryTimes();
        _newRestoreLinkedBackupId = 0;
        _backupFormError = null;
        _restoreFormError = null;
        _correctingBackupId = 0;
        _correctingRestoreId = 0;
        _correctionReason = "";
        _correctionReasonRestore = "";
        _showCorrectionForm = false;
        _proposedContactName = "";
        _proposedContactEmail = "";
        _correctionNote = "";
        _pendingCorrections = (await Corrections.ListForInstanceAsync(Id)).Where(r => r.Status == ContactCorrectionStatus.Pending).ToList();

        _changeLog = await Db.InstanceChangeLogs.AsNoTracking()
            .Where(c => c.DatabaseInstanceId == Id)
            .OrderByDescending(c => c.ChangedAtUtc)
            .ToListAsync();
        _openIncident = await Incidents.GetOpenAsync(Id);
        _assigneeName = _openIncident?.AssigneeName ?? "";
        _backupCorrections = await Db.BackupRecordCorrections.AsNoTracking()
            .Where(c => c.BackupRecord!.DatabaseInstanceId == Id)
            .ToListAsync();
        _restoreCorrections = await Db.RestoreEventCorrections.AsNoTracking()
            .Where(c => c.RestoreEvent!.DatabaseInstanceId == Id)
            .ToListAsync();

        if (_overview is not null)
        {
            var now = DateTime.UtcNow;
            _ownershipStatus = OwnershipStatusClassifier.Classify(
                _overview.Instance.OwnerTeamId, _overview.Instance.ContactEmail, _overview.Instance.BackupContactEmail, _overview.Instance.OwnershipConfirmedAtUtc);
            _explanation = BackupHealthCalculator.Explain(_overview.Instance, _overview.Instance.BackupRecords.ToList(), now);
            _scannerHealth = ScannerStalenessClassifier.Classify(
                backupFileLocationConfigured: !string.IsNullOrWhiteSpace(_overview.Instance.BackupFileLocation),
                lastAttemptUtc: _overview.Instance.LastScanUtc,
                lastScanStatus: _overview.Instance.LastScanStatus,
                lastSuccessUtc: _overview.Instance.LastScanSuccessUtc,
                scanIntervalMinutes: Configuration.GetValue("BackupScan:IntervalMinutes", 15),
                staleAfterMultiplier: Configuration.GetValue("BackupScan:StaleAfterMultiplier", 3),
                nowUtc: now);

            _effectiveRestoreTestIntervalDays = _overview.Instance.RestoreTestIntervalDaysOverride
                ?? Configuration.GetValue("RestoreTest:IntervalDays", 90);
            // Imported restore history is shown but never counts as a restore test (G23).
            _restoreTestRecency = RestoreTestRecencyCalculator.Compute(
                RestoreEvidence.LastVerifiedUtc(_overview.Instance.RestoreEvents),
                _effectiveRestoreTestIntervalDays, now);
        }
    }

    private IEnumerable<BackupRecord> BackupHistoryFiltered()
    {
        var items = (_overview?.Instance.BackupRecords ?? []).OrderByDescending(r => r.TimestampUtc).ThenByDescending(r => r.Id).AsEnumerable();
        if (_backupStatusFilter.Length > 0 && Enum.TryParse<BackupStatus>(_backupStatusFilter, out var s))
        {
            items = items.Where(r => r.Status == s);
        }
        return items;
    }

    private int BackupHistoryTotalPages() => Math.Max(1, (int)Math.Ceiling(BackupHistoryFiltered().Count() / (double)HistoryPageSize));
    private IEnumerable<BackupRecord> BackupHistoryPage() => BackupHistoryFiltered().Skip((Math.Clamp(_backupPage, 1, BackupHistoryTotalPages()) - 1) * HistoryPageSize).Take(HistoryPageSize);

    private IEnumerable<RestoreEvent> RestoreHistoryFiltered()
    {
        var items = (_overview?.Instance.RestoreEvents ?? []).OrderByDescending(r => r.TimestampUtc).AsEnumerable();
        if (_restoreOutcomeFilter.Length > 0 && Enum.TryParse<RestoreOutcome>(_restoreOutcomeFilter, out var o))
        {
            items = items.Where(r => r.Outcome == o);
        }
        return items;
    }

    private int RestoreHistoryTotalPages() => Math.Max(1, (int)Math.Ceiling(RestoreHistoryFiltered().Count() / (double)HistoryPageSize));
    private IEnumerable<RestoreEvent> RestoreHistoryPage() => RestoreHistoryFiltered().Skip((Math.Clamp(_restorePage, 1, RestoreHistoryTotalPages()) - 1) * HistoryPageSize).Take(HistoryPageSize);

    private IEnumerable<InstanceChangeLog> ChangeLogFiltered() =>
        _changeLogFieldFilter.Length > 0
            ? _changeLog.Where(c => c.FieldName.Contains(_changeLogFieldFilter, StringComparison.OrdinalIgnoreCase))
            : _changeLog;

    private int ChangeLogTotalPages() => Math.Max(1, (int)Math.Ceiling(ChangeLogFiltered().Count() / (double)HistoryPageSize));
    private IEnumerable<InstanceChangeLog> ChangeLogPage() => ChangeLogFiltered().Skip((Math.Clamp(_changeLogPage, 1, ChangeLogTotalPages()) - 1) * HistoryPageSize).Take(HistoryPageSize);

    private async Task AcknowledgeIncident()
    {
        if (_openIncident is null || !await CanRespondToIncidentAsync()) return;
        if (await Incidents.AcknowledgeAsync(_openIncident.Id, _userId ?? "", _userDisplayName ?? "unknown", _ackNote, _ackTicket))
        {
            Toasts.Success("Incident acknowledged. Escalation stopped.");
        }
        else
        {
            Toasts.Error("This incident has already closed, so it can't be acknowledged.");
        }
        await Load();
    }

    private async Task AssignIncident()
    {
        if (_openIncident is null || !await CanRespondToIncidentAsync()) return;
        if (await Incidents.AssignAsync(_openIncident.Id, _assigneeName, _userId ?? "", _userDisplayName ?? "unknown"))
        {
            Toasts.Success(string.IsNullOrWhiteSpace(_assigneeName) ? "Assignee cleared." : $"Assigned to {_assigneeName.Trim()}.");
        }
        await Load();
    }

    // The buttons are hidden for read-only roles; this re-checks on the server so a crafted event can't write.
    private async Task<bool> CanRespondToIncidentAsync()
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        if (Roles.CanEditPolicy.Split(',').Any(user.IsInRole))
        {
            return true;
        }

        Toasts.Error("Only DBA and Admin roles can acknowledge or assign incidents.");
        return false;
    }

    private async Task<string?> CurrentUserNameAsync() =>
        (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Viewer.Changed += OnViewerZoneChanged;
        }
        if (!Viewer.Known)
        {
            await Viewer.EnsureLoadedAsync(JS);
        }
    }

    /// <summary>Once the browser reports its zone, move the untouched "now" defaults into it.</summary>
    private void OnViewerZoneChanged() => InvokeAsync(() =>
    {
        var untouched = _newRecordOccurredLocal == _entryDefaultLocal && _newRestoreOccurredLocal == _entryDefaultLocal;
        if (untouched)
        {
            ResetEntryTimes();
        }
        StateHasChanged();
    });

    public void Dispose() => Viewer.Changed -= OnViewerZoneChanged;

    private void ResetEntryTimes()
    {
        var now = Viewer.ToViewer(DateTime.UtcNow);
        _entryDefaultLocal = new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0);
        _newRecordOccurredLocal = _entryDefaultLocal;
        _newRestoreOccurredLocal = _entryDefaultLocal;
    }

    private TimeZoneInfo EntryZone(string choice) => choice == EventTimeZones.Utc ? TimeZoneInfo.Utc : Viewer.Zone;

    private string EntryZoneLabel(string choice) => EventTimeZones.Label(EntryZone(choice), DateTime.UtcNow);

    /// <summary>Converts a form's occurrence time from its chosen zone, or returns the error to show.</summary>
    private (DateTime Utc, string ZoneId)? ResolveOccurred(DateTime wallClock, string zoneChoice, out string? error)
    {
        var untouched = wallClock == _entryDefaultLocal && zoneChoice != EventTimeZones.Utc;
        var result = EventTimeZones.FromEntryForm(wallClock, EntryZone(zoneChoice), untouched, DateTime.UtcNow);
        error = result.Error;
        return result.Ok ? (result.Utc!.Value, result.ZoneId) : null;
    }

    private static string RecordedByText(string recordedBy, BackupSource source)
    {
        var who = string.IsNullOrWhiteSpace(recordedBy) ? "Not recorded" : recordedBy;
        return source == BackupSource.Imported ? $"Imported by {who}" : who;
    }

    /// <summary>Names the zone a person stated the time in when it differs from the viewer's, so a backdated entry reads unambiguously.</summary>
    private string EnteredZoneNote(string zoneId) =>
        string.IsNullOrWhiteSpace(zoneId) || zoneId == Viewer.ZoneId ? "" : $" (entered in {zoneId})";

    private async Task LogBackup()
    {
        if (ResolveOccurred(_newRecordOccurredLocal, _backupEntryZone, out var timeError) is not { } occurred)
        {
            _backupFormError = timeError;
            return;
        }
        var occurredUtc = occurred.Utc;

        _backupFormError = null;
        _newRecord.DatabaseInstanceId = Id;
        _newRecord.TimestampUtc = occurredUtc;
        _newRecord.OccurredTimeZone = occurred.ZoneId;
        _newRecord.RecordedByUserName = await CurrentUserNameAsync() ?? "unknown";
        Db.BackupRecords.Add(_newRecord);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        await Audit.RecordUserActionAsync(_userId ?? "", _userDisplayName ?? "unknown", "BackupRecordLogged", "BackupRecord", _newRecord.Id.ToString(), _overview?.Instance.Name ?? $"Instance #{Id}",
            reason: $"Manual entry: {_newRecord.Type} {_newRecord.Status}", afterJson: EvidenceAuditSnapshot.Backup(_newRecord));
        Toasts.Success($"Backup result logged ({_newRecord.Status}).");
        await Load();
    }

    private async Task LogRestore()
    {
        if (ResolveOccurred(_newRestoreOccurredLocal, _restoreEntryZone, out var timeError) is not { } occurred)
        {
            _restoreFormError = timeError;
            return;
        }
        if (_newRestore.EvidenceReference.Length > EvidenceHistoryCsvImporter.MaxEvidenceReferenceLength)
        {
            _restoreFormError = $"Evidence reference is longer than {EvidenceHistoryCsvImporter.MaxEvidenceReferenceLength} characters.";
            return;
        }
        var occurredUtc = occurred.Utc;

        _restoreFormError = null;
        _newRestore.DatabaseInstanceId = Id;
        _newRestore.TimestampUtc = occurredUtc;
        _newRestore.OccurredTimeZone = occurred.ZoneId;
        _newRestore.EvidenceReference = _newRestore.EvidenceReference.Trim();
        _newRestore.LinkedBackupRecordId = _newRestoreLinkedBackupId == 0 ? null : _newRestoreLinkedBackupId;
        _newRestore.RecordedByUserName = await CurrentUserNameAsync() ?? "unknown";
        Db.RestoreEvents.Add(_newRestore);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        await Audit.RecordUserActionAsync(_userId ?? "", _userDisplayName ?? "unknown", "RestoreEventLogged", "RestoreEvent", _newRestore.Id.ToString(), _overview?.Instance.Name ?? $"Instance #{Id}",
            reason: $"Manual entry: {_newRestore.Reason} restore, {_newRestore.Outcome}", afterJson: EvidenceAuditSnapshot.Restore(_newRestore));
        Toasts.Success($"Restore logged ({_newRestore.Outcome}).");
        await Load();
    }

    private void OnBackupCorrectionTargetChanged()
    {
        if (_correctingBackupId == 0 || _overview is null)
        {
            return;
        }

        var original = _overview.Instance.BackupRecords.FirstOrDefault(r => r.Id == _correctingBackupId);
        if (original is null)
        {
            return;
        }

        _correctedBackupStatus = EvidenceCorrectionResolver.EffectiveStatus(original, _backupCorrections);
        _correctedBackupNotes = EvidenceCorrectionResolver.EffectiveNotes(original, _backupCorrections);
    }

    private void OnRestoreCorrectionTargetChanged()
    {
        if (_correctingRestoreId == 0 || _overview is null)
        {
            return;
        }

        var original = _overview.Instance.RestoreEvents.FirstOrDefault(r => r.Id == _correctingRestoreId);
        if (original is null)
        {
            return;
        }

        _correctedRestoreOutcome = EvidenceCorrectionResolver.EffectiveOutcome(original, _restoreCorrections);
        _correctedRestoreNotes = EvidenceCorrectionResolver.EffectiveNotes(original, _restoreCorrections);
    }

    private async Task SubmitBackupCorrection()
    {
        if (_correctingBackupId == 0 || string.IsNullOrWhiteSpace(_correctionReason))
        {
            return;
        }

        var original = _overview!.Instance.BackupRecords.First(r => r.Id == _correctingBackupId);
        var currentStatus = EvidenceCorrectionResolver.EffectiveStatus(original, _backupCorrections);
        var currentNotes = EvidenceCorrectionResolver.EffectiveNotes(original, _backupCorrections);

        Db.BackupRecordCorrections.Add(new BackupRecordCorrection
        {
            BackupRecordId = _correctingBackupId,
            CorrectedByUserName = await CurrentUserNameAsync() ?? "unknown",
            Reason = _correctionReason,
            PreviousStatus = currentStatus,
            NewStatus = _correctedBackupStatus,
            PreviousNotes = currentNotes,
            NewNotes = _correctedBackupNotes
        });
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        await Audit.RecordUserActionAsync(_userId ?? "", _userDisplayName ?? "unknown", "BackupRecordCorrected", "BackupRecord", _correctingBackupId.ToString(), _overview!.Instance.Name,
            reason: _correctionReason, beforeJson: EvidenceAuditSnapshot.BackupCorrectionSide(currentStatus, currentNotes),
            afterJson: EvidenceAuditSnapshot.BackupCorrectionSide(_correctedBackupStatus, _correctedBackupNotes));
        Toasts.Success("Correction recorded. The original entry is kept.");
        await Load();
    }

    private async Task SubmitRestoreCorrection()
    {
        if (_correctingRestoreId == 0 || string.IsNullOrWhiteSpace(_correctionReasonRestore))
        {
            return;
        }

        var original = _overview!.Instance.RestoreEvents.First(r => r.Id == _correctingRestoreId);
        var currentOutcome = EvidenceCorrectionResolver.EffectiveOutcome(original, _restoreCorrections);
        var currentNotes = EvidenceCorrectionResolver.EffectiveNotes(original, _restoreCorrections);

        Db.RestoreEventCorrections.Add(new RestoreEventCorrection
        {
            RestoreEventId = _correctingRestoreId,
            CorrectedByUserName = await CurrentUserNameAsync() ?? "unknown",
            Reason = _correctionReasonRestore,
            PreviousOutcome = currentOutcome,
            NewOutcome = _correctedRestoreOutcome,
            PreviousNotes = currentNotes,
            NewNotes = _correctedRestoreNotes
        });
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        await Audit.RecordUserActionAsync(_userId ?? "", _userDisplayName ?? "unknown", "RestoreEventCorrected", "RestoreEvent", _correctingRestoreId.ToString(), _overview!.Instance.Name,
            reason: _correctionReasonRestore, beforeJson: EvidenceAuditSnapshot.RestoreCorrectionSide(currentOutcome, currentNotes),
            afterJson: EvidenceAuditSnapshot.RestoreCorrectionSide(_correctedRestoreOutcome, _correctedRestoreNotes));
        Toasts.Success("Correction recorded. The original entry is kept.");
        await Load();
    }

    private async Task ScanNow()
    {
        _scanning = true;
        var result = await Scanner.ScanAsync(Id);
        _scanning = false;

        if (result.Outcome == ScanOutcome.Success)
        {
            Toasts.Success(result.FilesDiscovered switch
            {
                0 => "Scan complete: no new files found.",
                1 => "Scan complete: 1 new backup file found.",
                _ => $"Scan complete: {result.FilesDiscovered} new backup files found."
            });
        }
        else if (result.Outcome == ScanOutcome.Error)
        {
            Toasts.Error($"Scan failed: {result.ErrorMessage}");
        }

        Db.ChangeTracker.Clear();
        await Load();
    }

    private async Task OpenArchiveConfirm()
    {
        _archivePreview = ArchivePreviewBuilder.Build(await ArchiveService.PreviewAsync(Id));
        _archiveReason = "";
        _archiveError = null;
        _archiveKind = ArchiveKind.None;
        _showArchiveConfirm = true;
    }

    private async Task ConfirmArchive()
    {
        if (_archiveKind != ArchiveKind.Mistake || string.IsNullOrWhiteSpace(_archiveReason))
        {
            return;
        }

        var outcome = await ArchiveService.ArchiveAsync(Id, _archiveReason, _userId ?? "", _userDisplayName ?? "unknown");
        Db.ChangeTracker.Clear();
        if (!outcome.Ok)
        {
            _archiveError = outcome.Message;
            return;
        }

        Toasts.Success($"{_overview?.Instance.Name} archived.");
        Nav.NavigateTo("/instances");
    }

    private async Task StartMaintenance(int hours)
    {
        var entity = await Db.DatabaseInstances.FindAsync(Id);
        if (entity is not null)
        {
            entity.MaintenanceUntilUtc = DateTime.UtcNow.AddHours(hours);
            entity.MaintenanceReason = _maintenanceReason;
            entity.UpdatedAtUtc = DateTime.UtcNow;
            await Db.SaveChangesAsync();
            await Audit.RecordUserActionAsync(_userId ?? "", _userDisplayName ?? "unknown", "MaintenanceWindowStarted", "DatabaseInstance", Id.ToString(), entity.Name,
                reason: $"{hours}h: {_maintenanceReason}");
            Toasts.Success($"Maintenance window started for {hours}h. Overdue/Failed alerts are suppressed.");
        }
        Db.ChangeTracker.Clear();
        _maintenanceReason = "";
        await Load();
    }

    private async Task EndMaintenance()
    {
        var entity = await Db.DatabaseInstances.FindAsync(Id);
        if (entity is not null)
        {
            entity.MaintenanceUntilUtc = null;
            entity.MaintenanceReason = "";
            entity.UpdatedAtUtc = DateTime.UtcNow;
            await Db.SaveChangesAsync();
            await Audit.RecordUserActionAsync(_userId ?? "", _userDisplayName ?? "unknown", "MaintenanceWindowEnded", "DatabaseInstance", Id.ToString(), entity.Name);
            Toasts.Success("Maintenance window ended.");
        }
        Db.ChangeTracker.Clear();
        await Load();
    }

    private async Task TestConnection()
    {
        if (_overview is null)
        {
            return;
        }

        _testingConnection = true;
        _connectivityResult = null;
        _connectivityDisabledReason = null;

        var instance = _overview.Instance;
        var endpoint = ConnectivityEndpointResolver.Resolve(instance.ServerIp, instance.DatabaseIp, instance.Engine, instance.ConnectivityHostOverride, instance.ConnectivityPortOverride);

        if (!endpoint.CanCheck)
        {
            _connectivityDisabledReason = endpoint.DisabledReason;
            _testingConnection = false;
            Toasts.Error(endpoint.DisabledReason ?? "No endpoint to check.");
            return;
        }

        _connectivityEndpointDescription = $"{endpoint.Host}:{endpoint.Port}" +
            (endpoint.UsedHostOverride || endpoint.UsedPortOverride ? " (override)" : "");
        _connectivityResult = await Connectivity.CheckAsync(endpoint.Host, endpoint.Port, TimeSpan.FromSeconds(4));
        _testingConnection = false;

        if (_connectivityResult.Success)
        {
            Toasts.Success($"Connected to {_connectivityEndpointDescription} in {_connectivityResult.Elapsed.TotalMilliseconds:N0} ms.");
        }
        else
        {
            Toasts.Error($"Could not reach {_connectivityEndpointDescription}: {_connectivityResult.Error}");
        }
    }

    private static bool CanCheckConnectivity(DatabaseInstance instance) =>
        ConnectivityEndpointResolver.Resolve(instance.ServerIp, instance.DatabaseIp, instance.Engine, instance.ConnectivityHostOverride, instance.ConnectivityPortOverride).CanCheck;

    private static string StatusClass(BackupStatus status) => status switch
    {
        BackupStatus.Success => "OnTrack",
        BackupStatus.Failed => "Failed",
        BackupStatus.Missed => "Failed",
        _ => "NeverBackedUp"
    };

    private static string EvidenceClass(EvidenceLevel level) => level switch
    {
        EvidenceLevel.RestoreTested => "OnTrack",
        EvidenceLevel.ReportedSuccess => "Overdue",
        _ => "NeverBackedUp"
    };

    private static string ScannerFreshnessClass(ScannerFreshness freshness) => freshness switch
    {
        ScannerFreshness.Error => "Failed",
        ScannerFreshness.Stale => "Overdue",
        ScannerFreshness.Healthy => "OnTrack",
        _ => "NeverBackedUp"
    };

    private static string FormatDuration(TimeSpan span) =>
        span.TotalDays >= 1 ? $"{span.TotalDays:N1} days" : $"{span.TotalHours:N1} hours";

    private static string RecencyClass(RestoreTestRecency recency) => recency switch
    {
        RestoreTestRecency.Current => "OnTrack",
        RestoreTestRecency.Overdue => "Overdue",
        _ => "NeverBackedUp"
    };

    private static string RecencyLabel(RestoreTestRecency recency) => recency switch
    {
        RestoreTestRecency.Current => "Current",
        RestoreTestRecency.Overdue => "Expired",
        _ => "Never tested"
    };

    private static string OwnershipClass(OwnershipStatus status) => status switch
    {
        OwnershipStatus.Confirmed => "OnTrack",
        OwnershipStatus.Unconfirmed => "Overdue",
        _ => "NeverBackedUp"
    };

    private bool CanSubmitCorrection() =>
        !string.IsNullOrWhiteSpace(_correctionNote) &&
        (!string.IsNullOrWhiteSpace(_proposedContactName) || !string.IsNullOrWhiteSpace(_proposedContactEmail));

    private async Task SubmitCorrectionRequest()
    {
        var ok = await Corrections.SubmitAsync(new ContactCorrectionRequest
        {
            DatabaseInstanceId = Id,
            RequestedByUserId = _userId ?? "",
            RequestedByName = string.IsNullOrWhiteSpace(_userDisplayName) ? "unknown" : _userDisplayName,
            ProposedContactName = _proposedContactName,
            ProposedContactEmail = _proposedContactEmail,
            Note = _correctionNote
        });

        if (ok)
        {
            Toasts.Success("Correction request submitted. A reviewer with edit rights will look at it.");
        }
        else
        {
            Toasts.Error("Couldn't submit. Add a reason and at least one proposed field.");
        }

        await Load();
    }

    private async Task ApproveCorrection(int requestId)
    {
        await Corrections.ApproveAsync(requestId, _userId ?? "", _userDisplayName ?? "unknown", "Approved from instance detail");
        Toasts.Success("Correction approved and applied.");
        Db.ChangeTracker.Clear();
        await Load();
    }

    private async Task RejectCorrection(int requestId)
    {
        await Corrections.RejectAsync(requestId, _userId ?? "", _userDisplayName ?? "unknown", "Rejected from instance detail");
        Toasts.Success("Correction request rejected.");
        await Load();
    }
}
