@page "/instances/{Id:int}"
@inject InstanceOverviewService OverviewService
@inject DBTrackerDbContext Db
@inject BackupFileScanner Scanner
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>@(_overview?.Instance.Name ?? "Instance") · DBTracker</PageTitle>

@if (_overview is null)
{
    <div class="spinner-ring"></div>
}
else
{
    var instance = _overview.Instance;

    <div class="app-topbar">
        <div>
            <h1>@instance.Name <HealthBadge Health="_overview.Health" /></h1>
            <div class="subtitle">@instance.Engine @instance.Version · @instance.Environment · <span class="role-pill @instance.Role">@instance.Role</span></div>
        </div>
        <AuthorizeView Roles="@Roles.CanEditPolicy">
            <div class="d-flex gap-2">
                @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                {
                    <button class="btn btn-outline-secondary" @onclick="ScanNow" disabled="@_scanning">
                        <i class="bi bi-arrow-repeat"></i> @(_scanning ? "Scanning…" : "Scan now")
                    </button>
                }
                <a class="btn btn-outline-secondary" href="/instances/@Id/edit"><i class="bi bi-pencil"></i> Edit</a>
                @if (!instance.IsArchived)
                {
                    <button class="btn btn-outline-danger" @onclick="Archive"><i class="bi bi-archive"></i> Archive</button>
                }
            </div>
        </AuthorizeView>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Ownership &amp; contact</h2>
                <dl class="row mb-0 small">
                    <dt class="col-5">Application</dt><dd class="col-7">@instance.Application</dd>
                    <dt class="col-5">Company</dt><dd class="col-7">@instance.Company</dd>
                    <dt class="col-5">Department</dt><dd class="col-7">@instance.Department</dd>
                    <dt class="col-5">Contact</dt><dd class="col-7">@instance.ContactName</dd>
                    <dt class="col-5">Email</dt><dd class="col-7">@instance.ContactEmail</dd>
                    <dt class="col-5">Phone</dt><dd class="col-7">@instance.ContactPhone</dd>
                    @if (!string.IsNullOrWhiteSpace(instance.Tags))
                    {
                        <dt class="col-5">Tags</dt><dd class="col-7">@instance.Tags</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(instance.RunbookUrl))
                    {
                        <dt class="col-5">Runbook</dt><dd class="col-7"><a href="@instance.RunbookUrl" target="_blank" rel="noopener">@instance.RunbookUrl</a></dd>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(instance.Notes))
                {
                    <div class="text-muted small mt-2">@instance.Notes</div>
                }
            </div>
        </div>
        <div class="col-md-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Topology &amp; backup evidence</h2>
                <dl class="row mb-0 small">
                    <dt class="col-5">Database IP</dt><dd class="col-7">@instance.DatabaseIp</dd>
                    <dt class="col-5">Server IP</dt><dd class="col-7">@instance.ServerIp</dd>
                    <dt class="col-5">Expected cadence</dt><dd class="col-7">every @instance.ExpectedBackupIntervalHours h</dd>
                    @if (instance.RetentionPolicyDays is not null)
                    {
                        <dt class="col-5">Retention policy</dt><dd class="col-7">@instance.RetentionPolicyDays days</dd>
                    }
                    <dt class="col-5">Last successful backup</dt>
                    <dd class="col-7">@(_overview.LastBackupUtc is null ? "Never" : _overview.LastBackupUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</dd>
                    <dt class="col-5">Backup file location</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(instance.BackupFileLocation) ? "Not configured" : instance.BackupFileLocation)</dd>
                    @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                    {
                        <dt class="col-5">Last scanned</dt>
                        <dd class="col-7">
                            @switch (instance.LastScanStatus)
                            {
                                case ScanStatus.NeverScanned:
                                    <span class="text-muted">Never scanned</span>
                                    break;
                                case ScanStatus.Success:
                                    <span>@instance.LastScanUtc!.Value.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                    <span class="badge-health dot OnTrack ms-1">OK</span>
                                    break;
                                case ScanStatus.Error:
                                    <span>@instance.LastScanUtc!.Value.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                    <span class="badge-health dot Failed ms-1">Error</span>
                                    <div class="text-danger small mt-1">@instance.LastScanError</div>
                                    break;
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="backupAuth">
            <Authorized>
                <div class="col-md-5">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted text-uppercase mb-3">Log a backup result</h2>
                        <EditForm Model="_newRecord" OnValidSubmit="LogBackup">
                            <div class="mb-2">
                                <label class="form-label small">Type</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_newRecord.Type">
                                    @foreach (var t in Enum.GetValues<BackupType>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Status</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_newRecord.Status">
                                    @foreach (var s in Enum.GetValues<BackupStatus>())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small">Size (MB)</label>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_newRecord.SizeMb" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Duration (min)</label>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_newRecord.DurationMinutes" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Notes</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_newRecord.Notes" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Log backup</button>
                        </EditForm>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="col-md-7">
            <div class="dbt-card">
                <h2 class="h6 text-muted text-uppercase mb-3">Backup history</h2>
                @if (!instance.BackupRecords.Any())
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-clock-history"></i>
                        No backup history recorded yet.
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>When</th><th>Type</th><th>Status</th><th>Size</th><th>Duration</th><th>Source</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in instance.BackupRecords.OrderByDescending(r => r.TimestampUtc))
                            {
                                <tr>
                                    <td class="small">@r.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td class="small">@r.Type</td>
                                    <td><span class="badge-health dot @StatusClass(r.Status)">@r.Status</span></td>
                                    <td class="small">@(r.SizeMb is null ? "—" : $"{r.SizeMb:N0} MB")</td>
                                    <td class="small">@(r.DurationMinutes is null ? "—" : $"{r.DurationMinutes:N0} min")</td>
                                    <td class="small text-muted">@(r.Source == BackupSource.Discovered ? "Discovered" : "Logged")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="row g-3">
        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="restoreAuth">
            <Authorized>
                <div class="col-md-5">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted text-uppercase mb-3">Log a restore</h2>
                        <EditForm Model="_newRestore" OnValidSubmit="LogRestore">
                            <div class="mb-2">
                                <label class="form-label small">Performed by</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_newRestore.PerformedBy" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small">Reason</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_newRestore.Reason">
                                        @foreach (var r in Enum.GetValues<RestoreReason>())
                                        {
                                            <option value="@r">@r</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Outcome</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_newRestore.Outcome">
                                        @foreach (var o in Enum.GetValues<RestoreOutcome>())
                                        {
                                            <option value="@o">@o</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Notes</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_newRestore.Notes" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Log restore</button>
                        </EditForm>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="col-md-7">
            <div class="dbt-card">
                <h2 class="h6 text-muted text-uppercase mb-3">Restore history</h2>
                @if (!instance.RestoreEvents.Any())
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        No restore ever logged — this backup has never been proven recoverable.
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>When</th><th>By</th><th>Reason</th><th>Outcome</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in instance.RestoreEvents.OrderByDescending(r => r.TimestampUtc))
                            {
                                <tr>
                                    <td class="small">@r.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td class="small">@r.PerformedBy</td>
                                    <td class="small">@r.Reason</td>
                                    <td><span class="badge-health dot @(r.Outcome == RestoreOutcome.Success ? "OnTrack" : "Failed")">@r.Outcome</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InstanceOverview? _overview;
    private BackupRecord _newRecord = new();
    private RestoreEvent _newRestore = new();
    private bool _scanning;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _overview = await OverviewService.GetByIdAsync(Id);
        _newRecord = new BackupRecord { TimestampUtc = DateTime.UtcNow };
        _newRestore = new RestoreEvent { TimestampUtc = DateTime.UtcNow };
    }

    private async Task LogBackup()
    {
        _newRecord.DatabaseInstanceId = Id;
        _newRecord.TimestampUtc = DateTime.UtcNow;
        Db.BackupRecords.Add(_newRecord);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        Toasts.Success($"Backup result logged ({_newRecord.Status}).");
        await Load();
    }

    private async Task LogRestore()
    {
        _newRestore.DatabaseInstanceId = Id;
        _newRestore.TimestampUtc = DateTime.UtcNow;
        Db.RestoreEvents.Add(_newRestore);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        Toasts.Success($"Restore logged ({_newRestore.Outcome}).");
        await Load();
    }

    private async Task ScanNow()
    {
        _scanning = true;
        var result = await Scanner.ScanAsync(Id);
        _scanning = false;

        if (result.Outcome == ScanOutcome.Success)
        {
            Toasts.Success(result.FilesDiscovered switch
            {
                0 => "Scan complete — no new files found.",
                1 => "Scan complete — 1 new backup file found.",
                _ => $"Scan complete — {result.FilesDiscovered} new backup files found."
            });
        }
        else if (result.Outcome == ScanOutcome.Error)
        {
            Toasts.Error($"Scan failed: {result.ErrorMessage}");
        }

        Db.ChangeTracker.Clear();
        await Load();
    }

    private async Task Archive()
    {
        var entity = await Db.DatabaseInstances.FindAsync(Id);
        if (entity is not null)
        {
            entity.IsArchived = true;
            entity.UpdatedAtUtc = DateTime.UtcNow;
            await Db.SaveChangesAsync();
            Toasts.Success($"{entity.Name} archived.");
        }
        Nav.NavigateTo("/instances");
    }

    private static string StatusClass(BackupStatus status) => status switch
    {
        BackupStatus.Success => "OnTrack",
        BackupStatus.Failed => "Failed",
        BackupStatus.Missed => "Failed",
        _ => "NeverBackedUp"
    };
}
