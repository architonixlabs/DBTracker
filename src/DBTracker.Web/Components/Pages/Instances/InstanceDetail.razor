@page "/instances/{Id:int}"
@attribute [Authorize]
@inject InstanceOverviewService OverviewService
@inject DBTrackerDbContext Db
@inject BackupFileScanner Scanner
@inject ConnectivityChecker Connectivity
@inject IncidentService Incidents
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IConfiguration Configuration
@inject InstanceArchiveService ArchiveService
@inject AuditRecorder Audit
@inject ContactCorrectionService Corrections

<PageTitle>@(_overview?.Instance.Name ?? "Instance") · DBTracker</PageTitle>

@if (!_loaded)
{
    <div class="spinner-ring"></div>
}
else if (_overview is null)
{
    <div class="dbt-card" style="max-width: 600px;">
        <div class="empty-state py-4">
            <i class="bi bi-question-diamond"></i>
            Instance #@Id doesn't exist — it may have been deleted or archived, or the link is wrong.
        </div>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
        <a class="btn btn-outline-secondary" href="/instances/archived">Check archived instances</a>
    </div>
}
else
{
    var instance = _overview.Instance;

    @if (instance.IsArchived)
    {
        <div class="alert alert-warning">
            <i class="bi bi-archive"></i> This instance is <strong>archived</strong>
            (@instance.ArchivedAtUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") by @instance.ArchivedBy) — reason: @instance.ArchiveReason.
            It's excluded from background scans/alerts/reports. <a href="/instances/archived">Browse archived instances</a> to unarchive it.
        </div>
    }

    <div class="app-topbar">
        <div>
            <div class="eyebrow">Instance detail</div>
            <h1>
                @instance.Name <HealthBadge Health="_overview.Health" />
                @if (instance.MaintenanceUntilUtc is { } maintUtc && maintUtc > DateTime.UtcNow)
                {
                    <span class="badge-health dot Overdue" title="Overdue/Failed alerts are suppressed until this window ends">
                        <i class="bi bi-cone-striped"></i> Maintenance until @maintUtc.ToLocalTime().ToString("MMM d, h:mm tt")
                    </span>
                }
            </h1>
            <div class="subtitle">@instance.Engine @instance.Version · @instance.Environment · <span class="role-pill @instance.Role">@instance.Role</span></div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/instances/@Id/lifecycle" title="Installed-version identity, support runway, patch baseline and advisories (D01-D06)">
                <i class="bi bi-signpost-split"></i> Lifecycle
            </a>
            <a class="btn btn-outline-secondary" href="/instances/@Id/migration" title="Technical dependencies, source-to-target path assessment and upgrade-readiness checklist (D07-D09)">
                <i class="bi bi-diagram-2"></i> Migration
            </a>
            <a class="btn btn-outline-secondary" href="/instances/@Id/recovery" title="Recovery objectives, backup-chain coverage and backup-copy availability/retention evidence (D16-D17)">
                <i class="bi bi-shield-check"></i> Recovery
            </a>
            <a class="btn btn-outline-secondary" href="/instances/@Id/assurance" title="Integrity/HA/maintenance-job evidence and capacity/performance planning evidence (D18-D19)">
                <i class="bi bi-clipboard2-pulse"></i> Assurance
            </a>
            <a class="btn btn-outline-secondary" href="/instances/@Id/certificates" title="Certificate and recovery-key dependency reminders (D20)">
                <i class="bi bi-key"></i> Certificates
            </a>
            <button class="btn btn-outline-secondary" @onclick="TestConnection" disabled="@(_testingConnection || !CanCheckConnectivity(instance))" title="@(CanCheckConnectivity(instance) ? "" : "No host/IP or override configured")">
                <i class="bi bi-ethernet"></i> @(_testingConnection ? "Testing…" : "Test connection")
            </button>
            <AuthorizeView Roles="@Roles.CanEditPolicy">
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                    {
                        <button class="btn btn-outline-secondary" @onclick="ScanNow" disabled="@_scanning">
                            <i class="bi bi-arrow-repeat"></i> @(_scanning ? "Scanning…" : "Scan now")
                        </button>
                    }
                    <a class="btn btn-outline-secondary" href="/instances/@Id/edit"><i class="bi bi-pencil"></i> Edit</a>
                    @if (!instance.IsArchived && !_showArchiveConfirm)
                    {
                        <button class="btn btn-outline-danger" @onclick="OpenArchiveConfirm"><i class="bi bi-archive"></i> Archive</button>
                    }
                </div>
            </AuthorizeView>
        </div>
    </div>

    @if (_connectivityResult is not null)
    {
        <div class="small mb-4" style="margin-top:-20px;">
            <div style="color:@(_connectivityResult.Success ? "var(--dbt-ontrack)" : "var(--dbt-failed)")">
                @(_connectivityResult.Success
                    ? $"Reachable — connected to {_connectivityEndpointDescription} in {_connectivityResult.Elapsed.TotalMilliseconds:N0} ms."
                    : $"Not reachable — {_connectivityEndpointDescription} — {_connectivityResult.Error}")
            </div>
            <div class="text-muted">
                Checked @_connectivityResult.CheckedAtUtc.ToLocalTime().ToString("MMM d, h:mm:ss tt") · timeout @_connectivityResult.Timeout.TotalSeconds s ·
                a TCP connection succeeding is not proof of database login, backup success, or recoverability.
            </div>
        </div>
    }
    else if (_connectivityDisabledReason is not null)
    {
        <p class="small text-muted mb-4" style="margin-top:-20px;">Connectivity check unavailable — @_connectivityDisabledReason</p>
    }

    @if (_showArchiveConfirm && _archivePreview is not null)
    {
        <div class="dbt-card mb-4" style="border-color:var(--dbt-failed);">
            <h2 class="h6 text-muted text-uppercase mb-3">Confirm archive</h2>
            <ul class="small mb-3">
                @foreach (var line in _archivePreview)
                {
                    <li>@line.Text</li>
                }
            </ul>
            <div class="mb-2">
                <label class="form-label small">Reason (required)</label>
                <input class="form-control form-control-sm" @bind="_archiveReason" @bind:event="oninput" placeholder="Decommissioned, replaced by…, duplicate entry, …" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-danger btn-sm" @onclick="ConfirmArchive" disabled="@string.IsNullOrWhiteSpace(_archiveReason)">Archive this instance</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _showArchiveConfirm = false">Cancel</button>
            </div>
        </div>
    }

    <div class="row g-0 mb-4">
        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted text-uppercase mb-3">Health explanation</h2>
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">Last successful backup</dt>
                    <dd class="col-sm-9">@(_explanation!.LastSuccessUtc is { } ls ? ls.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "Never")</dd>

                    <dt class="col-sm-3">Latest attempt</dt>
                    <dd class="col-sm-9">
                        @(_explanation.LastAttemptUtc is { } la
                            ? $"{la.ToLocalTime():MMM d, yyyy h:mm tt} — {_explanation.LastAttemptStatus}"
                            : "No backup evidence recorded yet")
                    </dd>

                    <dt class="col-sm-3">Governing interval</dt>
                    <dd class="col-sm-9">every @_explanation.GoverningIntervalHours h</dd>

                    <dt class="col-sm-3">Next due</dt>
                    <dd class="col-sm-9">@(_explanation.NextDueUtc is { } due ? due.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "—")</dd>

                    @if (_explanation.OverdueBy is { } overdueBy)
                    {
                        <dt class="col-sm-3">Overdue by</dt>
                        <dd class="col-sm-9" style="color:var(--dbt-overdue)">@FormatDuration(overdueBy)</dd>
                    }

                    <dt class="col-sm-3">Alert suppression</dt>
                    <dd class="col-sm-9">
                        @if (_explanation.IsSuppressedByMaintenance)
                        {
                            <span><i class="bi bi-cone-striped"></i> Suppressed by active maintenance window — the health badge above stays truthful regardless.</span>
                        }
                        else
                        {
                            <span class="text-muted">Not suppressed</span>
                        }
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                    {
                        <dt class="col-sm-3">Scan freshness</dt>
                        <dd class="col-sm-9">
                            <span class="badge-health dot @ScannerFreshnessClass(_scannerHealth!.Freshness)">@_scannerHealth.Freshness</span>
                            @if (!string.IsNullOrWhiteSpace(_scannerHealth.RecoveryHint))
                            {
                                <div class="text-muted small mt-1">@_scannerHealth.RecoveryHint</div>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="row g-0 mb-4 kv-row">
        <div class="col-md-6">
            <div class="dbt-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="h6 text-muted text-uppercase mb-0">Ownership &amp; contact</h2>
                    <span class="badge-health dot @OwnershipClass(_ownershipStatus)" title="Personalization only — never a grant or restriction of access beyond the viewer's role">@_ownershipStatus</span>
                </div>
                <dl class="row mb-0 small">
                    <dt class="col-5">Application</dt><dd class="col-7">@instance.Application</dd>
                    <dt class="col-5">Company</dt><dd class="col-7">@instance.Company</dd>
                    <dt class="col-5">Department</dt><dd class="col-7">@instance.Department</dd>
                    <dt class="col-5">Owner team</dt><dd class="col-7">@(instance.OwnerTeam?.Name ?? "Not assigned")</dd>
                    <dt class="col-5">Contact</dt><dd class="col-7">@instance.ContactName</dd>
                    <dt class="col-5">Email</dt><dd class="col-7">@instance.ContactEmail</dd>
                    <dt class="col-5">Phone</dt><dd class="col-7">@instance.ContactPhone</dd>
                    @if (!string.IsNullOrWhiteSpace(instance.BackupContactName) || !string.IsNullOrWhiteSpace(instance.BackupContactEmail))
                    {
                        <dt class="col-5">Backup contact</dt><dd class="col-7">@instance.BackupContactName @instance.BackupContactEmail</dd>
                    }
                    @if (instance.OwnershipConfirmedAtUtc is { } confirmedAt)
                    {
                        <dt class="col-5">Confirmed</dt><dd class="col-7">@confirmedAt.ToLocalTime().ToString("MMM d, yyyy") by @instance.OwnershipConfirmedBy</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(instance.Region) || !string.IsNullOrWhiteSpace(instance.Cluster) || !string.IsNullOrWhiteSpace(instance.ReplicaSet))
                    {
                        <dt class="col-5">Region / cluster / replica set</dt>
                        <dd class="col-7">@instance.Region / @instance.Cluster / @instance.ReplicaSet</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(instance.Tags))
                    {
                        <dt class="col-5">Tags</dt><dd class="col-7">@instance.Tags</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(instance.RunbookUrl))
                    {
                        <dt class="col-5">Runbook</dt><dd class="col-7"><a href="@instance.RunbookUrl" target="_blank" rel="noopener">@instance.RunbookUrl</a></dd>
                    }
                    @if (instance.AppliedPolicyId is not null)
                    {
                        <dt class="col-5">Applied policy</dt><dd class="col-7">@(instance.AppliedPolicy?.Name ?? "(deleted)") v@instance.AppliedPolicyVersion</dd>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(instance.Notes))
                {
                    <div class="text-muted small mt-2">@instance.Notes</div>
                }

                <div class="mt-3" style="border-top:1px solid var(--dbt-line);padding-top:14px;">
                    @if (!_showCorrectionForm)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _showCorrectionForm = true">
                            <i class="bi bi-flag"></i> Request contact correction
                        </button>
                    }
                    else
                    {
                        <h3 class="h6 text-muted text-uppercase mb-2">Request a contact correction</h3>
                        <p class="small text-muted mb-2">Anyone can flag wrong contact info — an authorized reviewer applies only the fields you fill in below; this never edits the instance directly.</p>
                        <div class="row g-2 mb-2">
                            <div class="col-6"><input class="form-control form-control-sm" placeholder="Proposed contact name" @bind="_proposedContactName" @bind:event="oninput" /></div>
                            <div class="col-6"><input class="form-control form-control-sm" placeholder="Proposed contact email" @bind="_proposedContactEmail" @bind:event="oninput" /></div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="correction-note">Why is this wrong? (required)</label>
                            <input id="correction-note" class="form-control form-control-sm" @bind="_correctionNote" @bind:event="oninput" />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="SubmitCorrectionRequest" disabled="@(!CanSubmitCorrection())">Submit request</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _showCorrectionForm = false">Cancel</button>
                        </div>
                    }
                </div>

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    @if (_pendingCorrections.Count > 0)
                    {
                        <div class="mt-3" style="border-top:1px solid var(--dbt-line);padding-top:14px;">
                            <h3 class="h6 text-muted text-uppercase mb-2">Pending correction request(s)</h3>
                            @foreach (var req in _pendingCorrections)
                            {
                                <div class="small mb-2">
                                    <div>Requested by @req.RequestedByName on @req.RequestedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                                    <div class="text-muted">"@req.Note"</div>
                                    @if (!string.IsNullOrWhiteSpace(req.ProposedContactName)) { <div>Proposed name: @req.ProposedContactName</div> }
                                    @if (!string.IsNullOrWhiteSpace(req.ProposedContactEmail)) { <div>Proposed email: @req.ProposedContactEmail</div> }
                                    <div class="d-flex gap-2 mt-1">
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ApproveCorrection(req.Id)">Approve</button>
                                        <button class="btn btn-link btn-sm text-danger" @onclick="() => RejectCorrection(req.Id)">Reject</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </AuthorizeView>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Topology &amp; backup evidence</h2>
                <dl class="row mb-0 small">
                    <dt class="col-5">Database IP</dt><dd class="col-7">@instance.DatabaseIp</dd>
                    <dt class="col-5">Server IP</dt><dd class="col-7">@instance.ServerIp</dd>
                    <dt class="col-5">Expected cadence</dt><dd class="col-7">every @instance.ExpectedBackupIntervalHours h</dd>
                    @if (instance.RetentionPolicyDays is not null)
                    {
                        <dt class="col-5">Retention policy</dt><dd class="col-7">@instance.RetentionPolicyDays days</dd>
                    }
                    <dt class="col-5">Last successful backup</dt>
                    <dd class="col-7">@(_overview.LastBackupUtc is null ? "Never" : _overview.LastBackupUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</dd>
                    <dt class="col-5">Restore-test coverage</dt>
                    <dd class="col-7">
                        <span class="badge-health dot @RecencyClass(_restoreTestRecency!.Status)">@RecencyLabel(_restoreTestRecency.Status)</span>
                        @if (_restoreTestRecency.NextDueUtc is { } nextDue)
                        {
                            <span class="text-muted small ms-1">next due @nextDue.ToLocalTime().ToString("MMM d, yyyy")</span>
                        }
                        <span class="text-muted small ms-1">(every @_effectiveRestoreTestIntervalDays d@(instance.RestoreTestIntervalDaysOverride is null ? ", default" : ", override"))</span>
                    </dd>
                    <dt class="col-5">Backup file location</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(instance.BackupFileLocation) ? "Not configured" : instance.BackupFileLocation)</dd>
                    @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                    {
                        <dt class="col-5">Last scanned</dt>
                        <dd class="col-7">
                            @if (instance.LastScanUtc is null)
                            {
                                <span class="text-muted">Never scanned</span>
                            }
                            else
                            {
                                <span>@instance.LastScanUtc.Value.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                <span class="badge-health dot @ScannerFreshnessClass(_scannerHealth!.Freshness) ms-1">@_scannerHealth.Freshness</span>
                                @if (instance.LastScanStatus == ScanStatus.Error)
                                {
                                    <div class="text-danger small mt-1">@instance.LastScanError</div>
                                }
                            }
                        </dd>
                        <dt class="col-5">Name pattern(s)</dt>
                        <dd class="col-7">@(string.IsNullOrWhiteSpace(instance.BackupFileNamePatterns) ? "All files" : instance.BackupFileNamePatterns)</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="row g-0 mb-4" style="border-top:1px solid var(--dbt-line);padding-top:28px;">
        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted text-uppercase mb-3">Maintenance window</h2>
                @if (instance.MaintenanceUntilUtc is { } activeUntil && activeUntil > DateTime.UtcNow)
                {
                    <p class="mb-2"><span class="badge-health dot Overdue">Under maintenance</span> until @activeUntil.ToLocalTime().ToString("MMM d, yyyy h:mm tt") — Overdue/Failed email and webhook alerts are suppressed.</p>
                    @if (!string.IsNullOrWhiteSpace(instance.MaintenanceReason))
                    {
                        <p class="text-muted small mb-2">@instance.MaintenanceReason</p>
                    }
                    <AuthorizeView Roles="@Roles.CanEditPolicy">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="EndMaintenance">End maintenance now</button>
                    </AuthorizeView>
                }
                else
                {
                    <AuthorizeView Roles="@Roles.CanEditPolicy">
                        <Authorized>
                            <div class="d-flex gap-2 align-items-end flex-wrap mb-2">
                                <div class="field" style="min-width:240px">
                                    <label class="form-label small">Reason</label>
                                    <input class="form-control form-control-sm" @bind="_maintenanceReason" placeholder="Planned patching, migration, …" />
                                </div>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartMaintenance(1)">1 h</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartMaintenance(4)">4 h</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartMaintenance(24)">24 h</button>
                            </div>
                            <div class="form-text">Suppresses Overdue/Failed alerts for the chosen window — the health badge above stays truthful.</div>
                        </Authorized>
                        <NotAuthorized>
                            <p class="text-muted small mb-0">No maintenance window active.</p>
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </div>
        </div>
    </div>

    @if (_openIncident is not null)
    {
        <div class="row g-0 mb-4" style="border-top:1px solid var(--dbt-line);padding-top:28px;">
            <div class="col-12">
                <div class="dbt-card">
                    <h2 class="h6 text-muted text-uppercase mb-3">Open incident</h2>
                    <p class="small text-muted mb-2">
                        Opened @_openIncident.OpenedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt") on @_openIncident.TriggerHealth.
                        @if (_openIncident.EscalationLevel > 0)
                        {
                            <span style="color:var(--dbt-failed)"> Escalated @_openIncident.EscalationLevel time(s), last @_openIncident.LastEscalatedAtUtc?.ToLocalTime().ToString("MMM d, h:mm tt").</span>
                        }
                    </p>
                    @if (_openIncident.AcknowledgedAtUtc is { } ackAt)
                    {
                        <p class="mb-2"><span class="badge-health dot OnTrack">Acknowledged</span> by @_openIncident.AcknowledgedBy on @ackAt.ToLocalTime().ToString("MMM d, h:mm tt") — escalation stopped. <span class="text-muted">Acknowledgement is a response record only; it never changes the health badge above.</span></p>
                        @if (!string.IsNullOrWhiteSpace(_openIncident.Note))
                        {
                            <p class="small mb-1"><strong>Note:</strong> @_openIncident.Note</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_openIncident.TicketReference))
                        {
                            <p class="small mb-0"><strong>Ticket:</strong> @_openIncident.TicketReference</p>
                        }
                    }
                    else
                    {
                        <p class="mb-2"><span class="badge-health dot Overdue">Unacknowledged</span> — will keep escalating until someone acknowledges it.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openIncident.AssigneeName))
                    {
                        <p class="small mb-2"><strong>Assigned to:</strong> @_openIncident.AssigneeName</p>
                    }
                    <AuthorizeView Roles="@Roles.CanEditPolicy">
                        <Authorized>
                            <div class="d-flex gap-2 align-items-end flex-wrap mb-2">
                                <div class="field" style="min-width:160px"><label class="form-label small">Assignee</label><input class="form-control form-control-sm" @bind="_assigneeName" /></div>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="AssignIncident">Assign</button>
                            </div>
                            @if (_openIncident.AcknowledgedAtUtc is null)
                            {
                                <div class="d-flex gap-2 align-items-end flex-wrap">
                                    <div class="field" style="min-width:200px"><label class="form-label small">Note / runbook</label><input class="form-control form-control-sm" @bind="_ackNote" /></div>
                                    <div class="field" style="min-width:140px"><label class="form-label small">Ticket ref</label><input class="form-control form-control-sm" @bind="_ackTicket" /></div>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="AcknowledgeIncident">Acknowledge</button>
                                </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    }

    <div class="row g-0 mb-4 kv-row">
        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="backupAuth">
            <Authorized>
                <div class="col-md-5">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted text-uppercase mb-3">Log a backup result</h2>
                        <EditForm Model="_newRecord" OnValidSubmit="LogBackup">
                            <div class="mb-2">
                                <label class="form-label small">Occurred at (local time)</label>
                                <input type="datetime-local" class="form-control form-control-sm" @bind="_newRecordOccurredLocal" />
                                <div class="form-text">Defaults to now — backdate after logging an incident late. Future times are rejected.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Type</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_newRecord.Type">
                                    @foreach (var t in Enum.GetValues<BackupType>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Status</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_newRecord.Status">
                                    @foreach (var s in Enum.GetValues<BackupStatus>())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small">Size (MB)</label>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_newRecord.SizeMb" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Duration (min)</label>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_newRecord.DurationMinutes" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Notes</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_newRecord.Notes" />
                            </div>
                            @if (!string.IsNullOrEmpty(_backupFormError))
                            {
                                <div class="text-danger small mb-2">@_backupFormError</div>
                            }
                            <button type="submit" class="btn btn-primary btn-sm">Log backup</button>
                        </EditForm>

                        <div class="mt-4" style="border-top:1px solid var(--dbt-line);padding-top:16px;">
                            <h2 class="h6 text-muted text-uppercase mb-2">Correct a backup entry</h2>
                            <p class="text-muted small mb-2">The original entry is preserved — a correction is recorded alongside it, not overwritten.</p>
                            <div class="mb-2">
                                <select class="form-select form-select-sm" @bind="_correctingBackupId" @bind:after="OnBackupCorrectionTargetChanged">
                                    <option value="0">Select an entry…</option>
                                    @foreach (var r in instance.BackupRecords.OrderByDescending(r => r.TimestampUtc))
                                    {
                                        <option value="@r.Id">@r.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt") — @r.Status</option>
                                    }
                                </select>
                            </div>
                            @if (_correctingBackupId != 0)
                            {
                                <div class="mb-2">
                                    <label class="form-label small">New status</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_correctedBackupStatus">
                                        @foreach (var s in Enum.GetValues<BackupStatus>())
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">New notes</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_correctedBackupNotes" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">Reason (required)</label>
                                    <input class="form-control form-control-sm" @bind="_correctionReason" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SubmitBackupCorrection" disabled="@string.IsNullOrWhiteSpace(_correctionReason)">Save correction</button>
                            }
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="col-md-7">
            <div class="dbt-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 text-muted text-uppercase mb-0">Backup history</h2>
                    @if (instance.BackupRecords.Count > 0)
                    {
                        <select class="form-select form-select-sm" style="max-width:150px;" @bind="_backupStatusFilter" @bind:after="() => _backupPage = 1">
                            <option value="">All statuses</option>
                            @foreach (var s in Enum.GetValues<BackupStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    }
                </div>
                @if (!instance.BackupRecords.Any())
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-clock-history"></i>
                        No backup history recorded yet.
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0 dbt-table">
                        <thead>
                            <tr><th>When</th><th>Entered</th><th>By</th><th>Type</th><th>Status</th><th>Size</th><th>Duration</th><th>Evidence</th><th>File</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in BackupHistoryPage())
                            {
                                var evidence = BackupEvidenceClassifier.Classify(r, instance.RestoreEvents.ToList());
                                var effectiveStatus = EvidenceCorrectionResolver.EffectiveStatus(r, _backupCorrections);
                                var effectiveNotes = EvidenceCorrectionResolver.EffectiveNotes(r, _backupCorrections);
                                var wasCorrected = _backupCorrections.Any(c => c.BackupRecordId == r.Id);
                                <tr>
                                    <td class="small">@r.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td class="small text-muted">@r.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(r.RecordedByUserName) ? "—" : r.RecordedByUserName)</td>
                                    <td class="small">@r.Type</td>
                                    <td>
                                        <span class="badge-health dot @StatusClass(effectiveStatus)">@effectiveStatus</span>
                                        @if (wasCorrected)
                                        {
                                            <span class="text-muted small" title="This entry has one or more append-only corrections.">(corrected)</span>
                                        }
                                    </td>
                                    <td class="small">@(r.SizeMb is null ? "—" : $"{r.SizeMb:N0} MB")</td>
                                    <td class="small">@(r.DurationMinutes is null ? "—" : $"{r.DurationMinutes:N0} min")</td>
                                    <td class="small">
                                        @if (evidence is { } level)
                                        {
                                            <span class="badge-health dot @EvidenceClass(level)" title="@EvidenceTooltip(level)">@BackupEvidenceClassifier.Describe(level)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(r.SourceFile) ? "—" : r.SourceFile)</td>
                                    <td class="small text-muted">@effectiveNotes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!BackupHistoryFiltered().Any())
                    {
                        <div class="text-muted small py-2">No backup records match this filter.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="small text-muted">Page @_backupPage of @BackupHistoryTotalPages()</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_backupPage <= 1)" @onclick="() => _backupPage--">Prev</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_backupPage >= BackupHistoryTotalPages())" @onclick="() => _backupPage++">Next</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="row g-0 kv-row">
        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="restoreAuth">
            <Authorized>
                <div class="col-md-5">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted text-uppercase mb-3">Log a restore</h2>
                        <EditForm Model="_newRestore" OnValidSubmit="LogRestore">
                            <div class="mb-2">
                                <label class="form-label small">Occurred at (local time)</label>
                                <input type="datetime-local" class="form-control form-control-sm" @bind="_newRestoreOccurredLocal" />
                                <div class="form-text">Defaults to now — backdate after an incident. Future times are rejected.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Performed by</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_newRestore.PerformedBy" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small">Reason</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_newRestore.Reason">
                                        @foreach (var r in Enum.GetValues<RestoreReason>())
                                        {
                                            <option value="@r">@r</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Outcome</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_newRestore.Outcome">
                                        @foreach (var o in Enum.GetValues<RestoreOutcome>())
                                        {
                                            <option value="@o">@o</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Backup evidence this proves (optional)</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_newRestoreLinkedBackupId">
                                    <option value="0">Unknown / not linked</option>
                                    @foreach (var r in instance.BackupRecords.OrderByDescending(r => r.TimestampUtc))
                                    {
                                        <option value="@r.Id">@r.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt") — @r.Status</option>
                                    }
                                </InputSelect>
                                <div class="form-text">Left as "unknown" rather than guessed — never implies every backup was tested.</div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small">Duration (min)</label>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_newRestore.DurationMinutes" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Target recovery time (min)</label>
                                    <InputNumber class="form-control form-control-sm" @bind-Value="_newRestore.TargetRecoveryTimeMinutes" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Notes</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_newRestore.Notes" />
                            </div>
                            @if (!string.IsNullOrEmpty(_restoreFormError))
                            {
                                <div class="text-danger small mb-2">@_restoreFormError</div>
                            }
                            <button type="submit" class="btn btn-primary btn-sm">Log restore</button>
                        </EditForm>

                        <div class="mt-4" style="border-top:1px solid var(--dbt-line);padding-top:16px;">
                            <h2 class="h6 text-muted text-uppercase mb-2">Correct a restore entry</h2>
                            <p class="text-muted small mb-2">The original entry is preserved — a correction is recorded alongside it, not overwritten.</p>
                            <div class="mb-2">
                                <select class="form-select form-select-sm" @bind="_correctingRestoreId" @bind:after="OnRestoreCorrectionTargetChanged">
                                    <option value="0">Select an entry…</option>
                                    @foreach (var r in instance.RestoreEvents.OrderByDescending(r => r.TimestampUtc))
                                    {
                                        <option value="@r.Id">@r.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt") — @r.Outcome</option>
                                    }
                                </select>
                            </div>
                            @if (_correctingRestoreId != 0)
                            {
                                <div class="mb-2">
                                    <label class="form-label small">New outcome</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="_correctedRestoreOutcome">
                                        @foreach (var o in Enum.GetValues<RestoreOutcome>())
                                        {
                                            <option value="@o">@o</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">New notes</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_correctedRestoreNotes" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">Reason (required)</label>
                                    <input class="form-control form-control-sm" @bind="_correctionReasonRestore" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SubmitRestoreCorrection" disabled="@string.IsNullOrWhiteSpace(_correctionReasonRestore)">Save correction</button>
                            }
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="col-md-7">
            <div class="dbt-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 text-muted text-uppercase mb-0">Restore history</h2>
                    @if (instance.RestoreEvents.Count > 0)
                    {
                        <select class="form-select form-select-sm" style="max-width:150px;" @bind="_restoreOutcomeFilter" @bind:after="() => _restorePage = 1">
                            <option value="">All outcomes</option>
                            @foreach (var o in Enum.GetValues<RestoreOutcome>())
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    }
                </div>
                @if (!instance.RestoreEvents.Any())
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        No restore ever logged — this backup has never been proven recoverable.
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0 dbt-table">
                        <thead>
                            <tr><th>When</th><th>By</th><th>Entered by</th><th>Reason</th><th>Outcome</th><th>Linked evidence</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in RestoreHistoryPage())
                            {
                                var effectiveOutcome = EvidenceCorrectionResolver.EffectiveOutcome(r, _restoreCorrections);
                                var effectiveNotes = EvidenceCorrectionResolver.EffectiveNotes(r, _restoreCorrections);
                                var wasCorrected = _restoreCorrections.Any(c => c.RestoreEventId == r.Id);
                                var linked = instance.BackupRecords.FirstOrDefault(b => b.Id == r.LinkedBackupRecordId);
                                <tr>
                                    <td class="small">@r.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td class="small">@r.PerformedBy</td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(r.RecordedByUserName) ? "—" : r.RecordedByUserName)</td>
                                    <td class="small">@r.Reason</td>
                                    <td>
                                        <span class="badge-health dot @(effectiveOutcome == RestoreOutcome.Success ? "OnTrack" : "Failed")">@effectiveOutcome</span>
                                        @if (wasCorrected)
                                        {
                                            <span class="text-muted small" title="This entry has one or more append-only corrections.">(corrected)</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(linked is null ? "Unknown" : linked.TimestampUtc.ToLocalTime().ToString("MMM d, h:mm tt"))</td>
                                    <td class="small text-muted">@effectiveNotes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!RestoreHistoryFiltered().Any())
                    {
                        <div class="text-muted small py-2">No restore events match this filter.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="small text-muted">Page @_restorePage of @RestoreHistoryTotalPages()</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_restorePage <= 1)" @onclick="() => _restorePage--">Prev</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_restorePage >= RestoreHistoryTotalPages())" @onclick="() => _restorePage++">Next</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="row g-0" style="border-top:1px solid var(--dbt-line);padding-top:28px;margin-top:28px;">
        <div class="col-12">
            <div class="dbt-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 text-muted text-uppercase mb-0">Change history</h2>
                    @if (_changeLog.Count > 0)
                    {
                        <input class="form-control form-control-sm" style="max-width:180px;" placeholder="Filter by field…" @bind="_changeLogFieldFilter" @bind:event="oninput" @bind:after="() => _changeLogPage = 1" />
                    }
                </div>
                @if (_changeLog.Count == 0)
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-journal-text"></i>
                        No changes recorded yet.
                    </div>
                }
                else
                {
                    <table class="table table-sm mb-0 dbt-table">
                        <thead>
                            <tr><th>When</th><th>By</th><th>Field</th><th>From</th><th>To</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in ChangeLogPage())
                            {
                                <tr>
                                    <td class="small">@c.ChangedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td class="small">@c.ChangedBy</td>
                                    <td class="small">@c.FieldName</td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(c.OldValue) ? "—" : c.OldValue)</td>
                                    <td class="small">@(string.IsNullOrEmpty(c.NewValue) ? "—" : c.NewValue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!ChangeLogFiltered().Any())
                    {
                        <div class="text-muted small py-2">No changes match this filter.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="small text-muted">Page @_changeLogPage of @ChangeLogTotalPages()</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_changeLogPage <= 1)" @onclick="() => _changeLogPage--">Prev</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(_changeLogPage >= ChangeLogTotalPages())" @onclick="() => _changeLogPage++">Next</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InstanceOverview? _overview;
    private BackupRecord _newRecord = new();
    private RestoreEvent _newRestore = new();
    private DateTime _newRecordOccurredLocal = DateTime.Now;
    private DateTime _newRestoreOccurredLocal = DateTime.Now;
    private int _newRestoreLinkedBackupId;
    private string? _backupFormError;
    private string? _restoreFormError;
    private List<InstanceChangeLog> _changeLog = new();
    private List<BackupRecordCorrection> _backupCorrections = new();
    private List<RestoreEventCorrection> _restoreCorrections = new();
    private int _correctingBackupId;
    private BackupStatus _correctedBackupStatus;
    private string _correctedBackupNotes = "";
    private string _correctionReason = "";
    private int _correctingRestoreId;
    private RestoreOutcome _correctedRestoreOutcome;
    private string _correctedRestoreNotes = "";
    private string _correctionReasonRestore = "";
    private string _maintenanceReason = "";
    private bool _scanning;
    private bool _testingConnection;
    private ConnectivityResult? _connectivityResult;
    private HealthExplanation? _explanation;
    private ScannerHealth? _scannerHealth;
    private Incident? _openIncident;
    private string _assigneeName = "";
    private string _ackNote = "";
    private string _ackTicket = "";
    private string? _userDisplayName;
    private string? _userId;
    private RestoreTestRecencyResult? _restoreTestRecency;
    private int _effectiveRestoreTestIntervalDays;
    private bool _loaded;
    private string? _connectivityEndpointDescription;
    private string? _connectivityDisabledReason;
    private bool _showArchiveConfirm;
    private IReadOnlyList<ArchiveImpactLine>? _archivePreview;
    private string _archiveReason = "";

    // U21 — ownership status, contact-correction requests.
    private OwnershipStatus _ownershipStatus;
    private bool _showCorrectionForm;
    private string _proposedContactName = "";
    private string _proposedContactEmail = "";
    private string _correctionNote = "";
    private List<ContactCorrectionRequest> _pendingCorrections = new();

    // History tables are paged/filtered client-side over the already-loaded per-instance
    // collection (U06) — a single instance's own history is bounded in a way the cross-instance
    // dashboard/list queries weren't, so the bigger "stop loading full histories" win there
    // (InstanceListRow) was the priority; this still gives real paging + filtering in the UI.
    private const int HistoryPageSize = 10;
    private int _backupPage = 1, _restorePage = 1, _changeLogPage = 1;
    private string _backupStatusFilter = "";
    private string _restoreOutcomeFilter = "";
    private string _changeLogFieldFilter = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userDisplayName = state.User.Identity?.Name ?? "";
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        await Load();
        _loaded = true;
    }

    private async Task Load()
    {
        _overview = await OverviewService.GetByIdAsync(Id);
        _showArchiveConfirm = false;
        _archiveReason = "";
        _newRecord = new BackupRecord();
        _newRestore = new RestoreEvent();
        _newRecordOccurredLocal = DateTime.Now;
        _newRestoreOccurredLocal = DateTime.Now;
        _newRestoreLinkedBackupId = 0;
        _backupFormError = null;
        _restoreFormError = null;
        _correctingBackupId = 0;
        _correctingRestoreId = 0;
        _correctionReason = "";
        _correctionReasonRestore = "";
        _showCorrectionForm = false;
        _proposedContactName = "";
        _proposedContactEmail = "";
        _correctionNote = "";
        _pendingCorrections = (await Corrections.ListForInstanceAsync(Id)).Where(r => r.Status == ContactCorrectionStatus.Pending).ToList();

        _changeLog = await Db.InstanceChangeLogs.AsNoTracking()
            .Where(c => c.DatabaseInstanceId == Id)
            .OrderByDescending(c => c.ChangedAtUtc)
            .ToListAsync();
        _openIncident = await Incidents.GetOpenAsync(Id);
        _assigneeName = _openIncident?.AssigneeName ?? "";
        _backupCorrections = await Db.BackupRecordCorrections.AsNoTracking()
            .Where(c => c.BackupRecord!.DatabaseInstanceId == Id)
            .ToListAsync();
        _restoreCorrections = await Db.RestoreEventCorrections.AsNoTracking()
            .Where(c => c.RestoreEvent!.DatabaseInstanceId == Id)
            .ToListAsync();

        if (_overview is not null)
        {
            var now = DateTime.UtcNow;
            _ownershipStatus = OwnershipStatusClassifier.Classify(
                _overview.Instance.OwnerTeamId, _overview.Instance.ContactEmail, _overview.Instance.BackupContactEmail, _overview.Instance.OwnershipConfirmedAtUtc);
            _explanation = BackupHealthCalculator.Explain(_overview.Instance, _overview.Instance.BackupRecords.ToList(), now);
            _scannerHealth = ScannerStalenessClassifier.Classify(
                backupFileLocationConfigured: !string.IsNullOrWhiteSpace(_overview.Instance.BackupFileLocation),
                lastScanUtc: _overview.Instance.LastScanUtc,
                lastScanStatus: _overview.Instance.LastScanStatus,
                scanIntervalMinutes: Configuration.GetValue("BackupScan:IntervalMinutes", 15),
                staleAfterMultiplier: Configuration.GetValue("BackupScan:StaleAfterMultiplier", 3),
                nowUtc: now);

            _effectiveRestoreTestIntervalDays = _overview.Instance.RestoreTestIntervalDaysOverride
                ?? Configuration.GetValue("RestoreTest:IntervalDays", 90);
            var lastSuccessfulRestore = _overview.Instance.RestoreEvents
                .Where(r => r.Outcome == RestoreOutcome.Success)
                .OrderByDescending(r => r.TimestampUtc)
                .Select(r => r.TimestampUtc)
                .FirstOrDefault();
            _restoreTestRecency = RestoreTestRecencyCalculator.Compute(
                _overview.Instance.RestoreEvents.Any(r => r.Outcome == RestoreOutcome.Success) ? lastSuccessfulRestore : null,
                _effectiveRestoreTestIntervalDays, now);
        }
    }

    private IEnumerable<BackupRecord> BackupHistoryFiltered()
    {
        var items = (_overview?.Instance.BackupRecords ?? []).OrderByDescending(r => r.TimestampUtc).ThenByDescending(r => r.Id).AsEnumerable();
        if (_backupStatusFilter.Length > 0 && Enum.TryParse<BackupStatus>(_backupStatusFilter, out var s))
        {
            items = items.Where(r => r.Status == s);
        }
        return items;
    }

    private int BackupHistoryTotalPages() => Math.Max(1, (int)Math.Ceiling(BackupHistoryFiltered().Count() / (double)HistoryPageSize));
    private IEnumerable<BackupRecord> BackupHistoryPage() => BackupHistoryFiltered().Skip((Math.Clamp(_backupPage, 1, BackupHistoryTotalPages()) - 1) * HistoryPageSize).Take(HistoryPageSize);

    private IEnumerable<RestoreEvent> RestoreHistoryFiltered()
    {
        var items = (_overview?.Instance.RestoreEvents ?? []).OrderByDescending(r => r.TimestampUtc).AsEnumerable();
        if (_restoreOutcomeFilter.Length > 0 && Enum.TryParse<RestoreOutcome>(_restoreOutcomeFilter, out var o))
        {
            items = items.Where(r => r.Outcome == o);
        }
        return items;
    }

    private int RestoreHistoryTotalPages() => Math.Max(1, (int)Math.Ceiling(RestoreHistoryFiltered().Count() / (double)HistoryPageSize));
    private IEnumerable<RestoreEvent> RestoreHistoryPage() => RestoreHistoryFiltered().Skip((Math.Clamp(_restorePage, 1, RestoreHistoryTotalPages()) - 1) * HistoryPageSize).Take(HistoryPageSize);

    private IEnumerable<InstanceChangeLog> ChangeLogFiltered() =>
        _changeLogFieldFilter.Length > 0
            ? _changeLog.Where(c => c.FieldName.Contains(_changeLogFieldFilter, StringComparison.OrdinalIgnoreCase))
            : _changeLog;

    private int ChangeLogTotalPages() => Math.Max(1, (int)Math.Ceiling(ChangeLogFiltered().Count() / (double)HistoryPageSize));
    private IEnumerable<InstanceChangeLog> ChangeLogPage() => ChangeLogFiltered().Skip((Math.Clamp(_changeLogPage, 1, ChangeLogTotalPages()) - 1) * HistoryPageSize).Take(HistoryPageSize);

    private async Task AcknowledgeIncident()
    {
        if (_openIncident is null) return;
        await Incidents.AcknowledgeAsync(_openIncident.Id, _userDisplayName ?? "", _ackNote, _ackTicket);
        Toasts.Success("Incident acknowledged — escalation stopped.");
        await Load();
    }

    private async Task AssignIncident()
    {
        if (_openIncident is null) return;
        await Incidents.AssignAsync(_openIncident.Id, _assigneeName);
        Toasts.Success($"Assigned to {_assigneeName}.");
        await Load();
    }

    private async Task<string?> CurrentUserNameAsync() =>
        (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    private async Task LogBackup()
    {
        var occurredUtc = _newRecordOccurredLocal.ToUniversalTime();
        if (occurredUtc > DateTime.UtcNow.AddMinutes(1))
        {
            _backupFormError = "Occurrence time can't be in the future.";
            return;
        }

        _backupFormError = null;
        _newRecord.DatabaseInstanceId = Id;
        _newRecord.TimestampUtc = occurredUtc;
        _newRecord.RecordedByUserName = await CurrentUserNameAsync() ?? "unknown";
        Db.BackupRecords.Add(_newRecord);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        Toasts.Success($"Backup result logged ({_newRecord.Status}).");
        await Load();
    }

    private async Task LogRestore()
    {
        var occurredUtc = _newRestoreOccurredLocal.ToUniversalTime();
        if (occurredUtc > DateTime.UtcNow.AddMinutes(1))
        {
            _restoreFormError = "Occurrence time can't be in the future.";
            return;
        }

        _restoreFormError = null;
        _newRestore.DatabaseInstanceId = Id;
        _newRestore.TimestampUtc = occurredUtc;
        _newRestore.LinkedBackupRecordId = _newRestoreLinkedBackupId == 0 ? null : _newRestoreLinkedBackupId;
        _newRestore.RecordedByUserName = await CurrentUserNameAsync() ?? "unknown";
        Db.RestoreEvents.Add(_newRestore);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        Toasts.Success($"Restore logged ({_newRestore.Outcome}).");
        await Load();
    }

    private void OnBackupCorrectionTargetChanged()
    {
        if (_correctingBackupId == 0 || _overview is null)
        {
            return;
        }

        var original = _overview.Instance.BackupRecords.FirstOrDefault(r => r.Id == _correctingBackupId);
        if (original is null)
        {
            return;
        }

        _correctedBackupStatus = EvidenceCorrectionResolver.EffectiveStatus(original, _backupCorrections);
        _correctedBackupNotes = EvidenceCorrectionResolver.EffectiveNotes(original, _backupCorrections);
    }

    private void OnRestoreCorrectionTargetChanged()
    {
        if (_correctingRestoreId == 0 || _overview is null)
        {
            return;
        }

        var original = _overview.Instance.RestoreEvents.FirstOrDefault(r => r.Id == _correctingRestoreId);
        if (original is null)
        {
            return;
        }

        _correctedRestoreOutcome = EvidenceCorrectionResolver.EffectiveOutcome(original, _restoreCorrections);
        _correctedRestoreNotes = EvidenceCorrectionResolver.EffectiveNotes(original, _restoreCorrections);
    }

    private async Task SubmitBackupCorrection()
    {
        if (_correctingBackupId == 0 || string.IsNullOrWhiteSpace(_correctionReason))
        {
            return;
        }

        var original = _overview!.Instance.BackupRecords.First(r => r.Id == _correctingBackupId);
        var currentStatus = EvidenceCorrectionResolver.EffectiveStatus(original, _backupCorrections);
        var currentNotes = EvidenceCorrectionResolver.EffectiveNotes(original, _backupCorrections);

        Db.BackupRecordCorrections.Add(new BackupRecordCorrection
        {
            BackupRecordId = _correctingBackupId,
            CorrectedByUserName = await CurrentUserNameAsync() ?? "unknown",
            Reason = _correctionReason,
            PreviousStatus = currentStatus,
            NewStatus = _correctedBackupStatus,
            PreviousNotes = currentNotes,
            NewNotes = _correctedBackupNotes
        });
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        await Audit.RecordUserActionAsync(_userId ?? "", _userDisplayName ?? "unknown", "BackupRecordCorrected", "BackupRecord", _correctingBackupId.ToString(), _overview!.Instance.Name,
            reason: _correctionReason, beforeJson: $"{{\"Status\":\"{currentStatus}\"}}", afterJson: $"{{\"Status\":\"{_correctedBackupStatus}\"}}");
        Toasts.Success("Correction recorded — the original entry is preserved.");
        await Load();
    }

