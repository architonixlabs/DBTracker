@page "/instances/{Id:int}"
@attribute [Authorize]
@inject InstanceOverviewService OverviewService
@inject DBTrackerDbContext Db
@inject BackupFileScanner Scanner
@inject ConnectivityChecker Connectivity
@inject IncidentService Incidents
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IConfiguration Configuration
@inject InstanceArchiveService ArchiveService
@inject AuditRecorder Audit
@inject ContactCorrectionService Corrections
@inject ViewerTimeZone Viewer
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(_overview?.Instance.Name ?? "Instance") · DBTracker</PageTitle>

@if (_loadFailed)
{
    <div class="dbt-card" style="max-width: 600px;">
        <div class="empty-state py-4" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            Couldn't load this instance. The database may be unreachable.
        </div>
        <button type="button" class="btn btn-outline-secondary" @onclick="Retry">Try again</button>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
    </div>
}
else if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading instance…</span></div>
}
else if (_overview is null)
{
    <div class="dbt-card" style="max-width: 600px;">
        <div class="empty-state py-4">
            <i class="bi bi-question-diamond" aria-hidden="true"></i>
            Instance #@Id doesn't exist. It may have been deleted or archived, or the link is wrong.
        </div>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
        <a class="btn btn-outline-secondary" href="/instances/archived">Check archived instances</a>
    </div>
}
else
{
    var instance = _overview.Instance;

    @if (instance.IsArchived)
    {
        <div class="alert alert-warning" role="status">
            <i class="bi bi-archive" aria-hidden="true"></i> This instance is <strong>archived</strong>
            (<LocalTime Utc="instance.ArchivedAtUtc" ShowUtc="false" Empty="time not recorded" /> by @instance.ArchivedBy). Reason: @instance.ArchiveReason.
            It's excluded from background scans, alerts and reports. <a href="/instances/archived">Browse archived instances</a> to unarchive it.
        </div>
    }

    <div class="app-topbar">
        <div>
            <h1>
                @instance.Name <HealthBadge Health="_overview.Health" />
                @if (instance.MaintenanceUntilUtc is { } maintUtc && maintUtc > DateTime.UtcNow)
                {
                    <span class="badge-health dot Overdue">
                        <i class="bi bi-cone-striped" aria-hidden="true"></i> Maintenance until <LocalTime Utc="maintUtc" Format="MMM d, h:mm tt" ShowUtc="false" />
                    </span>
                }
            </h1>
            <div class="subtitle">@instance.Engine @instance.Version · @instance.Environment · <span class="role-pill @instance.Role">@instance.Role</span></div>
            @if (instance.MaintenanceUntilUtc is { } maintEnd && maintEnd > DateTime.UtcNow)
            {
                <div class="subtitle" data-testid="maintenance-note">Overdue and failed alerts are paused until this maintenance window ends.</div>
            }
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <nav class="d-flex gap-2 flex-wrap" aria-label="Instance sections">
                <a class="btn btn-outline-secondary" href="/instances/@Id/lifecycle">
                    <i class="bi bi-signpost-split" aria-hidden="true"></i> Lifecycle
                </a>
                <a class="btn btn-outline-secondary" href="/instances/@Id/migration">
                    <i class="bi bi-diagram-2" aria-hidden="true"></i> Migration
                </a>
                <a class="btn btn-outline-secondary" href="/instances/@Id/recovery">
                    <i class="bi bi-shield-check" aria-hidden="true"></i> Recovery
                </a>
                <a class="btn btn-outline-secondary" href="/instances/@Id/assurance">
                    <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i> Assurance
                </a>
                <a class="btn btn-outline-secondary" href="/instances/@Id/certificates">
                    <i class="bi bi-key" aria-hidden="true"></i> Certificates
                </a>
                <a class="btn btn-outline-secondary" href="/instances/@Id/entitlement">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Entitlement
                </a>
                <a class="btn btn-outline-secondary" href="/instances/@Id/retirement">
                    <i class="bi bi-door-closed" aria-hidden="true"></i> Retirement
                </a>
                <Toggletip Label="What each instance section covers" TestId="instance-sections-help">
                    <dl class="toggletip-list">
                        <dt>Lifecycle</dt><dd>Installed version, support runway, patch baseline and advisories.</dd>
                        <dt>Migration</dt><dd>Dependencies, migration path assessment and the upgrade-readiness checklist.</dd>
                        <dt>Recovery</dt><dd>Recovery objectives, backup-chain coverage and backup copies.</dd>
                        <dt>Assurance</dt><dd>Integrity, HA, maintenance-job and capacity evidence.</dd>
                        <dt>Certificates</dt><dd>Certificate and recovery-key reminders.</dd>
                        <dt>Entitlement</dt><dd>Support contracts and edition cost estimates.</dd>
                        <dt>Retirement</dt><dd>The decommission checklist that gates archiving.</dd>
                    </dl>
                </Toggletip>
            </nav>
            <button type="button" class="btn btn-outline-secondary" @onclick="TestConnection" disabled="@(_testingConnection || !CanCheckConnectivity(instance))" aria-describedby="@(CanCheckConnectivity(instance) ? null : "connectivity-unavailable")">
                <i class="bi bi-ethernet" aria-hidden="true"></i> @(_testingConnection ? "Testing…" : "Test connection")
            </button>
            <AuthorizeView Roles="@Roles.CanEditPolicy">
                <div class="d-flex gap-2 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="ScanNow" disabled="@_scanning">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i> @(_scanning ? "Scanning…" : "Scan now")
                        </button>
                    }
                    <a class="btn btn-outline-secondary" href="/instances/@Id/edit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
                    @* Stays rendered while the dialog is open, so closing it returns focus here. *@
                    @if (!instance.IsArchived)
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="OpenArchiveConfirm"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button>
                    }
                </div>
            </AuthorizeView>
        </div>
    </div>

    @if (_connectivityResult is not null)
    {
        <div class="small mb-4" style="margin-top:-20px;" role="status">
            <div style="color:@(_connectivityResult.Success ? "var(--dbt-ontrack)" : "var(--dbt-failed)")">
                @(_connectivityResult.Success
                    ? $"Reachable: connected to {_connectivityEndpointDescription} in {_connectivityResult.Elapsed.TotalMilliseconds:N0} ms."
                    : $"Not reachable: {_connectivityEndpointDescription} ({_connectivityResult.Error})")
            </div>
            <div class="text-muted">
                Checked <LocalTime Utc="_connectivityResult.CheckedAtUtc" Format="MMM d, h:mm:ss tt" ShowUtc="false" /> · timeout @_connectivityResult.Timeout.TotalSeconds s ·
                a successful TCP connection is not proof of database login, backup success or recoverability.
            </div>
        </div>
    }
    else if (_connectivityDisabledReason is not null)
    {
        <p class="small text-muted mb-4" style="margin-top:-20px;">Connectivity check unavailable: @_connectivityDisabledReason</p>
    }
    else if (!CanCheckConnectivity(instance))
    {
        @* Says why Test connection is disabled; a title on a disabled button reaches neither touch nor keyboard users. *@
        <p class="small text-muted mb-4" style="margin-top:-20px;" id="connectivity-unavailable">Test connection is off: no host, IP or connectivity override is configured.</p>
    }

    <ModalDialog Title="Confirm archive" @bind-Open="_showArchiveConfirm" CssClass="is-danger" data-testid="archive-dialog">
        @if (_archivePreview is not null)
        {
            <p class="small text-muted mb-2">What archiving <strong class="text-body">@instance.Name</strong> changes:</p>
            <ul class="small mb-3">
                @foreach (var line in _archivePreview)
                {
                    <li>@line.Text</li>
                }
            </ul>
            <fieldset class="mb-3">
                <legend class="form-label small mb-1">Why is it being archived?</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="archive-kind" id="archive-kind-mistake" data-testid="archive-kind-mistake"
                           checked="@(_archiveKind == ArchiveKind.Mistake)" @onchange="() => _archiveKind = ArchiveKind.Mistake" />
                    <label class="form-check-label small" for="archive-kind-mistake">Duplicate, or entered by mistake</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="archive-kind" id="archive-kind-retire" data-testid="archive-kind-retire"
                           checked="@(_archiveKind == ArchiveKind.Retirement)" @onchange="() => _archiveKind = ArchiveKind.Retirement" />
                    <label class="form-check-label small" for="archive-kind-retire">The database is being decommissioned or replaced</label>
                </div>
            </fieldset>
            @if (_archiveKind == ArchiveKind.Retirement)
            {
                <p class="small mb-0" role="status">
                    A decommissioned database is archived through its retirement checklist, so consumers, jobs, final backups and
                    sign-offs are checked first. <a href="/instances/@Id/retirement">Open the retirement checklist</a>.
                </p>
            }
            else if (_archiveKind == ArchiveKind.Mistake)
            {
                <div class="mb-0">
                    <label class="form-label small" for="archive-reason">Reason (required)</label>
                    <input id="archive-reason" class="form-control form-control-sm" @bind="_archiveReason" @bind:event="oninput" placeholder="Duplicate of …, test entry, …" />
                </div>
                @if (_archiveError is not null)
                {
                    <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed)">@_archiveError</p>
                }
            }
            @* Cancel stays at the far end, so the Archive button appearing beside it never moves it under the pointer. *@
            <div class="dbt-dialog-actions">
                @if (_archiveKind == ArchiveKind.Mistake)
                {
                    <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmArchive" disabled="@string.IsNullOrWhiteSpace(_archiveReason)">Archive this instance</button>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm" autofocus @onclick="() => _showArchiveConfirm = false">Cancel</button>
            </div>
        }
    </ModalDialog>

    <div class="row g-0 mb-4">
        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Health explanation</h2>
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">Last successful backup</dt>
                    <dd class="col-sm-9"><LocalTime Utc="_explanation!.LastSuccessUtc" /></dd>

                    <dt class="col-sm-3">Latest attempt</dt>
                    <dd class="col-sm-9">
                        @(_explanation.LastAttemptUtc is { } la
                            ? $"{Viewer.Format(la)}: {_explanation.LastAttemptStatus}"
                            : "No backup evidence recorded yet")
                    </dd>

                    <dt class="col-sm-3">Governing interval</dt>
                    <dd class="col-sm-9">every @_explanation.GoverningIntervalHours h</dd>

                    <dt class="col-sm-3">Next due</dt>
                    <dd class="col-sm-9"><LocalTime Utc="_explanation.NextDueUtc" Empty="No successful backup yet" /></dd>

                    @if (_explanation.OverdueBy is { } overdueBy)
                    {
                        <dt class="col-sm-3">Overdue by</dt>
                        <dd class="col-sm-9" style="color:var(--dbt-overdue)">@FormatDuration(overdueBy)</dd>
                    }

                    <dt class="col-sm-3">Alert suppression</dt>
                    <dd class="col-sm-9">
                        @if (_explanation.IsSuppressedByMaintenance)
                        {
                            <span><i class="bi bi-cone-striped" aria-hidden="true"></i> Suppressed by an active maintenance window. The health badge above still shows the real status.</span>
                        }
                        else
                        {
                            <span class="text-muted">Not suppressed</span>
                        }
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                    {
                        <dt class="col-sm-3">Scan freshness</dt>
                        <dd class="col-sm-9">
                            <span class="badge-health dot @ScannerFreshnessClass(_scannerHealth!.Freshness)">@_scannerHealth.Freshness</span>
                            @if (!string.IsNullOrWhiteSpace(_scannerHealth.RecoveryHint))
                            {
                                <div class="text-muted small mt-1">@_scannerHealth.RecoveryHint</div>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="row g-0 mb-4 kv-row">
        <div class="col-md-6">
            <div class="dbt-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="h6 text-muted mb-0">Ownership &amp; contact</h2>
                    <span class="d-inline-flex align-items-center gap-1">
                        <span class="badge-health dot @OwnershipClass(_ownershipStatus)">@_ownershipStatus</span>
                        <Toggletip Label="About ownership status" TestId="ownership-status-help">Ownership status is for personal views only. It never grants or restricts access beyond the viewer's role.</Toggletip>
                    </span>
                </div>
                <dl class="row mb-0 small">
                    <dt class="col-5">Application</dt><dd class="col-7">@instance.Application</dd>
                    <dt class="col-5">Company</dt><dd class="col-7">@instance.Company</dd>
                    <dt class="col-5">Department</dt><dd class="col-7">@instance.Department</dd>
                    <dt class="col-5">Owner team</dt><dd class="col-7">@(instance.OwnerTeam?.Name ?? "Not assigned")</dd>
                    <dt class="col-5">Contact</dt><dd class="col-7">@instance.ContactName</dd>
                    <dt class="col-5">Email</dt><dd class="col-7">@instance.ContactEmail</dd>
                    <dt class="col-5">Phone</dt><dd class="col-7">@instance.ContactPhone</dd>
                    @if (!string.IsNullOrWhiteSpace(instance.BackupContactName) || !string.IsNullOrWhiteSpace(instance.BackupContactEmail))
                    {
                        <dt class="col-5">Backup contact</dt><dd class="col-7">@instance.BackupContactName @instance.BackupContactEmail</dd>
                    }
                    @if (instance.OwnershipConfirmedAtUtc is { } confirmedAt)
                    {
                        <dt class="col-5">Confirmed</dt><dd class="col-7"><LocalTime Utc="confirmedAt" Format="MMM d, yyyy" ShowUtc="false" /> by @instance.OwnershipConfirmedBy</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(instance.Region) || !string.IsNullOrWhiteSpace(instance.Cluster) || !string.IsNullOrWhiteSpace(instance.ReplicaSet))
                    {
                        <dt class="col-5">Region / cluster / replica set</dt>
                        <dd class="col-7">@instance.Region / @instance.Cluster / @instance.ReplicaSet</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(instance.Tags))
                    {
                        <dt class="col-5">Tags</dt><dd class="col-7">@instance.Tags</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(instance.RunbookUrl))
                    {
                        <dt class="col-5">Runbook</dt><dd class="col-7"><a href="@instance.RunbookUrl" target="_blank" rel="noopener">@instance.RunbookUrl<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
                    }
                    @if (instance.AppliedPolicyId is not null)
                    {
                        <dt class="col-5">Applied policy</dt><dd class="col-7">@(instance.AppliedPolicy?.Name ?? "(deleted)") v@instance.AppliedPolicyVersion</dd>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(instance.Notes))
                {
                    <div class="text-muted small mt-2">@instance.Notes</div>
                }

                <div class="mt-3" style="border-top:1px solid var(--dbt-line);padding-top:14px;">
                    @if (!_showCorrectionForm)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _showCorrectionForm = true">
                            <i class="bi bi-flag" aria-hidden="true"></i> Request contact correction
                        </button>
                    }
                    else
                    {
                        <h3 class="h6 text-muted mb-2">Request a contact correction</h3>
                        <p class="small text-muted mb-2">Anyone can flag wrong contact details. A reviewer with edit rights applies only the fields you fill in; your request never edits the instance directly.</p>
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label class="visually-hidden" for="proposed-contact-name">Proposed contact name</label><input id="proposed-contact-name" class="form-control form-control-sm" placeholder="Proposed contact name" @bind="_proposedContactName" @bind:event="oninput" /></div>
                            <div class="col-6"><label class="visually-hidden" for="proposed-contact-email">Proposed contact email</label><input id="proposed-contact-email" class="form-control form-control-sm" placeholder="Proposed contact email" @bind="_proposedContactEmail" @bind:event="oninput" /></div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="correction-note">Why is this wrong? (required)</label>
                            <input id="correction-note" class="form-control form-control-sm" @bind="_correctionNote" @bind:event="oninput" />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="SubmitCorrectionRequest" disabled="@(!CanSubmitCorrection())">Submit request</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _showCorrectionForm = false">Cancel</button>
                        </div>
                    }
                </div>

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    @if (_pendingCorrections.Count > 0)
                    {
                        <div class="mt-3" style="border-top:1px solid var(--dbt-line);padding-top:14px;">
                            <h3 class="h6 text-muted mb-2">Pending correction request(s)</h3>
                            @foreach (var req in _pendingCorrections)
                            {
                                <div class="small mb-2">
                                    <div>Requested by @req.RequestedByName on <LocalTime Utc="req.RequestedAtUtc" Format="MMM d, h:mm tt" ShowUtc="false" /></div>
                                    <div class="text-muted">"@req.Note"</div>
                                    @if (!string.IsNullOrWhiteSpace(req.ProposedContactName)) { <div>Proposed name: @req.ProposedContactName</div> }
                                    @if (!string.IsNullOrWhiteSpace(req.ProposedContactEmail)) { <div>Proposed email: @req.ProposedContactEmail</div> }
                                    <div class="d-flex gap-2 mt-1">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ApproveCorrection(req.Id)">Approve</button>
                                        <button type="button" class="btn btn-link btn-sm text-danger" @onclick="() => RejectCorrection(req.Id)">Reject</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </AuthorizeView>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Topology &amp; backup evidence</h2>
                <dl class="row mb-0 small">
                    <dt class="col-5">Database IP</dt><dd class="col-7">@instance.DatabaseIp</dd>
                    <dt class="col-5">Server IP</dt><dd class="col-7">@instance.ServerIp</dd>
                    <dt class="col-5">Expected cadence</dt><dd class="col-7">every @instance.ExpectedBackupIntervalHours h</dd>
                    @if (instance.RetentionPolicyDays is not null)
                    {
                        <dt class="col-5">Retention policy</dt><dd class="col-7">@instance.RetentionPolicyDays days</dd>
                    }
                    <dt class="col-5">Last successful backup</dt>
                    <dd class="col-7"><LocalTime Utc="_overview.LastBackupUtc" ShowUtc="false" /></dd>
                    <dt class="col-5">Restore-test coverage</dt>
                    <dd class="col-7">
                        <span class="badge-health dot @RecencyClass(_restoreTestRecency!.Status)">@RecencyLabel(_restoreTestRecency.Status)</span>
                        @if (_restoreTestRecency.NextDueUtc is { } nextDue)
                        {
                            <span class="text-muted small ms-1">next due <LocalTime Utc="nextDue" Format="MMM d, yyyy" ShowUtc="false" /></span>
                        }
                        <span class="text-muted small ms-1">(every @_effectiveRestoreTestIntervalDays d@(instance.RestoreTestIntervalDaysOverride is null ? ", default" : ", override"))</span>
                    </dd>
                    <dt class="col-5">Backup file location</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(instance.BackupFileLocation) ? "Not configured" : instance.BackupFileLocation)</dd>
                    @if (!string.IsNullOrWhiteSpace(instance.BackupFileLocation))
                    {
                        <dt class="col-5">Last scanned</dt>
                        <dd class="col-7">
                            @if (instance.LastScanUtc is null)
                            {
                                <span class="text-muted">Never scanned</span>
                            }
                            else
                            {
                                <span><LocalTime Utc="instance.LastScanUtc" Format="MMM d, h:mm tt" ShowUtc="false" /></span>
                                <span class="badge-health dot @ScannerFreshnessClass(_scannerHealth!.Freshness) ms-1">@_scannerHealth.Freshness</span>
                                @if (instance.LastScanStatus == ScanStatus.Error)
                                {
                                    <div class="text-danger small mt-1">@instance.LastScanError</div>
                                }
                            }
                        </dd>
                        <dt class="col-5">Name pattern(s)</dt>
                        <dd class="col-7">@(string.IsNullOrWhiteSpace(instance.BackupFileNamePatterns) ? "All files" : instance.BackupFileNamePatterns)</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="row g-0 mb-4" style="border-top:1px solid var(--dbt-line);padding-top:28px;">
        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Maintenance window</h2>
                @if (instance.MaintenanceUntilUtc is { } activeUntil && activeUntil > DateTime.UtcNow)
                {
                    <p class="mb-2"><span class="badge-health dot Overdue">Under maintenance</span> until <LocalTime Utc="activeUntil" Format="MMM d, yyyy h:mm tt" ShowUtc="false" />. Overdue/Failed email and webhook alerts are suppressed.</p>
                    @if (!string.IsNullOrWhiteSpace(instance.MaintenanceReason))
                    {
                        <p class="text-muted small mb-2">@instance.MaintenanceReason</p>
                    }
                    <AuthorizeView Roles="@Roles.CanEditPolicy">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="EndMaintenance">End maintenance now</button>
                    </AuthorizeView>
                }
                else
                {
                    <AuthorizeView Roles="@Roles.CanEditPolicy">
                        <Authorized>
                            <div class="d-flex gap-2 align-items-end flex-wrap mb-2" role="group" aria-label="Start a maintenance window">
                                <div class="field" style="min-width:240px">
                                    <label class="form-label small" for="maintenance-reason">Reason</label>
                                    <input id="maintenance-reason" class="form-control form-control-sm" @bind="_maintenanceReason" placeholder="Planned patching, migration, …" />
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => StartMaintenance(1)">1 h</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => StartMaintenance(4)">4 h</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => StartMaintenance(24)">24 h</button>
                            </div>
                            <div class="form-text">Suppresses Overdue/Failed alerts for the chosen window. The health badge above still shows the real status.</div>
                        </Authorized>
                        <NotAuthorized>
                            <p class="text-muted small mb-0">No maintenance window active.</p>
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </div>
        </div>
    </div>

    @if (_openIncident is not null)
    {
        <div class="row g-0 mb-4" style="border-top:1px solid var(--dbt-line);padding-top:28px;">
            <div class="col-12">
                <div class="dbt-card">
                    <h2 class="h6 text-muted mb-3">Open incident</h2>
                    <p class="small text-muted mb-2">
                        Opened <LocalTime Utc="_openIncident.OpenedAtUtc" Format="MMM d, h:mm tt" ShowUtc="false" /> on @_openIncident.TriggerHealth.
                        @if (_openIncident.EscalationLevel > 0)
                        {
                            <span style="color:var(--dbt-failed)"> Escalated @_openIncident.EscalationLevel time(s), last <LocalTime Utc="_openIncident.LastEscalatedAtUtc" Format="MMM d, h:mm tt" ShowUtc="false" />.</span>
                        }
                    </p>
                    @if (_openIncident.AcknowledgedAtUtc is { } ackAt)
                    {
                        <p class="mb-2"><span class="badge-health dot OnTrack">Acknowledged</span> by @_openIncident.AcknowledgedBy on <LocalTime Utc="ackAt" Format="MMM d, h:mm tt" ShowUtc="false" />. Escalation stopped. <span class="text-muted">Acknowledgement is a response record only; it never changes the health badge above.</span></p>
                        @if (!string.IsNullOrWhiteSpace(_openIncident.Note))
                        {
                            <p class="small mb-1"><strong>Note:</strong> @_openIncident.Note</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_openIncident.TicketReference))
                        {
                            <p class="small mb-0"><strong>Ticket:</strong> @_openIncident.TicketReference</p>
                        }
                    }
                    else
                    {
                        <p class="mb-2"><span class="badge-health dot Overdue">Unacknowledged</span>. It keeps escalating until someone acknowledges it.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openIncident.AssigneeName))
                    {
                        <p class="small mb-2"><strong>Assigned to:</strong> @_openIncident.AssigneeName</p>
                    }
                    <AuthorizeView Roles="@Roles.CanEditPolicy">
                        <Authorized>
                            <div class="d-flex gap-2 align-items-end flex-wrap mb-2">
                                <div class="field" style="min-width:160px"><label class="form-label small" for="incident-assignee">Assignee</label><input id="incident-assignee" class="form-control form-control-sm" @bind="_assigneeName" /></div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AssignIncident">Assign</button>
                            </div>
                            @if (_openIncident.AcknowledgedAtUtc is null)
                            {
                                <div class="d-flex gap-2 align-items-end flex-wrap">
                                    <div class="field" style="min-width:200px"><label class="form-label small" for="incident-note">Note / runbook</label><input id="incident-note" class="form-control form-control-sm" @bind="_ackNote" /></div>
                                    <div class="field" style="min-width:140px"><label class="form-label small" for="incident-ticket">Ticket ref</label><input id="incident-ticket" class="form-control form-control-sm" @bind="_ackTicket" /></div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AcknowledgeIncident">Acknowledge</button>
                                </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    }

    <div class="row g-0 mb-4 kv-row">
        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="backupAuth">
            <Authorized>
                <div class="col-md-5">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted mb-3">Log a backup result</h2>
                        <EditForm Model="_newRecord" OnValidSubmit="LogBackup">
                            <div class="mb-2">
                                <label class="form-label small" for="backup-occurred">Occurred at (@EntryZoneLabel(_backupEntryZone))</label>
                                <div class="d-flex gap-1">
                                    <input id="backup-occurred" type="datetime-local" class="form-control form-control-sm" @bind="_newRecordOccurredLocal" aria-describedby="backup-occurred-help" />
                                    <label class="visually-hidden" for="backup-occurred-zone">Time zone of the occurrence time</label>
                                    <select id="backup-occurred-zone" data-testid="backup-occurred-zone" class="form-select form-select-sm" style="max-width:150px;" @bind="_backupEntryZone">
                                        <option value="viewer">Your time zone</option>
                                        <option value="UTC">UTC</option>
                                    </select>
                                </div>
                                <div class="form-text" id="backup-occurred-help">Defaults to now. Set an earlier time when logging a backup after the fact; future times are rejected. The zone is stored with the entry.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="backup-type">Type</label>
                                <InputSelect id="backup-type" class="form-select form-select-sm" @bind-Value="_newRecord.Type">
                                    @foreach (var t in Enum.GetValues<BackupType>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="backup-chain-role">Backup-chain role</label>
                                <InputSelect id="backup-chain-role" class="form-select form-select-sm" @bind-Value="_newRecord.ChainRole" aria-describedby="backup-chain-role-help" data-testid="backup-chain-role">
                                    <option value="">Same as type</option>
                                    @foreach (var m in Enum.GetValues<ChainMemberType>())
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </InputSelect>
                                <div class="form-text" id="backup-chain-role-help">Set this for a WAL archive, binlog or archival copy, which the type list can't express. It counts toward the recovery page's chain coverage.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="backup-status">Status</label>
                                <InputSelect id="backup-status" class="form-select form-select-sm" @bind-Value="_newRecord.Status">
                                    @foreach (var s in Enum.GetValues<BackupStatus>())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small" for="backup-size">Size (MB)</label>
                                    <InputNumber id="backup-size" class="form-control form-control-sm" @bind-Value="_newRecord.SizeMb" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small" for="backup-duration">Duration (min)</label>
                                    <InputNumber id="backup-duration" class="form-control form-control-sm" @bind-Value="_newRecord.DurationMinutes" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small" for="backup-notes">Notes</label>
                                <InputTextArea id="backup-notes" class="form-control form-control-sm" rows="2" @bind-Value="_newRecord.Notes" />
                            </div>
                            @if (!string.IsNullOrEmpty(_backupFormError))
                            {
                                <div class="text-danger small mb-2" role="alert">@_backupFormError</div>
                            }
                            <button type="submit" class="btn btn-primary btn-sm">Log backup</button>
                        </EditForm>

                        <div class="mt-4" style="border-top:1px solid var(--dbt-line);padding-top:16px;">
                            <h2 class="h6 text-muted mb-2">Correct a backup entry</h2>
                            <p class="text-muted small mb-2">The original entry is kept. The correction is recorded alongside it, never written over it.</p>
                            <div class="mb-2">
                                <label class="visually-hidden" for="backup-correct-target">Backup entry to correct</label>
                                <select id="backup-correct-target" class="form-select form-select-sm" @bind="_correctingBackupId" @bind:after="OnBackupCorrectionTargetChanged">
                                    <option value="0">Select an entry…</option>
                                    @foreach (var r in instance.BackupRecords.OrderByDescending(r => r.TimestampUtc))
                                    {
                                        <option value="@r.Id">@Viewer.Format(r.TimestampUtc, "MMM d, h:mm tt"): @r.Status</option>
                                    }
                                </select>
                            </div>
                            @if (_correctingBackupId != 0)
                            {
                                <div class="mb-2">
                                    <label class="form-label small" for="backup-correct-status">New status</label>
                                    <InputSelect id="backup-correct-status" class="form-select form-select-sm" @bind-Value="_correctedBackupStatus">
                                        @foreach (var s in Enum.GetValues<BackupStatus>())
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="backup-correct-notes">New notes</label>
                                    <InputTextArea id="backup-correct-notes" class="form-control form-control-sm" rows="2" @bind-Value="_correctedBackupNotes" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="backup-correct-reason">Reason (required)</label>
                                    <input id="backup-correct-reason" class="form-control form-control-sm" @bind="_correctionReason" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SubmitBackupCorrection" disabled="@string.IsNullOrWhiteSpace(_correctionReason)">Save correction</button>
                            }
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="col-md-7">
            <div class="dbt-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 text-muted mb-0">Backup history</h2>
                    @if (instance.BackupRecords.Count > 0)
                    {
                        <label class="visually-hidden" for="backup-history-filter">Filter backup history by status</label>
                        <select id="backup-history-filter" class="form-select form-select-sm" style="max-width:150px;" @bind="_backupStatusFilter" @bind:after="() => _backupPage = 1">
                            <option value="">All statuses</option>
                            @foreach (var s in Enum.GetValues<BackupStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    }
                </div>
                @if (!instance.BackupRecords.Any())
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                        No backup history recorded yet.
                        <AuthorizeView Roles="@Roles.CanEditPolicy">
                            <span>Log a backup result@(string.IsNullOrWhiteSpace(instance.BackupFileLocation) ? "" : " or run Scan now") to start one.</span>
                        </AuthorizeView>
                    </div>
                }
                else
                {
                    <div class="table-responsive" role="region" aria-label="Backup history" tabindex="0">
                    <table class="table table-sm mb-0 dbt-table">
                        <thead>
                            <tr><th scope="col">When</th><th scope="col">Entered</th><th scope="col">By</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Size</th><th scope="col">Duration</th><th scope="col">Evidence <Toggletip Label="About evidence levels" TestId="backup-evidence-help"><EvidenceLevelsHelp /></Toggletip></th><th scope="col">File</th><th scope="col">Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in BackupHistoryPage())
                            {
                                var evidence = BackupEvidenceClassifier.Classify(r, instance.RestoreEvents.ToList());
                                var effectiveStatus = EvidenceCorrectionResolver.EffectiveStatus(r, _backupCorrections);
                                var effectiveNotes = EvidenceCorrectionResolver.EffectiveNotes(r, _backupCorrections);
                                var wasCorrected = _backupCorrections.Any(c => c.BackupRecordId == r.Id);
                                <tr>
                                    <td class="small"><LocalTime Utc="r.TimestampUtc" Format="MMM d, h:mm tt" ShowUtc="false" />@EnteredZoneNote(r.OccurredTimeZone)</td>
                                    <td class="small text-muted"><LocalTime Utc="r.CreatedAtUtc" Format="MMM d, h:mm tt" ShowUtc="false" /></td>
                                    <td class="small text-muted">@RecordedByText(r.RecordedByUserName, r.Source)</td>
                                    <td class="small">@r.Type</td>
                                    <td>
                                        <span class="badge-health dot @StatusClass(effectiveStatus)">@effectiveStatus</span>
                                        @if (wasCorrected)
                                        {
                                            <span class="text-muted small" title="This entry has one or more append-only corrections.">(corrected)</span>
                                        }
                                    </td>
                                    <td class="small">@(r.SizeMb is null ? "Not recorded" : $"{r.SizeMb:N0} MB")</td>
                                    <td class="small">@(r.DurationMinutes is null ? "Not recorded" : $"{r.DurationMinutes:N0} min")</td>
                                    <td class="small">
                                        @if (evidence is { } level)
                                        {
                                            <span class="badge-health dot @EvidenceClass(level)">@BackupEvidenceClassifier.Describe(level)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(r.SourceFile) ? "None" : r.SourceFile)</td>
                                    <td class="small text-muted">@effectiveNotes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @if (!BackupHistoryFiltered().Any())
                    {
                        <div class="text-muted small py-2">No backup records match this filter.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="small text-muted">Page @_backupPage of @BackupHistoryTotalPages()</span>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Previous page of backup history" disabled="@(_backupPage <= 1)" @onclick="() => _backupPage--">Prev</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Next page of backup history" disabled="@(_backupPage >= BackupHistoryTotalPages())" @onclick="() => _backupPage++">Next</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="row g-0 kv-row">
        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="restoreAuth">
            <Authorized>
                <div class="col-md-5">
                    <div class="dbt-card">
                        <h2 class="h6 text-muted mb-3">Log a restore</h2>
                        <EditForm Model="_newRestore" OnValidSubmit="LogRestore">
                            <div class="mb-2">
                                <label class="form-label small" for="restore-occurred">Occurred at (@EntryZoneLabel(_restoreEntryZone))</label>
                                <div class="d-flex gap-1">
                                    <input id="restore-occurred" type="datetime-local" class="form-control form-control-sm" @bind="_newRestoreOccurredLocal" aria-describedby="restore-occurred-help" />
                                    <label class="visually-hidden" for="restore-occurred-zone">Time zone of the occurrence time</label>
                                    <select id="restore-occurred-zone" data-testid="restore-occurred-zone" class="form-select form-select-sm" style="max-width:150px;" @bind="_restoreEntryZone">
                                        <option value="viewer">Your time zone</option>
                                        <option value="UTC">UTC</option>
                                    </select>
                                </div>
                                <div class="form-text" id="restore-occurred-help">Defaults to now. Set an earlier time when logging a restore after an incident; future times are rejected. The zone is stored with the entry.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="restore-performed-by">Performed by</label>
                                <InputText id="restore-performed-by" class="form-control form-control-sm" @bind-Value="_newRestore.PerformedBy" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small" for="restore-reason">Reason</label>
                                    <InputSelect id="restore-reason" class="form-select form-select-sm" @bind-Value="_newRestore.Reason">
                                        @foreach (var r in Enum.GetValues<RestoreReason>())
                                        {
                                            <option value="@r">@r</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small" for="restore-outcome">Outcome</label>
                                    <InputSelect id="restore-outcome" class="form-select form-select-sm" @bind-Value="_newRestore.Outcome">
                                        @foreach (var o in Enum.GetValues<RestoreOutcome>())
                                        {
                                            <option value="@o">@o</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="restore-linked-backup">Backup evidence this proves (optional)</label>
                                <InputSelect id="restore-linked-backup" class="form-select form-select-sm" @bind-Value="_newRestoreLinkedBackupId" aria-describedby="restore-linked-help">
                                    <option value="0">Unknown / not linked</option>
                                    @foreach (var r in instance.BackupRecords.OrderByDescending(r => r.TimestampUtc))
                                    {
                                        <option value="@r.Id">@Viewer.Format(r.TimestampUtc, "MMM d, h:mm tt"): @r.Status</option>
                                    }
                                </InputSelect>
                                <div class="form-text" id="restore-linked-help">Leave as Unknown if you're not sure. DBTracker never assumes every backup was tested.</div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small" for="restore-duration">Duration (min)</label>
                                    <InputNumber id="restore-duration" class="form-control form-control-sm" @bind-Value="_newRestore.DurationMinutes" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small" for="restore-target-rto">Target recovery time (min)</label>
                                    <InputNumber id="restore-target-rto" class="form-control form-control-sm" @bind-Value="_newRestore.TargetRecoveryTimeMinutes" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="restore-evidence-ref">Evidence reference (optional)</label>
                                <InputText id="restore-evidence-ref" data-testid="restore-evidence-ref" class="form-control form-control-sm" @bind-Value="_newRestore.EvidenceReference" aria-describedby="restore-evidence-ref-help" />
                                <div class="form-text" id="restore-evidence-ref-help">Ticket, change record or report link that proves this restore. Up to 500 characters.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small" for="restore-notes">Notes</label>
                                <InputTextArea id="restore-notes" class="form-control form-control-sm" rows="2" @bind-Value="_newRestore.Notes" />
                            </div>
                            @if (!string.IsNullOrEmpty(_restoreFormError))
                            {
                                <div class="text-danger small mb-2" role="alert">@_restoreFormError</div>
                            }
                            <button type="submit" class="btn btn-primary btn-sm">Log restore</button>
                        </EditForm>

                        <div class="mt-4" style="border-top:1px solid var(--dbt-line);padding-top:16px;">
                            <h2 class="h6 text-muted mb-2">Correct a restore entry</h2>
                            <p class="text-muted small mb-2">The original entry is kept. The correction is recorded alongside it, never written over it.</p>
                            <div class="mb-2">
                                <label class="visually-hidden" for="restore-correct-target">Restore entry to correct</label>
                                <select id="restore-correct-target" class="form-select form-select-sm" @bind="_correctingRestoreId" @bind:after="OnRestoreCorrectionTargetChanged">
                                    <option value="0">Select an entry…</option>
                                    @foreach (var r in instance.RestoreEvents.OrderByDescending(r => r.TimestampUtc))
                                    {
                                        <option value="@r.Id">@Viewer.Format(r.TimestampUtc, "MMM d, h:mm tt"): @r.Outcome</option>
                                    }
                                </select>
                            </div>
                            @if (_correctingRestoreId != 0)
                            {
                                <div class="mb-2">
                                    <label class="form-label small" for="restore-correct-outcome">New outcome</label>
                                    <InputSelect id="restore-correct-outcome" class="form-select form-select-sm" @bind-Value="_correctedRestoreOutcome">
                                        @foreach (var o in Enum.GetValues<RestoreOutcome>())
                                        {
                                            <option value="@o">@o</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="restore-correct-notes">New notes</label>
                                    <InputTextArea id="restore-correct-notes" class="form-control form-control-sm" rows="2" @bind-Value="_correctedRestoreNotes" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="restore-correct-reason">Reason (required)</label>
                                    <input id="restore-correct-reason" class="form-control form-control-sm" @bind="_correctionReasonRestore" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SubmitRestoreCorrection" disabled="@string.IsNullOrWhiteSpace(_correctionReasonRestore)">Save correction</button>
                            }
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="col-md-7">
            <div class="dbt-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 text-muted mb-0">Restore history</h2>
                    @if (instance.RestoreEvents.Count > 0)
                    {
                        <label class="visually-hidden" for="restore-history-filter">Filter restore history by outcome</label>
                        <select id="restore-history-filter" class="form-select form-select-sm" style="max-width:150px;" @bind="_restoreOutcomeFilter" @bind:after="() => _restorePage = 1">
                            <option value="">All outcomes</option>
                            @foreach (var o in Enum.GetValues<RestoreOutcome>())
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    }
                </div>
                @if (!instance.RestoreEvents.Any())
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        No restore ever logged, so these backups have never been proven recoverable.
                    </div>
                }
                else
                {
                    <div class="table-responsive" role="region" aria-label="Restore history" tabindex="0">
                    <table class="table table-sm mb-0 dbt-table">
                        <thead>
                            <tr><th scope="col">When</th><th scope="col">By</th><th scope="col">Entered by</th><th scope="col">Reason</th><th scope="col">Outcome</th><th scope="col">Linked evidence</th><th scope="col">Evidence reference</th><th scope="col">Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in RestoreHistoryPage())
                            {
                                var effectiveOutcome = EvidenceCorrectionResolver.EffectiveOutcome(r, _restoreCorrections);
                                var effectiveNotes = EvidenceCorrectionResolver.EffectiveNotes(r, _restoreCorrections);
                                var wasCorrected = _restoreCorrections.Any(c => c.RestoreEventId == r.Id);
                                var linked = instance.BackupRecords.FirstOrDefault(b => b.Id == r.LinkedBackupRecordId);
                                <tr>
                                    <td class="small"><LocalTime Utc="r.TimestampUtc" Format="MMM d, h:mm tt" ShowUtc="false" />@EnteredZoneNote(r.OccurredTimeZone)</td>
                                    <td class="small">@r.PerformedBy</td>
                                    <td class="small text-muted">@RecordedByText(r.RecordedByUserName, r.Source)</td>
                                    <td class="small">@r.Reason</td>
                                    <td>
                                        <span class="badge-health dot @(effectiveOutcome == RestoreOutcome.Success ? "OnTrack" : "Failed")">@effectiveOutcome</span>
                                        @if (r.Source == BackupSource.Imported)
                                        {
                                            <span class="text-muted small" title="Loaded from a history import. Shown for context; it never counts as restore-test evidence.">(imported, not counted)</span>
                                        }
                                        @if (wasCorrected)
                                        {
                                            <span class="text-muted small" title="This entry has one or more append-only corrections.">(corrected)</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@if (linked is null) { <span>Unknown</span> } else { <LocalTime Utc="linked.TimestampUtc" Format="MMM d, h:mm tt" ShowUtc="false" /> }</td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(r.EvidenceReference) ? "None" : r.EvidenceReference)</td>
                                    <td class="small text-muted">@effectiveNotes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @if (!RestoreHistoryFiltered().Any())
                    {
                        <div class="text-muted small py-2">No restore events match this filter.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="small text-muted">Page @_restorePage of @RestoreHistoryTotalPages()</span>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Previous page of restore history" disabled="@(_restorePage <= 1)" @onclick="() => _restorePage--">Prev</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Next page of restore history" disabled="@(_restorePage >= RestoreHistoryTotalPages())" @onclick="() => _restorePage++">Next</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="row g-0" style="border-top:1px solid var(--dbt-line);padding-top:28px;margin-top:28px;">
        <div class="col-12">
            <div class="dbt-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 text-muted mb-0">Change history</h2>
