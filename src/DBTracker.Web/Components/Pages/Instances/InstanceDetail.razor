                        <input id="change-log-filter" type="search" class="form-control form-control-sm" style="max-width:180px;" placeholder="Filter by field…" @bind="_changeLogFieldFilter" @bind:event="oninput" @bind:after="() => _changeLogPage = 1" />
                    }
                </div>
                @if (_changeLog.Count == 0)
                {
                    <div class="empty-state py-3">
                        <i class="bi bi-journal-text" aria-hidden="true"></i>
