    private async Task ScanNow()
    {
        _scanning = true;
        var result = await Scanner.ScanAsync(Id);
        _scanning = false;

        if (result.Outcome == ScanOutcome.Success)
        {
            Toasts.Success(result.FilesDiscovered switch
            {
                0 => "Scan complete — no new files found.",
                1 => "Scan complete — 1 new backup file found.",
                _ => $"Scan complete — {result.FilesDiscovered} new backup files found."
            });
        }
        else if (result.Outcome == ScanOutcome.Error)
        {
            Toasts.Error($"Scan failed: {result.ErrorMessage}");
        }

        Db.ChangeTracker.Clear();
        await Load();
    }

