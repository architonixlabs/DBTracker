@page "/instances/import"
@attribute [Authorize(Roles = Roles.CanEditPolicy)]
@inject DBTrackerDbContext Db
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IJSRuntime JS
@inject AuditRecorder Audit
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Import instances · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Import database instances</h1>
        <div class="subtitle">Onboard many databases from one CSV file. Re-importing the same file updates existing instances by name instead of duplicating them.</div>
    </div>
    <button type="button" class="btn btn-outline-secondary" @onclick="DownloadTemplate">
        <i class="bi bi-download" aria-hidden="true"></i> Download CSV template
    </button>
</div>

<div class="dbt-card" style="max-width: 900px;">
    <h2 class="h6 text-muted text-uppercase mb-3">File</h2>
    <p class="text-muted small mb-3" id="import-file-help">
        The first row must be a header. Only the <strong>Name</strong> and <strong>Engine</strong> columns are required.
        Rows are matched to the existing inventory by Name, ignoring case: a matching name updates that instance,
        a new name creates one. Quoted fields may contain commas and line breaks. Maximum file size is 2 MB.
    </p>
    <label class="form-label small" for="import-file">CSV file</label>
    <InputFile id="import-file" OnChange="OnFileSelected" class="form-control" accept=".csv" aria-describedby="import-file-help" disabled="@_parsing" />

    @if (_parsing)
    {
        <p class="text-muted small mt-2 mb-0" role="status">Reading @_fileName…</p>
    }
    else if (_fileError is not null)
    {
        <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed);">@_fileError</p>
    }
    else if (_fileName is not null)
    {
        <p class="text-muted small mt-2 mb-0">@_fileName</p>
    }
</div>

@if (_preview is not null)
{
    <div class="dbt-card mt-4">
        <h2 class="h6 text-muted text-uppercase mb-3">Preview</h2>

        <p class="mb-3">
            <span style="color:var(--dbt-ontrack)">@_preview.CreateCount create</span>,
            <span style="color:var(--dbt-overdue)">@_preview.UpdateCount update</span>,
            <span class="text-muted">@_preview.SkipCount unchanged (skip)</span>
            @if (_preview.AmbiguousCount > 0)
            {
                <span>, <span style="color:var(--dbt-failed)">@_preview.AmbiguousCount ambiguous (not imported)</span></span>
            }
            @if (_preview.Errors.Count > 0)
            {
                <span>, <span style="color:var(--dbt-failed)">@_preview.Errors.Count row(s) with errors (skipped)</span></span>
            }
        </p>

        @if (_preview.Errors.Count > 0)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Fix these rows and upload the file again. Valid rows are not affected.</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DownloadErrors"><i class="bi bi-download" aria-hidden="true"></i> Download error rows (CSV)</button>
            </div>
            <div class="dbt-table mb-4">
                <table class="table" aria-label="Rows with errors">
                    <thead><tr><th scope="col">Row</th><th scope="col">Error</th></tr></thead>
                    <tbody>
                        @foreach (var e in _preview.Errors)
                        {
                            <tr><td>@e.RowNumber</td><td class="text-danger">@e.Message</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_preview.Rows.Count > 0)
        {
            <div class="dbt-table mb-4">
                <table class="table" aria-label="Import plan per row">
                    <thead><tr><th scope="col">Row</th><th scope="col">Plan</th><th scope="col">Name</th><th scope="col">Engine</th><th scope="col">Detail</th></tr></thead>
                    <tbody>
                        @foreach (var row in _preview.Rows.Take(100))
                        {
                            <tr>
                                <td class="small">@row.RowNumber</td>
                                <td><span class="badge-health dot @PlanClass(row.Plan)">@row.Plan</span></td>
                                <td class="small">@(row.Instance?.Name ?? "(no name)")</td>
                                <td class="small">@row.Instance?.Engine</td>
                                <td class="small text-muted">@row.AmbiguityReason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_preview.Rows.Count > 100)
            {
                <p class="text-muted small">…and @(_preview.Rows.Count - 100) more.</p>
            }

            @if (_importError is not null)
            {
                <p class="small" role="alert" style="color:var(--dbt-failed);">@_importError</p>
            }
            <button type="button" class="btn btn-primary" @onclick="Import" disabled="@(_importing || (_preview.CreateCount + _preview.UpdateCount) == 0)">
                <i class="bi bi-upload" aria-hidden="true"></i> @(_importing ? "Importing…" : $"Apply {_preview.CreateCount} create / {_preview.UpdateCount} update")
            </button>
        }
    </div>
}

@code {
    private string? _fileName;
    private ImportPreviewResult? _preview;
    private bool _importing, _parsing;
    private string? _fileError, _importError;
    private const long MaxFileBytes = 2 * 1024 * 1024;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _preview = null;
        _fileError = null;
        _importError = null;
        _fileName = e.File.Name;

        if (e.File.Size > MaxFileBytes)
        {
            _fileError = $"{e.File.Name} is larger than 2 MB. Split it into smaller files and import each one.";
            return;
        }

        _parsing = true;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: MaxFileBytes);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var existingByName = await Db.DatabaseInstances
                .AsNoTracking()
                .ToDictionaryAsync(i => i.Name, i => i, StringComparer.OrdinalIgnoreCase);

            _preview = InstanceCsvImporter.ParseForImport(content, existingByName);
        }
        catch (Exception)
        {
            _fileError = $"Couldn't read {e.File.Name}. Check that it is a UTF-8 CSV file and try again.";
        }
        finally
        {
            _parsing = false;
        }
    }

    private async Task Import()
    {
        if (_preview is null)
        {
            return;
        }

        _importing = true;
        var now = DateTime.UtcNow;
        var creates = 0;
        var updates = 0;

        foreach (var row in _preview.Rows)
        {
            if (row.Instance is null)
            {
                continue;
            }

            if (row.Plan == ImportRowPlan.Create)
            {
                row.Instance.CreatedAtUtc = now;
                row.Instance.UpdatedAtUtc = now;
                Db.DatabaseInstances.Add(row.Instance);
                creates++;
            }
            else if (row.Plan == ImportRowPlan.Update)
            {
                row.Instance.UpdatedAtUtc = now;
                Db.DatabaseInstances.Update(row.Instance);
                updates++;
            }
            // Skip and Ambiguous rows are never written.
        }

        try
        {
            await Db.SaveChangesAsync();
        }
        catch (Exception)
        {
            Db.ChangeTracker.Clear();
            _importing = false;
            _importError = "The import failed and nothing was saved. Reload the file to rebuild the preview, then try again.";
            return;
        }
        Db.ChangeTracker.Clear();

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        var userName = state.User.Identity?.Name ?? "unknown";
        await Audit.RecordUserActionAsync(userId, userName, "InstancesCsvImported", "CsvImport", "", $"{_fileName}",
            reason: $"{creates} created, {updates} updated, {_preview.SkipCount} unchanged, {_preview.AmbiguousCount} ambiguous, {_preview.Errors.Count} error row(s)");

        _importing = false;
        Toasts.Success($"Import complete: {creates} created, {updates} updated.");
        Nav.NavigateTo("/instances");
    }

    private async Task DownloadTemplate() =>
        await JS.InvokeVoidAsync("dbtracker.downloadCsv", "dbtracker-import-template.csv", InstanceCsvImporter.TemplateCsv());

    private async Task DownloadErrors()
    {
        if (_preview is null || _preview.Errors.Count == 0)
        {
            return;
        }

        var csv = new System.Text.StringBuilder("Row,Error\n");
        foreach (var e in _preview.Errors)
        {
            csv.AppendLine($"{e.RowNumber},\"{e.Message.Replace("\"", "\"\"")}\"");
        }
        await JS.InvokeVoidAsync("dbtracker.downloadCsv", "dbtracker-import-errors.csv", csv.ToString());
    }

    private static string PlanClass(ImportRowPlan plan) => plan switch
    {
        ImportRowPlan.Create => "OnTrack",
        ImportRowPlan.Update => "Overdue",
        ImportRowPlan.Skip => "NeverBackedUp",
        _ => "Failed"
    };
}
