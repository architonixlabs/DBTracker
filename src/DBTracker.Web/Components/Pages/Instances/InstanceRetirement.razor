@page "/instances/{Id:int}/retirement"
@attribute [Authorize]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.Identity
@using DBTracker.Infrastructure.Queries
@using DBTracker.Infrastructure.Retirement
@using Microsoft.AspNetCore.Components.Authorization
@inject InstanceOverviewService OverviewService
@inject RetirementChecklistService Checklists
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@(_instance?.Name ?? "Instance") retirement checklist · DBTracker</PageTitle>

@if (_loadFailed)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Couldn't load the retirement checklist. The database may be unreachable.</div>
        <button type="button" class="btn btn-outline-secondary" @onclick="Retry">Try again</button>
    </div>
}
else if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading retirement checklist…</span></div>
}
else if (_instance is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i class="bi bi-question-diamond" aria-hidden="true"></i> Instance #@Id doesn't exist.</div>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
    </div>
}
else if (_instance.IsArchived)
{
    <div class="dbt-card" style="max-width:700px;">
        <div class="empty-state py-4"><i class="bi bi-door-closed" aria-hidden="true"></i> @_instance.Name is already archived or retired.</div>
        <a class="btn btn-outline-secondary" href="/instances/@Id">Back to instance detail</a>
    </div>
}
else if (_view is null)
{
    <div class="dbt-card" style="max-width:700px;">
        <h1 class="h5">@_instance.Name: retirement</h1>
        <p class="small text-muted">
            No retirement checklist is open. Start one when this database is being decommissioned or replaced. Its gates
            (consumers moved, jobs removed, final backup kept, rollback window closed, legal hold, sign-offs, cost review)
            must pass before it is archived, and a plain archive is refused while the checklist is open.
        </p>
        <div class="d-flex gap-2 flex-wrap">
            <AuthorizeView Roles="@Roles.CanEditPolicy">
                <button type="button" class="btn btn-primary btn-sm" @onclick="StartChecklist" data-testid="start-retirement-checklist">Start retirement checklist</button>
            </AuthorizeView>
            <a class="btn btn-outline-secondary btn-sm" href="/instances/@Id">Back to instance detail</a>
        </div>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <h1>@_instance.Name: retirement checklist #@_view.Checklist.Id</h1>
            <div class="subtitle">
                <a href="/instances/@Id">Back to instance detail</a> ·
                Archive only after every gate passes, or while a scoped exception targeting
                <code>RetirementChecklist #@_view.Checklist.Id</code> is Active. Completing retirement uses the normal archive action, so archive history and unarchive still work.
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Gates</h2>
                <table class="table table-sm dbt-table mb-0" data-testid="retirement-gate-table" aria-label="Retirement gates">
                    <thead><tr><th scope="col">Gate</th><th scope="col">Status</th><th scope="col">Detail</th></tr></thead>
                    <tbody>
                        @foreach (var gate in _view.Evaluation.Gates)
                        {
                            <tr data-testid="retirement-gate-row">
                                <td class="small">@gate.Label</td>
                                <td class="small"><span class="badge-health dot @GateCssClass(gate.Status)" data-testid="retirement-gate-status">@gate.Status</span></td>
                                <td class="small">@gate.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3" data-testid="retirement-overall-status">
                    @if (_view.Evaluation.AllGatesSatisfied)
                    {
                        <span class="badge-health dot OnTrack">All gates satisfied</span>
                    }
                    else if (_view.HasActiveException)
                    {
                        <span class="badge-health dot Overdue">Blocked, but a scoped exception is Active</span>
                    }
                    else
                    {
                        <span class="badge-health dot Failed">Blocked</span>
                        <ul class="small text-muted mt-2 mb-0" data-testid="retirement-blocking-reasons">
                            @foreach (var reason in _view.Evaluation.BlockingReasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                        <p class="small text-muted mt-2 mb-0">
                            No exception is Active. To bypass the remaining gates, record a scoped exception on the
                            <a href="/exceptions">Exceptions page</a> with target type <code>RetirementChecklist</code> and target id <code>@_view.Checklist.Id</code>.
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <AuthorizeView Roles="@Roles.CanEditPolicy">
                <div class="dbt-card mb-3">
                    <h2 class="h6 text-muted mb-3">Manual review fields</h2>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="legal-hold-reviewed" @bind="_legalHoldReviewed" data-testid="legal-hold-reviewed-checkbox" />
                        <label class="form-check-label small" for="legal-hold-reviewed">Retention and legal-hold obligations reviewed</label>
                    </div>
                    <label class="visually-hidden" for="legal-hold-notes">Legal-hold review notes</label>
                    <textarea id="legal-hold-notes" class="form-control form-control-sm mb-2" rows="2" placeholder="Legal-hold review notes" @bind="_legalHoldNotes"></textarea>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="cost-contract-reviewed" @bind="_costContractReviewed" data-testid="cost-contract-reviewed-checkbox" />
                        <label class="form-check-label small" for="cost-contract-reviewed">Cost and contract review completed</label>
                    </div>
                    <label class="visually-hidden" for="cost-contract-notes">Cost and contract review notes</label>
                    <textarea id="cost-contract-notes" class="form-control form-control-sm mb-2" rows="2" placeholder="Cost/contract review notes" @bind="_costContractNotes"></textarea>

                    <label class="form-label small mb-1" for="final-backup-notes">Final backup and key-access evidence</label>
                    <textarea id="final-backup-notes" class="form-control form-control-sm mb-2" rows="2" placeholder="Final backup/key-access evidence notes" @bind="_finalBackupNotes"></textarea>
                    <label class="form-label small mb-1" for="external-cleanup-notes">Access and monitoring cleanup done outside DBTracker</label>
                    <textarea id="external-cleanup-notes" class="form-control form-control-sm mb-2" rows="2" placeholder="Externally performed access/monitoring-cleanup note" @bind="_externalCleanupNotes"></textarea>

                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SaveManualFields" data-testid="save-retirement-fields">Save review fields</button>

                    <hr />
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-6"><label class="form-label small mb-1" for="app-owner-name">Application owner</label><input id="app-owner-name" class="form-control form-control-sm" placeholder="Application owner name" @bind="_appOwnerName" @bind:event="oninput" /></div>
                        <button type="button" class="btn btn-link btn-sm p-0 col-6 text-start" @onclick="SignAppOwner" disabled="@string.IsNullOrWhiteSpace(_appOwnerName)" data-testid="sign-app-owner">
                            Sign as application owner@(_view.Checklist.AppOwnerSignoffAtUtc is { } a ? $" (signed by {_view.Checklist.AppOwnerSignoffBy})" : "")
                        </button>
                    </div>
                    <div class="row g-2 align-items-end">
                        <div class="col-6"><label class="form-label small mb-1" for="platform-owner-name">Platform owner</label><input id="platform-owner-name" class="form-control form-control-sm" placeholder="Platform owner name" @bind="_platformOwnerName" @bind:event="oninput" /></div>
                        <button type="button" class="btn btn-link btn-sm p-0 col-6 text-start" @onclick="SignPlatform" disabled="@string.IsNullOrWhiteSpace(_platformOwnerName)" data-testid="sign-platform">
                            Sign as platform owner@(_view.Checklist.PlatformSignoffAtUtc is { } p ? $" (signed by {_view.Checklist.PlatformSignoffBy})" : "")
                        </button>
                    </div>
                </div>

                <div class="dbt-card">
                    <h2 class="h6 text-muted mb-3">Complete retirement</h2>
                    <p class="small text-muted">Archives the instance through the normal archive action, with its reason and history, once every gate passes or a scoped exception is Active.</p>
                    <label class="form-label small mb-1" for="retirement-reason">Retirement reason (required, saved as the archive reason)</label>
                    <input id="retirement-reason" class="form-control form-control-sm mb-2" placeholder="Retirement reason (required: becomes the archive reason)" @bind="_retirementReason" @bind:event="oninput" data-testid="retirement-reason-input" />
                    <button type="button" class="btn btn-danger btn-sm" @onclick="CompleteRetirement"
                            disabled="@(_completing || string.IsNullOrWhiteSpace(_retirementReason) || !_view.CanRetire)"
                            data-testid="complete-retirement-button">
                        @(_completing ? "Retiring…" : "Complete retirement (archive)")
                    </button>
                </div>

                <div class="dbt-card mt-3">
                    <h2 class="h6 text-muted mb-3">Cancel this checklist</h2>
                    <p class="small text-muted">If it was started by mistake, or the database is staying. The checklist and its sign-offs are kept in history, and the instance stays active.</p>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenCancelDialog" data-testid="open-cancel-checklist">Cancel checklist…</button>
                </div>
            </AuthorizeView>
        </div>
    </div>
}

@* Outside the branches above, so it survives the re-render that follows a cancel and can hand focus to Start. *@
<ModalDialog Title="Cancel this retirement checklist?" @bind-Open="_showCancelDialog" FallbackFocusSelector="[data-testid=start-retirement-checklist]" data-testid="cancel-checklist-dialog">
    @if (_view is not null && _instance is not null)
    {
        <p class="small mb-3">
            Cancelling closes checklist #@_view.Checklist.Id for <strong>@_instance.Name</strong>. The checklist and its sign-offs stay in
            history, and the instance stays active. Use this if it was started by mistake, or the database is staying.
        </p>
        <label class="form-label small mb-1" for="cancel-reason">Reason (required)</label>
        <input id="cancel-reason" class="form-control form-control-sm" @bind="_cancelReason" @bind:event="oninput" data-testid="cancel-checklist-reason" />
        @if (_cancelError is not null)
        {
            @* Shown here, not as a toast: the page behind a modal is inert, so a toast there would go unannounced. *@
            <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed)">@_cancelError</p>
        }
        <div class="dbt-dialog-actions">
            <button type="button" class="btn btn-danger btn-sm" @onclick="CancelChecklist"
                    disabled="@string.IsNullOrWhiteSpace(_cancelReason)" data-testid="cancel-checklist-button">Cancel checklist</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" autofocus @onclick="() => _showCancelDialog = false">Keep checklist</button>
        </div>
    }
</ModalDialog>

@code {
    [Parameter] public int Id { get; set; }

    private DatabaseInstance? _instance;
    private bool _loaded, _loadFailed;
    private string? _userId, _userName;
    private RetirementChecklistView? _view;
    private bool _completing;
    private bool _showCancelDialog;
    private string? _cancelError;

    private void OpenCancelDialog()
    {
        _cancelReason = "";
        _cancelError = null;
        _showCancelDialog = true;
    }

    private bool _legalHoldReviewed, _costContractReviewed;
    private string _legalHoldNotes = "", _costContractNotes = "", _finalBackupNotes = "", _externalCleanupNotes = "";
    private string _appOwnerName = "", _platformOwnerName = "", _retirementReason = "", _cancelReason = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? _userName;
        await Retry();
    }

    private async Task Retry()
    {
        _loadFailed = false;
        try
        {
            await Load();
            _loaded = true;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private async Task Load()
    {
        var overview = await OverviewService.GetByIdAsync(Id);
        _instance = overview?.Instance;
        if (_instance is null || _instance.IsArchived)
        {
            return;
        }

        var checklist = await Checklists.GetOpenForInstanceAsync(Id);
        _view = checklist is null ? null : await Checklists.GetViewAsync(checklist.Id);
        if (_view is not null)
        {
            _legalHoldReviewed = _view.Checklist.LegalHoldReviewed;
            _legalHoldNotes = _view.Checklist.LegalHoldReviewNotes;
            _costContractReviewed = _view.Checklist.CostContractReviewed;
            _costContractNotes = _view.Checklist.CostContractReviewNotes;
            _finalBackupNotes = _view.Checklist.FinalBackupEvidenceNotes;
            _externalCleanupNotes = _view.Checklist.ExternalCleanupNotes;
        }
    }

    private async Task SaveManualFields()
    {
        await Checklists.UpdateManualFieldsAsync(_view!.Checklist.Id, _legalHoldReviewed, _legalHoldNotes, _externalCleanupNotes,
            _costContractReviewed, _costContractNotes, _finalBackupNotes, _userName ?? "unknown");
        Toasts.Success("Review fields saved.");
        await Load();
    }

    private async Task SignAppOwner()
    {
        await Checklists.RecordSignoffAsync(_view!.Checklist.Id, isApplicationOwner: true, _appOwnerName, _userName ?? "unknown");
        Toasts.Success("Application-owner sign-off recorded.");
        _appOwnerName = "";
        await Load();
    }

    private async Task SignPlatform()
    {
        await Checklists.RecordSignoffAsync(_view!.Checklist.Id, isApplicationOwner: false, _platformOwnerName, _userName ?? "unknown");
        Toasts.Success("Platform sign-off recorded.");
        _platformOwnerName = "";
        await Load();
    }

    private async Task StartChecklist()
    {
        await Checklists.GetOrCreateForInstanceAsync(Id, null, _userName ?? "unknown");
        Toasts.Success("Retirement checklist started.");
        await Load();
    }

    private async Task CancelChecklist()
    {
        var (ok, reason) = await Checklists.CancelAsync(_view!.Checklist.Id, _cancelReason, _userId ?? "unknown", _userName ?? "unknown");
        if (ok)
        {
            Toasts.Success("Retirement checklist cancelled. The instance stays active.");
            _cancelReason = "";
            _showCancelDialog = false;
            await Load();
        }
        else
        {
            _cancelError = reason;
        }
    }

    private async Task CompleteRetirement()
    {
        _completing = true;
        var (ok, reason) = await Checklists.CompleteRetirementAsync(_view!.Checklist.Id, _retirementReason, _userId ?? "unknown", _userName ?? "unknown");
        _completing = false;

        if (ok)
        {
            Toasts.Success($"{_instance!.Name} retired and archived.");
            Nav.NavigateTo($"/instances/{Id}");
        }
        else
        {
            Toasts.Error($"Not retired: {reason}");
            await Load();
        }
    }

    private static string GateCssClass(RetirementGateStatus status) => status switch
    {
        RetirementGateStatus.Passed => "OnTrack",
        RetirementGateStatus.NotApplicable => "OnTrack",
        RetirementGateStatus.Blocked => "Failed",
        _ => "Overdue"
    };
}
