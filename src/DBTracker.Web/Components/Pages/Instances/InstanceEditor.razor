@page "/instances/new"
@page "/instances/{Id:int}/edit"
@attribute [Authorize(Roles = Roles.CanEditPolicy)]
@implements IDisposable
@inject DBTrackerDbContext Db
@inject NavigationManager Nav
@inject ToastService Toasts
@inject AuthenticationStateProvider AuthProvider
@inject BackupFileScanner Scanner
@inject AuditRecorder Audit
@inject TeamService Teams
@inject IJSRuntime JS

<PageTitle>@(Id is null ? "Add instance" : "Edit instance") · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>@(Id is null ? "Add database instance" : $"Edit {_model.Name}")</h1>
        <div class="subtitle">Inventory, ownership and contact details</div>
    </div>
</div>

@if (_loading)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading instance…</span></div>
}
else if (_notFound)
{
    <div class="dbt-card" style="max-width: 600px;">
        <div class="empty-state py-4">
            <i class="bi bi-question-diamond" aria-hidden="true"></i>
            Instance #@Id doesn't exist. It may have been deleted, or the link is wrong.
        </div>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
    </div>
}
else
{
    <div class="dbt-card" style="max-width: 760px;">
        @if (_saveError is not null)
        {
            <div class="alert alert-danger" role="alert">@_saveError</div>
        }

        @if (_concurrencyConflict)
        {
            <div class="alert alert-danger" role="alert">
                <strong>This record changed since you opened it.</strong> Someone else saved an update in the
                meantime. Your edits below are kept. Reload to see the latest version (you'll lose these
                edits), or save again to overwrite it with your changes.
                <div class="mt-2 d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReloadDiscardingEdits">Reload latest, discard my edits</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => SaveInternal(overwrite: true)">Save anyway (overwrite)</button>
                </div>
            </div>
        }

        @if (_fieldErrors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Fix the following before saving:</strong>
                <ul class="mb-0">
                    @foreach (var e in _fieldErrors)
                    {
                        <li>@e.Message</li>
                    }
                </ul>
            </div>
        }

        <EditForm EditContext="_editContext" OnSubmit="Save">
            <DataAnnotationsValidator />

            <h2 class="h6 text-muted mb-3">Identity</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="ed-name">Instance name</label>
                    <InputText id="ed-name" class="form-control" @bind-Value="_model.Name" aria-required="true" />
                    <ValidationMessage For="() => _model.Name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="ed-engine">Engine</label>
                    <InputSelect id="ed-engine" class="form-select" @bind-Value="_model.Engine">
                        @foreach (var e in Enum.GetValues<DatabaseEngine>())
                        {
                            <option value="@e">@e</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="ed-version">Version</label>
                    <InputText id="ed-version" class="form-control" @bind-Value="_model.Version" />
                </div>
            </div>

            <h2 class="h6 text-muted mb-3">Ownership</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label" for="ed-application">Application</label>
                    <InputText id="ed-application" class="form-control" @bind-Value="_model.Application" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-company">Company</label>
                    <InputText id="ed-company" class="form-control" @bind-Value="_model.Company" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-department">Department</label>
                    <InputText id="ed-department" class="form-control" @bind-Value="_model.Department" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="owner-team">Owner team</label>
                    <InputSelect id="owner-team" class="form-select" @bind-Value="_model.OwnerTeamId">
                        <option value="">No team assigned</option>
                        @foreach (var t in _teams)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </InputSelect>
                    <div class="form-text">Used for "My instances" and team notification subscriptions. It only groups instances; it never grants access beyond a user's role.</div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="ownership-confirmed" @bind="_confirmOwnership" />
                        <label class="form-check-label" for="ownership-confirmed">Ownership/contact information above is current</label>
                    </div>
                </div>
            </div>

            <h2 class="h6 text-muted mb-3">Contact</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label" for="ed-contact-name">Contact name</label>
                    <InputText id="ed-contact-name" class="form-control" @bind-Value="_model.ContactName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-contact-email">Contact email</label>
                    <InputText id="ed-contact-email" class="form-control" @bind-Value="_model.ContactEmail" />
                    <ValidationMessage For="() => _model.ContactEmail" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-contact-phone">Contact phone</label>
                    <InputText id="ed-contact-phone" class="form-control" @bind-Value="_model.ContactPhone" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-backup-name">Backup contact name</label>
                    <InputText id="ed-backup-name" class="form-control" @bind-Value="_model.BackupContactName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-backup-email">Backup contact email</label>
                    <InputText id="ed-backup-email" class="form-control" @bind-Value="_model.BackupContactEmail" />
                    <ValidationMessage For="() => _model.BackupContactEmail" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-backup-phone">Backup contact phone</label>
                    <InputText id="ed-backup-phone" class="form-control" @bind-Value="_model.BackupContactPhone" />
                </div>
            </div>

            <h2 class="h6 text-muted mb-3">Topology</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label" for="ed-role">Role</label>
                    <InputSelect id="ed-role" class="form-select" @bind-Value="_model.Role">
                        @foreach (var r in Enum.GetValues<InstanceRole>())
                        {
                            <option value="@r">@r</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="ed-environment">Environment</label>
                    <InputSelect id="ed-environment" class="form-select" @bind-Value="_model.Environment">
                        @foreach (var e in Enum.GetValues<EnvironmentTier>())
                        {
                            <option value="@e">@e</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="ed-db-ip">Database IP</label>
                    <InputText id="ed-db-ip" class="form-control" @bind-Value="_model.DatabaseIp" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="ed-server-ip">Server IP</label>
                    <InputText id="ed-server-ip" class="form-control" @bind-Value="_model.ServerIp" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-region">Region</label>
                    <InputText id="ed-region" class="form-control" @bind-Value="_model.Region" placeholder="us-east-1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-cluster">Cluster</label>
                    <InputText id="ed-cluster" class="form-control" @bind-Value="_model.Cluster" placeholder="cluster-a" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-replica-set">Replica set</label>
                    <InputText id="ed-replica-set" class="form-control" @bind-Value="_model.ReplicaSet" placeholder="rs0" />
                </div>
            </div>

            <h2 class="h6 text-muted mb-3">Connectivity check</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="ed-conn-host">Host/DNS override (optional)</label>
                    <InputText id="ed-conn-host" class="form-control" @bind-Value="_model.ConnectivityHostOverride" placeholder="Defaults to Server IP, then Database IP" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="ed-conn-port">Port override (optional)</label>
                    <InputNumber id="ed-conn-port" class="form-control" @bind-Value="_model.ConnectivityPortOverride" placeholder="Defaults to the engine's conventional port" aria-describedby="ed-conn-port-help" />
                    <div class="form-text" id="ed-conn-port-help">A port outside 1-65535 is ignored and the engine's default port is used instead.</div>
                </div>
            </div>

            <h2 class="h6 text-muted mb-3">Backup expectations</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label" for="ed-interval">Expected backup interval (hours)</label>
                    <InputNumber id="ed-interval" class="form-control" @bind-Value="_model.ExpectedBackupIntervalHours" aria-describedby="ed-interval-help" />
                    <div class="form-text" id="ed-interval-help">Flagged as overdue if no successful backup within this window.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-retention">Retention policy (days)</label>
                    <InputNumber id="ed-retention" class="form-control" @bind-Value="_model.RetentionPolicyDays" aria-describedby="ed-retention-help" />
                    <div class="form-text" id="ed-retention-help">For reference only: how long backups should be kept.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ed-backup-location">Backup file location</label>
                    <InputText id="ed-backup-location" class="form-control" @bind-Value="_model.BackupFileLocation" placeholder="\\server\backups\instance" aria-describedby="ed-backup-location-help" />
                    <div class="form-text" id="ed-backup-location-help">UNC path scanned for backup files. Leave blank to disable.</div>
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label" for="ed-restore-interval">Restore-test interval override (days)</label>
                    <InputNumber id="ed-restore-interval" class="form-control" @bind-Value="_model.RestoreTestIntervalDaysOverride" aria-describedby="ed-restore-interval-help" />
                    <div class="form-text" id="ed-restore-interval-help">How often this instance's backups should be proven restorable. Leave blank to use the organization default.</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_model.BackupFileLocation))
            {
                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label class="form-label" for="ed-patterns">Backup file name pattern(s)</label>
                        <InputText id="ed-patterns" class="form-control" @bind-Value="_model.BackupFileNamePatterns" placeholder="*.bak;*.trn" aria-describedby="ed-patterns-help" />
                        <div class="form-text" id="ed-patterns-help">Semicolon-separated glob patterns deciding which files on the shared drive count as evidence. Leave blank to match every file. Zero-length and still-being-written files are always excluded.</div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-secondary" @onclick="PreviewScan" disabled="@_previewing">
                            <i class="bi bi-eye" aria-hidden="true"></i> @(_previewing ? "Checking…" : "Preview scan")
                        </button>
                    </div>
                </div>

                @if (_previewError is not null)
                {
                    <div class="alert alert-danger mb-4" role="alert">@_previewError</div>
                }
                else if (_preview is not null)
                {
                    <div class="dbt-card mb-4">
                        <h3 class="h6 text-muted mb-3">Scan preview</h3>
                        @if (_preview.Count == 0)
                        {
                            <div class="empty-state py-3"><i class="bi bi-inbox" aria-hidden="true"></i> No files found at this location.</div>
                        }
                        else
                        {
                            <table class="table table-sm mb-0 dbt-table" aria-label="Files found by the scan preview">
                                <thead><tr><th scope="col">File</th><th scope="col">Size</th><th scope="col">Last modified</th><th scope="col">Result</th></tr></thead>
                                <tbody>
                                    @foreach (var f in _preview)
                                    {
                                        <tr>
                                            <td class="small">@f.FileName</td>
                                            <td class="small">@($"{f.SizeBytes / 1024.0 / 1024.0:N1} MB")</td>
                                            <td class="small">@f.LastWriteUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                            <td class="small">
                                                @if (f.AlreadyKnown)
                                                {
                                                    <span class="text-muted">Already recorded</span>
                                                }
                                                else if (f.Eligibility == FileEligibility.Eligible)
                                                {
                                                    <span class="badge-health dot OnTrack">Would be recorded</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-health dot NeverBackedUp">Excluded</span>
                                                    <span class="text-muted small">: @f.Reason</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            }

            <h2 class="h6 text-muted mb-3">Reference</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label class="form-label" for="ed-tags">Tags</label>
                    <InputText id="ed-tags" class="form-control" @bind-Value="_model.Tags" placeholder="comma, separated, tags" />
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="ed-runbook">Runbook / monitoring link</label>
                    <InputText id="ed-runbook" class="form-control" @bind-Value="_model.RunbookUrl" placeholder="https://…" />
                    <ValidationMessage For="() => _model.RunbookUrl" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="ed-notes">Notes</label>
                    <InputTextArea id="ed-notes" class="form-control" rows="2" @bind-Value="_model.Notes" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Saving…" : (Id is null ? "Save instance" : "Save changes"))</button>
                <a class="btn btn-outline-secondary" href="@CancelUrl">Cancel</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private DatabaseInstance _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private bool _loading = true;
    private bool _notFound;
    private bool _previewing;
    private bool _saving;
    private bool _dirty;
    private bool _concurrencyConflict;
    private string? _previewError;
    private string? _saveError;
    private IReadOnlyList<FilePreview>? _preview;
    private IReadOnlyList<FieldError> _fieldErrors = [];
    private byte[] _loadedRowVersion = [];
    private IDisposable? _navigationLock;
    private string? _userDisplayName;
    private List<Team> _teams = new();
    private bool _confirmOwnership;

    private string CancelUrl => Id is null ? "/instances" : $"/instances/{Id}";

    private async Task PreviewScan()
    {
        _previewing = true;
        _previewError = null;
        _preview = null;

        try
        {
            _preview = await Scanner.PreviewAsync(_model.BackupFileLocation, _model.BackupFileNamePatterns, Id);
        }
        catch (Exception ex)
        {
            _previewError = ex.Message;
        }

        _previewing = false;
    }

    protected override async Task OnInitializedAsync()
    {
        _userDisplayName = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
        _teams = (await Teams.ListAsync()).Select(s => s.Team).OrderBy(t => t.Name).ToList();

        if (Id is not null)
        {
            var existing = await Db.DatabaseInstances.AsNoTracking().FirstOrDefaultAsync(i => i.Id == Id.Value);
            if (existing is null)
            {
                _notFound = true;
                _loading = false;
                return;
            }
            _model = existing;
            _confirmOwnership = existing.OwnershipConfirmedAtUtc is not null;
            _loadedRowVersion = existing.RowVersion;
        }

        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += (_, _) => _dirty = true;

        // In-app navigation with unsaved changes uses a real browser confirm() dialog, since
        // Blazor has no built-in prompt for intercepted navigation.
        _navigationLock = Nav.RegisterLocationChangingHandler(async context =>
        {
            if (!_dirty || _saving)
            {
                return;
            }
            var proceed = await JS.InvokeAsync<bool>("dbtracker.confirmLeave", "You have unsaved changes on this form. Leave without saving?");
            if (!proceed)
            {
                context.PreventNavigation();
            }
        });

        _loading = false;
    }

    /// <summary>Also arms/disarms the browser's native beforeunload prompt for an actual tab close/refresh, which RegisterLocationChangingHandler doesn't cover.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_notFound)
        {
            await JS.InvokeVoidAsync("dbtracker.setUnloadGuard", _dirty && !_saving);
        }
    }

    private Task Save() => SaveInternal(overwrite: false);

    private async Task SaveInternal(bool overwrite)
    {
        if (_saving)
        {
            return; // duplicate-submit guard
        }

        _fieldErrors = InstanceValidator.Validate(_model);
        _messageStore.Clear();
        if (_fieldErrors.Count > 0)
        {
            foreach (var error in _fieldErrors)
            {
                _messageStore.Add(_editContext.Field(error.Field), error.Message);
            }
            _editContext.NotifyValidationStateChanged();
            return;
        }

        _saving = true;
        _concurrencyConflict = false;
        _saveError = null;
        var now = DateTime.UtcNow;
        _model.UpdatedAtUtc = now;

        // The checkbox only sets or clears the confirmation stamp: saving never auto-confirms,
        // and unchecking explicitly clears a stale confirmation.
        if (_confirmOwnership)
        {
            _model.OwnershipConfirmedAtUtc = now;
            _model.OwnershipConfirmedBy = _userDisplayName ?? "unknown";
        }
        else
        {
            _model.OwnershipConfirmedAtUtc = null;
            _model.OwnershipConfirmedBy = "";
        }

        try
        {
            if (Id is null)
            {
                Db.DatabaseInstances.Add(_model);
                await Db.SaveChangesAsync();
                await Audit.RecordUserActionAsync(await CurrentUserIdAsync(), _userDisplayName ?? "unknown", "InstanceCreated", "DatabaseInstance", _model.Id.ToString(), _model.Name);
            }
            else
            {
                // Diff against the untouched row still in the database, not the in-memory _model
                // (which already carries the edited values), so the change log records real
                // before/after values.
                var before = await Db.DatabaseInstances.AsNoTracking().FirstOrDefaultAsync(i => i.Id == Id.Value);
                if (before is not null)
                {
                    var changedBy = _userDisplayName ?? "unknown";
                    var changes = InstanceChangeLogBuilder.Diff(before, _model, changedBy, now);
                    if (changes.Count > 0)
                    {
                        Db.InstanceChangeLogs.AddRange(changes);
                    }
                }

                if (overwrite)
                {
                    // "Save anyway" re-reads the row's current RowVersion right before writing so
                    // this explicit, user-confirmed overwrite isn't itself rejected as stale.
                    var currentRowVersion = await Db.DatabaseInstances
                        .Where(i => i.Id == Id.Value)
                        .Select(i => i.RowVersion)
                        .FirstOrDefaultAsync() ?? [];
                    _model.RowVersion = currentRowVersion;
                }
                else
                {
                    // The RowVersion loaded when the form opened is the concurrency token's original
                    // value: if another session saved first, EF throws DbUpdateConcurrencyException
                    // below instead of silently overwriting their change.
                    _model.RowVersion = _loadedRowVersion;
                }
                Db.DatabaseInstances.Update(_model);
                await Db.SaveChangesAsync();
                await Audit.RecordUserActionAsync(await CurrentUserIdAsync(), _userDisplayName ?? "unknown", "InstanceEdited", "DatabaseInstance", _model.Id.ToString(), _model.Name);
            }
        }
        catch (DbUpdateConcurrencyException)
        {
            Db.ChangeTracker.Clear();
            _concurrencyConflict = true;
            _saving = false;
            return;
        }
        catch (DbUpdateException)
        {
            Db.ChangeTracker.Clear();
            _saveError = "The instance couldn't be saved. Your edits are still in the form; check the values and try again.";
            _saving = false;
            return;
        }

        // The scoped DbContext persists across navigation within a circuit (see NotificationBell's
        // factory-context comment elsewhere in this app for the same root cause). Without this, an
        // instance saved here stays tracked as Unchanged; editing that same instance again later in
        // the same session then throws "another instance with the same key is already being
        // tracked" when Update() tries to attach the freshly-loaded _model.
        Db.ChangeTracker.Clear();
        _dirty = false;
        await JS.InvokeVoidAsync("dbtracker.setUnloadGuard", false);
        Toasts.Success(Id is null ? $"{_model.Name} created." : $"{_model.Name} updated.");
        Nav.NavigateTo($"/instances/{_model.Id}");
    }

    private async Task ReloadDiscardingEdits()
    {
        _concurrencyConflict = false;
        _dirty = false;
        _loading = true;
        var existing = await Db.DatabaseInstances.AsNoTracking().FirstOrDefaultAsync(i => i.Id == Id!.Value);
        if (existing is null)
        {
            _notFound = true;
        }
        else
        {
            _model = existing;
            _loadedRowVersion = existing.RowVersion;
            _editContext = new EditContext(_model);
            _messageStore = new ValidationMessageStore(_editContext);
            _editContext.OnFieldChanged += (_, _) => _dirty = true;
        }
        _loading = false;
    }

    private async Task<string> CurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    }

    public void Dispose() => _navigationLock?.Dispose();
}
