@page "/instances/new"
@page "/instances/{Id:int}/edit"
@attribute [Authorize(Roles = Roles.CanEditPolicy)]
@inject DBTrackerDbContext Db
@inject NavigationManager Nav
@inject ToastService Toasts
@inject AuthenticationStateProvider AuthProvider

<PageTitle>@(Id is null ? "Add instance" : "Edit instance") · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <div class="eyebrow">Instance record</div>
        <h1>@(Id is null ? "Add database instance" : $"Edit {_model.Name}")</h1>
        <div class="subtitle">Inventory, ownership and contact details</div>
    </div>
</div>

@if (_loading)
{
    <div class="spinner-ring"></div>
}
else
{
    <div class="dbt-card" style="max-width: 760px;">
        <EditForm Model="_model" OnValidSubmit="Save">
            <DataAnnotationsValidator />

            <h2 class="h6 text-muted text-uppercase mb-3">Identity</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Instance name</label>
                    <InputText class="form-control" @bind-Value="_model.Name" />
                    <ValidationMessage For="() => _model.Name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Engine</label>
                    <InputSelect class="form-select" @bind-Value="_model.Engine">
                        @foreach (var e in Enum.GetValues<DatabaseEngine>())
                        {
                            <option value="@e">@e</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Version</label>
                    <InputText class="form-control" @bind-Value="_model.Version" />
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Ownership</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">Application</label>
                    <InputText class="form-control" @bind-Value="_model.Application" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Company</label>
                    <InputText class="form-control" @bind-Value="_model.Company" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Department</label>
                    <InputText class="form-control" @bind-Value="_model.Department" />
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Contact</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">Contact name</label>
                    <InputText class="form-control" @bind-Value="_model.ContactName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Contact email</label>
                    <InputText class="form-control" @bind-Value="_model.ContactEmail" />
                    <ValidationMessage For="() => _model.ContactEmail" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Contact phone</label>
                    <InputText class="form-control" @bind-Value="_model.ContactPhone" />
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Topology</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label">Role</label>
                    <InputSelect class="form-select" @bind-Value="_model.Role">
                        @foreach (var r in Enum.GetValues<InstanceRole>())
                        {
                            <option value="@r">@r</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Environment</label>
                    <InputSelect class="form-select" @bind-Value="_model.Environment">
                        @foreach (var e in Enum.GetValues<EnvironmentTier>())
                        {
                            <option value="@e">@e</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Database IP</label>
                    <InputText class="form-control" @bind-Value="_model.DatabaseIp" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Server IP</label>
                    <InputText class="form-control" @bind-Value="_model.ServerIp" />
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Backup expectations</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">Expected backup interval (hours)</label>
                    <InputNumber class="form-control" @bind-Value="_model.ExpectedBackupIntervalHours" />
                    <div class="form-text">Flagged as overdue if no successful backup within this window.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Retention policy (days)</label>
                    <InputNumber class="form-control" @bind-Value="_model.RetentionPolicyDays" />
                    <div class="form-text">Informational — how long backups should be kept.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Backup file location</label>
                    <InputText class="form-control" @bind-Value="_model.BackupFileLocation" placeholder="\\server\backups\instance" />
                    <div class="form-text">UNC path scanned for backup files. Leave blank to disable.</div>
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Reference</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label class="form-label">Tags</label>
                    <InputText class="form-control" @bind-Value="_model.Tags" placeholder="comma, separated, tags" />
                </div>
                <div class="col-md-7">
                    <label class="form-label">Runbook / monitoring link</label>
                    <InputText class="form-control" @bind-Value="_model.RunbookUrl" placeholder="https://…" />
                </div>
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_model.Notes" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="@CancelUrl">Cancel</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private DatabaseInstance _model = new();
    private bool _loading = true;

    private string CancelUrl => Id is null ? "/instances" : $"/instances/{Id}";

    protected override async Task OnInitializedAsync()
    {
        if (Id is not null)
        {
            var existing = await Db.DatabaseInstances.AsNoTracking().FirstOrDefaultAsync(i => i.Id == Id.Value);
            if (existing is not null)
            {
                _model = existing;
            }
        }
        _loading = false;
    }

    private async Task Save()
    {
        var now = DateTime.UtcNow;
        _model.UpdatedAtUtc = now;

        if (Id is null)
        {
            Db.DatabaseInstances.Add(_model);
        }
        else
        {
            // Diff against the untouched row still in the database — not the in-memory _model,
            // which already carries the edited values the form just bound — so the change log
            // records actual before/after, not after/after.
            var before = await Db.DatabaseInstances.AsNoTracking().FirstOrDefaultAsync(i => i.Id == Id.Value);
            if (before is not null)
            {
                var changedBy = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
                var changes = InstanceChangeLogBuilder.Diff(before, _model, changedBy, now);
                if (changes.Count > 0)
                {
                    Db.InstanceChangeLogs.AddRange(changes);
                }
            }

            Db.DatabaseInstances.Update(_model);
        }

        await Db.SaveChangesAsync();
        // The scoped DbContext persists across navigation within a circuit (see NotificationBell's
        // factory-context comment elsewhere in this app for the same root cause). Without this, an
        // instance saved here stays tracked as Unchanged; editing that same instance again later in
        // the same session then throws "another instance with the same key is already being
        // tracked" when Update() tries to attach the freshly-loaded _model.
        Db.ChangeTracker.Clear();
        Toasts.Success(Id is null ? $"{_model.Name} created." : $"{_model.Name} updated.");
        Nav.NavigateTo($"/instances/{_model.Id}");
    }
}
