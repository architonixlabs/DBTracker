@page "/instances/archived"
@attribute [Authorize]
@inject InstanceArchiveService ArchiveService
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toasts

<PageTitle>Archived instances · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Archived instances</h1>
        <div class="subtitle">Search and unarchive instances. Backup, restore and change history stays attached through archive and unarchive.</div>
    </div>
    <a class="btn btn-outline-secondary" href="/instances"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to instances</a>
</div>

<div class="filter-bar mb-3">
    <label class="form-label small mb-1" for="archived-search">Search archived instances</label>
    <input id="archived-search" type="search" class="form-control" style="max-width:280px;" placeholder="Search name, application, company…" value="@_search" @oninput="OnSearch" />
</div>

@if (_loadFailed)
{
    <div class="empty-state" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        Couldn't load archived instances. The database may be unreachable.
        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="Load">Try again</button>
    </div>
}
else if (_rows is null)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading archived instances…</span></div>
}
else if (_rows.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(_search))
    {
        <EmptyState Icon="archive">
            <ChildContent>No archived instances. An instance archived from its detail page moves here with its history kept, and a DBA or admin can unarchive it.</ChildContent>
            <Action><a href="/instances">Back to the inventory</a></Action>
        </EmptyState>
    }
    else
    {
        <EmptyState Icon="archive" Role="status">No archived instances match this search. The search looks at name, application and company; clear it to list them all.</EmptyState>
    }
}
else
{
    <div class="dbt-table">
        <table class="table" aria-label="Archived instances">
            <thead>
                <tr><th scope="col">Name</th><th scope="col">Application</th><th scope="col">Company</th><th scope="col">Archived</th><th scope="col">By</th><th scope="col">Reason</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td class="fw-semibold"><a href="/instances/@row.Id">@row.Name</a></td>
                        <td>@row.Application</td>
                        <td>@row.Company</td>
                        <td class="small text-muted"><LocalTime Utc="row.ArchivedAtUtc" ShowUtc="false" Empty="Not recorded" /></td>
                        <td class="small text-muted">@row.ArchivedBy</td>
                        <td class="small">@row.ArchiveReason</td>
                        <td>
                            <AuthorizeView Roles="@Roles.CanEditPolicy">
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Unarchive @row.Name" aria-expanded="@(_unarchivingId == row.Id ? "true" : "false")"
                                        data-testid="unarchive-open" @onclick="() => OpenUnarchive(row.Id)">Unarchive</button>
                            </AuthorizeView>
                        </td>
                    </tr>
                    @if (_unarchivingId == row.Id)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="d-flex gap-2 align-items-end flex-wrap py-1">
                                    <div style="min-width:260px;flex:1;">
                                        <label class="form-label small mb-1" for="unarchive-reason-@row.Id">Why is @row.Name coming back? (required)</label>
                                        <input id="unarchive-reason-@row.Id" data-testid="unarchive-reason" class="form-control form-control-sm" @bind="_unarchiveReason" @bind:event="oninput"
                                               placeholder="Archived by mistake, database back in service…" aria-describedby="unarchive-help-@row.Id" />
                                        <div class="form-text" id="unarchive-help-@row.Id">Recorded in the audit trail with the original archive reason. Scans, alerts and reports pick it up again.</div>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm" data-testid="unarchive-confirm" disabled="@(string.IsNullOrWhiteSpace(_unarchiveReason) || _busy)" @onclick="() => Unarchive(row.Id)">Unarchive @row.Name</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _unarchivingId = null">Cancel</button>
                                </div>
                                @if (_unarchiveError is not null)
                                {
                                    <p class="small mb-0" role="alert" style="color:var(--dbt-failed)">@_unarchiveError</p>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ArchivedInstanceRow>? _rows;
    private bool _loadFailed;
    private string _search = "";
    private string? _userId;
    private string? _userName;
    private bool _canEdit;
    private int? _unarchivingId;
    private string _unarchiveReason = "";
    private string? _unarchiveError;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _userName = state.User.Identity?.Name ?? "unknown";
        _canEdit = Roles.CanEditPolicy.Split(',').Any(state.User.IsInRole);
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _rows = await ArchiveService.SearchArchivedAsync(_search);
            _loadFailed = false;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        await Load();
    }

    private void OpenUnarchive(int id)
    {
        _unarchivingId = id;
        _unarchiveReason = "";
        _unarchiveError = null;
    }

    private async Task Unarchive(int id)
    {
        // The button is hidden from read-only roles, but the write is checked here too.
        if (!_canEdit)
        {
            _unarchiveError = "Only DBA or Admin users can unarchive instances.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_unarchiveReason))
        {
            _unarchiveError = "Give a reason before unarchiving.";
            return;
        }

        _busy = true;
        var ok = await ArchiveService.UnarchiveAsync(id, _unarchiveReason, _userId ?? "", _userName ?? "unknown");
        _busy = false;
        _unarchivingId = null;
        if (ok)
        {
            // Health/alert eligibility isn't cached: the next dashboard/list read and the next
            // scan/alert sweep stop excluding this instance once IsArchived is false.
            Toasts.Success("Instance unarchived. Health and alert eligibility are recomputed on its next read.");
        }
        else
        {
            Toasts.Error("Couldn't unarchive this instance. It may already be active; reload the list to check.");
        }
        await Load();
    }
}
