@page "/instances"
@implements IDisposable
@inject InstanceOverviewService OverviewService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Instances · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <div class="eyebrow">Inventory</div>
        <h1>Database Instances</h1>
        <div class="subtitle">@(_overviews is null ? "" : $"{Filtered().Count()} of {_overviews.Count} instances")</div>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <div class="small text-muted" role="status">
            @if (_refreshError is not null)
            {
                <span style="color:var(--dbt-failed)"><i class="bi bi-exclamation-circle"></i> Refresh failed: @_refreshError</span>
            }
            else
            {
                <span>Updated @_lastUpdatedUtc.ToLocalTime().ToString("h:mm:ss tt")</span>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshNow" disabled="@_refreshing">
            <i class="bi bi-arrow-clockwise"></i> @(_refreshing ? "Refreshing…" : "Refresh")
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleAutoRefresh" title="Auto-refreshes every 30s while on">
            <i class="bi @(_autoRefreshPaused ? "bi-play-fill" : "bi-pause-fill")"></i> Auto-refresh @(_autoRefreshPaused ? "paused" : "on")
        </button>
        <AuthorizeView Roles="@Roles.CanEditPolicy">
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="/instances/import">
                    <i class="bi bi-upload"></i> Import CSV
                </a>
                <a class="btn btn-primary" href="/instances/new">
                    <i class="bi bi-plus-lg"></i> Add instance
                </a>
            </div>
        </AuthorizeView>
    </div>
</div>

@if (_overviews is null)
{
    <div class="skeleton" style="height: 54px; margin-bottom: 1.25rem;"></div>
    <div class="dbt-table">
        @for (var i = 0; i < 7; i++)
        {
            <div class="skeleton skeleton-row"></div>
        }
    </div>
}
else
{
    <div class="filter-bar">
        <input class="form-control" style="max-width:220px;" placeholder="Search name, app, owner, IP…"
               value="@_search" @oninput="OnSearchChanged" />

        <select class="form-select" style="max-width:150px;" @bind="_engine">
            <option value="">All engines</option>
            @foreach (var e in Enum.GetValues<DatabaseEngine>())
            {
                <option value="@e">@e</option>
            }
        </select>

        <select class="form-select" style="max-width:150px;" @bind="_health">
            <option value="">All health</option>
            @foreach (var h in Enum.GetValues<BackupHealth>())
            {
                <option value="@h">@FilterLabel(h)</option>
            }
        </select>

        <select class="form-select" style="max-width:130px;" @bind="_role">
            <option value="">Active + passive</option>
            @foreach (var r in Enum.GetValues<InstanceRole>())
            {
                <option value="@r">@r</option>
            }
        </select>

        <select class="form-select" style="max-width:160px;" @bind="_envTier">
            <option value="">All environments</option>
            @foreach (var e in Enum.GetValues<EnvironmentTier>())
            {
                <option value="@e">@e</option>
            }
        </select>

        <select class="form-select" style="max-width:170px;" @bind="_company">
            <option value="">All companies</option>
            @foreach (var c in Companies)
            {
                <option value="@c">@c</option>
            }
        </select>

        @if (_hasOwnInstances)
        {
            <div class="form-check" style="padding-bottom:7px;">
                <input class="form-check-input" type="checkbox" id="my-instances" @bind="_myInstancesOnly" />
                <label class="form-check-label" for="my-instances">My instances only</label>
            </div>
        }

        @if (HasFilters)
        {
            <button class="btn btn-link btn-sm" @onclick="ClearFilters">Clear filters</button>
        }
    </div>

    <div class="dbt-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Instance</th>
                    <th>Engine</th>
                    <th>Application</th>
                    <th>Company / Dept</th>
                    <th>Owner</th>
                    <th>Role</th>
                    <th>Env</th>
                    <th>Health</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Filtered())
                {
                    <tr @onclick='() => Nav.NavigateTo($"/instances/{o.Instance.Id}")'>
                        <td>
                            <div class="fw-semibold">@o.Instance.Name</div>
                            <div class="text-muted small">@o.Instance.DatabaseIp</div>
                        </td>
                        <td><span class="engine-pill">@o.Instance.Engine</span> <span class="text-muted small">@o.Instance.Version</span></td>
                        <td>@o.Instance.Application</td>
                        <td>
                            <div>@o.Instance.Company</div>
                            <div class="text-muted small">@o.Instance.Department</div>
                        </td>
                        <td>
                            <div>@o.Instance.ContactName</div>
                            <div class="text-muted small">@o.Instance.ContactEmail</div>
                        </td>
                        <td><span class="role-pill @o.Instance.Role">@o.Instance.Role</span></td>
                        <td>@o.Instance.Environment</td>
                        <td>
                            <HealthBadge Health="o.Health" />
                            @if (o.Instance.MaintenanceUntilUtc > DateTime.UtcNow)
                            {
                                <i class="bi bi-cone-striped text-muted ms-1" title="Under maintenance — alerts suppressed"></i>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Filtered().Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            No instances match these filters.
        </div>
    }
}

@code {
    private List<InstanceOverview>? _overviews;

    private string _search = "";
    private string _engine = "";
    private string _health = "";
    private string _role = "";
    private string _envTier = "";
    private string _company = "";
    private bool _myInstancesOnly;
    private string? _myEmail;
    private bool _hasOwnInstances;

    private DateTime _lastUpdatedUtc;
    private string? _refreshError;
    private bool _refreshing;
    private bool _autoRefreshPaused;
    private Timer? _autoRefreshTimer;

    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _myEmail = state.User.Identity?.Name;

        await Load();
        _autoRefreshTimer = new Timer(async _ => await AutoRefreshTickAsync(), null, AutoRefreshInterval, AutoRefreshInterval);
    }

    private async Task Load()
    {
        try
        {
            // Filters (_search, _engine, etc.) are separate fields this reload never touches, so a
            // refresh preserves whatever the user had selected instead of resetting the view.
            _overviews = await OverviewService.GetAllAsync();
            _lastUpdatedUtc = DateTime.UtcNow;
            _refreshError = null;
            _hasOwnInstances = !string.IsNullOrWhiteSpace(_myEmail) &&
                _overviews.Any(o => string.Equals(o.Instance.ContactEmail, _myEmail, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            _refreshError = ex.Message;
        }
    }

    private async Task RefreshNow()
    {
        _refreshing = true;
        await Load();
        _refreshing = false;
    }

    private async Task AutoRefreshTickAsync()
    {
        if (_autoRefreshPaused)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        });
    }

    private void ToggleAutoRefresh() => _autoRefreshPaused = !_autoRefreshPaused;

    public void Dispose() => _autoRefreshTimer?.Dispose();

    private IEnumerable<string> Companies =>
        _overviews?.Select(o => o.Instance.Company).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    private bool HasFilters =>
        _search.Length > 0 || _engine.Length > 0 || _health.Length > 0 || _role.Length > 0 || _envTier.Length > 0 || _company.Length > 0 || _myInstancesOnly;

    private void ClearFilters()
    {
        _search = ""; _engine = ""; _health = ""; _role = ""; _envTier = ""; _company = ""; _myInstancesOnly = false;
    }

    private void OnSearchChanged(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private IEnumerable<InstanceOverview> Filtered()
    {
        var items = _overviews ?? Enumerable.Empty<InstanceOverview>();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            items = items.Where(o =>
                Contains(o.Instance.Name, term) ||
                Contains(o.Instance.Application, term) ||
                Contains(o.Instance.Company, term) ||
                Contains(o.Instance.Department, term) ||
                Contains(o.Instance.ContactName, term) ||
                Contains(o.Instance.ContactEmail, term) ||
                Contains(o.Instance.DatabaseIp, term) ||
                Contains(o.Instance.ServerIp, term));
        }

        if (_engine.Length > 0 && Enum.TryParse<DatabaseEngine>(_engine, out var engine))
        {
            items = items.Where(o => o.Instance.Engine == engine);
        }

        if (_health.Length > 0 && Enum.TryParse<BackupHealth>(_health, out var health))
        {
            items = items.Where(o => o.Health == health);
        }

        if (_role.Length > 0 && Enum.TryParse<InstanceRole>(_role, out var role))
        {
            items = items.Where(o => o.Instance.Role == role);
        }

        if (_envTier.Length > 0 && Enum.TryParse<EnvironmentTier>(_envTier, out var env))
        {
            items = items.Where(o => o.Instance.Environment == env);
        }

        if (_company.Length > 0)
        {
            items = items.Where(o => o.Instance.Company == _company);
        }

        if (_myInstancesOnly && !string.IsNullOrWhiteSpace(_myEmail))
        {
            items = items.Where(o => string.Equals(o.Instance.ContactEmail, _myEmail, StringComparison.OrdinalIgnoreCase));
        }

        return items.OrderBy(o => o.Instance.Name);
    }

    private static bool Contains(string haystack, string term) =>
        haystack.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FilterLabel(BackupHealth health) => health switch
    {
        BackupHealth.OnTrack => "On track",
        BackupHealth.Overdue => "Overdue",
        BackupHealth.Failed => "Failed",
        BackupHealth.NeverBackedUp => "Never backed up",
        _ => health.ToString()
    };
}
