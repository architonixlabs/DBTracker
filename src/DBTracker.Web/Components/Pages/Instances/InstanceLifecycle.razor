@page "/instances/{Id:int}/lifecycle"
@attribute [Authorize]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.Lifecycle
@using DBTracker.Infrastructure.Queries
@using DBTracker.Infrastructure.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject InstanceOverviewService OverviewService
@inject VersionIdentityService IdentityService
@inject SupportRunwayService RunwayService
@inject PatchBaselineService PatchService
@inject AdvisoryService Advisories
@inject VersionObservationService Observations
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>@(_instance?.Name ?? "Instance") lifecycle · DBTracker</PageTitle>

@if (_loadFailed)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Couldn't load lifecycle data. The database may be unreachable.</div>
        <button type="button" class="btn btn-outline-secondary" @onclick="Retry">Try again</button>
    </div>
}
else if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading lifecycle data…</span></div>
}
else if (_instance is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i class="bi bi-question-diamond" aria-hidden="true"></i> Instance #@Id doesn't exist.</div>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <h1>@_instance.Name</h1>
            <div class="subtitle">
                Version identity and support lifecycle · @_instance.Engine · <a href="/instances/@Id">Back to instance detail</a><br />
                Release availability, lifecycle risk, security exposure and backup health are tracked separately. A newer release alone doesn't make a migration required.
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Installed-version identity</h2>

                @if (_identity is null)
                {
                    <EmptyState Icon="patch-question" Compact="true">No structured identity recorded yet.</EmptyState>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-health dot @ResolutionCssClass(_identity.ResolutionStatus)">@_identity.ResolutionStatus</span>
                        @if (_identity.IsAttested)
                        {
                            <span class="small text-muted"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> Attested by @_identity.AttestedBy on <LocalTime Utc="_identity.AttestedAtUtc" Format="MMM d, yyyy" ShowUtc="false" /></span>
                        }
                        else
                        {
                            <span class="small text-muted">Not attested</span>
                        }
                    </div>
                    <p class="small mb-1">Raw text: <code>@_identity.RawVersionText</code></p>
                    @if (_identity.ResolutionStatus != VersionResolutionStatus.Resolved)
                    {
                        <p class="small mb-2" style="color:var(--dbt-overdue);">@_identity.UnresolvedReason<br />Unresolved or unrecognized versions are never treated as compliant.</p>
                    }
                    else
                    {
                        <p class="small mb-2">
                            @_identity.Family @_identity.Major@(_identity.Minor is { } mn ? $".{mn}" : "")@(string.IsNullOrEmpty(_identity.Build) ? "" : $" build {_identity.Build}")
                            @(string.IsNullOrEmpty(_identity.Edition) ? "" : $" ({_identity.Edition})")
                        </p>
                    }
                    <dl class="row small mb-2">
                        <dt class="col-5">Distribution</dt><dd class="col-7">@OrNotRecorded(_identity.Distribution)</dd>
                        <dt class="col-5">Patch train</dt><dd class="col-7">@OrNotRecorded(_identity.PatchTrain)</dd>
                        <dt class="col-5">Hosting engine version</dt><dd class="col-7">@OrNotRecorded(_identity.HostingEngineVersion)</dd>
                        <dt class="col-5">DB compatibility level</dt><dd class="col-7">@OrNotRecorded(_identity.DatabaseCompatibilityLevel)</dd>
                        <dt class="col-5">Hosting provider</dt><dd class="col-7">@OrNotRecorded(_identity.HostingProvider)</dd>
                        <dt class="col-5">Hosting context</dt><dd class="col-7" data-testid="identity-hosting-context">@OrNotRecorded(_identity.HostingContext)</dd>
                        <dt class="col-5">Observed</dt><dd class="col-7"><LocalTime Utc="_identity.ObservedAtUtc" Format="MMM d, yyyy h:mm tt" ShowUtc="false" /> (@_identity.ObservationSource)</dd>
                    </dl>

                    @if (_clusterNodes.Count > 0)
                    {
                        <p class="small text-muted mb-1">Cluster-node versions, recorded separately from the Region, Cluster and ReplicaSet fields:</p>
                        <ul class="small mb-2">
                            @foreach (var n in _clusterNodes)
                            {
                                <li>@n.NodeName: @n.RawVersionText (@n.ResolutionStatus)</li>
                            }
                        </ul>
                    }
                }

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <hr />
                    <div class="mb-2">
                        <label class="form-label small" for="raw-version">Raw version text, as reported or imported</label>
                        <div class="d-flex gap-2">
                            <input id="raw-version" class="form-control form-control-sm" @bind="_rawVersionInput" @bind:event="oninput" placeholder="e.g. 16.2, 2019 CU18, 10.6.16-MariaDB" aria-describedby="raw-version-help" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SaveRawVersion" disabled="@string.IsNullOrWhiteSpace(_rawVersionInput)">Resolve &amp; save</button>
                        </div>
                        <div class="form-text" id="raw-version-help">If the text can't be matched to a known release, it's saved as Unresolved. That's a correct result, not an error.</div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6"><label class="form-label small mb-1" for="id-edition">Edition</label><input id="id-edition" class="form-control form-control-sm" placeholder="Edition" @bind="_edition" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-distribution">Distribution</label><input id="id-distribution" class="form-control form-control-sm" placeholder="Distribution" @bind="_distribution" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-patch-train">Patch train</label><input id="id-patch-train" class="form-control form-control-sm" placeholder="Patch train" @bind="_patchTrain" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-provider">Hosting provider</label><input id="id-provider" class="form-control form-control-sm" placeholder="Hosting provider" @bind="_hostingProvider" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-host-engine">Hosting engine version</label><input id="id-host-engine" class="form-control form-control-sm" placeholder="Hosting engine version" @bind="_hostingEngineVersion" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-compat">DB compatibility level</label><input id="id-compat" class="form-control form-control-sm" placeholder="DB compatibility level" @bind="_compatLevel" @bind:event="oninput" /></div>
                        <div class="col-12"><label class="form-label small mb-1" for="id-hosting-context">Hosting context</label><input id="id-hosting-context" class="form-control form-control-sm" placeholder="e.g. Azure SQL Managed Instance, eu-west, General Purpose" maxlength="500" @bind="_hostingContext" @bind:event="oninput" data-testid="identity-hosting-context-input" /></div>
                    </div>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SaveMetadata" disabled="@(_identity is null)">Save metadata</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Attest" disabled="@(_identity is null)"><i class="bi bi-patch-check" aria-hidden="true"></i> Attest current identity</button>
                    </div>

                    <div class="d-flex gap-2">
                        <label class="visually-hidden" for="node-name">Node name</label>
                        <input id="node-name" class="form-control form-control-sm" placeholder="Node name" @bind="_newNodeName" @bind:event="oninput" style="max-width:160px;" />
                        <label class="visually-hidden" for="node-version">Node version text</label>
                        <input id="node-version" class="form-control form-control-sm" placeholder="Node version text" @bind="_newNodeVersion" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddClusterNode" disabled="@(string.IsNullOrWhiteSpace(_newNodeName) || string.IsNullOrWhiteSpace(_newNodeVersion))">Add node</button>
                    </div>
                </AuthorizeView>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Support runway</h2>

                @if (_runway is null)
                {
                    <EmptyState Icon="hourglass" Compact="true">Not yet evaluated.</EmptyState>
                }
                else if (_runway.NeedsReview)
                {
                    <div class="small" style="color:var(--dbt-overdue);" data-testid="runway-status"><i class="bi bi-exclamation-diamond" aria-hidden="true"></i> Needs review: @_runway.UnknownReason</div>
                    <p class="small text-muted mb-2">The facts exist but can't be relied on until someone reviews them. This is not treated as supported.</p>
                }
                else if (_runway.IsUnknown)
                {
                    <div class="small" style="color:var(--dbt-overdue);" data-testid="runway-status"><i class="bi bi-patch-question" aria-hidden="true"></i> Unknown: @_runway.UnknownReason</div>
                    <p class="small text-muted mb-2">There are no usable facts yet. Unknown is not treated as supported.</p>
                }
                else
                {
                    <p class="small text-muted mb-1">Vendor lifecycle@(_matchedEntry is null ? "" : $", from \"{_matchedEntry.ReleaseLabel}\"")@(_matchedEntry?.IsManualOverride == true ? " (dates set by an internal override)" : ""):</p>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-health dot @PhaseCssClass(_runway.Phase)" data-testid="runway-status">@_runway.Phase</span>
                        <span class="small">@_runway.NextMilestoneLabel: @_runway.NextMilestoneUtc?.ToString("yyyy-MM-dd")</span>
                    </div>
                    <p class="small mb-2" data-testid="runway-days">
                        @if (_runway.DaysToNextMilestone is { } d && d <= 0)
                        {
                            <span style="color:var(--dbt-failed);">@Math.Abs(d) day(s) overdue.</span>
                        }
                        else
                        {
                            <span>@_runway.DaysToNextMilestone day(s) remaining.</span>
                        }
                    </p>
                }

                @if (_runway is not null)
                {
                    <p class="small mb-2" data-testid="runway-coverage">
                        <span class="text-muted">Contract coverage:</span>
                        @(string.IsNullOrEmpty(_runway.CoverageNote) ? "No Extended coverage contract affects this runway." : _runway.CoverageNote)
                        <a href="/instances/@Id/entitlement">Contracts</a>
                    </p>
                }

                @if (_latestDecision is not null)
                {
                    <p class="small text-muted mb-2">Last decision: <strong>@_latestDecision.ActionType</strong>, @_latestDecision.ActionReference (by @_latestDecision.DecidedBy, <LocalTime Utc="_latestDecision.DecidedAtUtc" Format="MMM d, yyyy" ShowUtc="false" />)</p>
                }

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <hr />
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-1" for="decision-action">Decision</label>
                            <select id="decision-action" class="form-select form-select-sm" @bind="_decisionActionType">
                                @foreach (var t in Enum.GetValues<SupportActionType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-6"><label class="form-label small mb-1" for="decision-reference">Reference (required)</label><input id="decision-reference" class="form-control form-control-sm" placeholder="Reference (ticket/plan link)" @bind="_decisionReference" @bind:event="oninput" /></div>
                    </div>
                    <div class="d-flex gap-2">
                        <label class="visually-hidden" for="decision-notes">Decision notes</label>
                        <input id="decision-notes" class="form-control form-control-sm" placeholder="Notes" @bind="_decisionNotes" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecordDecision" disabled="@string.IsNullOrWhiteSpace(_decisionReference)">Record decision</button>
                    </div>
                    <div class="mt-2">
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="EvaluateRunwayNow">Evaluate support-runway notices now (admin/DBA action, mirrors the background sweep)</button>
                    </div>
                </AuthorizeView>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Release availability &amp; patch baseline</h2>

                @if (_patchBaseline is null)
                {
                    <EmptyState Icon="box-seam" Compact="true">Record a resolved version identity first.</EmptyState>
                }
                else
                {
                    <dl class="row small mb-0">
                        <dt class="col-5">Installed</dt><dd class="col-7">@_patchBaseline.InstalledLabel</dd>
                        <dt class="col-5">Available: latest applicable branch patch</dt>
                        <dd class="col-7" data-testid="patch-latest-branch">
                            @(_patchBaseline.LatestApplicableBranchPatch is { } p1 ? $"{p1.ReleaseLabel} ({p1.Build})" : "None catalogued")
                            @if (_patchBaseline.LatestApplicableBranchPatch is not null)
                            {
                                <span class="text-muted"> · installed is @PositionText(_patchBaseline.InstalledVsLatestPatch)</span>
                                @ReleaseNotes(_patchBaseline.LatestApplicableBranchPatch!)
                            }
                        </dd>
                        <dt class="col-5">Available: newest relevant GA</dt>
                        <dd class="col-7">
                            @(_patchBaseline.NewestRelevantGA is { } p2 ? p2.ReleaseLabel : "None catalogued")
                            @if (_patchBaseline.NewestRelevantGA is not null)
                            {
                                @ReleaseNotes(_patchBaseline.NewestRelevantGA!)
                            }
                        </dd>
                        <dt class="col-5">Approved organizational target</dt>
                        <dd class="col-7" data-testid="patch-approved-target">
                            @(_patchBaseline.ApprovedTarget is { } p3 ? $"{p3.ReleaseLabel}{(string.IsNullOrWhiteSpace(p3.Build) ? "" : $" ({p3.Build})")}" : "None approved")
                            @if (_patchBaseline.ApprovedTarget is not null)
                            {
                                <span class="text-muted"> · installed is @PositionText(_patchBaseline.InstalledVsApproved)</span>
                                @ReleaseNotes(_patchBaseline.ApprovedTarget!)
                            }
                            @if (_patchBaseline.IsMajorUpgradeFromApproved)
                            {
                                <span class="small text-muted"> (a major-version migration, not a same-branch patch)</span>
                            }
                        </dd>
                        <dt class="col-5">Required by (internal policy)</dt>
                        <dd class="col-7" data-testid="patch-required-by">
                            @if (_patchBaseline.RequiredByUtc is { } due)
                            {
                                @due.ToString("yyyy-MM-dd")
                                @if (_patchBaseline.IsPastRequiredBy(DateTime.UtcNow))
                                {
                                    <span style="color:var(--dbt-failed);"> · passed, and the instance isn't confirmed on the target</span>
                                }
                            }
                            else
                            {
                                <span>No deadline set</span>
                            }
                        </dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_patchBaseline.Notes))
                    {
                        <p class="small text-muted mt-2 mb-0">@_patchBaseline.Notes</p>
                    }
                    <p class="small text-muted mt-2 mb-0">Preview releases are excluded by default. The approved target is never picked automatically from the newest GA; only a reviewed baseline sets it.</p>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Advisory applicability</h2>

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-2" @onclick="EvaluateAdvisories">Evaluate advisories for this instance</button>
                </AuthorizeView>

                @if (_assessments.Count == 0)
                {
                    <EmptyState Icon="shield-check" Compact="true">No advisories evaluated against this instance.</EmptyState>
                }
                else
                {
                    <p class="small text-muted mb-2">Highest priority first: severity, this service's criticality, its exposure and the applicability are weighed together. Unknown severity or criticality is weighed like High.</p>
                    @foreach (var ranked in _assessments)
                    {
                        var a = ranked.Assessment;
                        <div class="mb-2 pb-2" style="border-bottom:1px solid var(--dbt-line);" data-testid="advisory-row">
                            <div class="d-flex justify-content-between">
                                <strong class="small">@a.AdvisoryRecord?.VendorAdvisoryId: @a.AdvisoryRecord?.Title</strong>
                                <span class="badge-health dot @AdvisoryCssClass(a.Classification)">@a.Classification</span>
                            </div>
                            <p class="small text-muted mb-1" data-testid="advisory-priority">Priority @ranked.Score: @ranked.Rationale</p>
                            <p class="small text-muted mb-1">@a.ClassificationReasoning</p>
                            @if (a.IsReviewed)
                            {
                                <p class="small mb-0" data-testid="advisory-review-summary">
                                    Reviewed by @a.ReviewedBy, verification: @a.VerificationStatus.
                                    Owner: @OrNotRecorded(a.Owner). Deadline: @(a.RemediationDeadlineUtc?.ToString("yyyy-MM-dd") ?? "Not set").
                                    Target patch: @OrNotRecorded(a.TargetPatch).
                                </p>
                                @if (!string.IsNullOrWhiteSpace(a.ReviewerEvidence))
                                {
                                    <p class="small text-muted mb-0">Evidence: @a.ReviewerEvidence</p>
                                }
                            }
                            <AuthorizeView Roles="@Roles.CanEditPolicy">
                                @if (_reviewingId == a.Id)
                                {
                                    <div class="mt-2 p-2" style="border:1px dashed var(--dbt-line);" data-testid="advisory-review-form">
                                        <div class="row g-2 mb-1">
                                            <div class="col-6">
                                                <label class="form-label small mb-1" for="adv-class-@a.Id">Applicability</label>
                                                <select id="adv-class-@a.Id" class="form-select form-select-sm" @bind="_reviewClassification">
                                                    @foreach (var c in Enum.GetValues<AdvisoryClassification>())
                                                    {
                                                        <option value="@c">@c</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small mb-1" for="adv-verify-@a.Id">Verification</label>
                                                <select id="adv-verify-@a.Id" class="form-select form-select-sm" @bind="_reviewVerification">
                                                    @foreach (var v in Enum.GetValues<AdvisoryVerificationStatus>())
                                                    {
                                                        <option value="@v">@v</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-12"><label class="form-label small mb-1" for="adv-evidence-@a.Id">Evidence (required)</label><input id="adv-evidence-@a.Id" class="form-control form-control-sm" maxlength="1000" @bind="_reviewEvidence" @bind:event="oninput" data-testid="advisory-review-evidence" /></div>
                                            <div class="col-6"><label class="form-label small mb-1" for="adv-owner-@a.Id">Remediation owner</label><input id="adv-owner-@a.Id" class="form-control form-control-sm" maxlength="320" @bind="_reviewOwner" @bind:event="oninput" data-testid="advisory-review-owner" /></div>
                                            <div class="col-6">
                                                <label class="form-label small mb-1" for="adv-deadline-@a.Id">Remediation deadline</label>
                                                <input id="adv-deadline-@a.Id" type="date" class="form-control form-control-sm" @bind="_reviewDeadline" data-testid="advisory-review-deadline" />
                                            </div>
                                            <div class="col-6"><label class="form-label small mb-1" for="adv-target-@a.Id">Target patch</label><input id="adv-target-@a.Id" class="form-control form-control-sm" maxlength="200" @bind="_reviewTargetPatch" @bind:event="oninput" data-testid="advisory-review-target" /></div>
                                            <div class="col-6"><label class="form-label small mb-1" for="adv-vnotes-@a.Id">Verification notes</label><input id="adv-vnotes-@a.Id" class="form-control form-control-sm" maxlength="1000" @bind="_reviewVerificationNotes" @bind:event="oninput" /></div>
                                        </div>
                                        <p class="small text-muted mb-1">For a temporary exception instead of a fix, record it on the Exceptions page and set verification to Exception.</p>
                                        @if (_reviewError is not null)
                                        {
                                            <p class="small mb-1" role="alert" style="color:var(--dbt-failed);">@_reviewError</p>
                                        }
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveReview" data-testid="advisory-review-save">Save review</button>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="() => _reviewingId = null">Cancel</button>
                                    </div>
                                }
                                else if (!a.IsReviewed)
                                {
                                    <div class="d-flex gap-1 mt-1">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenReview(a, AdvisoryClassification.Confirmed)">Confirm</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenReview(a, AdvisoryClassification.NotApplicable)">Mark not applicable</button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => OpenReview(a, a.Classification)">Update review</button>
                                }
                            </AuthorizeView>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Version attestation &amp; observed-metadata drift</h2>
                <p class="small text-muted">
                    Versions are confirmed by manual attestation (above) or by entering what was observed or imported. DBTracker doesn't
                    connect to the database to collect versions itself.
                </p>

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small mb-1" for="observation-outcome">Outcome</label>
                            <select id="observation-outcome" class="form-select form-select-sm" @bind="_observationOutcome" data-testid="observation-outcome">
                                @foreach (var o in Enum.GetValues<ObservationOutcome>())
                                {
                                    <option value="@o">@o</option>
                                }
                            </select>
                        </div>
                        @if (_observationOutcome == ObservationOutcome.Success)
                        {
                            <div class="col-md-3">
                                <label class="visually-hidden" for="observation-input">Observed or imported raw version text</label>
                                <input id="observation-input" class="form-control form-control-sm" placeholder="Observed/imported raw version text" maxlength="200" @bind="_observationInput" @bind:event="oninput" />
                            </div>
                            <div class="col-md-3"><label class="form-label small mb-1" for="observation-edition">Observed edition</label><input id="observation-edition" class="form-control form-control-sm" maxlength="100" @bind="_observationEdition" @bind:event="oninput" /></div>
                            <div class="col-md-3"><label class="form-label small mb-1" for="observation-compat">Observed compatibility level</label><input id="observation-compat" class="form-control form-control-sm" maxlength="100" @bind="_observationCompat" @bind:event="oninput" /></div>
                        }
                        else
                        {
                            <div class="col-md-9"><label class="form-label small mb-1" for="observation-failure">What failed (required)</label><input id="observation-failure" class="form-control form-control-sm" placeholder="e.g. VIEW SERVER STATE denied for the inventory login" maxlength="500" @bind="_observationFailure" @bind:event="oninput" data-testid="observation-failure" /></div>
                        }
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecordObservation"
                                disabled="@(_observationOutcome == ObservationOutcome.Success ? string.IsNullOrWhiteSpace(_observationInput) : string.IsNullOrWhiteSpace(_observationFailure))">Record observation</button>
                        <a class="btn btn-link btn-sm" href="/lifecycle/import">Import observations from CSV</a>
                    </div>
                    <p class="small text-muted">A failed read is recorded as evidence of where metadata couldn't be collected. It never changes the declared identity.</p>
                </AuthorizeView>

                @if (_observations.Count == 0)
                {
                    <EmptyState Icon="clipboard-data" Compact="true">No observations recorded yet.</EmptyState>
                }
                else
                {
                    <table class="table table-sm mb-0 dbt-table" aria-label="Version observations">
                        <thead><tr><th scope="col">When</th><th scope="col">Source</th><th scope="col">Raw text</th><th scope="col">Outcome</th><th scope="col">Drift</th></tr></thead>
                        <tbody>
                            @foreach (var o in _observations)
                            {
                                <tr data-testid="observation-row">
                                    <td class="small"><LocalTime Utc="o.ObservedAtUtc" Format="MMM d, h:mm tt" ShowUtc="false" /></td>
                                    <td class="small">@o.Source</td>
                                    <td class="small">
                                        @o.RawVersionText
                                        @if (!string.IsNullOrWhiteSpace(o.ObservedEdition) || !string.IsNullOrWhiteSpace(o.ObservedCompatibilityLevel))
                                        {
                                            <span class="text-muted">(@string.Join(", ", new[] { o.ObservedEdition, string.IsNullOrWhiteSpace(o.ObservedCompatibilityLevel) ? "" : $"compat {o.ObservedCompatibilityLevel}" }.Where(s => !string.IsNullOrWhiteSpace(s))))</span>
                                        }
                                    </td>
                                    <td class="small">@o.Outcome@(string.IsNullOrWhiteSpace(o.FailureDetail) ? "" : $": {o.FailureDetail}")</td>
                                    <td class="small">@o.DriftStatus @(string.IsNullOrEmpty(o.DriftDetail) ? "" : $"({o.DriftDetail})")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private DatabaseInstance? _instance;
    private VersionIdentity? _identity;
    private List<ClusterNodeVersion> _clusterNodes = new();
    private SupportRunwayResult? _runway;
    private SupportRunwayDecision? _latestDecision;
    private PatchBaselineResult? _patchBaseline;
    private IReadOnlyList<RankedAdvisoryAssessment> _assessments = [];
    private List<VersionObservation> _observations = new();
    private ReleaseCatalogEntry? _matchedEntry;
    private bool _loaded, _loadFailed;
    private string? _userName;

    private string _rawVersionInput = "";
    private string _edition = "", _distribution = "", _patchTrain = "", _hostingProvider = "", _hostingContext = "", _hostingEngineVersion = "", _compatLevel = "";
    private string _newNodeName = "", _newNodeVersion = "";
    private SupportActionType _decisionActionType = SupportActionType.Patch;
    private string _decisionReference = "", _decisionNotes = "";
    private string _observationInput = "", _observationEdition = "", _observationCompat = "", _observationFailure = "";
    private ObservationOutcome _observationOutcome = ObservationOutcome.Success;

    // Advisory review form.
    private int? _reviewingId;
    private AdvisoryClassification _reviewClassification;
    private AdvisoryVerificationStatus _reviewVerification = AdvisoryVerificationStatus.Unverified;
    private string _reviewEvidence = "", _reviewOwner = "", _reviewTargetPatch = "", _reviewVerificationNotes = "";
    private DateTime? _reviewDeadline;
    private string? _reviewError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        await Retry();
    }

    private async Task Retry()
    {
        _loadFailed = false;
        try
        {
            await Load();
            _loaded = true;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private async Task Load()
    {
        var overview = await OverviewService.GetByIdAsync(Id);
        _instance = overview?.Instance;
        if (_instance is null)
        {
            return;
        }

        _identity = await IdentityService.GetByInstanceAsync(Id);
        _clusterNodes = await IdentityService.ListClusterNodesAsync(Id);

        var runwayView = await RunwayService.GetForInstanceAsync(Id);
        _runway = runwayView?.Runway;
        _latestDecision = runwayView?.LatestDecision;
        _matchedEntry = runwayView?.MatchedCatalogEntry;

        _patchBaseline = await PatchService.ComputeForInstanceAsync(Id);
        _assessments = await Advisories.ListRankedAssessmentsForInstanceAsync(Id);
        _observations = await Observations.ListForInstanceAsync(Id);

        if (_identity is not null)
        {
            _edition = _identity.Edition;
            _distribution = _identity.Distribution;
            _patchTrain = _identity.PatchTrain;
            _hostingProvider = _identity.HostingProvider;
            _hostingContext = _identity.HostingContext;
            _hostingEngineVersion = _identity.HostingEngineVersion;
            _compatLevel = _identity.DatabaseCompatibilityLevel;
            _rawVersionInput = _identity.RawVersionText;
        }
        else
        {
            _rawVersionInput = _instance.Version;
        }
    }

    private async Task SaveRawVersion()
    {
        await IdentityService.RecordManualRawVersionAsync(Id, _rawVersionInput, _userName ?? "unknown");
        Toasts.Success("Version identity saved.");
        await Load();
    }

    private async Task SaveMetadata()
    {
        await IdentityService.SetStructuredFieldsAsync(Id, _edition, _distribution, _patchTrain, _hostingProvider, _hostingContext.Trim(), _hostingEngineVersion, _compatLevel, _userName ?? "unknown");
        Toasts.Success("Version metadata saved.");
        await Load();
    }

    private async Task Attest()
    {
        await IdentityService.AttestAsync(Id, _userName ?? "unknown");
        Toasts.Success("Version identity attested.");
        await Load();
    }

    private async Task AddClusterNode()
    {
        await IdentityService.AddClusterNodeAsync(Id, _newNodeName, _newNodeVersion, "", _userName ?? "unknown");
        Toasts.Success($"Node \"{_newNodeName}\" recorded.");
        _newNodeName = _newNodeVersion = "";
        await Load();
    }

    private async Task RecordDecision()
    {
        await RunwayService.RecordDecisionAsync(Id, null, _decisionActionType, _decisionReference, _decisionNotes, _userName ?? "unknown");
        Toasts.Success("Decision recorded.");
        _decisionReference = _decisionNotes = "";
        await Load();
    }

    private async Task EvaluateRunwayNow()
    {
        var count = await RunwayService.EvaluateAndNotifyAsync();
        Toasts.Success(count > 0 ? $"{count} support-runway notice(s) raised." : "No new support-runway notices were due.");
        await Load();
    }

    private async Task EvaluateAdvisories()
    {
        var count = await Advisories.EvaluateForInstanceAsync(Id, _userName ?? "unknown");
        Toasts.Success(count > 0 ? $"{count} advisory(ies) evaluated." : "No advisories catalogued for this instance's family.");
        await Load();
    }

    private void OpenReview(AdvisoryInstanceAssessment a, AdvisoryClassification classification)
    {
        _reviewingId = a.Id;
        _reviewClassification = classification;
        _reviewVerification = a.IsReviewed ? a.VerificationStatus : AdvisoryVerificationStatus.Unverified;
        _reviewEvidence = a.ReviewerEvidence;
        _reviewOwner = string.IsNullOrWhiteSpace(a.Owner) ? (_instance?.ContactName ?? "") : a.Owner;
        _reviewDeadline = a.RemediationDeadlineUtc;
        _reviewTargetPatch = string.IsNullOrWhiteSpace(a.TargetPatch) ? (a.AdvisoryRecord?.FixedBuild ?? "") : a.TargetPatch;
        _reviewVerificationNotes = a.VerificationNotes;
        _reviewError = null;
    }

    private async Task SaveReview()
    {
        if (_reviewingId is not { } id || !await CanEditAsync())
        {
            return;
        }

        var deadline = _reviewDeadline is { } d ? DateTime.SpecifyKind(d.Date, DateTimeKind.Utc) : (DateTime?)null;
        var (ok, error) = await Advisories.ReviewAssessmentAsync(id, _reviewClassification, _reviewEvidence.Trim(), _reviewOwner.Trim(), deadline,
            _reviewTargetPatch.Trim(), _reviewVerification, _userName ?? "unknown", _reviewVerificationNotes.Trim());
        if (!ok)
        {
            _reviewError = error;
            return;
        }

        Toasts.Success("Advisory assessment reviewed.");
        _reviewingId = null;
        await Load();
    }

    private async Task RecordObservation()
    {
        if (!await CanEditAsync())
        {
            return;
        }

        if (_observationOutcome == ObservationOutcome.Success)
        {
            var observation = await Observations.RecordObservationAsync(Id, _observationInput.Trim(), VersionObservationSource.ManualEntry, _userName ?? "unknown",
                observedEdition: _observationEdition.Trim(), observedCompatibilityLevel: _observationCompat.Trim());
            Toasts.Success(observation.DriftStatus == DriftStatus.Drift ? "Observation recorded. It differs from the declared version identity." : "Observation recorded.");
        }
        else
        {
            await Observations.RecordFailureAsync(Id, _observationOutcome, _observationFailure.Trim(), _userName ?? "unknown", VersionObservationSource.ManualEntry);
            Toasts.Success($"Failed read recorded ({_observationOutcome}). The declared identity is unchanged.");
        }
        _observationInput = _observationEdition = _observationCompat = _observationFailure = "";
        _observationOutcome = ObservationOutcome.Success;
        await Load();
    }

    private async Task<bool> CanEditAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return Roles.CanEditPolicy.Split(',').Any(state.User.IsInRole);
    }

    private static string PositionText(BuildPosition position) => position switch
    {
        BuildPosition.Behind => "behind it",
        BuildPosition.Same => "on it",
        BuildPosition.Ahead => "ahead of it",
        _ => "not comparable (build not recorded on one side)"
    };

    private RenderFragment ReleaseNotes(ReleaseCatalogEntry entry) => @<text>@if (!string.IsNullOrWhiteSpace(entry.ReleaseNotesUrl))
    {
        <span> · <a href="@entry.ReleaseNotesUrl" target="_blank" rel="noopener noreferrer">release notes</a></span>
    }</text>;

    private static string OrNotRecorded(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;

    private static string ResolutionCssClass(VersionResolutionStatus status) => status switch
    {
        VersionResolutionStatus.Resolved => "OnTrack",
        VersionResolutionStatus.NeedsReview => "Overdue",
        _ => "Failed"
    };

    private static string PhaseCssClass(SupportPhase phase) => phase switch
    {
        SupportPhase.Mainstream => "OnTrack",
        SupportPhase.Extended or SupportPhase.Esu => "Overdue",
        SupportPhase.EndOfLife => "Failed",
        _ => "Overdue"
    };

    private static string AdvisoryCssClass(AdvisoryClassification classification) => classification switch
    {
        AdvisoryClassification.NotApplicable => "OnTrack",
        AdvisoryClassification.Potential => "Overdue",
        AdvisoryClassification.Confirmed => "Failed",
        _ => "Overdue"
    };
}
