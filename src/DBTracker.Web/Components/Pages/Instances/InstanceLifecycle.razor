@page "/instances/{Id:int}/lifecycle"
@attribute [Authorize]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.Lifecycle
@using DBTracker.Infrastructure.Queries
@using DBTracker.Infrastructure.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject InstanceOverviewService OverviewService
@inject VersionIdentityService IdentityService
@inject SupportRunwayService RunwayService
@inject PatchBaselineService PatchService
@inject AdvisoryService Advisories
@inject VersionObservationService Observations
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>@(_instance?.Name ?? "Instance") lifecycle · DBTracker</PageTitle>

@if (_loadFailed)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Couldn't load lifecycle data. The database may be unreachable.</div>
        <button type="button" class="btn btn-outline-secondary" @onclick="Retry">Try again</button>
    </div>
}
else if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading lifecycle data…</span></div>
}
else if (_instance is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i class="bi bi-question-diamond" aria-hidden="true"></i> Instance #@Id doesn't exist.</div>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <h1>@_instance.Name</h1>
            <div class="subtitle">
                Version identity and support lifecycle · @_instance.Engine · <a href="/instances/@Id">Back to instance detail</a><br />
                Release availability, lifecycle risk, security exposure and backup health are tracked separately. A newer release alone doesn't make a migration required.
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Installed-version identity</h2>

                @if (_identity is null)
                {
                    <div class="empty-state py-3"><i class="bi bi-patch-question" aria-hidden="true"></i> No structured identity recorded yet.</div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-health dot @ResolutionCssClass(_identity.ResolutionStatus)">@_identity.ResolutionStatus</span>
                        @if (_identity.IsAttested)
                        {
                            <span class="small text-muted"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> Attested by @_identity.AttestedBy on @_identity.AttestedAtUtc?.ToLocalTime().ToString("MMM d, yyyy")</span>
                        }
                        else
                        {
                            <span class="small text-muted">Not attested</span>
                        }
                    </div>
                    <p class="small mb-1">Raw text: <code>@_identity.RawVersionText</code></p>
                    @if (_identity.ResolutionStatus != VersionResolutionStatus.Resolved)
                    {
                        <p class="small mb-2" style="color:var(--dbt-overdue);">@_identity.UnresolvedReason<br />Unresolved or unrecognized versions are never treated as compliant.</p>
                    }
                    else
                    {
                        <p class="small mb-2">
                            @_identity.Family @_identity.Major@(_identity.Minor is { } mn ? $".{mn}" : "")@(string.IsNullOrEmpty(_identity.Build) ? "" : $" build {_identity.Build}")
                            @(string.IsNullOrEmpty(_identity.Edition) ? "" : $" ({_identity.Edition})")
                        </p>
                    }
                    <dl class="row small mb-2">
                        <dt class="col-5">Distribution</dt><dd class="col-7">@OrNotRecorded(_identity.Distribution)</dd>
                        <dt class="col-5">Patch train</dt><dd class="col-7">@OrNotRecorded(_identity.PatchTrain)</dd>
                        <dt class="col-5">Hosting engine version</dt><dd class="col-7">@OrNotRecorded(_identity.HostingEngineVersion)</dd>
                        <dt class="col-5">DB compatibility level</dt><dd class="col-7">@OrNotRecorded(_identity.DatabaseCompatibilityLevel)</dd>
                        <dt class="col-5">Hosting provider</dt><dd class="col-7">@OrNotRecorded(_identity.HostingProvider)</dd>
                        <dt class="col-5">Observed</dt><dd class="col-7">@_identity.ObservedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt") (@_identity.ObservationSource)</dd>
                    </dl>

                    @if (_clusterNodes.Count > 0)
                    {
                        <p class="small text-muted mb-1">Cluster-node versions, recorded separately from the Region, Cluster and ReplicaSet fields:</p>
                        <ul class="small mb-2">
                            @foreach (var n in _clusterNodes)
                            {
                                <li>@n.NodeName: @n.RawVersionText (@n.ResolutionStatus)</li>
                            }
                        </ul>
                    }
                }

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <hr />
                    <div class="mb-2">
                        <label class="form-label small" for="raw-version">Raw version text, as reported or imported</label>
                        <div class="d-flex gap-2">
                            <input id="raw-version" class="form-control form-control-sm" @bind="_rawVersionInput" @bind:event="oninput" placeholder="e.g. 16.2, 2019 CU18, 10.6.16-MariaDB" aria-describedby="raw-version-help" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SaveRawVersion" disabled="@string.IsNullOrWhiteSpace(_rawVersionInput)">Resolve &amp; save</button>
                        </div>
                        <div class="form-text" id="raw-version-help">If the text can't be matched to a known release, it's saved as Unresolved. That's a correct result, not an error.</div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6"><label class="form-label small mb-1" for="id-edition">Edition</label><input id="id-edition" class="form-control form-control-sm" placeholder="Edition" @bind="_edition" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-distribution">Distribution</label><input id="id-distribution" class="form-control form-control-sm" placeholder="Distribution" @bind="_distribution" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-patch-train">Patch train</label><input id="id-patch-train" class="form-control form-control-sm" placeholder="Patch train" @bind="_patchTrain" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-provider">Hosting provider</label><input id="id-provider" class="form-control form-control-sm" placeholder="Hosting provider" @bind="_hostingProvider" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-host-engine">Hosting engine version</label><input id="id-host-engine" class="form-control form-control-sm" placeholder="Hosting engine version" @bind="_hostingEngineVersion" @bind:event="oninput" /></div>
                        <div class="col-6"><label class="form-label small mb-1" for="id-compat">DB compatibility level</label><input id="id-compat" class="form-control form-control-sm" placeholder="DB compatibility level" @bind="_compatLevel" @bind:event="oninput" /></div>
                    </div>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SaveMetadata" disabled="@(_identity is null)">Save metadata</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Attest" disabled="@(_identity is null)"><i class="bi bi-patch-check" aria-hidden="true"></i> Attest current identity</button>
                    </div>

                    <div class="d-flex gap-2">
                        <label class="visually-hidden" for="node-name">Node name</label>
                        <input id="node-name" class="form-control form-control-sm" placeholder="Node name" @bind="_newNodeName" @bind:event="oninput" style="max-width:160px;" />
                        <label class="visually-hidden" for="node-version">Node version text</label>
                        <input id="node-version" class="form-control form-control-sm" placeholder="Node version text" @bind="_newNodeVersion" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddClusterNode" disabled="@(string.IsNullOrWhiteSpace(_newNodeName) || string.IsNullOrWhiteSpace(_newNodeVersion))">Add node</button>
                    </div>
                </AuthorizeView>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Support runway</h2>

                @if (_runway is null)
                {
                    <div class="empty-state py-3"><i class="bi bi-hourglass" aria-hidden="true"></i> Not yet evaluated.</div>
                }
                else if (_runway.IsUnknown)
                {
                    <div class="small" style="color:var(--dbt-overdue);"><i class="bi bi-patch-question" aria-hidden="true"></i> Unknown, needs review: @_runway.UnknownReason</div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-health dot @PhaseCssClass(_runway.Phase)">@_runway.Phase</span>
                        <span class="small">@_runway.NextMilestoneLabel: @_runway.NextMilestoneUtc?.ToString("yyyy-MM-dd")</span>
                    </div>
                    <p class="small mb-2" data-testid="runway-days">
                        @if (_runway.DaysToNextMilestone is { } d && d <= 0)
                        {
                            <span style="color:var(--dbt-failed);">@Math.Abs(d) day(s) overdue.</span>
                        }
                        else
                        {
                            <span>@_runway.DaysToNextMilestone day(s) remaining.</span>
                        }
                    </p>
                }

                @if (_latestDecision is not null)
                {
                    <p class="small text-muted mb-2">Last decision: <strong>@_latestDecision.ActionType</strong>, @_latestDecision.ActionReference (by @_latestDecision.DecidedBy, @_latestDecision.DecidedAtUtc.ToLocalTime().ToString("MMM d, yyyy"))</p>
                }

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <hr />
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-1" for="decision-action">Decision</label>
                            <select id="decision-action" class="form-select form-select-sm" @bind="_decisionActionType">
                                @foreach (var t in Enum.GetValues<SupportActionType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-6"><label class="form-label small mb-1" for="decision-reference">Reference (required)</label><input id="decision-reference" class="form-control form-control-sm" placeholder="Reference (ticket/plan link)" @bind="_decisionReference" @bind:event="oninput" /></div>
                    </div>
                    <div class="d-flex gap-2">
                        <label class="visually-hidden" for="decision-notes">Decision notes</label>
                        <input id="decision-notes" class="form-control form-control-sm" placeholder="Notes" @bind="_decisionNotes" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecordDecision" disabled="@string.IsNullOrWhiteSpace(_decisionReference)">Record decision</button>
                    </div>
                    <div class="mt-2">
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="EvaluateRunwayNow">Evaluate support-runway notices now (admin/DBA action, mirrors the background sweep)</button>
                    </div>
                </AuthorizeView>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Release availability &amp; patch baseline</h2>

                @if (_patchBaseline is null)
                {
                    <div class="empty-state py-3"><i class="bi bi-box-seam" aria-hidden="true"></i> Record a resolved version identity first.</div>
                }
                else
                {
                    <dl class="row small mb-0">
                        <dt class="col-5">Installed</dt><dd class="col-7">@_patchBaseline.InstalledLabel</dd>
                        <dt class="col-5">Latest applicable branch patch</dt>
                        <dd class="col-7">@(_patchBaseline.LatestApplicableBranchPatch is { } p1 ? $"{p1.ReleaseLabel} ({p1.Build})" : "None catalogued")</dd>
                        <dt class="col-5">Newest relevant GA</dt>
                        <dd class="col-7">@(_patchBaseline.NewestRelevantGA is { } p2 ? p2.ReleaseLabel : "None catalogued")</dd>
                        <dt class="col-5">Approved organizational target</dt>
                        <dd class="col-7">
                            @(_patchBaseline.ApprovedTarget is { } p3 ? p3.ReleaseLabel : "None approved")
                            @if (_patchBaseline.IsMajorUpgradeFromApproved)
                            {
                                <span class="small text-muted"> (a major-version migration, not a same-branch patch)</span>
                            }
                        </dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_patchBaseline.Notes))
                    {
                        <p class="small text-muted mt-2 mb-0">@_patchBaseline.Notes</p>
                    }
                    <p class="small text-muted mt-2 mb-0">Preview releases are excluded by default. The approved target is never picked automatically from the newest GA; only a reviewed baseline sets it.</p>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Advisory applicability</h2>

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-2" @onclick="EvaluateAdvisories">Evaluate advisories for this instance</button>
                </AuthorizeView>

                @if (_assessments.Count == 0)
                {
                    <div class="empty-state py-3"><i class="bi bi-shield-check" aria-hidden="true"></i> No advisories evaluated against this instance.</div>
                }
                else
                {
                    @foreach (var a in _assessments)
                    {
                        <div class="mb-2 pb-2" style="border-bottom:1px solid var(--dbt-line);">
                            <div class="d-flex justify-content-between">
                                <strong class="small">@a.AdvisoryRecord?.VendorAdvisoryId: @a.AdvisoryRecord?.Title</strong>
                                <span class="badge-health dot @AdvisoryCssClass(a.Classification)">@a.Classification</span>
                            </div>
                            <p class="small text-muted mb-1">@a.ClassificationReasoning</p>
                            @if (a.IsReviewed)
                            {
                                <p class="small mb-0">Reviewed by @a.ReviewedBy, verification: @a.VerificationStatus@(string.IsNullOrEmpty(a.Owner) ? "" : $", owner {a.Owner}")</p>
                            }
                            else
                            {
                                <AuthorizeView Roles="@Roles.CanEditPolicy">
                                    <div class="d-flex gap-1 mt-1">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ReviewAssessment(a.Id, AdvisoryClassification.Confirmed)">Confirm</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ReviewAssessment(a.Id, AdvisoryClassification.NotApplicable)">Mark not applicable</button>
                                    </div>
                                </AuthorizeView>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted text-uppercase mb-3">Version attestation &amp; observed-metadata drift</h2>
                <p class="small text-muted">
                    Versions are confirmed by manual attestation (above) or by entering what was observed or imported. DBTracker doesn't
                    connect to the database to collect versions itself.
                </p>

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <div class="d-flex gap-2 mb-3">
                        <label class="visually-hidden" for="observation-input">Observed or imported raw version text</label>
                        <input id="observation-input" class="form-control form-control-sm" placeholder="Observed/imported raw version text" @bind="_observationInput" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecordObservation" disabled="@string.IsNullOrWhiteSpace(_observationInput)">Record observation</button>
                    </div>
                </AuthorizeView>

                @if (_observations.Count == 0)
                {
                    <div class="empty-state py-3"><i class="bi bi-clipboard-data" aria-hidden="true"></i> No observations recorded yet.</div>
                }
                else
                {
                    <table class="table table-sm mb-0 dbt-table" aria-label="Version observations">
                        <thead><tr><th scope="col">When</th><th scope="col">Source</th><th scope="col">Raw text</th><th scope="col">Outcome</th><th scope="col">Drift</th></tr></thead>
                        <tbody>
                            @foreach (var o in _observations)
                            {
                                <tr>
                                    <td class="small">@o.ObservedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td class="small">@o.Source</td>
                                    <td class="small">@o.RawVersionText</td>
                                    <td class="small">@o.Outcome</td>
                                    <td class="small">@o.DriftStatus @(string.IsNullOrEmpty(o.DriftDetail) ? "" : $"({o.DriftDetail})")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private DatabaseInstance? _instance;
    private VersionIdentity? _identity;
    private List<ClusterNodeVersion> _clusterNodes = new();
    private SupportRunwayResult? _runway;
    private SupportRunwayDecision? _latestDecision;
    private PatchBaselineResult? _patchBaseline;
    private List<AdvisoryInstanceAssessment> _assessments = new();
    private List<VersionObservation> _observations = new();
    private bool _loaded, _loadFailed;
    private string? _userName;

    private string _rawVersionInput = "";
    private string _edition = "", _distribution = "", _patchTrain = "", _hostingProvider = "", _hostingEngineVersion = "", _compatLevel = "";
    private string _newNodeName = "", _newNodeVersion = "";
    private SupportActionType _decisionActionType = SupportActionType.Patch;
    private string _decisionReference = "", _decisionNotes = "";
    private string _observationInput = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        await Retry();
    }

    private async Task Retry()
    {
        _loadFailed = false;
        try
        {
            await Load();
            _loaded = true;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private async Task Load()
    {
        var overview = await OverviewService.GetByIdAsync(Id);
        _instance = overview?.Instance;
        if (_instance is null)
        {
            return;
        }

        _identity = await IdentityService.GetByInstanceAsync(Id);
        _clusterNodes = await IdentityService.ListClusterNodesAsync(Id);

        var runwayView = await RunwayService.GetForInstanceAsync(Id);
        _runway = runwayView?.Runway;
        _latestDecision = runwayView?.LatestDecision;

        _patchBaseline = await PatchService.ComputeForInstanceAsync(Id);
        _assessments = await Advisories.ListAssessmentsForInstanceAsync(Id);
        _observations = await Observations.ListForInstanceAsync(Id);

        if (_identity is not null)
        {
            _edition = _identity.Edition;
            _distribution = _identity.Distribution;
            _patchTrain = _identity.PatchTrain;
            _hostingProvider = _identity.HostingProvider;
            _hostingEngineVersion = _identity.HostingEngineVersion;
            _compatLevel = _identity.DatabaseCompatibilityLevel;
            _rawVersionInput = _identity.RawVersionText;
        }
        else
        {
            _rawVersionInput = _instance.Version;
        }
    }

    private async Task SaveRawVersion()
    {
        await IdentityService.RecordManualRawVersionAsync(Id, _rawVersionInput, _userName ?? "unknown");
        Toasts.Success("Version identity saved.");
        await Load();
    }

    private async Task SaveMetadata()
    {
        await IdentityService.SetStructuredFieldsAsync(Id, _edition, _distribution, _patchTrain, _hostingProvider, "", _hostingEngineVersion, _compatLevel, _userName ?? "unknown");
        Toasts.Success("Version metadata saved.");
        await Load();
    }

    private async Task Attest()
    {
        await IdentityService.AttestAsync(Id, _userName ?? "unknown");
        Toasts.Success("Version identity attested.");
        await Load();
    }

    private async Task AddClusterNode()
    {
        await IdentityService.AddClusterNodeAsync(Id, _newNodeName, _newNodeVersion, "", _userName ?? "unknown");
        Toasts.Success($"Node \"{_newNodeName}\" recorded.");
        _newNodeName = _newNodeVersion = "";
        await Load();
    }

    private async Task RecordDecision()
    {
        await RunwayService.RecordDecisionAsync(Id, null, _decisionActionType, _decisionReference, _decisionNotes, _userName ?? "unknown");
        Toasts.Success("Decision recorded.");
        _decisionReference = _decisionNotes = "";
        await Load();
    }

    private async Task EvaluateRunwayNow()
    {
        var count = await RunwayService.EvaluateAndNotifyAsync();
        Toasts.Success(count > 0 ? $"{count} support-runway notice(s) raised." : "No new support-runway notices were due.");
        await Load();
    }

    private async Task EvaluateAdvisories()
    {
        var count = await Advisories.EvaluateForInstanceAsync(Id, _userName ?? "unknown");
        Toasts.Success(count > 0 ? $"{count} advisory(ies) evaluated." : "No advisories catalogued for this instance's family.");
        await Load();
    }

    private async Task ReviewAssessment(int assessmentId, AdvisoryClassification classification)
    {
        await Advisories.ReviewAssessmentAsync(assessmentId, classification, $"Reviewed from instance lifecycle page by {_userName}.",
            "", null, "", AdvisoryVerificationStatus.Verified, _userName ?? "unknown");
        Toasts.Success("Advisory assessment reviewed.");
        await Load();
    }

    private async Task RecordObservation()
    {
        var observation = await Observations.RecordObservationAsync(Id, _observationInput, VersionObservationSource.ManualEntry, _userName ?? "unknown");
        Toasts.Success(observation.DriftStatus == DriftStatus.Drift ? "Observation recorded. It differs from the declared version identity." : "Observation recorded.");
        _observationInput = "";
        await Load();
    }

    private static string OrNotRecorded(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;

    private static string ResolutionCssClass(VersionResolutionStatus status) => status switch
    {
        VersionResolutionStatus.Resolved => "OnTrack",
        VersionResolutionStatus.NeedsReview => "Overdue",
        _ => "Failed"
    };

    private static string PhaseCssClass(SupportPhase phase) => phase switch
    {
        SupportPhase.Mainstream => "OnTrack",
        SupportPhase.Extended or SupportPhase.Esu => "Overdue",
        SupportPhase.EndOfLife => "Failed",
        _ => "Overdue"
    };

    private static string AdvisoryCssClass(AdvisoryClassification classification) => classification switch
    {
        AdvisoryClassification.NotApplicable => "OnTrack",
        AdvisoryClassification.Potential => "Overdue",
        AdvisoryClassification.Confirmed => "Failed",
        _ => "Overdue"
    };
}
