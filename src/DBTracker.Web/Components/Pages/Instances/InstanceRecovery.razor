@page "/instances/{Id:int}/recovery"
@attribute [Authorize]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.Identity
@using DBTracker.Infrastructure.Queries
@using DBTracker.Infrastructure.Recovery
@using Microsoft.AspNetCore.Components.Authorization
@inject InstanceOverviewService OverviewService
@inject RecoveryObjectiveService Recovery
@inject BackupCopyLocationService Copies
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>@(_instance?.Name ?? "Instance") recovery evidence · DBTracker</PageTitle>

@if (_loadFailed)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Couldn't load recovery evidence. The database may be unreachable.</div>
        <button type="button" class="btn btn-outline-secondary" @onclick="Retry">Try again</button>
    </div>
}
else if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading recovery evidence…</span></div>
}
else if (_instance is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i class="bi bi-question-diamond" aria-hidden="true"></i> Instance #@Id doesn't exist.</div>
        <a class="btn btn-outline-secondary" href="/instances">Back to instances</a>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <h1>@_instance.Name</h1>
            <div class="subtitle">
                Recovery objectives and backup copies · @_instance.Engine · <a href="/instances/@Id">Back to instance detail</a><br />
                Chain coverage stays Unknown until evidence proves otherwise. A recent log, WAL or binlog backup alone doesn't prove a valid base backup or full recoverability.
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Recovery objectives</h2>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1" for="rpo-minutes">RPO target (minutes)</label>
                        <input id="rpo-minutes" type="number" min="0" class="form-control form-control-sm" @bind="_rpoMinutes" disabled="@(!_canEdit)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1" for="rto-minutes">RTO target (minutes)</label>
                        <input id="rto-minutes" type="number" min="0" class="form-control form-control-sm" @bind="_rtoMinutes" disabled="@(!_canEdit)" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1" for="encryption-note">Encryption-key dependency reference</label>
                    <input id="encryption-note" class="form-control form-control-sm" @bind="_encryptionNote" @bind:event="oninput" disabled="@(!_canEdit)" aria-describedby="encryption-note-help" />
                    <div class="form-text" id="encryption-note-help">Full key tracking is on the <a href="/instances/@Id/certificates">certificates page</a>.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1" for="offsite-note">Offsite-copy dependency reference</label>
                    <input id="offsite-note" class="form-control form-control-sm" @bind="_offsiteNote" @bind:event="oninput" disabled="@(!_canEdit)" aria-describedby="offsite-note-help" />
                    <div class="form-text" id="offsite-note-help">Copy locations are tracked in the backup-copy section below.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1" for="objective-notes">Notes</label>
                    <textarea id="objective-notes" class="form-control form-control-sm" rows="2" @bind="_objectiveNotes" @bind:event="oninput" disabled="@(!_canEdit)"></textarea>
                </div>
                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveObjective" data-testid="save-recovery-objective">Save objectives</button>
                </AuthorizeView>

                @if (_recentRestores.Count > 0)
                {
                    <hr />
                    <p class="small text-muted mb-1">Measured restore durations, taken from the restore log on the instance detail page:</p>
                    <ul class="small mb-0">
                        @foreach (var r in _recentRestores.Take(3))
                        {
                            <li>@r.TimestampUtc.ToString("MMM d, yyyy"): @r.Outcome @(r.DurationMinutes is { } d ? $"({d:N0} min)" : "(duration not recorded)")</li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Backup-chain coverage</h2>

                <div class="mb-3" data-testid="chain-coverage-status">
                    <span class="badge-health dot @CoverageCssClass(_coverage!.Status)">@_coverage.Status</span>
                    @if (_coverage.RecoverablePointUtc is { } point)
                    {
                        <span class="small text-muted ms-2">Recoverable to @point.ToString("MMM d, yyyy h:mm tt") UTC</span>
                    }
                    else
                    {
                        <span class="small text-muted ms-2">No recoverable point established from recorded evidence.</span>
                    }
                </div>

                @if (_coverage.MissingReasons.Count > 0)
                {
                    <ul class="small mb-2" style="color:var(--dbt-overdue);" data-testid="chain-missing-reasons">
                        @foreach (var reason in _coverage.MissingReasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }

                @if (_chainRequirements.Count > 0)
                {
                    <div class="table-responsive mb-3" role="region" aria-label="Chain requirements" tabindex="0">
                        <table class="table table-sm dbt-table mb-0" data-testid="chain-requirement-table">
                            <thead><tr><th scope="col">Member</th><th scope="col">Required</th><th scope="col">Max age (h)</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                            <tbody>
                                @foreach (var req in _chainRequirements)
                                {
                                    <tr data-testid="chain-requirement-row">
                                        <td class="small">@req.MemberType</td>
                                        <td class="small">@(req.IsRequired ? "Yes" : "No")</td>
                                        <td class="small">@(req.MaxAgeHoursOverride?.ToString() ?? "default")</td>
                                        <td class="small">
                                            <AuthorizeView Roles="@Roles.CanEditPolicy">
                                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => RemoveRequirement(req.Id)">Remove</button>
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-2"><i class="bi bi-link" aria-hidden="true"></i> No chain members recorded. Coverage stays Unknown until at least one is added.</div>
                }

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-5">
                            <label class="form-label small mb-1" for="chain-member-type">Chain member</label>
                            <select id="chain-member-type" class="form-select form-select-sm" @bind="_newMemberType">
                                @foreach (var m in Enum.GetValues<ChainMemberType>())
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small mb-1" for="chain-max-age">Max age (hours)</label>
                            <input id="chain-max-age" type="number" min="1" class="form-control form-control-sm" placeholder="Max age (h), optional" @bind="_newMaxAgeHours" />
                        </div>
                        <div class="col-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick="AddRequirement" data-testid="add-chain-requirement">Add to chain</button>
                        </div>
                    </div>
                </AuthorizeView>
            </div>
        </div>

        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Backup-copy availability and retention</h2>
                <p class="small text-muted">Finding a copy once doesn't mean it is available now. Only a current, recent verification that the copy is accessible counts toward retention coverage.</p>

                <div class="mb-3" data-testid="retention-coverage-status">
                    <span class="badge-health dot @RetentionCssClass(_retention!.Coverage.Status)">@_retention.Coverage.Status</span>
                    <span class="small text-muted ms-2">@_retention.Coverage.Reasoning</span>
                </div>

                @if (_copies.Count > 0)
                {
                    <div class="table-responsive mb-3" role="region" aria-label="Backup copy locations" tabindex="0">
                        <table class="table table-sm dbt-table mb-0" data-testid="copy-location-table">
                            <thead><tr><th scope="col">Label</th><th scope="col">Path/reference</th><th scope="col">Offsite</th><th scope="col">Immutable-flagged</th><th scope="col">Verification</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                            <tbody>
                                @foreach (var copy in _copies)
                                {
                                    <tr data-testid="copy-location-row">
                                        <td class="small">@copy.Label</td>
                                        <td class="small" data-testid="copy-path">@copy.StoragePathOrReference</td>
                                        <td class="small">@(copy.IsOffsite ? "Yes" : "No")</td>
                                        <td class="small">@(copy.IsImmutableFlagged ? "Yes" : "No")</td>
                                        <td class="small" data-testid="copy-verification-status">
                                            <span class="badge-health dot @VerificationCssClass(copy.VerificationStatus)">@copy.VerificationStatus</span>
                                        </td>
                                        <td class="small">
                                            <AuthorizeView Roles="@Roles.CanEditPolicy">
                                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => MarkVerification(copy.Id, CopyVerificationStatus.Accessible)">Mark accessible</button>
                                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => MarkVerification(copy.Id, CopyVerificationStatus.CannotVerify)">Mark cannot verify</button>
                                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => MarkVerification(copy.Id, CopyVerificationStatus.Missing)">Mark missing</button>
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-2"><i class="bi bi-hdd-network" aria-hidden="true"></i> No copy locations recorded yet.</div>
                }

                <AuthorizeView Roles="@Roles.CanEditPolicy">
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-3"><label class="form-label small mb-1" for="copy-label">Label (required)</label><input id="copy-label" class="form-control form-control-sm" placeholder="Label" @bind="_newCopyLabel" @bind:event="oninput" /></div>
                        <div class="col-md-5"><label class="form-label small mb-1" for="copy-path">Storage path, URL or bucket</label><input id="copy-path" class="form-control form-control-sm" placeholder="Storage path/URL/bucket reference" @bind="_newCopyPath" @bind:event="oninput" /></div>
                        <div class="col-md-2 form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="newCopyOffsite" @bind="_newCopyOffsite" />
                            <label class="form-check-label small" for="newCopyOffsite">Offsite</label>
                        </div>
                        <div class="col-md-2 form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="newCopyImmutable" @bind="_newCopyImmutable" />
                            <label class="form-check-label small" for="newCopyImmutable">Immutable-flagged</label>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddCopy" disabled="@string.IsNullOrWhiteSpace(_newCopyLabel)" data-testid="add-copy-location">Record copy location</button>
                </AuthorizeView>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private DatabaseInstance? _instance;
    private bool _loaded, _loadFailed;
    private bool _canEdit;
    private string? _userName;

    private int? _rpoMinutes;
    private int? _rtoMinutes;
    private string _encryptionNote = "", _offsiteNote = "", _objectiveNotes = "";
    private List<RestoreEvent> _recentRestores = new();

    private List<BackupChainRequirement> _chainRequirements = new();
    private BackupChainCoverageResult? _coverage;
    private ChainMemberType _newMemberType = ChainMemberType.Base;
    private int? _newMaxAgeHours;

    private List<BackupCopyLocation> _copies = new();
    private RetentionEvidenceView? _retention;
    private string _newCopyLabel = "", _newCopyPath = "";
    private bool _newCopyOffsite, _newCopyImmutable;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        _canEdit = state.User.IsInRole(Roles.Admin) || state.User.IsInRole(Roles.Dba);
        await Retry();
    }

    private async Task Retry()
    {
        _loadFailed = false;
        try
        {
            await Load();
            _loaded = true;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
    }

    private async Task Load()
    {
        var overview = await OverviewService.GetByIdAsync(Id);
        _instance = overview?.Instance;
        if (_instance is null)
        {
            return;
        }

        var evidence = await Recovery.GetForInstanceAsync(Id);
        if (evidence is not null)
        {
            _rpoMinutes = evidence.Objective?.RpoTargetMinutes;
            _rtoMinutes = evidence.Objective?.RtoTargetMinutes;
            _encryptionNote = evidence.Objective?.EncryptionKeyReferenceNote ?? "";
            _offsiteNote = evidence.Objective?.OffsiteCopyReferenceNote ?? "";
            _objectiveNotes = evidence.Objective?.Notes ?? "";
            _chainRequirements = evidence.ChainRequirements.ToList();
            _coverage = evidence.Coverage;
            _recentRestores = evidence.RecentRestores.ToList();
        }

        _retention = await Copies.GetRetentionEvidenceAsync(Id, _canEdit);
        _copies = _retention?.Copies.ToList() ?? new();
    }

    private async Task SaveObjective()
    {
        await Recovery.SetObjectiveAsync(Id, _rpoMinutes, _rtoMinutes, _encryptionNote, _offsiteNote, _objectiveNotes, _userName ?? "unknown");
        Toasts.Success("Recovery objectives saved.");
        await Load();
    }

    private async Task AddRequirement()
    {
        await Recovery.AddChainRequirementAsync(Id, _newMemberType, true, _newMaxAgeHours, "", _userName ?? "unknown");
        Toasts.Success($"{_newMemberType} added to the required backup chain.");
        _newMaxAgeHours = null;
        await Load();
    }

    private async Task RemoveRequirement(int requirementId)
    {
        await Recovery.RemoveChainRequirementAsync(requirementId, _userName ?? "unknown");
        Toasts.Success("Chain requirement removed.");
        await Load();
    }

    private async Task AddCopy()
    {
        await Copies.AddAsync(new BackupCopyLocation
        {
            DatabaseInstanceId = Id,
            Label = _newCopyLabel,
            StoragePathOrReference = _newCopyPath,
            IsOffsite = _newCopyOffsite,
            IsImmutableFlagged = _newCopyImmutable
        }, _userName ?? "unknown");
        Toasts.Success($"Copy location \"{_newCopyLabel}\" recorded.");
        _newCopyLabel = _newCopyPath = "";
        _newCopyOffsite = _newCopyImmutable = false;
        await Load();
    }

    private async Task MarkVerification(int copyId, CopyVerificationStatus status)
    {
        await Copies.SetVerificationAsync(copyId, status, "", _userName ?? "unknown");
        Toasts.Success($"Verification recorded: {status}.");
        await Load();
    }

    private static string CoverageCssClass(ChainCoverageStatus status) => status switch
    {
        ChainCoverageStatus.Complete => "OnTrack",
        ChainCoverageStatus.Incomplete => "Failed",
        _ => "Overdue"
    };

    private static string RetentionCssClass(RetentionCoverageStatus status) => status switch
    {
        RetentionCoverageStatus.Compliant => "OnTrack",
        RetentionCoverageStatus.Gap => "Failed",
        _ => "Overdue"
    };

    private static string VerificationCssClass(CopyVerificationStatus status) => status switch
    {
        CopyVerificationStatus.Accessible => "OnTrack",
        CopyVerificationStatus.Missing => "Failed",
        CopyVerificationStatus.CannotVerify => "Overdue",
        _ => "Overdue"
    };
}
