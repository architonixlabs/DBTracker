@page "/campaigns/{Id:int}"
@attribute [Authorize(Roles = Roles.CanEditPolicy)]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.Identity
@using DBTracker.Infrastructure.MigrationPlanning
@using DBTracker.Infrastructure.ChangeManagement
@using DBTracker.Infrastructure.Queries
@using Microsoft.AspNetCore.Components.Authorization
@inject CampaignService Campaigns
@inject CampaignCompletionGateService CompletionGate
@inject InstanceOverviewService OverviewService
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>@(_campaign?.Name ?? "Campaign") · DBTracker</PageTitle>

@if (!_loaded)
{
    <div class="spinner-ring"></div>
}
else if (_campaign is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i class="bi bi-question-diamond"></i> Campaign #@Id doesn't exist.</div>
        <a class="btn btn-outline-secondary" href="/campaigns">Back to campaigns</a>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <div class="eyebrow">Migration campaign · Epic 19 (D10)</div>
            <h1>@_campaign.Name <span class="badge-health dot Overdue" data-testid="campaign-detail-state">@_campaign.State</span></h1>
            <div class="subtitle">
                @_campaign.SourceLabel → @_campaign.TargetLabel · @_campaign.ChosenMethod · <a href="/campaigns">Back to campaigns</a> ·
                <a href="/campaigns/@Id/rehearsals">Rehearsals (D11)</a> ·
                <a href="/campaigns/@Id/change-windows">Change windows (D12)</a> ·
                <a href="/campaigns/@Id/validation">Validation (D13)</a> ·
                <a href="/exceptions">Exceptions (D14)</a>
            </div>
        </div>
    </div>

    @if (_completionGate is not null)
    {
        <div class="dbt-card mb-3" data-testid="completion-gate-banner" style="border-color:@(_completionGate.CanComplete ? "var(--dbt-ontrack)" : "var(--dbt-overdue)");">
            @if (_completionGate.CanComplete)
            {
                <strong style="color:var(--dbt-ontrack);"><i class="bi bi-check-circle"></i> Completion readiness: ready.</strong>
                @if (_completionGate.UsedException)
                {
                    <span class="small"> — proceeding on an active D14 exception, not full evidence.</span>
                }
            }
            else
            {
                <strong style="color:var(--dbt-overdue);"><i class="bi bi-exclamation-triangle"></i> Completion readiness: blocked.</strong>
                <ul class="small mb-0">
                    @foreach (var r in _completionGate.BlockingReasons)
                    {
                        <li>@r</li>
                    }
                </ul>
                <span class="small text-muted">Resolve the evidence above, or record a scoped D14 exception, before this campaign can reach Completed.</span>
            }
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Overview</h2>
                <dl class="row small mb-2">
                    <dt class="col-5">Reason</dt><dd class="col-7">@EmDash(_campaign.Reason)</dd>
                    <dt class="col-5">Change ticket</dt><dd class="col-7">@EmDash(_campaign.ChangeTicketReference)</dd>
                    <dt class="col-5">DBA owner</dt><dd class="col-7">@EmDash(_campaign.AccountableDbaTeam?.Name)</dd>
                    <dt class="col-5">App owner</dt><dd class="col-7">@EmDash(_campaign.AccountableAppTeam?.Name)</dd>
                    <dt class="col-5">Platform owner</dt><dd class="col-7">@EmDash(_campaign.AccountablePlatformTeam?.Name)</dd>
                    <dt class="col-5">Estimated effort</dt><dd class="col-7">@(_campaign.EstimatedEffortHours?.ToString("0.#") ?? "—") h</dd>
                    <dt class="col-5">Estimated cost</dt><dd class="col-7">@(_campaign.EstimatedCost?.ToString("0.##") ?? "—")</dd>
                    <dt class="col-5">Blockers</dt><dd class="col-7">@EmDash(_campaign.Blockers)</dd>
                </dl>

                <p class="small text-muted mb-1">Affected deployments:</p>
                <ul class="small mb-2">
                    @foreach (var link in _campaign.InstanceLinks)
                    {
                        <li>@(link.DatabaseInstance?.Name ?? $"#{link.DatabaseInstanceId}")</li>
                    }
                </ul>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" @bind="_addInstanceId">
                        <option value="0">Add instance…</option>
                        @foreach (var i in _instances.Where(i => !_campaign.InstanceLinks.Any(l => l.DatabaseInstanceId == i.Id)))
                        {
                            <option value="@i.Id">@i.Name</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="AddInstance" disabled="@(_addInstanceId == 0)">Add</button>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">State transition</h2>
                <p class="small mb-2">Current state: <strong>@_campaign.State</strong></p>

                @{
                    var nextStates = CampaignStateTransitionValidator.AllowedNextStates(_campaign.State);
                }
                @if (nextStates.Count == 0)
                {
                    <p class="small text-muted">Terminal state — no further transitions.</p>
                }
                else
                {
                    <div class="d-flex gap-2 mb-2">
                        <select class="form-select form-select-sm" @bind="_nextState" data-testid="next-state-select">
                            @foreach (var s in nextStates)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                        <input class="form-control form-control-sm" placeholder="Reason" @bind="_transitionReason" @bind:event="oninput" />
                        <button class="btn btn-primary btn-sm" @onclick="Transition" data-testid="transition-button">Transition</button>
                    </div>
                }

                @if (_campaign.StateTransitions.Count > 0)
                {
                    <table class="table table-sm dbt-table mb-0" data-testid="transition-history">
                        <thead><tr><th>When</th><th>From → to</th><th>By</th><th>Reason</th></tr></thead>
                        <tbody>
                            @foreach (var t in _campaign.StateTransitions.OrderByDescending(t => t.TransitionedAtUtc))
                            {
                                <tr><td class="small">@t.TransitionedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td><td class="small">@t.FromState → @t.ToState</td><td class="small">@t.TransitionedBy</td><td class="small">@t.Reason</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Alternatives compared</h2>
                <p class="small text-muted">Upgrade vs. patch vs. replace vs. retire vs. a documented support-extension/exception — recording the comparison, not just the final pick.</p>

                @if (_campaign.Alternatives.Count > 0)
                {
                    @foreach (var alt in _campaign.Alternatives)
                    {
                        <div class="mb-2 pb-2 d-flex justify-content-between align-items-start" style="border-bottom:1px solid var(--dbt-line);" data-testid="alternative-row">
                            <div>
                                <strong class="small">@alt.Type</strong> <span class="small text-muted">— @alt.Description</span>
                                <div class="small text-muted">@(alt.EstimatedEffortHours?.ToString("0.#") ?? "—") h · @(alt.EstimatedCost?.ToString("0.##") ?? "—") · @alt.RiskNotes</div>
                            </div>
                            @if (alt.IsChosen)
                            {
                                <span class="badge-health dot OnTrack">Chosen</span>
                            }
                            else
                            {
                                <button class="btn btn-link btn-sm p-0" @onclick="() => ChooseAlternative(alt.Id)">Choose</button>
                            }
                        </div>
                    }
                }

                <div class="row g-2 mb-2 mt-2">
                    <div class="col-4">
                        <select class="form-select form-select-sm" @bind="_altType">
                            @foreach (var t in Enum.GetValues<CampaignAlternativeType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-8"><input class="form-control form-control-sm" placeholder="Description" @bind="_altDescription" @bind:event="oninput" /></div>
                </div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="AddAlternative" disabled="@string.IsNullOrWhiteSpace(_altDescription)">Add alternative</button>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted text-uppercase mb-3">Approval history</h2>

                @if (_campaign.Approvals.Count > 0)
                {
                    <table class="table table-sm dbt-table mb-2">
                        <thead><tr><th>Scope</th><th>Decision</th><th>Approver</th><th>When</th></tr></thead>
                        <tbody>
                            @foreach (var a in _campaign.Approvals.OrderByDescending(a => a.DecidedAtUtc))
                            {
                                <tr><td class="small">@a.Scope</td><td class="small">@a.Decision</td><td class="small">@a.ApproverName</td><td class="small">@a.DecidedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td></tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="row g-2 mb-2">
                    <div class="col-4"><input class="form-control form-control-sm" placeholder="Scope (e.g. DBA technical)" @bind="_approvalScope" @bind:event="oninput" /></div>
                    <div class="col-4">
                        <select class="form-select form-select-sm" @bind="_approvalDecision">
                            @foreach (var d in Enum.GetValues<CampaignApprovalDecision>())
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-4"><input class="form-control form-control-sm" placeholder="Approver name" @bind="_approverName" @bind:event="oninput" /></div>
                </div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="RecordApproval" disabled="@(string.IsNullOrWhiteSpace(_approvalScope) || string.IsNullOrWhiteSpace(_approverName))">Record approval</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private MigrationCampaign? _campaign;
    private List<DBTracker.Core.Services.InstanceListRow> _instances = new();
    private CampaignCompletionGateView? _completionGate;
    private bool _loaded;
    private string? _userName;

    private int _addInstanceId;
    private CampaignState _nextState;
    private string _transitionReason = "";

    private CampaignAlternativeType _altType = CampaignAlternativeType.Upgrade;
    private string _altDescription = "";

    private string _approvalScope = "", _approverName = "";
    private CampaignApprovalDecision _approvalDecision = CampaignApprovalDecision.Approved;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        await Load();
        _loaded = true;
    }

    private async Task Load()
    {
        _campaign = await Campaigns.GetAsync(Id);
        _instances = await OverviewService.GetAllSummariesAsync();
        if (_campaign is not null)
        {
            var next = CampaignStateTransitionValidator.AllowedNextStates(_campaign.State);
            if (next.Count > 0)
            {
                _nextState = next[0];
            }
            _completionGate = await CompletionGate.EvaluateAsync(Id);
        }
    }

    private async Task AddInstance()
    {
        if (_addInstanceId == 0)
        {
            return;
        }
        await Campaigns.AddInstanceAsync(Id, _addInstanceId, _userName ?? "unknown");
        Toasts.Success("Instance added to campaign.");
        _addInstanceId = 0;
        await Load();
    }

    private async Task Transition()
    {
        var (ok, reason) = await Campaigns.TransitionAsync(Id, _nextState, _transitionReason, _userName ?? "unknown");
        if (ok)
        {
            Toasts.Success($"Campaign transitioned to {_nextState}.");
            _transitionReason = "";
        }
        else
        {
            Toasts.Error($"Transition rejected: {reason}");
        }
        await Load();
    }

    private async Task AddAlternative()
    {
        await Campaigns.AddAlternativeAsync(Id, _altType, _altDescription, null, null, "", _userName ?? "unknown");
        Toasts.Success("Alternative recorded.");
        _altDescription = "";
        await Load();
    }

    private async Task ChooseAlternative(int alternativeId)
    {
        await Campaigns.ChooseAlternativeAsync(Id, alternativeId, _userName ?? "unknown");
        Toasts.Success("Alternative chosen.");
        await Load();
    }

    private async Task RecordApproval()
    {
        await Campaigns.RecordApprovalAsync(Id, _approvalScope, _approvalDecision, _approverName, "", _userName ?? "unknown");
        Toasts.Success("Approval recorded.");
        _approvalScope = _approverName = "";
        await Load();
    }

    private static string EmDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
