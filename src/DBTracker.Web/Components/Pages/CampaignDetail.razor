@page "/campaigns/{Id:int}"
@attribute [Authorize(Roles = Roles.CanEditPolicy)]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.Identity
@using DBTracker.Infrastructure.MigrationPlanning
@using DBTracker.Infrastructure.ChangeManagement
@using DBTracker.Infrastructure.Queries
@using Microsoft.AspNetCore.Components.Authorization
@inject CampaignService Campaigns
@inject CampaignCompletionGateService CompletionGate
@inject InstanceOverviewService OverviewService
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>@(_campaign?.Name ?? "Campaign") · DBTracker</PageTitle>

@if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else if (_campaign is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i aria-hidden="true" class="bi bi-question-diamond"></i> Campaign #@Id doesn't exist.</div>
        <a class="btn btn-outline-secondary" href="/campaigns">Back to campaigns</a>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <h1>@_campaign.Name <span class="badge-health dot Overdue" data-testid="campaign-detail-state">@_campaign.State</span></h1>
            <div class="subtitle">
                @_campaign.SourceLabel → @_campaign.TargetLabel · @_campaign.ChosenMethod · <a href="/campaigns">Back to campaigns</a> ·
                <a href="/campaigns/@Id/rehearsals">Rehearsals</a> ·
                <a href="/campaigns/@Id/change-windows">Change windows</a> ·
                <a href="/campaigns/@Id/validation">Validation</a> ·
                <a href="/exceptions">Exceptions</a>
            </div>
        </div>
    </div>

    @if (_completionGate is not null)
    {
        <div class="dbt-card mb-3" data-testid="completion-gate-banner" style="border-color:@(_completionGate.CanComplete ? "var(--dbt-ontrack)" : "var(--dbt-overdue)");">
            @if (_completionGate.CanComplete)
            {
                <strong style="color:var(--dbt-ontrack);"><i aria-hidden="true" class="bi bi-check-circle"></i> Completion readiness: ready.</strong>
                @if (_completionGate.UsedException)
                {
                    <span class="small"> Proceeding on an active exception, not full evidence.</span>
                }
            }
            else
            {
                <strong style="color:var(--dbt-overdue);"><i aria-hidden="true" class="bi bi-exclamation-triangle"></i> Completion readiness: blocked.</strong>
                <ul class="small mb-0">
                    @foreach (var r in _completionGate.BlockingReasons)
                    {
                        <li>@r</li>
                    }
                </ul>
                <span class="small text-muted">Resolve the evidence above, or record a scoped D14 exception, before this campaign can reach Completed.</span>
            }
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Overview</h2>
                <dl class="row small mb-2">
                    <dt class="col-5">Reason</dt><dd class="col-7">@OrNotRecorded(_campaign.Reason)</dd>
                    <dt class="col-5">Change ticket</dt><dd class="col-7">@OrNotRecorded(_campaign.ChangeTicketReference)</dd>
                    <dt class="col-5">DBA owner</dt><dd class="col-7">@OrNotRecorded(_campaign.AccountableDbaTeam?.Name)</dd>
                    <dt class="col-5">App owner</dt><dd class="col-7">@OrNotRecorded(_campaign.AccountableAppTeam?.Name)</dd>
                    <dt class="col-5">Platform owner</dt><dd class="col-7">@OrNotRecorded(_campaign.AccountablePlatformTeam?.Name)</dd>
                    <dt class="col-5">Estimated effort</dt><dd class="col-7" data-testid="campaign-effort">@(_campaign.EstimatedEffortHours is { } effort ? $"{effort:0.#} h" : "Not estimated")</dd>
                    <dt class="col-5">Estimated cost</dt><dd class="col-7" data-testid="campaign-cost">@CostText(_campaign.EstimatedCost)</dd>
                    <dt class="col-5">Blockers</dt><dd class="col-7" data-testid="campaign-blockers">@OrNotRecorded(_campaign.Blockers)</dd>
                    <dt class="col-5">Milestones</dt><dd class="col-7" data-testid="campaign-milestones" style="white-space:pre-line;">@OrNotRecorded(_campaign.Milestones)</dd>
                </dl>

                @if (_editingPlan)
                {
                    <div class="p-2 mb-2" style="border:1px dashed var(--dbt-line);" data-testid="campaign-plan-form">
                        <div class="mb-2"><label class="form-label small mb-1" for="plan-blockers">Blockers</label><textarea id="plan-blockers" class="form-control form-control-sm" rows="2" maxlength="1000" @bind="_planBlockers" @bind:event="oninput" data-testid="plan-blockers"></textarea></div>
                        <div class="mb-2"><label class="form-label small mb-1" for="plan-milestones">Milestones (one per line, with dates)</label><textarea id="plan-milestones" class="form-control form-control-sm" rows="3" maxlength="2000" @bind="_planMilestones" @bind:event="oninput" data-testid="plan-milestones"></textarea></div>
                        <div class="row g-2 mb-2">
                            <div class="col-4"><label class="form-label small mb-1" for="plan-effort">Effort (hours)</label><input id="plan-effort" type="number" min="0" step="0.5" class="form-control form-control-sm" @bind="_planEffort" data-testid="plan-effort" /></div>
                            <div class="col-4">
                                @if (_canViewCost)
                                {
                                    <label class="form-label small mb-1" for="plan-cost">Cost</label><input id="plan-cost" type="number" min="0" step="0.01" class="form-control form-control-sm" @bind="_planCost" data-testid="plan-cost" />
                                }
                                else
                                {
                                    <span class="form-label small mb-1 d-block">Cost</span><span class="small text-muted">Only Admin or IT Manager can enter or see cost.</span>
                                }
                            </div>
                            <div class="col-4"><label class="form-label small mb-1" for="plan-ticket">Change ticket</label><input id="plan-ticket" class="form-control form-control-sm" maxlength="200" @bind="_planTicket" @bind:event="oninput" /></div>
                        </div>
                        @if (_planError is not null)
                        {
                            <p class="small mb-1" role="alert" style="color:var(--dbt-failed);">@_planError</p>
                        }
                        <button class="btn btn-primary btn-sm" @onclick="SavePlan" data-testid="plan-save">Save plan</button>
                        <button class="btn btn-link btn-sm" @onclick="() => _editingPlan = false">Cancel</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-link btn-sm p-0 mb-2" @onclick="OpenPlan" data-testid="plan-edit">Edit blockers, milestones and estimates</button>
                }

                <p class="small text-muted mb-1">Affected deployments:</p>
                <ul class="small mb-2">
                    @foreach (var link in _campaign.InstanceLinks)
                    {
                        <li>@(link.DatabaseInstance?.Name ?? $"#{link.DatabaseInstanceId}")</li>
                    }
                </ul>
                <div class="d-flex gap-2">
                    <label class="visually-hidden" for="campaigndetail-add-instance">Instance to add</label><select id="campaigndetail-add-instance" class="form-select form-select-sm" @bind="_addInstanceId">
                        <option value="0">Add instance…</option>
                        @foreach (var i in _instances.Where(i => !_campaign.InstanceLinks.Any(l => l.DatabaseInstanceId == i.Id)))
                        {
                            <option value="@i.Id">@i.Name</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="AddInstance" disabled="@(_addInstanceId == 0)">Add to campaign</button>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">State transition</h2>
                <p class="small mb-2">Current state: <strong>@_campaign.State</strong></p>

                @{
                    var nextStates = CampaignStateTransitionValidator.AllowedNextStates(_campaign.State);
                }
                @if (nextStates.Count == 0)
                {
                    <p class="small text-muted">Final state. No further transitions.</p>
                }
                else
                {
                    <div class="d-flex gap-2 mb-2">
                        <label class="visually-hidden" for="campaigndetail-next-state">Next state</label><select id="campaigndetail-next-state" class="form-select form-select-sm" @bind="_nextState" data-testid="next-state-select">
                            @foreach (var s in nextStates)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                        <label class="visually-hidden" for="campaigndetail-transition-reason">Transition reason</label><input id="campaigndetail-transition-reason" class="form-control form-control-sm" placeholder="Reason" @bind="_transitionReason" @bind:event="oninput" />
                        <button class="btn btn-primary btn-sm" @onclick="Transition" data-testid="transition-button">Transition</button>
                    </div>
                    <p class="small text-muted mb-2">Ready, Scheduled and In progress need a current, passing rehearsal for every instance (or an active campaign exception). Scheduled and In progress also need an approval, with no scope's latest decision a rejection.</p>
                    @if (_transitionGates.TryGetValue(_nextState, out var gate) && (!gate.Allowed || gate.UsedException))
                    {
                        <div class="small mb-2" role="status" data-testid="transition-gate" style="color:@(gate.Allowed ? "var(--dbt-overdue)" : "var(--dbt-failed)");">
                            @if (gate.Allowed)
                            {
                                <span>Moving to @_nextState relies on an active exception instead of rehearsal evidence.</span>
                            }
                            else
                            {
                                <span>Moving to @_nextState is blocked:</span>
                                <ul class="mb-0">
                                    @foreach (var r in gate.BlockingReasons)
                                    {
                                        <li>@r</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                }

                @if (_campaign.StateTransitions.Count == 0)
                {
                    <p class="small text-muted mb-2">No state changes recorded yet.</p>
                }
                else
                {
                    <table aria-label="State change history" class="table table-sm dbt-table mb-0" data-testid="transition-history">
                        <thead><tr><th>When</th><th>From → to</th><th>By</th><th>Reason</th></tr></thead>
                        <tbody>
                            @foreach (var t in _campaign.StateTransitions.OrderByDescending(t => t.TransitionedAtUtc))
                            {
                                <tr><td class="small">@t.TransitionedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td><td class="small">@t.FromState → @t.ToState</td><td class="small">@t.TransitionedBy</td><td class="small">@t.Reason</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Alternatives compared</h2>
                <p class="small text-muted">Compare an upgrade, a patch, a replacement, retirement, or a documented support extension or exception. Record the comparison, not just the final pick.</p>

                @if (_campaign.Alternatives.Count == 0)
                {
                    <p class="small text-muted mb-2">No alternatives recorded yet.</p>
                }
                else
                {
                    @foreach (var alt in _campaign.Alternatives)
                    {
                        <div class="mb-2 pb-2 d-flex justify-content-between align-items-start" style="border-bottom:1px solid var(--dbt-line);" data-testid="alternative-row">
                            <div>
                                <strong class="small">@alt.Type</strong> <span class="small text-muted">: @alt.Description</span>
                                <div class="small text-muted" data-testid="alternative-estimates">@(alt.EstimatedEffortHours is { } altEffort ? $"{altEffort:0.#} h" : "Effort not estimated") · @(alt.EstimatedCost is null ? "Cost not estimated" : $"Cost {CostText(alt.EstimatedCost)}") · Risk: @(string.IsNullOrWhiteSpace(alt.RiskNotes) ? "not recorded" : alt.RiskNotes)</div>
                            </div>
                            @if (alt.IsChosen)
                            {
                                <span class="badge-health dot OnTrack">Chosen</span>
                            }
                            else
                            {
                                <button class="btn btn-link btn-sm p-0" @onclick="() => ChooseAlternative(alt.Id)">Choose</button>
                            }
                        </div>
                    }
                }

                <div class="row g-2 mb-2 mt-2">
                    <div class="col-4">
                        <label class="form-label small mb-1" for="campaigndetail-alt-type">Alternative type</label><select id="campaigndetail-alt-type" class="form-select form-select-sm" @bind="_altType">
                            @foreach (var t in Enum.GetValues<CampaignAlternativeType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-8"><label class="form-label small mb-1" for="campaigndetail-description">Description</label><input class="form-control form-control-sm" placeholder="Description" id="campaigndetail-description" @bind="_altDescription" @bind:event="oninput" /></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><label class="form-label small mb-1" for="alt-effort">Effort (hours)</label><input id="alt-effort" type="number" min="0" step="0.5" class="form-control form-control-sm" @bind="_altEffort" data-testid="alt-effort" /></div>
                    @if (_canViewCost)
                    {
                        <div class="col-4"><label class="form-label small mb-1" for="alt-cost">Cost</label><input id="alt-cost" type="number" min="0" step="0.01" class="form-control form-control-sm" @bind="_altCost" data-testid="alt-cost" /></div>
                    }
                    <div class="@(_canViewCost ? "col-4" : "col-8")"><label class="form-label small mb-1" for="alt-risk">Risk</label><input id="alt-risk" class="form-control form-control-sm" placeholder="Main risk of this option" maxlength="1000" @bind="_altRisk" @bind:event="oninput" data-testid="alt-risk" /></div>
                </div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="AddAlternative" disabled="@string.IsNullOrWhiteSpace(_altDescription)">Add alternative</button>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Approval history</h2>

                @if (_campaign.Approvals.Count == 0)
                {
                    <p class="small text-muted mb-2">No approval decisions recorded yet.</p>
                }
                else
                {
                    <table aria-label="Approval history" class="table table-sm dbt-table mb-2">
                        <thead><tr><th>Scope</th><th>Decision</th><th>Approver</th><th>When</th><th>Notes</th></tr></thead>
                        <tbody>
                            @foreach (var a in _campaign.Approvals.OrderByDescending(a => a.DecidedAtUtc))
                            {
                                <tr><td class="small">@a.Scope</td><td class="small">@a.Decision</td><td class="small">@a.ApproverName</td><td class="small">@a.DecidedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td><td class="small" data-testid="approval-notes">@a.Notes</td></tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="row g-2 mb-2">
                    <div class="col-4"><label class="form-label small mb-1" for="campaigndetail-scope">Scope</label><input class="form-control form-control-sm" placeholder="Scope (e.g. DBA technical)" id="campaigndetail-scope" @bind="_approvalScope" @bind:event="oninput" /></div>
                    <div class="col-4">
                        <label class="form-label small mb-1" for="campaigndetail-approval-decision">Decision</label><select id="campaigndetail-approval-decision" class="form-select form-select-sm" @bind="_approvalDecision">
                            @foreach (var d in Enum.GetValues<CampaignApprovalDecision>())
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-4"><label class="form-label small mb-1" for="campaigndetail-approver-name">Approver name</label><input class="form-control form-control-sm" placeholder="Approver name" id="campaigndetail-approver-name" @bind="_approverName" @bind:event="oninput" /></div>
                    <div class="col-12"><label class="form-label small mb-1" for="campaigndetail-approval-notes">Notes</label><input class="form-control form-control-sm" placeholder="Conditions or reasons for the decision" id="campaigndetail-approval-notes" maxlength="1000" @bind="_approvalNotes" @bind:event="oninput" data-testid="approval-notes-input" /></div>
                </div>
                <p class="small text-muted mb-2">Scheduling needs at least one approval. A rejection blocks scheduling until a later approval for the same scope.</p>
                <button class="btn btn-outline-secondary btn-sm" @onclick="RecordApproval" disabled="@(string.IsNullOrWhiteSpace(_approvalScope) || string.IsNullOrWhiteSpace(_approverName))">Record approval</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private MigrationCampaign? _campaign;
    private List<DBTracker.Core.Services.InstanceListRow> _instances = new();
    private CampaignCompletionGateView? _completionGate;
    private bool _loaded;
    private string? _userName;

    private int _addInstanceId;
    private CampaignState _nextState;
    private string _transitionReason = "";

    private CampaignAlternativeType _altType = CampaignAlternativeType.Upgrade;
    private string _altDescription = "", _altRisk = "";
    private decimal? _altEffort, _altCost;

    private string _approvalScope = "", _approverName = "", _approvalNotes = "";
    private CampaignApprovalDecision _approvalDecision = CampaignApprovalDecision.Approved;

    private Dictionary<CampaignState, CampaignTransitionGateResult> _transitionGates = new();
    private bool _canViewCost, _editingPlan;
    private string _planBlockers = "", _planMilestones = "", _planTicket = "";
    private decimal? _planEffort, _planCost;
    private string? _planError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        _canViewCost = Roles.CommercialEvidencePolicy.Split(',').Any(state.User.IsInRole);
        await Load();
        _loaded = true;
    }

    private string CostText(decimal? amount) => amount is not { } a
        ? "Not estimated"
        : _canViewCost ? a.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) : CostEvidenceMasker.MaskedPlaceholder;

    private void OpenPlan()
    {
        if (_campaign is null)
        {
            return;
        }
        _planBlockers = _campaign.Blockers;
        _planMilestones = _campaign.Milestones;
        _planEffort = _campaign.EstimatedEffortHours;
        _planCost = _campaign.EstimatedCost;
        _planTicket = _campaign.ChangeTicketReference;
        _planError = null;
        _editingPlan = true;
    }

    private async Task SavePlan()
    {
        if (_planEffort < 0 || _planCost < 0)
        {
            _planError = "Effort and cost can't be negative.";
            return;
        }
        var ok = await Campaigns.UpdatePlanAsync(Id, _planBlockers.Trim(), _planMilestones.Trim(), _planEffort, _planCost, _canViewCost, _planTicket.Trim(), _userName ?? "unknown");
        if (!ok)
        {
            _planError = "The plan wasn't saved. Check the values and try again.";
            return;
        }
        Toasts.Success("Campaign plan saved.");
        _editingPlan = false;
        await Load();
    }

    private async Task Load()
    {
        _campaign = await Campaigns.GetAsync(Id);
        _instances = await OverviewService.GetAllSummariesAsync();
        if (_campaign is not null)
        {
            var next = CampaignStateTransitionValidator.AllowedNextStates(_campaign.State);
            if (next.Count > 0)
            {
                _nextState = next[0];
            }
            _transitionGates = new();
            foreach (var s in next)
            {
                _transitionGates[s] = await Campaigns.EvaluateTransitionGateAsync(Id, s);
            }
            _completionGate = await CompletionGate.EvaluateAsync(Id);
        }
    }

    private async Task AddInstance()
    {
        if (_addInstanceId == 0)
        {
            return;
        }
        await Campaigns.AddInstanceAsync(Id, _addInstanceId, _userName ?? "unknown");
        Toasts.Success("Instance added to campaign.");
        _addInstanceId = 0;
        await Load();
    }

    private async Task Transition()
    {
        var (ok, reason) = await Campaigns.TransitionAsync(Id, _nextState, _transitionReason, _userName ?? "unknown");
        if (ok)
        {
            Toasts.Success($"Campaign transitioned to {_nextState}.");
            _transitionReason = "";
        }
        else
        {
            Toasts.Error($"Transition rejected: {reason}");
        }
        await Load();
    }

    private async Task AddAlternative()
    {
        if (_altEffort < 0 || _altCost < 0)
        {
            Toasts.Error("Effort and cost can't be negative.");
            return;
        }
        await Campaigns.AddAlternativeAsync(Id, _altType, _altDescription, _altEffort, _canViewCost ? _altCost : null, _altRisk.Trim(), _userName ?? "unknown");
        Toasts.Success("Alternative recorded.");
        _altDescription = _altRisk = "";
        _altEffort = _altCost = null;
        await Load();
    }

    private async Task ChooseAlternative(int alternativeId)
    {
        await Campaigns.ChooseAlternativeAsync(Id, alternativeId, _userName ?? "unknown");
        Toasts.Success("Alternative chosen.");
        await Load();
    }

    private async Task RecordApproval()
    {
        await Campaigns.RecordApprovalAsync(Id, _approvalScope.Trim(), _approvalDecision, _approverName.Trim(), _approvalNotes.Trim(), _userName ?? "unknown");
        Toasts.Success("Approval recorded.");
        _approvalScope = _approverName = _approvalNotes = "";
        await Load();
    }

    private static string OrNotRecorded(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
}
