@page "/compliance"
@attribute [Authorize]
@inject InstanceOverviewService OverviewService
@inject ComplianceReportService ReportService
@inject DBTrackerDbContext Db
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>Compliance · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Compliance snapshot</h1>
        <div class="subtitle">Last-backup age per instance as of @_asOf.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
    </div>
    <div class="d-flex gap-2">
        <AuthorizeView Roles="@Roles.ReportingPolicy">
            <div>
                <ReportSendPanel ButtonText="Send report" FullScopeCount="@(_overviews?.Count ?? 0)" FilteredScope="@CurrentFilterScope()" />
            </div>
        </AuthorizeView>
        <AuthorizeView Roles="@Roles.ReportingPolicy">
            <button class="btn btn-outline-secondary" @onclick="SaveSnapshot" disabled="@(_overviews is null || _savingSnapshot)">
                <i aria-hidden="true" class="bi bi-camera"></i> @(_savingSnapshot ? "Saving…" : "Save snapshot")
            </button>
        </AuthorizeView>
        <button class="btn btn-outline-primary" @onclick="ExportCsv" disabled="@(_overviews is null)">
            <i aria-hidden="true" class="bi bi-download"></i> Export CSV
        </button>
    </div>
</div>

@if (_overviews is null)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else
{
    <div class="filter-bar">
        <label class="visually-hidden" for="compliance-role">Instance role</label><select id="compliance-role" class="form-select" style="max-width:150px;" @bind="_role">
            <option value="">Active + passive</option>
            @foreach (var r in Enum.GetValues<InstanceRole>())
            {
                <option value="@r">@r</option>
            }
        </select>
        <label class="visually-hidden" for="compliance-environment">Environment</label><select id="compliance-environment" class="form-select" style="max-width:170px;" @bind="_envTier">
            <option value="">All environments</option>
            @foreach (var e in Enum.GetValues<EnvironmentTier>())
            {
                <option value="@e">@e</option>
            }
        </select>
    </div>

    <div class="dbt-table">
        <table aria-label="Last-backup age per instance" class="table">
            <thead>
                <tr>
                    <th>Instance</th>
                    <th>Owner</th>
                    <th>Role</th>
                    <th>Env</th>
                    <th>Last successful backup</th>
                    <th>Evidence</th>
                    <th>Age</th>
                    <th>Health</th>
                    <th>Restore tested</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Filtered())
                {
                    var restoreTested = o.Instance.RestoreEvents.Any(r => r.Outcome == RestoreOutcome.Success);
                    <tr>
                        <td class="fw-semibold">@o.Instance.Name</td>
                        <td>@o.Instance.Company / @o.Instance.Department</td>
                        <td><span class="role-pill @o.Instance.Role">@o.Instance.Role</span></td>
                        <td>@o.Instance.Environment</td>
                        <td>@(o.LastBackupUtc is null ? "Never" : o.LastBackupUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</td>
                        <td data-testid="compliance-evidence">
                            @if (Evidence(o) is { } level)
                            {
                                <span class="badge-health dot @(level == EvidenceLevel.RestoreTested ? "OnTrack" : level == EvidenceLevel.ReportedSuccess ? "Overdue" : "NeverBackedUp")">@BackupEvidenceClassifier.Describe(level)</span>
                            }
                            else
                            {
                                <span class="text-muted small">None</span>
                            }
                        </td>
                        <td>@Age(o.LastBackupUtc)</td>
                        <td><HealthBadge Health="o.Health" /></td>
                        <td>
                            @if (restoreTested)
                            {
                                <span class="badge-health dot OnTrack">Yes</span>
                            }
                            else
                            {
                                <span class="badge-health dot Overdue">No</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row g-0 mt-4" style="border-top:1px solid var(--dbt-line);padding-top:28px;">
        <div class="col-12">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Saved snapshots</h2>
                <p class="text-muted small mb-3">A snapshot freezes the rows above at the moment it's saved. Reopening it later reproduces those exact values even if instances are since edited, archived or backdated. Evidence for an audit period, not a live view.</p>
                @if (_snapshots.Count == 0)
                {
                    <div class="empty-state py-3"><i aria-hidden="true" class="bi bi-camera"></i>No snapshots saved yet.</div>
                }
                else
                {
                    <table aria-label="Saved compliance snapshots" class="table table-sm mb-0 dbt-table">
                        <thead><tr><th>Generated</th><th>By</th><th>Scope</th><th>Rows</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var s in _snapshots)
                            {
                                <tr>
                                    <td class="small">@s.GeneratedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                    <td class="small">@s.GeneratedByUserName</td>
                                    <td class="small">@s.ScopeDescription</td>
                                    <td class="small">@s.RowCount</td>
                                    <td class="small"><a href="/compliance/snapshots/@s.Id">View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<InstanceOverview>? _overviews;
    private List<ComplianceSnapshot> _snapshots = new();
    private DateTime _asOf;
    private string _role = "";
    private string _envTier = "";
    private bool _savingSnapshot;

    protected override async Task OnInitializedAsync()
    {
        _asOf = DateTime.UtcNow;
        // U06: latest record and latest success per instance, not every backup; enough for health, age and evidence level.
        _overviews = await OverviewService.GetAllLatestAsync();
        await LoadSnapshots();
    }

    private async Task LoadSnapshots()
    {
        _snapshots = await Db.ComplianceSnapshots.AsNoTracking()
            .OrderByDescending(s => s.GeneratedAtUtc)
            .Take(20)
            .ToListAsync();
    }

    /// <summary>Describes the role/environment filter currently applied on screen, for the "current filtered view" report-scope option (U09). Null once no filter narrows the set (same as full inventory).</summary>
    private ReportScope? CurrentFilterScope()
    {
        if (_overviews is null || (_role.Length == 0 && _envTier.Length == 0))
        {
            return null;
        }

        var ids = Filtered().Select(o => o.Instance.Id);
        var parts = new List<string>();
        if (_role.Length > 0) parts.Add($"Role={_role}");
        if (_envTier.Length > 0) parts.Add($"Env={_envTier}");
        return ReportScope.Filtered(ids, string.Join(", ", parts));
    }

    private IEnumerable<InstanceOverview> Filtered()
    {
        var items = _overviews ?? Enumerable.Empty<InstanceOverview>();

        if (_role.Length > 0 && Enum.TryParse<InstanceRole>(_role, out var role))
        {
            items = items.Where(o => o.Instance.Role == role);
        }
        if (_envTier.Length > 0 && Enum.TryParse<EnvironmentTier>(_envTier, out var env))
        {
            items = items.Where(o => o.Instance.Environment == env);
        }

        return items.OrderBy(o => o.Instance.Name);
    }

    /// <summary>U04: evidence level of the latest successful backup as of the page's as-of time, the same label instance detail shows.</summary>
    private EvidenceLevel? Evidence(InstanceOverview o) =>
        BackupEvidenceClassifier.ClassifyLatestSuccess(o.Instance.BackupRecords.ToList(), o.Instance.RestoreEvents.ToList(), _asOf);

    private string Age(DateTime? lastBackupUtc)
    {
        if (lastBackupUtc is null)
        {
            return "Never";
        }
        var span = _asOf - lastBackupUtc.Value;
        return span.TotalHours < 48 ? $"{span.TotalHours:N0} h" : $"{span.TotalDays:N0} d";
    }

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Instance,Engine,Company,Department,Owner,ContactEmail,Role,Environment,LastSuccessfulBackupUtc,LastSuccessEvidence,AgeHours,Health,RestoreTested");
        foreach (var o in Filtered())
        {
            var ageHours = o.LastBackupUtc is null ? "" : ((_asOf - o.LastBackupUtc.Value).TotalHours).ToString("N1");
            var restoreTested = o.Instance.RestoreEvents.Any(r => r.Outcome == RestoreOutcome.Success);
            sb.AppendLine(string.Join(",", new[]
            {
                Csv(o.Instance.Name), Csv(o.Instance.Engine.ToString()), Csv(o.Instance.Company), Csv(o.Instance.Department),
                Csv(o.Instance.ContactName), Csv(o.Instance.ContactEmail), Csv(o.Instance.Role.ToString()), Csv(o.Instance.Environment.ToString()),
                Csv(o.LastBackupUtc?.ToString("O") ?? ""), Csv(BackupEvidenceClassifier.DescribeOrEmpty(Evidence(o))), Csv(ageHours), Csv(o.Health.ToString()), Csv(restoreTested ? "Yes" : "No")
            }));
        }

        var fileName = $"dbtracker-compliance-{_asOf:yyyyMMdd-HHmm}.csv";
        await JS.InvokeVoidAsync("dbtracker.downloadCsv", fileName, sb.ToString());
    }

    private static string Csv(string value) =>
        value.Contains(',') || value.Contains('"')
            ? $"\"{value.Replace("\"", "\"\"")}\""
            : value;

    private async Task SaveSnapshot()
    {
        _savingSnapshot = true;

        var rows = Filtered().Select(o => new ComplianceReportRow(
            o.Instance, o.Health, o.LastBackupUtc,
            o.Instance.RestoreEvents.Any(r => r.Outcome == RestoreOutcome.Success)));
        var snapshotRows = ComplianceSnapshotBuilder.BuildRows(rows);

        var scopeDescription = _role.Length == 0 && _envTier.Length == 0
            ? "Full inventory"
            : string.Join(", ", new[] { _role.Length > 0 ? $"Role={_role}" : null, _envTier.Length > 0 ? $"Env={_envTier}" : null }.Where(p => p is not null));

        var username = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

        var snapshot = new ComplianceSnapshot
        {
            GeneratedAtUtc = DateTime.UtcNow,
            EffectiveAsOfUtc = _asOf,
            GeneratedByUserName = username,
            ScopeDescription = scopeDescription,
            EvidenceProvenance = "BackupHealthCalculator.Compute + RestoreEvents, via the Compliance view",
            RowsJson = ComplianceSnapshotBuilder.Serialize(snapshotRows),
            RowCount = snapshotRows.Count
        };

        Db.ComplianceSnapshots.Add(snapshot);
        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        _savingSnapshot = false;
        Toasts.Success($"Snapshot saved ({snapshotRows.Count} row(s)).");
        await LoadSnapshots();
    }
}
