@page "/notifications"
@attribute [Authorize]
@inject NotificationService NotificationSvc
@inject NotificationSubscriptionService Subscriptions
@inject NotificationPreferenceService Preferences
@inject TeamService Teams
@inject InstanceOverviewService OverviewService
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Notifications · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Notifications</h1>
        <div class="subtitle">Your own read state and subscriptions. Reading a notification here never affects what anyone else sees as unread.</div>
    </div>
</div>

@if (_page is null)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="dbt-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 text-muted mb-0">Inbox (@_page.UnreadCount unread of @_page.TotalCount)</h2>
                    @if (_page.UnreadCount > 0)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="MarkAllRead">Mark all read</button>
                    }
                </div>

                @if (_page.Items.Count == 0 && _page.InboxOptedOut)
                {
                    <div class="empty-state py-3" data-testid="inbox-opted-out"><i aria-hidden="true" class="bi bi-envelope"></i>Your subscriptions are all email only, so nothing is shown here. Change one to "In-app + email" to see alerts in this inbox too.</div>
                }
                else if (_page.Items.Count == 0)
                {
                    <div class="empty-state py-3"><i aria-hidden="true" class="bi bi-inbox"></i>No notifications yet.</div>
                }
                else
                {
                    @foreach (var n in _page.Items)
                    {
                        <button type="button" class="notif-item @(n.IsRead ? "" : "unread")" style="cursor:pointer;width:100%;text-align:left;border-width:0 0 1px 0;color:inherit;font:inherit;@(n.IsRead ? "background:transparent;" : "")" @onclick="() => OpenItem(n)">
                            <span class="dot" aria-hidden="true" style="background:@SeverityColor(n.Severity)"></span>
                            <span class="d-block">
                                <span class="notif-message d-block">@n.Message</span>
                                <span class="notif-time d-block">@n.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt") @(n.IsRead ? "" : "· unread")</span>
                            </span>
                        </button>
                    }

                    <div class="d-flex justify-content-between align-items-center pt-3">
                        <span class="small text-muted">Page @_inboxPage</span>
                        <div class="d-flex gap-1">
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(_inboxPage <= 1)" @onclick="() => ChangeInboxPage(_inboxPage - 1)">Prev</button>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(_inboxPage * PageSize >= _page.TotalCount)" @onclick="() => ChangeInboxPage(_inboxPage + 1)">Next</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Subscriptions</h2>
                <p class="small text-muted">Narrows which broadcast alerts reach you. With no subscriptions, every alert shows in your inbox and none are emailed to you. Once you add any, your inbox shows only alerts matching an "In-app only" or "In-app + email" subscription, and email goes only to "Email only" or "In-app + email" ones. A subscription can only narrow what you already see. It never grants access to an instance your role can't see.</p>

                @if (_subscriptions.Count == 0)
                {
                    <div class="text-muted small mb-3">No subscriptions. You see every alert.</div>
                }
                else
                {
                    @foreach (var s in _subscriptions)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2 small">
                            <span>
                                <span class="role-pill">@s.Scope</span>
                                @SubscriptionTarget(s)
                                <span class="text-muted">· @ChannelLabel(s.Channel)</span>
                            </span>
                            <button type="button" class="btn btn-link btn-sm text-danger p-0" aria-label="Delete subscription" title="Delete subscription" @onclick="() => DeleteSubscription(s.Id)"><i aria-hidden="true" class="bi bi-trash"></i></button>
                        </div>
                    }
                    <hr />
                }

                <div class="d-flex gap-2 flex-wrap align-items-end">
                    <div class="field">
                        <label for="notifications-scope" class="form-label small">Scope</label>
                        <select id="notifications-scope" class="form-select form-select-sm" @bind="_newScope">
                            <option value="@SubscriptionScope.AllInstances">All instances</option>
                            <option value="@SubscriptionScope.Instance">One instance</option>
                            <option value="@SubscriptionScope.Company">Company</option>
                            <option value="@SubscriptionScope.Team">Owner team</option>
                        </select>
                    </div>
                    @if (_newScope == SubscriptionScope.Team)
                    {
                        <div class="field">
                            @if (_teams.Count == 0)
                            {
                                <div class="small text-muted" role="status">No teams yet. An admin can add them on the Ownership page.</div>
                            }
                            else
                            {
                                <label for="notifications-team" class="form-label small">Team</label>
                                <select id="notifications-team" class="form-select form-select-sm" data-testid="subscription-team" @bind="_newTeamId">
                                    @foreach (var t in _teams)
                                    {
                                        <option value="@t.Team.Id">@t.Team.Name</option>
                                    }
                                </select>
                            }
                        </div>
                    }
                    @if (_newScope == SubscriptionScope.Instance)
                    {
                        <div class="field">
                            <label for="notifications-instance" class="form-label small">Instance</label>
                            <select id="notifications-instance" class="form-select form-select-sm" @bind="_newInstanceId">
                                @foreach (var i in _instances)
                                {
                                    <option value="@i.Id">@i.Name</option>
                                }
                            </select>
                        </div>
                    }
                    @if (_newScope == SubscriptionScope.Company)
                    {
                        <div class="field">
                            <label for="notifications-company" class="form-label small">Company</label>
                            <select id="notifications-company" class="form-select form-select-sm" @bind="_newCompany">
                                @foreach (var c in _companies)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="field">
                        <label for="notifications-channel" class="form-label small">Channel</label>
                        <select id="notifications-channel" class="form-select form-select-sm" @bind="_newChannel">
                            <option value="@NotificationChannel.InApp">In-app only</option>
                            <option value="@NotificationChannel.Email">Email only</option>
                            <option value="@NotificationChannel.Both">In-app + email</option>
                        </select>
                    </div>
                    <button class="btn btn-primary btn-sm" data-testid="subscription-add" @onclick="AddSubscription" disabled="@(_newScope == SubscriptionScope.Team && _teams.Count == 0)">Add subscription</button>
                </div>
                @if (_subscriptionError is not null)
                {
                    <div class="small text-danger mt-2" role="alert">@_subscriptionError</div>
                }
            </div>

            <div class="dbt-card mt-4" data-testid="quiet-hours">
                <h2 class="h6 text-muted mb-2">Quiet hours</h2>
                <p class="small text-muted">During quiet hours, alert and recovery emails to you are held back and not resent. Alerts still land in your inbox, incidents stay open and escalation reminders keep coming, so the first reminder after quiet hours reaches you by email. The instance's own contact address is not affected.</p>
                <div class="form-check mb-2">
                    <input id="quiet-enabled" type="checkbox" class="form-check-input" data-testid="quiet-hours-enabled" @bind="_quietEnabled" />
                    <label for="quiet-enabled" class="form-check-label small">Hold alert email during quiet hours</label>
                </div>
                <div class="d-flex gap-2 flex-wrap align-items-end">
                    <div class="field">
                        <label for="quiet-start" class="form-label small">From (24-hour)</label>
                        <input id="quiet-start" type="time" class="form-control form-control-sm" @bind="_quietStart" disabled="@(!_quietEnabled)" />
                    </div>
                    <div class="field">
                        <label for="quiet-end" class="form-label small">Until (24-hour)</label>
                        <input id="quiet-end" type="time" class="form-control form-control-sm" @bind="_quietEnd" disabled="@(!_quietEnabled)" />
                    </div>
                    <div class="field" style="min-width:220px;max-width:100%;">
                        <label for="quiet-zone" class="form-label small">Time zone</label>
                        <select id="quiet-zone" class="form-select form-select-sm" @bind="_quietZone" disabled="@(!_quietEnabled)">
                            @foreach (var z in TimeZoneInfo.GetSystemTimeZones())
                            {
                                <option value="@z.Id">@z.DisplayName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-check mt-2">
                    <input id="quiet-critical" type="checkbox" class="form-check-input" @bind="_quietCriticalBypass" disabled="@(!_quietEnabled)" />
                    <label for="quiet-critical" class="form-check-label small">Still email me about failed backups during quiet hours</label>
                </div>
                <div class="d-flex gap-2 align-items-center mt-3 flex-wrap">
                    <button class="btn btn-outline-primary btn-sm" data-testid="quiet-hours-save" @onclick="SaveQuietHours" disabled="@_savingQuiet">@(_savingQuiet ? "Saving…" : "Save quiet hours")</button>
                    <span class="small" role="status" data-testid="quiet-hours-status">@_quietStatus</span>
                </div>
                @if (_quietError is not null)
                {
                    <div class="small text-danger mt-2" role="alert">@_quietError</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 20;
    private NotificationInboxPage? _page;
    private int _inboxPage = 1;
    private string? _userId;

    private List<NotificationSubscription> _subscriptions = new();
    private List<InstanceListRow> _instances = new();
    private List<string> _companies = new();
    private SubscriptionScope _newScope = SubscriptionScope.AllInstances;
    private int _newInstanceId;
    private string _newCompany = "";
    private NotificationChannel _newChannel = NotificationChannel.InApp;
    private List<TeamSummary> _teams = new();
    private int _newTeamId;
    private string? _subscriptionError;

    private bool _quietEnabled;
    private TimeOnly _quietStart = new(22, 0);
    private TimeOnly _quietEnd = new(7, 0);
    private string _quietZone = TimeZoneInfo.Local.Id;
    private bool _quietCriticalBypass = true;
    private bool _savingQuiet;
    private string _quietStatus = "";
    private string? _quietError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        _instances = await OverviewService.GetAllSummariesAsync();
        _companies = _instances.Select(i => i.Company).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList();
        if (_instances.Count > 0) _newInstanceId = _instances[0].Id;
        if (_companies.Count > 0) _newCompany = _companies[0];
        _teams = await Teams.ListAsync();
        if (_teams.Count > 0) _newTeamId = _teams[0].Team.Id;

        if (!string.IsNullOrEmpty(_userId))
        {
            var pref = await Preferences.GetAsync(_userId);
            _quietEnabled = pref.QuietHoursEnabled;
            _quietStart = new TimeOnly(pref.QuietStartMinute / 60, pref.QuietStartMinute % 60);
            _quietEnd = new TimeOnly(pref.QuietEndMinute / 60, pref.QuietEndMinute % 60);
            _quietZone = TimeZoneInfo.TryFindSystemTimeZoneById(pref.TimeZoneId, out _) ? pref.TimeZoneId : TimeZoneInfo.Local.Id;
            _quietCriticalBypass = pref.CriticalBypassesQuietHours;
            _quietStatus = DescribeQuiet();
        }

        await LoadInbox();
        await LoadSubscriptions();
    }

    private async Task LoadInbox()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _page = await NotificationSvc.GetInboxAsync(_userId, _inboxPage, PageSize);
    }

    private async Task LoadSubscriptions()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _subscriptions = await Subscriptions.ListAsync(_userId);
    }

    private async Task ChangeInboxPage(int page)
    {
        _inboxPage = Math.Max(1, page);
        await LoadInbox();
    }

    private async Task MarkAllRead()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        await NotificationSvc.MarkAllReadAsync(_userId);
        await LoadInbox();
    }

    private async Task OpenItem(NotificationInboxItem n)
    {
        if (string.IsNullOrEmpty(_userId)) return;
        if (!n.IsRead)
        {
            await NotificationSvc.MarkReadAsync(_userId, n.Id);
            await LoadInbox();
        }
        if (n.DatabaseInstanceId is { } id)
        {
            Nav.NavigateTo($"/instances/{id}");
        }
    }

    private async Task AddSubscription()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _subscriptionError = await Subscriptions.AddAsync(_userId, _newScope, _newScope == SubscriptionScope.Instance ? _newInstanceId : null,
            _newScope == SubscriptionScope.Company ? _newCompany : "", _newChannel,
            _newScope == SubscriptionScope.Team ? _newTeamId : null);
        if (_subscriptionError is not null)
        {
            return;
        }
        await LoadSubscriptions();
        await LoadInbox();
        Toasts.Success("Subscription added.");
    }

    private async Task DeleteSubscription(int id)
    {
        if (string.IsNullOrEmpty(_userId)) return;
        await Subscriptions.DeleteAsync(id, _userId);
        await LoadSubscriptions();
        await LoadInbox();
    }

    private async Task SaveQuietHours()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _savingQuiet = true;
        _quietError = await Preferences.SaveAsync(_userId, _quietEnabled,
            _quietStart.Hour * 60 + _quietStart.Minute, _quietEnd.Hour * 60 + _quietEnd.Minute,
            _quietZone, _quietCriticalBypass);
        _savingQuiet = false;
        _quietStatus = _quietError is null ? "Saved. " + DescribeQuiet() : "";
    }

    private string DescribeQuiet() =>
        _quietEnabled
            ? $"Quiet hours {QuietHoursEvaluator.FormatClock(_quietStart.Hour * 60 + _quietStart.Minute)} to {QuietHoursEvaluator.FormatClock(_quietEnd.Hour * 60 + _quietEnd.Minute)}, {(_quietCriticalBypass ? "failed-backup alerts still emailed" : "no alert email at all")}."
            : "Quiet hours are off.";

    private static string SubscriptionTarget(NotificationSubscription s) => s.Scope switch
    {
        SubscriptionScope.Instance => s.DatabaseInstance?.Name ?? "(deleted instance)",
        SubscriptionScope.Company => s.Company,
        SubscriptionScope.Team => s.Team?.Name ?? "(deleted team)",
        _ => ""
    };

    private static string ChannelLabel(NotificationChannel channel) => channel switch
    {
        NotificationChannel.InApp => "In-app only",
        NotificationChannel.Email => "Email only",
        _ => "In-app + email"
    };

    private static string SeverityColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Critical => "var(--dbt-failed)",
        NotificationSeverity.Warning => "var(--dbt-overdue)",
        _ => "var(--dbt-never)"
    };
}
