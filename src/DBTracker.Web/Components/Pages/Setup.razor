@page "/setup"
@attribute [Authorize(Roles = Roles.Admin)]
@using System.ComponentModel.DataAnnotations
@inject SetupDiagnosticsService Diagnostics
@inject ToastService Toasts
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Setup &amp; diagnostics · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Setup &amp; diagnostics</h1>
        <div class="subtitle">Admin only. Diagnose configuration without database or log access. Credentials are masked below.</div>
    </div>
    <button class="btn btn-outline-secondary" @onclick="Load"><i aria-hidden="true" class="bi bi-arrow-clockwise"></i> Refresh</button>
</div>

@if (_items is null)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else
{
    <div class="dbt-table mb-4">
        <table aria-label="Setup checklist" class="table">
            <thead><tr><th>Area</th><th>Check</th><th>Status</th><th>Detail</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td class="small text-muted">@item.Area</td>
                        <td class="small fw-semibold">@item.Label</td>
                        <td><span class="badge-health dot @SeverityClass(item.Severity)">@item.Severity</span></td>
                        <td class="small">@item.Detail</td>
                        <td class="small">
                            @if (item.NextActionUrl is not null)
                            {
                                <a href="@item.NextActionUrl">@item.NextActionLabel</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="dbt-card mb-4">
        <h2 class="h6 text-muted mb-3">Backup file path reachability</h2>
        <p class="text-muted small mb-3">Checked under the service's own process identity, the same one the background scanner runs as.</p>
        @if (_paths is null)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="CheckPaths" disabled="@_checkingPaths">@(_checkingPaths ? "Checking…" : "Check configured paths")</button>
        }
        else if (_paths.Count == 0)
        {
            <div class="text-muted small">No instances have a backup file location configured.</div>
        }
        else
        {
            <table aria-label="Backup file path reachability" class="table table-sm dbt-table mb-0">
                <thead><tr><th>Instance</th><th>Path</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var p in _paths)
                    {
                        <tr>
                            <td class="small">@p.InstanceName</td>
                            <td class="small text-muted">@p.Path</td>
                            <td class="small">
                                @if (p.Reachable)
                                {
                                    <span class="badge-health dot OnTrack">Reachable</span>
                                }
                                else
                                {
                                    <span class="badge-health dot Failed">Unreachable</span>
                                    <span class="text-muted">: @p.Error</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="dbt-card" style="max-width:480px;">
        <h2 class="h6 text-muted mb-3">Send test email</h2>
        <div class="d-flex gap-2 align-items-end flex-wrap">
            <div class="field" style="min-width:260px;">
                <label for="setup-recipient" class="form-label small">Recipient</label>
                <input id="setup-recipient" class="form-control form-control-sm" @bind="_testEmailAddress" @bind:event="oninput" placeholder="you@architonixlabs.com" />
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="SendTestEmail" disabled="@(_sendingTest || string.IsNullOrWhiteSpace(_testEmailAddress))">
                @(_sendingTest ? "Sending…" : "Send test email")
            </button>
        </div>
        @if (_testResult is not null)
        {
            <div class="small mt-2" style="color:@(_testResult.Outcome == DBTracker.Core.Enums.EmailSendOutcome.Accepted ? "var(--dbt-ontrack)" : "var(--dbt-failed)")">
                @_testResult.Outcome switch
                {
                    DBTracker.Core.Enums.EmailSendOutcome.Disabled => "No email provider is configured, so nothing was attempted. See Email:Provider above.",
                    DBTracker.Core.Enums.EmailSendOutcome.Accepted => "The provider accepted the message. (Acceptance isn't proof the recipient received it.)",
                    _ => $"Failed: {_testResult.Detail}"
                }
            </div>
        }
    </div>

    <div class="dbt-card mt-4" id="delivery-history">
        <h2 class="h6 text-muted mb-2">Delivery history</h2>
        <p class="text-muted small mb-3">The last @_attempts.Count send attempts: reports, alerts, recovery notices and test emails by email, and alerts by webhook. For email, "Accepted" means the provider took the message, not that it reached the inbox; for a webhook, it means the endpoint answered with a success status. Addresses and the webhook URL aren't stored, only counts.</p>
        @if (_attempts.Count == 0)
        {
            <div class="empty-state py-3" data-testid="delivery-history-empty"><i aria-hidden="true" class="bi bi-envelope"></i>No send attempts recorded yet. Send a test email above to check delivery.</div>
        }
        else
        {
            <div class="dbt-table" role="region" aria-label="Delivery history" tabindex="0">
                <table class="table table-sm mb-0" data-testid="delivery-history">
                    <thead><tr><th scope="col">When</th><th scope="col">What</th><th scope="col">Channel</th><th scope="col">Scope</th><th scope="col">Recipients</th><th scope="col">Outcome</th><th scope="col">Error</th><th scope="col">Triggered by</th></tr></thead>
                    <tbody>
                        @foreach (var a in _attempts)
                        {
                            <tr data-testid="delivery-attempt-row">
                                <td class="small"><LocalTime Utc="a.AttemptedAtUtc" Format="MMM d, h:mm tt" ShowUtc="false" /></td>
                                <td class="small">@DeliveryOutcomeSummarizer.Describe(a.Kind)</td>
                                <td class="small">@a.Channel</td>
                                <td class="small">@a.ScopeDescription</td>
                                <td class="small">
                                    @a.RecipientCount
                                    @if (a.HeldForQuietHoursCount > 0)
                                    {
                                        <span class="text-muted">(@a.HeldForQuietHoursCount held by quiet hours)</span>
                                    }
                                </td>
                                <td class="small"><span class="badge-health dot @OutcomeClass(a.Outcome)">@DeliveryOutcomeSummarizer.Describe(a.Outcome)</span>@(a.Outcome == DeliveryOutcome.Partial ? $" ({a.AcceptedCount} accepted, {a.FailedCount} failed)" : "")</td>
                                <td class="small text-danger">@a.Error</td>
                                <td class="small text-muted">@a.TriggeredBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<DiagnosticItem>? _items;
    private List<PathCheck>? _paths;
    private bool _checkingPaths;
    private string _testEmailAddress = "";
    private bool _sendingTest;
    private EmailSendResult? _testResult;
    private List<DeliveryAttempt> _attempts = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _items = await Diagnostics.BuildChecklistAsync();
        _attempts = await Diagnostics.ListDeliveryAttemptsAsync();
        _paths = null;
    }

    private async Task CheckPaths()
    {
        _checkingPaths = true;
        _paths = await Diagnostics.CheckFilePathsAsync();
        _checkingPaths = false;
    }

    private async Task SendTestEmail()
    {
        _sendingTest = true;
        var userName = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
        _testResult = await Diagnostics.SendTestEmailAsync(_testEmailAddress, userName);
        _attempts = await Diagnostics.ListDeliveryAttemptsAsync();
        _sendingTest = false;

        if (_testResult.Outcome == DBTracker.Core.Enums.EmailSendOutcome.Accepted)
        {
            Toasts.Success("Test email accepted by the provider.");
        }
        else
        {
            Toasts.Error(_testResult.Outcome == DBTracker.Core.Enums.EmailSendOutcome.Disabled
                ? "Email is disabled (Email:Provider=None), so nothing was sent."
                : $"Send failed: {_testResult.Detail}");
        }
    }

    private static string OutcomeClass(DeliveryOutcome outcome) => outcome switch
    {
        DeliveryOutcome.Accepted => "OnTrack",
        DeliveryOutcome.Partial => "Overdue",
        DeliveryOutcome.Failed => "Failed",
        _ => "NeverBackedUp"
    };

    private static string SeverityClass(DiagnosticSeverity severity) => severity switch
    {
        DiagnosticSeverity.Ok => "OnTrack",
        DiagnosticSeverity.Warning => "Overdue",
        _ => "Failed"
    };
}
