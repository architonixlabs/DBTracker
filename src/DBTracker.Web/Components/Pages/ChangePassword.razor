@page "/account/change-password"
@using System.ComponentModel.DataAnnotations
@using DBTracker.Infrastructure.Identity
@attribute [Authorize]
@inject AccountLifecycleService Lifecycle
@inject AuthenticationStateProvider AuthProvider
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtection

<PageTitle>Change password · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Change password</h1>
        <div class="subtitle">@(_mustChange ? "Your current password was set by an administrator. Choose your own before continuing." : "Update your own sign-in password.")</div>
    </div>
</div>

<div class="dbt-card" style="max-width:480px;">
    @if (Changed)
    {
        <p class="mb-2" role="status" data-testid="password-changed">Your password was changed. You're still signed in on this device; other devices and browsers were signed out.</p>
        <a href="/" class="btn btn-outline-secondary btn-sm">Go to the dashboard</a>
    }
    else
    {
    <EditForm Model="_model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="mb-2">
            <label for="changepassword-current-password" class="form-label small">Current password</label>
            <InputText id="changepassword-current-password" type="password" class="form-control form-control-sm" @bind-Value="_model.CurrentPassword" />
            <ValidationMessage For="() => _model.CurrentPassword" />
        </div>
        <div class="mb-3">
            <label for="changepassword-new-password" class="form-label small">New password</label>
            <InputText id="changepassword-new-password" type="password" class="form-control form-control-sm" @bind-Value="_model.NewPassword" />
            <ValidationMessage For="() => _model.NewPassword" />
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="text-danger small mb-2">@_error</div>
        }
        <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">@(_saving ? "Saving…" : "Change password")</button>
    </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery] public bool Required { get; set; }

    [SupplyParameterFromQuery] public bool Changed { get; set; }

    private readonly Model _model = new();
    private string? _error;
    private bool _saving;
    private bool _mustChange;
    private string _userId = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        if (user is not null)
        {
            _userId = user.Id;
            _mustChange = user.MustChangePassword || Required;
        }
    }

    private async Task Submit()
    {
        _error = null;
        _saving = true;
        var ok = await Lifecycle.ChangeOwnPasswordAsync(_userId, _model.CurrentPassword, _model.NewPassword);
        _saving = false;

        if (!ok)
        {
            _error = "Current password is incorrect, or the new password doesn't meet policy.";
            return;
        }

        // The change rotated the security stamp. Re-issue this browser's cookie over a real request so it isn't signed out too.
        var user = await UserManager.FindByIdAsync(_userId);
        var stamp = user is null ? "" : await UserManager.GetSecurityStampAsync(user) ?? "";
        Nav.NavigateTo(Microsoft.AspNetCore.Routing.SignInRefreshEndpointRouteBuilderExtensions.CreateUrl(DataProtection, _userId, stamp, "/account/change-password?Changed=true"), forceLoad: true);
    }

    private class Model
    {
        [Required]
        public string CurrentPassword { get; set; } = "";

        [Required, MinLength(8, ErrorMessage = "At least 8 characters.")]
        public string NewPassword { get; set; } = "";
    }
}
