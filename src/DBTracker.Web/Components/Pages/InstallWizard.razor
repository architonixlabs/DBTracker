    {
        Step.Key => "Setup key",
        Step.Database => "Database",
        Step.Tables => "Tables",
        Step.Sample => "Sample data",
        Step.Admin => "Administrator",
        Step.Email => "Email",
        Step.Share => "Backup share",
        _ => "Finish",
    };

    private static string StepTitle(Step step) => step switch
    {
        Step.Key => "Enter the setup key",
        Step.Database => "Connect to SQL Server",
        Step.Tables => "Create the tables",
        Step.Sample => "Sample data",
        Step.Admin => "Create the Administrator account",
        Step.Email => "Email delivery",
        Step.Share => "Check a backup share",
