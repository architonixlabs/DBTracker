    };

    private static string RowBadge(MigrationState state) => state switch
    {
        MigrationState.Done => "OnTrack",
        MigrationState.Running => "Overdue",
        MigrationState.Failed => "Failed",
        _ => "NeverBackedUp",
    };

    private static string RowLabel(MigrationState state) => state switch
    {
        MigrationState.Done => "Created",
        MigrationState.Running => "Creating",
        MigrationState.Failed => "Failed",
        _ => "Waiting",
    };

    private string TestResultClass => _testResult?.Outcome switch
    {
        EmailSendOutcome.Accepted => "alert-success",
        EmailSendOutcome.Failed => "alert-danger",
        _ => "alert-warning",
    };

    private string TestResultText => _testResult?.Outcome switch
    {
        EmailSendOutcome.Accepted => $"The provider accepted the message for {_email.TestTo.Trim()}. Check that inbox to confirm it arrived.",
        EmailSendOutcome.Failed => $"Sending failed: {_testResult.Detail}",
        _ => $"Nothing was sent. {(_testResult?.Detail ?? "Email is turned off or the settings are incomplete.")}",
    };

    private string EmailSummary => _email.Provider switch
    {
        EmailProviders.ArxMail => $"ArxMail gateway, from {_email.ArxMailFromAddress.Trim()}{ReportsSuffix}",
        EmailProviders.Smtp => $"SMTP via {_email.SmtpHost.Trim()}:{_email.SmtpPort}, from {_email.SmtpFromAddress.Trim()}{ReportsSuffix}",
        _ => "Off. Alerts and reports are logged, not sent.",
    };

    private string ReportsSuffix => string.IsNullOrWhiteSpace(_email.DistributionList)
        ? ""
        : $". Reports go to {string.Join(", ", SplitAddresses(_email.DistributionList))}";

    public void Dispose() => _persisting.Dispose();
