@page "/"
@attribute [Authorize]
@implements IDisposable
@inject InstanceOverviewService OverviewService
@inject IncidentService Incidents
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Dashboard · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <div class="eyebrow">Overview</div>
        <h1>Dashboard</h1>
        <div class="subtitle">Backup health across every tracked database instance, ranked by what needs attention first.</div>
    </div>
</div>

@if (_rows is null)
{
    <div class="skeleton-stats">
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
    </div>
    <div class="dbt-table">
        @for (var i = 0; i < 5; i++)
        {
            <div class="skeleton skeleton-row"></div>
        }
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="small text-muted" role="status">
            @if (_refreshError is not null)
            {
                <span style="color:var(--dbt-failed)"><i class="bi bi-exclamation-circle"></i> Refresh failed: @_refreshError — showing data as of last successful load.</span>
            }
            else
            {
                <span>Updated @FormatAge(_lastUpdatedUtc)</span>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshNow" disabled="@_refreshing">
                <i class="bi bi-arrow-clockwise"></i> @(_refreshing ? "Refreshing…" : "Refresh")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleAutoRefresh" title="Auto-refreshes every 30s while on">
                <i class="bi @(_autoRefreshPaused ? "bi-play-fill" : "bi-pause-fill")"></i> Auto-refresh @(_autoRefreshPaused ? "paused" : "on")
            </button>
        </div>
    </div>

    @if (_scanIssueCount > 0)
    {
        <div class="alert alert-danger mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-exclamation-triangle"></i> @_scanIssueCount shared-drive scan(s) erroring, stale or never completed.</span>
            <a class="btn btn-outline-secondary btn-sm" href="/reports?type=ScanActivity">View scan activity</a>
        </div>
    }

    @if (_openIncidents.Count > 0)
    {
        <div class="alert alert-warning mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-person-exclamation"></i> @_openIncidents.Count open incident(s) — @_openIncidents.Count(i => i.AcknowledgedAtUtc is null) unacknowledged.</span>
            <a class="btn btn-outline-secondary btn-sm" href="/instances/@_openIncidents[0].DatabaseInstanceId">Open earliest</a>
        </div>
    }

    <div class="stat-strip">
        <a href="/instances" class="stat-cell Total @(_filterHealth is null ? "is-active" : "")" @onclick="() => SetFilter(null)" @onclick:preventDefault="true">
            <div class="stat-label">Total instances</div>
            <div class="stat-value">@_rows.Count</div>
        </a>
        <a href="/instances?health=OnTrack" class="stat-cell OnTrack @(_filterHealth == BackupHealth.OnTrack ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.OnTrack)" @onclick:preventDefault="true">
            <div class="stat-label"><span class="stat-dot OnTrack"></span>On track</div>
            <div class="stat-value">@Count(BackupHealth.OnTrack)</div>
        </a>
        <a href="/instances?health=Overdue" class="stat-cell Overdue @(_filterHealth == BackupHealth.Overdue ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.Overdue)" @onclick:preventDefault="true">
            <div class="stat-label"><span class="stat-dot Overdue"></span>Overdue</div>
            <div class="stat-value">@Count(BackupHealth.Overdue)</div>
        </a>
        <a href="/instances?health=Failed" class="stat-cell Failed @(_filterHealth == BackupHealth.Failed ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.Failed)" @onclick:preventDefault="true">
            <div class="stat-label"><span class="stat-dot Failed"></span>Failed</div>
            <div class="stat-value">@Count(BackupHealth.Failed)</div>
        </a>
        @if (Count(BackupHealth.NeverBackedUp) > 0)
        {
            <a href="/instances?health=NeverBackedUp" class="stat-cell NeverBackedUp @(_filterHealth == BackupHealth.NeverBackedUp ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.NeverBackedUp)" @onclick:preventDefault="true">
                <div class="stat-label"><span class="stat-dot NeverBackedUp"></span>Never backed up</div>
                <div class="stat-value">@Count(BackupHealth.NeverBackedUp)</div>
            </a>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0" style="font-family:var(--dbt-mono);font-weight:500;color:var(--dbt-sidebar-fg-active);">@(_filterHealth is null ? "All instances, most at risk first" : $"Instances: {FilterLabel(_filterHealth)}")</h2>
        <a class="small" href="@($"/instances{(_filterHealth is null ? "" : $"?health={_filterHealth}")}")">Open in Instances (filtered, sortable, shareable) &rarr;</a>
    </div>

    <div class="dbt-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Instance</th>
                    <th>Engine</th>
                    <th>Application / Owner</th>
                    <th>Role</th>
                    <th>Health</th>
                    <th>Last backup</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Sorted())
                {
                    <tr @onclick='() => Nav.NavigateTo($"/instances/{o.Id}")'>
                        <td>
                            <div class="fw-semibold">@o.Name</div>
                            <div class="text-muted small">@o.Environment</div>
                        </td>
                        <td><span class="engine-pill">@o.Engine</span></td>
                        <td>
                            <div>@o.Application</div>
                            <div class="text-muted small">@o.Company · @o.Department</div>
                        </td>
                        <td><span class="role-pill @o.Role">@o.Role</span></td>
                        <td>
                            <HealthBadge Health="o.Health" />
                            @if (o.MaintenanceUntilUtc > DateTime.UtcNow)
                            {
                                <i class="bi bi-cone-striped text-muted ms-1" title="Under maintenance — alerts suppressed"></i>
                            }
                        </td>
                        <td>@(o.LastBackupUtc is null ? "—" : o.LastBackupUtc.Value.ToLocalTime().ToString("MMM d, h:mm tt"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Sorted().Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            No instances match this filter.
        </div>
    }
}

@code {
    // Dashboard reads the lightweight InstanceListRow projection (U06) rather than including every
    // instance's full BackupRecords/RestoreEvents collections — the stat counts and risk-sorted
    // table only ever need each instance's latest record/success, which is all that shape carries.
    private List<InstanceListRow>? _rows;
    private List<Core.Entities.Incident> _openIncidents = new();
    private BackupHealth? _filterHealth;
    private int _scanIssueCount;
    private DateTime _lastUpdatedUtc;
    private string? _refreshError;
    private bool _refreshing;
    private bool _autoRefreshPaused;
    private Timer? _autoRefreshTimer;

    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _autoRefreshTimer = new Timer(async _ => await AutoRefreshTickAsync(), null, AutoRefreshInterval, AutoRefreshInterval);
    }

    private async Task Load()
    {
        try
        {
            // Preserves the current filter (a separate field, untouched by this reload) so a
            // manual or periodic refresh doesn't reset what the user was looking at.
            _rows = await OverviewService.GetAllSummariesAsync();
            _openIncidents = await Incidents.ListOpenAsync();
            _lastUpdatedUtc = DateTime.UtcNow;
            _refreshError = null;

            var scanRows = ScanActivityReportBuilder.Build(
                _rows.Select(r => new ScanActivityInput(r.Name, r.BackupFileLocation, r.LastScanUtc, r.LastScanStatus, r.LastScanError)),
                Configuration.GetValue("BackupScan:IntervalMinutes", 15),
                Configuration.GetValue("BackupScan:StaleAfterMultiplier", 3),
                DateTime.UtcNow);
            _scanIssueCount = scanRows.Count(r => r.Scanner.Freshness is ScannerFreshness.Error or ScannerFreshness.NeverScanned or ScannerFreshness.Stale);
        }
        catch (Exception ex)
        {
            _refreshError = ex.Message;
        }
    }

    private async Task RefreshNow()
    {
        _refreshing = true;
        await Load();
        _refreshing = false;
    }

    private async Task AutoRefreshTickAsync()
    {
        if (_autoRefreshPaused)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        });
    }

    private void ToggleAutoRefresh() => _autoRefreshPaused = !_autoRefreshPaused;

    private static string FormatAge(DateTime lastUpdatedUtc)
    {
        var age = DateTime.UtcNow - lastUpdatedUtc;
        return age.TotalSeconds < 5 ? "just now" : $"{lastUpdatedUtc.ToLocalTime():h:mm:ss tt} ({(int)age.TotalSeconds}s ago)";
    }

    private int Count(BackupHealth health) => _rows?.Count(r => r.Health == health) ?? 0;

    private void SetFilter(BackupHealth? health) => _filterHealth = health;

    private static readonly Dictionary<BackupHealth, int> RiskRank = new()
    {
        [BackupHealth.Failed] = 0,
        [BackupHealth.NeverBackedUp] = 1,
        [BackupHealth.Overdue] = 2,
        [BackupHealth.OnTrack] = 3,
    };

    private IEnumerable<InstanceListRow> Sorted()
    {
        var items = _rows ?? Enumerable.Empty<InstanceListRow>();
        if (_filterHealth is not null)
        {
            items = items.Where(o => o.Health == _filterHealth);
        }
        return items.OrderBy(o => RiskRank[o.Health]).ThenBy(o => o.Name);
    }

    private static string FilterLabel(BackupHealth? health) => health switch
    {
        BackupHealth.OnTrack => "On track",
        BackupHealth.Overdue => "Overdue",
        BackupHealth.Failed => "Failed",
        BackupHealth.NeverBackedUp => "Never backed up",
        _ => "All"
    };

    public void Dispose() => _autoRefreshTimer?.Dispose();
}
