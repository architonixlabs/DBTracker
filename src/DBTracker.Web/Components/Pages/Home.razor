@page "/"
@inject InstanceOverviewService OverviewService
@inject NavigationManager Nav

<PageTitle>Dashboard · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <div class="eyebrow">Overview</div>
        <h1>Dashboard</h1>
        <div class="subtitle">Backup health across every tracked database instance, ranked by what needs attention first.</div>
    </div>
</div>

@if (_overviews is null)
{
    <div class="skeleton-stats">
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
    </div>
    <div class="dbt-table">
        @for (var i = 0; i < 5; i++)
        {
            <div class="skeleton skeleton-row"></div>
        }
    </div>
}
else
{
    @if (_scanIssueCount > 0)
    {
        <div class="alert alert-danger mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-exclamation-triangle"></i> @_scanIssueCount shared-drive scan(s) erroring or never completed.</span>
            <a class="btn btn-outline-secondary btn-sm" href="/reports">View scan activity</a>
        </div>
    }

    <div class="stat-strip">
        <button type="button" class="stat-cell Total @(_filterHealth is null ? "is-active" : "")" @onclick="() => SetFilter(null)">
            <div class="stat-label">Total instances</div>
            <div class="stat-value">@_overviews.Count</div>
        </button>
        <button type="button" class="stat-cell OnTrack @(_filterHealth == BackupHealth.OnTrack ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.OnTrack)">
            <div class="stat-label"><span class="stat-dot OnTrack"></span>On track</div>
            <div class="stat-value">@Count(BackupHealth.OnTrack)</div>
        </button>
        <button type="button" class="stat-cell Overdue @(_filterHealth == BackupHealth.Overdue ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.Overdue)">
            <div class="stat-label"><span class="stat-dot Overdue"></span>Overdue</div>
            <div class="stat-value">@Count(BackupHealth.Overdue)</div>
        </button>
        <button type="button" class="stat-cell Failed @(_filterHealth == BackupHealth.Failed ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.Failed)">
            <div class="stat-label"><span class="stat-dot Failed"></span>Failed</div>
            <div class="stat-value">@Count(BackupHealth.Failed)</div>
        </button>
        @if (Count(BackupHealth.NeverBackedUp) > 0)
        {
            <button type="button" class="stat-cell NeverBackedUp @(_filterHealth == BackupHealth.NeverBackedUp ? "is-active" : "")" @onclick="() => SetFilter(BackupHealth.NeverBackedUp)">
                <div class="stat-label"><span class="stat-dot NeverBackedUp"></span>Never backed up</div>
                <div class="stat-value">@Count(BackupHealth.NeverBackedUp)</div>
            </button>
        }
    </div>

    <h2 class="h5 mb-3" style="font-family:var(--dbt-mono);font-weight:500;color:var(--dbt-sidebar-fg-active);">@(_filterHealth is null ? "All instances, most at risk first" : $"Instances: {FilterLabel(_filterHealth)}")</h2>

    <div class="dbt-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Instance</th>
                    <th>Engine</th>
                    <th>Application / Owner</th>
                    <th>Role</th>
                    <th>Health</th>
                    <th>Last backup</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Sorted())
                {
                    <tr @onclick='() => Nav.NavigateTo($"/instances/{o.Instance.Id}")'>
                        <td>
                            <div class="fw-semibold">@o.Instance.Name</div>
                            <div class="text-muted small">@o.Instance.Environment</div>
                        </td>
                        <td><span class="engine-pill">@o.Instance.Engine</span></td>
                        <td>
                            <div>@o.Instance.Application</div>
                            <div class="text-muted small">@o.Instance.Company · @o.Instance.Department</div>
                        </td>
                        <td><span class="role-pill @o.Instance.Role">@o.Instance.Role</span></td>
                        <td>
                            <HealthBadge Health="o.Health" />
                            @if (o.Instance.MaintenanceUntilUtc > DateTime.UtcNow)
                            {
                                <i class="bi bi-cone-striped text-muted ms-1" title="Under maintenance — alerts suppressed"></i>
                            }
                        </td>
                        <td>@(o.LastBackupUtc is null ? "—" : o.LastBackupUtc.Value.ToLocalTime().ToString("MMM d, h:mm tt"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Sorted().Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            No instances match this filter.
        </div>
    }
}

@code {
    private List<InstanceOverview>? _overviews;
    private BackupHealth? _filterHealth;
    private int _scanIssueCount;

    protected override async Task OnInitializedAsync()
    {
        _overviews = await OverviewService.GetAllAsync();

        var scanRows = ScanActivityReportBuilder.Build(_overviews.Select(o => new ScanActivityInput(
            o.Instance.Name, o.Instance.BackupFileLocation, o.Instance.LastScanUtc, o.Instance.LastScanStatus, o.Instance.LastScanError)));
        _scanIssueCount = scanRows.Count(r => r.LastScanStatus is ScanStatus.Error or ScanStatus.NeverScanned);
    }

    private int Count(BackupHealth health) => _overviews?.Count(o => o.Health == health) ?? 0;

    private void SetFilter(BackupHealth? health) => _filterHealth = health;

    private static readonly Dictionary<BackupHealth, int> RiskRank = new()
    {
        [BackupHealth.Failed] = 0,
        [BackupHealth.NeverBackedUp] = 1,
        [BackupHealth.Overdue] = 2,
        [BackupHealth.OnTrack] = 3,
    };

    private IEnumerable<InstanceOverview> Sorted()
    {
        var items = _overviews ?? Enumerable.Empty<InstanceOverview>();
        if (_filterHealth is not null)
        {
            items = items.Where(o => o.Health == _filterHealth);
        }
        return items.OrderBy(o => RiskRank[o.Health]).ThenBy(o => o.Instance.Name);
    }

    private static string FilterLabel(BackupHealth? health) => health switch
    {
        BackupHealth.OnTrack => "On track",
        BackupHealth.Overdue => "Overdue",
        BackupHealth.Failed => "Failed",
        BackupHealth.NeverBackedUp => "Never backed up",
        _ => "All"
    };
}
