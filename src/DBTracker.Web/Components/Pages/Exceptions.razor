@page "/exceptions"
@attribute [Authorize]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.ChangeManagement
@using DBTracker.Infrastructure.Identity
@using DBTracker.Infrastructure.Ownership
@using Microsoft.AspNetCore.Components.Authorization
@inject ReadinessExceptionService ExceptionSvc
@inject TeamService Teams
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>Readiness exceptions · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Readiness &amp; support exceptions</h1>
        <div class="subtitle">
            An explicit, time-boxed risk acceptance against a specific target or gate, not a status override. An exception never
            changes any vendor fact and never clears the underlying risk; it is distinct from actual paid vendor support coverage.
            When one expires or is revoked, its accountable owner is told.
        </div>
    </div>
</div>

@if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-5">
            <AuthorizeView Roles="@Roles.CanEditPolicy">
            <Authorized>
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Record an exception</h2>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small mb-1" for="exceptions-target-type">Applies to</label>
                        <select id="exceptions-target-type" class="form-select form-select-sm" @bind="_targetType" @bind:after="LoadTargetOptions" data-testid="exception-target-type">
                            <option value="">Choose…</option>
                            @foreach (var t in ReadinessExceptionTargets.All)
                            {
                                <option value="@t">@ReadinessExceptionTargets.Describe(t)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1" for="exceptions-target">Which one</label>
                        <select id="exceptions-target" class="form-select form-select-sm" @bind="_targetId" disabled="@string.IsNullOrEmpty(_targetType)" data-testid="exception-target">
                            <option value="0">@(string.IsNullOrEmpty(_targetType) ? "Choose a type first" : _targetOptions.Count == 0 ? "None recorded" : "Choose…")</option>
                            @foreach (var o in _targetOptions)
                            {
                                <option value="@o.Id">@o.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-2"><label class="form-label small mb-1" for="exceptions-waived-check-policy-reference">Waived check/policy reference</label><input class="form-control form-control-sm" placeholder="Waived check/policy reference" id="exceptions-waived-check-policy-reference" @bind="_waivedCheckReference" @bind:event="oninput" /></div>
                <div class="mb-2"><label class="form-label small mb-1" for="exceptions-reason">Reason</label><textarea class="form-control form-control-sm" rows="2" placeholder="Reason" id="exceptions-reason" @bind="_reason"></textarea></div>
                <div class="mb-2"><label class="form-label small mb-1" for="exceptions-compensating-controls">Compensating controls</label><textarea class="form-control form-control-sm" rows="2" placeholder="Compensating controls" id="exceptions-compensating-controls" @bind="_compensatingControls"></textarea></div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small mb-1" for="exceptions-owner-team">Owner team</label><select id="exceptions-owner-team" class="form-select form-select-sm" @bind="_ownerTeamId">
                            <option value="0">No owner team</option>
                            @foreach (var t in _teams)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6"><label class="form-label small mb-1" for="exceptions-accountable-owner-name">Accountable owner (name)</label><input class="form-control form-control-sm" placeholder="Accountable owner (name)" id="exceptions-accountable-owner-name" @bind="_ownerName" @bind:event="oninput" /></div>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1" for="exceptions-accountable-owner-email">Accountable owner email</label>
                    <input type="email" class="form-control form-control-sm" id="exceptions-accountable-owner-email" @bind="_ownerEmail" @bind:event="oninput" aria-describedby="exceptions-owner-email-help" data-testid="exception-owner-email" />
                    <div class="form-text" id="exceptions-owner-email-help">Expiry and revocation notices go here and to the owner team's contacts.</div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small mb-1" for="exceptions-permitted-approver-role">Permitted approver role</label><input class="form-control form-control-sm" placeholder="Permitted approver role (e.g. Admin, ITManager)" id="exceptions-permitted-approver-role" @bind="_permittedApproverRole" @bind:event="oninput" /></div>
                    <div class="col-6 form-check pt-2">
                        <input class="form-check-input" type="checkbox" id="require-sep" @bind="_requiresSeparateApprover" />
                        <label class="form-check-label small" for="require-sep">Requires separate approver</label>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label for="exceptions-expires" class="form-label small">Expires</label>
                        <input id="exceptions-expires" type="date" class="form-control form-control-sm" @bind="_expiresAt" data-testid="exception-expires-input" />
                    </div>
                    <div class="col-6">
                        <label for="exceptions-review-date" class="form-label small">Review date</label>
                        <input id="exceptions-review-date" type="date" class="form-control form-control-sm" @bind="_reviewDate" />
                    </div>
                </div>
                <div class="mb-2"><label class="form-label small mb-1" for="exceptions-evidence-url-reference">Evidence URL/reference</label><input class="form-control form-control-sm" placeholder="Evidence URL/reference" id="exceptions-evidence-url-reference" @bind="_evidenceUrl" @bind:event="oninput" /></div>
                <button class="btn btn-primary btn-sm" @onclick="CreateException" disabled="@(string.IsNullOrWhiteSpace(_targetType) || _targetId == 0 || string.IsNullOrWhiteSpace(_reason) || _expiresAt == default)" data-testid="create-exception-button">Record exception</button>
                @if (_createError is not null)
                {
                    <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed);">@_createError</p>
                }
            </div>
            </Authorized>
            <NotAuthorized>
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Record an exception</h2>
                <div class="text-muted small">Recording a risk-acceptance exception is restricted to Admin/DBA users. You can view exceptions here but not record them.</div>
            </div>
            </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="col-lg-7">
            @if (_action is not null)
            {
                <div class="dbt-card mb-3" data-testid="exception-action-panel">
                    @if (_action.Value.Kind == "revoke")
                    {
                        <h2 class="h6 text-muted mb-2">Revoke exception #@_action.Value.Id</h2>
                        <p class="small text-muted">The waived check is blocked again straight away, and the accountable owner is told.</p>
                        <label class="form-label small mb-1" for="exceptions-revoke-reason">Why revoke it</label>
                        <input id="exceptions-revoke-reason" class="form-control form-control-sm mb-2" @bind="_actionReason" @bind:event="oninput" data-testid="revoke-reason-input" />
                        <button class="btn btn-danger btn-sm" @onclick="ConfirmRevoke" disabled="@string.IsNullOrWhiteSpace(_actionReason)" data-testid="confirm-revoke-button">Revoke</button>
                    }
                    else
                    {
                        <h2 class="h6 text-muted mb-2">Renew exception #@_action.Value.Id</h2>
                        <p class="small text-muted">Creates a new exception, pending approval, linked to this one. The original and its history are kept.</p>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small mb-1" for="exceptions-renew-expires">New expiry</label>
                                <input id="exceptions-renew-expires" type="date" class="form-control form-control-sm" @bind="_renewExpiresAt" data-testid="renew-expires-input" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1" for="exceptions-renew-review">Review date</label>
                                <input id="exceptions-renew-review" type="date" class="form-control form-control-sm" @bind="_renewReviewDate" />
                            </div>
                        </div>
                        <label class="form-label small mb-1" for="exceptions-renew-reason">Why it is still needed</label>
                        <textarea id="exceptions-renew-reason" class="form-control form-control-sm mb-2" rows="2" @bind="_actionReason"></textarea>
                        <button class="btn btn-primary btn-sm" @onclick="ConfirmRenew" disabled="@(_renewExpiresAt == default)" data-testid="confirm-renew-button">Request renewal</button>
                    }
                    <button class="btn btn-link btn-sm" @onclick="CancelAction">Cancel</button>
                    @if (_actionError is not null)
                    {
                        <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed);" data-testid="exception-action-error">@_actionError</p>
                    }
                </div>
            }

            @if (_exceptions.Count == 0)
            {
                <div class="empty-state"><i aria-hidden="true" class="bi bi-shield-exclamation"></i> No exceptions recorded.</div>
            }
            else
            {
                <table aria-label="Recorded exceptions" class="table table-sm dbt-table" data-testid="exception-table">
                    <thead><tr><th>Target</th><th>Waived check</th><th>Status</th><th>Expires</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var e in _exceptions)
                        {
                            var effective = ReadinessExceptionEvaluator.EffectiveStatus(e, DateTime.UtcNow);
                            var isLatest = ReadinessExceptionEvaluator.IsLatestInChain(e, _exceptions);
                            <tr data-testid="exception-row">
                                <td class="small">@ReadinessExceptionTargets.Describe(e.TargetType): @TargetLabel(e)</td>
                                <td class="small">@e.WaivedCheckReference</td>
                                <td class="small"><span class="badge-health dot @StatusCss(effective)" data-testid="exception-status">@effective</span></td>
                                <td class="small">@e.ExpiresAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="small">
                                    @if (effective == ReadinessExceptionEffectiveStatus.PendingApproval)
                                    {
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => Decide(e.Id, true)" data-testid="approve-exception-button">Approve</button>
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => Decide(e.Id, false)">Reject</button>
                                    }
                                    else if (effective == ReadinessExceptionEffectiveStatus.Active)
                                    {
                                        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="revokeAuth">
                                            <Authorized><button class="btn btn-link btn-sm p-0" @onclick='() => StartAction(e.Id, "revoke")' data-testid="revoke-exception-button">Revoke</button></Authorized>
                                        </AuthorizeView>
                                    }
                                    else if (isLatest && effective is ReadinessExceptionEffectiveStatus.Expired or ReadinessExceptionEffectiveStatus.Rejected or ReadinessExceptionEffectiveStatus.Revoked)
                                    {
                                        <AuthorizeView Roles="@Roles.CanEditPolicy" Context="renewAuth">
                                            <Authorized><button class="btn btn-link btn-sm p-0" @onclick='() => StartAction(e.Id, "renew")' data-testid="renew-exception-button">Renew</button></Authorized>
                                        </AuthorizeView>
                                    }
                                    <button class="btn btn-link btn-sm p-0 ms-1" @onclick="() => ToggleHistory(e.Id)" aria-expanded="@(_historyFor == e.Id ? "true" : "false")" data-testid="exception-history-button">History</button>
                                </td>
                            </tr>
                            @if (_historyFor == e.Id)
                            {
                                <tr>
                                    <td colspan="5" class="small" data-testid="exception-history">
                                        <ol class="mb-0 ps-3">
                                            @foreach (var h in _history)
                                            {
                                                <li data-testid="exception-history-item">
                                                    #@h.Id, prepared by @h.PreparedByUserName on @h.CreatedAtUtc.ToString("yyyy-MM-dd"), expires @h.ExpiresAtUtc.ToString("yyyy-MM-dd"):
                                                    <strong>@ReadinessExceptionEvaluator.EffectiveStatus(h, DateTime.UtcNow)</strong>
                                                    @if (h.DecidedAtUtc is { } decided)
                                                    {
                                                        <span>, decided by @h.ApprovedByUserName on @decided.ToString("yyyy-MM-dd")</span>
                                                    }
                                                    @if (h.RevokedAtUtc is { } revoked)
                                                    {
                                                        <span>, revoked by @h.RevokedBy on @revoked.ToString("yyyy-MM-dd") (@h.RevokedReason)</span>
                                                    }
                                                    @if (h.ExpiryNotifiedAtUtc is { } notified)
                                                    {
                                                        <span>, owner told it expired on @notified.ToString("yyyy-MM-dd")</span>
                                                    }
                                                    <div class="text-muted">@h.Reason</div>
                                                </li>
                                            }
                                        </ol>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private List<ReadinessException> _exceptions = new();
    private Dictionary<(string, int), string> _targetLabels = new();
    private List<ExceptionTargetOption> _targetOptions = new();
    private List<Team> _teams = new();
    private bool _loaded;
    private string _userId = "unknown", _userName = "unknown";
    private IReadOnlyCollection<string> _userRoles = [];

    private string _targetType = "", _waivedCheckReference = "", _reason = "", _compensatingControls = "", _ownerName = "", _ownerEmail = "", _permittedApproverRole = "", _evidenceUrl = "";
    private int _targetId;
    private int _ownerTeamId;
    private bool _requiresSeparateApprover = true;
    private DateTime _expiresAt;
    private DateTime? _reviewDate;
    private string? _createError;

    private (int Id, string Kind)? _action;
    private string _actionReason = "";
    private DateTime _renewExpiresAt;
    private DateTime? _renewReviewDate;
    private string? _actionError;

    private int? _historyFor;
    private List<ReadinessException> _history = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? _userName;
        _userRoles = state.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        await Load();
        _loaded = true;
    }

    private async Task Load()
    {
        _exceptions = await ExceptionSvc.ListAsync();
        _targetLabels = await ExceptionSvc.DescribeTargetsAsync(_exceptions);
        _teams = (await Teams.ListAsync()).Select(s => s.Team).ToList();
        if (_historyFor is { } id)
        {
            _history = await ExceptionSvc.GetHistoryChainAsync(id);
        }
    }

    private string TargetLabel(ReadinessException e) =>
        _targetLabels.TryGetValue((e.TargetType, e.TargetId), out var label) ? label : $"#{e.TargetId}";

    private async Task LoadTargetOptions()
    {
        _targetId = 0;
        _targetOptions = string.IsNullOrEmpty(_targetType) ? new() : await ExceptionSvc.ListTargetOptionsAsync(_targetType);
    }

    private async Task CreateException()
    {
        var exception = new ReadinessException
        {
            TargetType = _targetType,
            TargetId = _targetId,
            WaivedCheckReference = _waivedCheckReference.Trim(),
            Reason = _reason.Trim(),
            CompensatingControls = _compensatingControls.Trim(),
            AccountableOwnerTeamId = _ownerTeamId == 0 ? null : _ownerTeamId,
            AccountableOwnerName = _ownerName.Trim(),
            AccountableOwnerEmail = _ownerEmail.Trim(),
            PermittedApproverRole = _permittedApproverRole.Trim(),
            RequiresSeparateApprover = _requiresSeparateApprover,
            EvidenceUrl = _evidenceUrl.Trim(),
            ExpiresAtUtc = DateTime.SpecifyKind(_expiresAt, DateTimeKind.Utc),
            ReviewDate = _reviewDate
        };
        var (ok, reason, _) = await ExceptionSvc.CreateAsync(exception, _userId, _userName, _userRoles);
        if (!ok)
        {
            _createError = reason;
            return;
        }

        _createError = null;
        Toasts.Success("Exception recorded and pending approval.");
        _waivedCheckReference = _reason = _compensatingControls = _ownerName = _ownerEmail = _permittedApproverRole = _evidenceUrl = "";
        _targetId = 0;
        await Load();
    }

    private async Task Decide(int id, bool approve)
    {
        var (ok, reason) = await ExceptionSvc.DecideAsync(id, approve, _userId, _userName, _userRoles, "");
        if (ok)
        {
            Toasts.Success(approve ? "Exception approved." : "Exception rejected.");
        }
        else
        {
            Toasts.Error($"Not recorded: {reason}");
        }
        await Load();
    }

    private void StartAction(int id, string kind)
    {
        _action = (id, kind);
        _actionReason = "";
        _actionError = null;
        _renewExpiresAt = default;
        _renewReviewDate = null;
    }

    private void CancelAction()
    {
        _action = null;
        _actionError = null;
    }

    private async Task ConfirmRevoke()
    {
        if (_action is not { } action)
        {
            return;
        }
        var (ok, result) = await ExceptionSvc.RevokeAsync(action.Id, _userName, _actionReason, _userRoles);
        if (!ok)
        {
            _actionError = result;
            return;
        }

        _action = null;
        Toasts.Success($"Exception revoked. The waived action is reopened, and the notice went to {result}.");
        await Load();
    }

    private async Task ConfirmRenew()
    {
        if (_action is not { } action)
        {
            return;
        }
        var (ok, reason, _) = await ExceptionSvc.RenewAsync(action.Id, DateTime.SpecifyKind(_renewExpiresAt, DateTimeKind.Utc), _renewReviewDate, _actionReason,
            _userId, _userName, _userRoles);
        if (!ok)
        {
            _actionError = reason;
            return;
        }

        _action = null;
        Toasts.Success("Renewal recorded and pending approval. The original history is kept.");
        await Load();
    }

    private async Task ToggleHistory(int id)
    {
        if (_historyFor == id)
        {
            _historyFor = null;
            return;
        }
        _historyFor = id;
        _history = await ExceptionSvc.GetHistoryChainAsync(id);
    }

    private static string StatusCss(ReadinessExceptionEffectiveStatus status) => status switch
    {
        ReadinessExceptionEffectiveStatus.Active => "OnTrack",
        ReadinessExceptionEffectiveStatus.Expired => "Overdue",
        ReadinessExceptionEffectiveStatus.Revoked => "Failed",
        ReadinessExceptionEffectiveStatus.Rejected => "Failed",
        _ => "Overdue"
    };
}
