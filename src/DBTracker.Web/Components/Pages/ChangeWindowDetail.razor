@page "/change-windows/{Id:int}"
@attribute [Authorize]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.ChangeManagement
@using DBTracker.Infrastructure.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject ChangeWindowService Windows
@inject ReadinessExceptionService ExceptionSvc
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>@(_window?.Title ?? "Change window") · DBTracker</PageTitle>

@if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else if (_window is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i aria-hidden="true" class="bi bi-question-diamond"></i> Change window #@Id doesn't exist.</div>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <h1>@_window.Title <span class="badge-health dot Overdue" data-testid="change-window-detail-status">@_window.Status</span></h1>
            <div class="subtitle">
                @_window.PlannedStartUtc.ToString("yyyy-MM-dd HH:mm") to @_window.PlannedEndUtc.ToString("yyyy-MM-dd HH:mm") UTC (@_window.TimeZoneLabel) ·
                <a href="/campaigns/@_window.MigrationCampaignId/change-windows">Back to change windows</a> ·
                <a href="/change-freezes">Change freezes</a>
            </div>
        </div>
    </div>

    @if (_conflicts is not null && (_conflicts.HasFreezeConflicts || _conflicts.HasWindowOverlaps))
    {
        <div class="dbt-card mb-3" data-testid="window-conflicts" role="status" style="border-color:var(--dbt-overdue);">
            @foreach (var f in _conflicts.FreezeConflicts)
            {
                <div class="small" style="color:var(--dbt-overdue);"><strong>Change freeze:</strong> @f This window can't be approved or started unless an approved emergency exception is linked.</div>
            }
            @foreach (var w in _conflicts.WindowOverlaps)
            {
                <div class="small text-muted">@w</div>
            }
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dbt-card mb-3">
                <h2 class="h6 text-muted mb-3">Required approvals</h2>
                <p class="small text-muted">Each scope is checked against your role. A decision outside your role is refused, not just hidden, and is recorded under your account name.</p>
                <table aria-label="Required approvals" class="table table-sm dbt-table mb-2">
                    <thead><tr><th>Scope</th><th>Decision</th><th>Approver</th></tr></thead>
                    <tbody>
                        @foreach (var a in _window.Approvals)
                        {
                            <tr data-testid="approval-row">
                                <td class="small">@a.RequiredScope</td>
                                <td class="small" data-testid="approval-decision">@(a.Decision?.ToString() ?? "Pending")</td>
                                <td class="small">@a.ApproverName</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_window.Approvals.Any(a => ChangeWindowApprovalAuthorizer.IsAuthorized(a.RequiredScope, _userRoles)))
                {
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-1" for="changewindow-approval">Approval</label><select id="changewindow-approval" class="form-select form-select-sm" @bind="_approvalId">
                                <option value="0">Choose approval…</option>
                                @foreach (var a in _window.Approvals.Where(a => ChangeWindowApprovalAuthorizer.IsAuthorized(a.RequiredScope, _userRoles)))
                                {
                                    <option value="@a.Id">@a.RequiredScope</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1" for="changewindow-approval-decision">Decision</label><select id="changewindow-approval-decision" class="form-select form-select-sm" @bind="_approvalDecision">
                                @foreach (var d in Enum.GetValues<CampaignApprovalDecision>())
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-2"><label class="form-label small mb-1" for="changewindow-approval-notes">Notes (optional)</label><input class="form-control form-control-sm" id="changewindow-approval-notes" @bind="_approvalNotes" @bind:event="oninput" /></div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RecordApproval" disabled="@(_approvalId == 0)" data-testid="record-approval-button">Record decision as @_userName</button>
                }
                else
                {
                    <p class="small text-muted mb-0">Your role can't decide any of these approvals.</p>
                }
            </div>

            <div class="dbt-card mb-3">
                <p class="small mb-1">Status: <strong>@_window.Status</strong></p>
                <AuthorizeView Roles="@Roles.CanEditPolicy" Context="statusAuth">
                <Authorized>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var s in ChangeWindowStatusTransitionValidator.AllowedNextStatuses(_window.Status))
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => SetStatus(s)" data-testid="@($"status-{s}")">Set to @s</button>
                    }
                    @if (ChangeWindowStatusTransitionValidator.AllowedNextStatuses(_window.Status).Count == 0)
                    {
                        <span class="small text-muted">@_window.Status is final. Plan a new change window for further work.</span>
                    }
                </div>
                @if (_statusError is not null)
                {
                    <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed);" data-testid="status-error">@_statusError</p>
                }
                <div class="mt-3">
                    <label class="form-label small" for="changewindow-emergency-exception">Emergency exception</label>
                    @if (_windowExceptions.Count == 0)
                    {
                        <p class="small text-muted mb-1" id="changewindow-emergency-help">
                            No exception is recorded for this window. Record one on the <a href="/exceptions">exceptions page</a> with target "Change window" and this window selected.
                        </p>
                    }
                    <div class="d-flex gap-2">
                        <select id="changewindow-emergency-exception" class="form-select form-select-sm" @bind="_emergencyExceptionId" data-testid="emergency-exception-select">
                            <option value="0">None linked</option>
                            @foreach (var e in _windowExceptions)
                            {
                                <option value="@e.Id">#@e.Id @e.WaivedCheckReference (@ReadinessExceptionEvaluator.EffectiveStatus(e, DateTime.UtcNow))</option>
                            }
                        </select>
                        <button class="btn btn-link btn-sm" @onclick="LinkException" data-testid="link-exception-button">Save link</button>
                    </div>
                </div>
                </Authorized>
                </AuthorizeView>
            </div>

            <div class="dbt-card">
                <h2 class="h6 text-muted mb-2">Runbook steps</h2>
                <p class="small text-muted">Ticking a step records that someone says it was done. It runs nothing.</p>
                @if (_window.RunbookSteps.Count == 0)
                {
                    <EmptyState Compact="true" Class="small mb-2">No runbook steps yet. Steps added to this window are listed here in order.</EmptyState>
                }
                else
                {
                    <ol class="small mb-2 ps-3" data-testid="runbook-steps">
                        @foreach (var step in _window.RunbookSteps.OrderBy(s => s.Order))
                        {
                            <li class="mb-1" data-testid="runbook-step">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"runbook-step-{step.Id}")" checked="@step.IsCompleted"
                                           disabled="@(!_canEdit || IsFinal)" @onchange="e => ToggleStep(step.Id, (bool)e.Value!)" data-testid="runbook-step-checkbox" />
                                    <label class="form-check-label" for="@($"runbook-step-{step.Id}")">
                                        @step.Description @(step.IsRequired ? "" : "(optional)")
                                    </label>
                                </div>
                            </li>
                        }
                    </ol>
                    <p class="small mb-2" data-testid="runbook-progress">
                        @_window.RunbookSteps.Count(s => s.IsCompleted) of @_window.RunbookSteps.Count done.
                        @if (_window.RunbookSteps.Any(s => s.IsRequired && !s.IsCompleted))
                        {
                            <span style="color:var(--dbt-overdue);">@_window.RunbookSteps.Count(s => s.IsRequired && !s.IsCompleted) required step(s) still open.</span>
                        }
                    </p>
                }
                @if (_canEdit && !IsFinal)
                {
                    <div class="row g-2 align-items-end">
                        <div class="col-8"><label class="form-label small mb-1" for="runbook-new-step">New step</label><input id="runbook-new-step" class="form-control form-control-sm" @bind="_newStep" @bind:event="oninput" data-testid="runbook-new-step" /></div>
                        <div class="col-4 form-check">
                            <input class="form-check-input" type="checkbox" id="runbook-new-step-required" @bind="_newStepRequired" />
                            <label class="form-check-label small" for="runbook-new-step-required">Required</label>
                        </div>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="AddStep" disabled="@string.IsNullOrWhiteSpace(_newStep)" data-testid="add-runbook-step-button">Add step</button>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dbt-card h-100">
                <h2 class="h6 text-muted mb-3">Cutover journal</h2>
                <p class="small text-muted">Externally performed actions, traffic/write-state notes, go/no-go decisions, the point of no return, and rollback outcomes. Adding an entry never runs anything against any database.</p>

                @if (_window.JournalEntries.Count == 0)
                {
                    <EmptyState Compact="true" Class="small mb-2">No journal entries yet. Actions, decisions and outcomes recorded during the cutover are listed here in time order.</EmptyState>
                }
                else
                {
                    <table aria-label="Cutover journal" class="table table-sm dbt-table mb-2" data-testid="journal-table">
                        <thead><tr><th>Happened (UTC)</th><th>Type</th><th>Description</th><th>Decision</th><th>Recorded</th></tr></thead>
                        <tbody>
                            @foreach (var e in _window.JournalEntries.OrderBy(e => e.TimestampUtc))
                            {
                                <tr data-testid="journal-row">
                                    <td class="small" data-testid="journal-time">@e.TimestampUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small">@e.EntryType</td>
                                    <td class="small">@e.Description @(string.IsNullOrWhiteSpace(e.TrafficOrWriteStateNote) ? "" : $"({e.TrafficOrWriteStateNote})")</td>
                                    <td class="small">@e.Decision</td>
                                    <td class="small text-muted">@e.RecordedBy, @e.RecordedAtUtc.ToString("MMM d HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <AuthorizeView Roles="@Roles.CanEditPolicy" Context="journalAuth">
                <Authorized>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small mb-1" for="changewindow-entry-type">Entry type</label><select id="changewindow-entry-type" class="form-select form-select-sm" @bind="_entryType">
                            @foreach (var t in Enum.GetValues<CutoverJournalEntryType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1" for="changewindow-entry-decision">Go/no-go decision</label><select id="changewindow-entry-decision" class="form-select form-select-sm" @bind="_entryDecision">
                            @foreach (var d in Enum.GetValues<GoNoGoDecision>())
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1" for="changewindow-entry-time">When it happened (UTC)</label>
                    <input id="changewindow-entry-time" type="datetime-local" class="form-control form-control-sm" @bind="_entryTime" aria-describedby="changewindow-entry-time-help" data-testid="journal-time-input" />
                    <div class="form-text" id="changewindow-entry-time-help">Defaults to now. Set an earlier time when writing up something after it happened.</div>
                </div>
                <div class="mb-2"><label class="form-label small mb-1" for="changewindowdetail-description">Description</label><input class="form-control form-control-sm" placeholder="Description" id="changewindowdetail-description" @bind="_entryDescription" @bind:event="oninput" /></div>
                <div class="mb-2"><label class="form-label small mb-1" for="changewindowdetail-traffic-write-state-note">Traffic/write-state note</label><input class="form-control form-control-sm" placeholder="Traffic/write-state note" id="changewindowdetail-traffic-write-state-note" @bind="_entryTrafficNote" @bind:event="oninput" /></div>
                <button class="btn btn-primary btn-sm" @onclick="AddJournalEntry" disabled="@string.IsNullOrWhiteSpace(_entryDescription)" data-testid="add-journal-entry-button">Add journal entry</button>
                @if (_journalError is not null)
                {
                    <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed);" data-testid="journal-error">@_journalError</p>
                }
                </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ChangeWindow? _window;
    private ChangeWindowConflictResult? _conflicts;
    private List<ReadinessException> _windowExceptions = new();
    private bool _loaded, _canEdit;
    private string _userName = "unknown", _userId = "";
    private IReadOnlyCollection<string> _userRoles = [];

    private int _approvalId;
    private CampaignApprovalDecision _approvalDecision = CampaignApprovalDecision.Approved;
    private string _approvalNotes = "";
    private string? _statusError, _journalError;

    private CutoverJournalEntryType _entryType = CutoverJournalEntryType.Action;
    private GoNoGoDecision _entryDecision = GoNoGoDecision.None;
    private string _entryDescription = "", _entryTrafficNote = "";
    private DateTime _entryTime = UtcNowToMinute();

    private string _newStep = "";
    private bool _newStepRequired = true;

    private int _emergencyExceptionId;

    private bool IsFinal => _window?.Status is ChangeWindowStatus.Completed or ChangeWindowStatus.RolledBack or ChangeWindowStatus.Cancelled;

    private static DateTime UtcNowToMinute()
    {
        var now = DateTime.UtcNow;
        return new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0, DateTimeKind.Unspecified);
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _userRoles = state.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        _canEdit = state.User.IsInRole(Roles.Admin) || state.User.IsInRole(Roles.Dba);
        await Load();
        _loaded = true;
    }

    private async Task Load()
    {
        _window = await Windows.GetAsync(Id);
        if (_window is null)
        {
            return;
        }
        _conflicts = await Windows.DetectConflictsAsync(_window.MigrationCampaignId, _window.PlannedStartUtc, _window.PlannedEndUtc, _window.Id);
        _windowExceptions = await ExceptionSvc.ListAsync(ReadinessExceptionTargets.ChangeWindow, Id);
        _emergencyExceptionId = _window.EmergencyExceptionId ?? 0;
    }

    private async Task RecordApproval()
    {
        var (ok, reason) = await Windows.RecordApprovalAsync(_approvalId, _approvalDecision, _userName, _userId, _userRoles, _approvalNotes.Trim(), _userName);
        if (ok)
        {
            Toasts.Success("Approval decision recorded.");
            _approvalNotes = "";
        }
        else
        {
            Toasts.Error($"Not recorded: {reason}");
        }
        await Load();
    }

    private async Task SetStatus(ChangeWindowStatus status)
    {
        var (ok, reason) = await Windows.SetStatusAsync(Id, status, _userName);
        if (ok)
        {
            _statusError = null;
            Toasts.Success($"Status changed to {status}.");
        }
        else
        {
            _statusError = $"Blocked: {reason}";
            Toasts.Error(_statusError);
        }
        await Load();
    }

    private async Task AddJournalEntry()
    {
        var (ok, reason) = await Windows.AddJournalEntryAsync(Id, new CutoverJournalEntry
        {
            EntryType = _entryType,
            Description = _entryDescription.Trim(),
            TrafficOrWriteStateNote = _entryTrafficNote.Trim(),
            Decision = _entryDecision,
            TimestampUtc = DateTime.SpecifyKind(_entryTime, DateTimeKind.Utc)
        }, _userName, _userRoles);
        if (!ok)
        {
            _journalError = reason;
            return;
        }

        _journalError = null;
        Toasts.Success("Journal entry recorded.");
        _entryDescription = _entryTrafficNote = "";
        _entryTime = UtcNowToMinute();
        await Load();
    }

    private async Task AddStep()
    {
        var (ok, reason) = await Windows.AddRunbookStepAsync(Id, _newStep, _newStepRequired, _userName, _userRoles);
        if (ok)
        {
            Toasts.Success("Runbook step added.");
            _newStep = "";
            _newStepRequired = true;
        }
        else
        {
            Toasts.Error(reason);
        }
        await Load();
    }

    private async Task ToggleStep(int stepId, bool completed)
    {
        var (ok, reason) = await Windows.SetRunbookStepCompletedAsync(stepId, completed, _userName, _userRoles);
        if (ok)
        {
            Toasts.Success(completed ? "Step marked done." : "Step reopened.");
        }
        else
        {
            Toasts.Error(reason);
        }
        await Load();
    }

    private async Task LinkException()
    {
        var (ok, reason) = await Windows.SetEmergencyExceptionAsync(Id, _emergencyExceptionId == 0 ? null : _emergencyExceptionId, _userName);
        if (ok)
        {
            Toasts.Success(_emergencyExceptionId == 0 ? "Emergency exception link cleared." : "Emergency exception linked.");
        }
        else
        {
            Toasts.Error(reason);
        }
        await Load();
    }
}
