@page "/account/passkeys"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject PasskeyService PasskeyStore
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject AntiforgeryStateProvider Antiforgery
@inject IOptions<IdentityPasskeyOptions> PasskeyOptions
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Passkeys · DBTracker</PageTitle>

<div class="app-topbar">
    <div>
        <h1>Passkeys</h1>
        <div class="subtitle">
            Sign in with your fingerprint, face, screen lock or a security key instead of typing your password. A passkey only works
            on this site, so a fake sign-in page can't steal it. Your password keeps working too. Adding, renaming and removing
            passkeys is recorded in the audit trail.
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="dbt-card" @ref="_addCard" data-antiforgery="@_antiforgeryToken" data-testid="passkey-add-panel">
            <h2 class="h6 text-muted mb-3">Add a passkey</h2>
            @if (_support == SupportState.Checking)
            {
                <p class="small text-muted mb-0">Checking whether this browser can create passkeys…</p>
            }
            else if (_support == SupportState.Unsupported)
            {
                <p class="small mb-0" data-testid="passkey-unsupported">@_unsupportedReason You can keep signing in with your password.</p>
            }
            @* Plain DOM controls: passkeys.js reads the name and handles the click so the browser prompt runs inside the user's gesture. *@
            <div hidden="@(_support != SupportState.Supported)">
                <div class="mb-2">
                    <label for="passkey-name" class="form-label small">Passkey name (optional)</label>
                    <input id="passkey-name" class="form-control form-control-sm" maxlength="@PasskeyService.MaxNameLength" autocomplete="off"
                           placeholder="Work laptop" aria-describedby="passkey-name-hint" data-passkey-name data-testid="passkey-name" />
                    <div id="passkey-name-hint" class="form-text">Leave it blank to use your passkey provider's name, such as Google Password Manager.</div>
                </div>
                <button type="button" class="btn btn-primary btn-sm" data-passkey-add data-testid="passkey-add">
                    <i class="bi bi-fingerprint" aria-hidden="true"></i> Add a passkey
                </button>
            </div>
        </div>

        <div class="small mt-2" role="status" aria-live="polite" data-testid="passkey-status">@_status</div>
        <div class="small mt-2 text-danger" role="alert" data-testid="passkey-error">@_error</div>
    </div>

    <div class="col-md-7">
        @if (_loadError)
        {
            <div class="alert alert-warning small" role="alert">
                Your passkeys couldn't be loaded. <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else if (_passkeys is null)
        {
            <div class="text-muted small" role="status">Loading your passkeys…</div>
        }
        else if (_passkeys.Count == 0)
        {
            <div class="empty-state py-3" data-testid="passkey-empty"><i aria-hidden="true" class="bi bi-fingerprint"></i>You have no passkeys yet. Until you add one, sign in with your password.</div>
        }
        else
        {
            <div class="dbt-table">
                <table aria-label="Your passkeys" class="table" data-testid="passkey-list">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Provider</th>
                            <th scope="col">Added</th>
                            <th scope="col">Backed up</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _passkeys)
                        {
                            <tr data-testid="passkey-row">
                                <td>
                                    @if (_renamingId == p.CredentialId)
                                    {
                                        <form class="d-flex gap-2 flex-wrap align-items-center" @onsubmit="SaveRenameAsync">
                                            <label for="passkey-rename" class="visually-hidden">New name for @p.Name</label>
                                            <input id="passkey-rename" class="form-control form-control-sm" style="min-width:0;flex:1 1 10rem;" maxlength="@PasskeyService.MaxNameLength"
                                                   autocomplete="off" @bind="_renameValue" @ref="_renameInput" data-testid="passkey-rename-input" />
                                            <button type="submit" class="btn btn-primary btn-sm" data-testid="passkey-rename-save">Save name</button>
                                            <button type="button" class="btn btn-link btn-sm" @onclick="CancelRename">Cancel</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span data-testid="passkey-name-cell">@p.Name</span>
                                    }
                                </td>
                                <td class="small">@(p.Provider ?? "Not reported")</td>
                                <td class="small"><LocalTime Utc="p.CreatedAt.UtcDateTime" Format="MMM d, yyyy" ShowUtc="false" /></td>
                                <td class="small">@(p.IsBackedUp ? "Yes, synced" : "No, this device only")</td>
                                <td class="small text-nowrap">
                                    @if (_removingId == p.CredentialId)
                                    {
                                        <div class="d-flex gap-2 flex-wrap align-items-center" role="group" aria-label="@($"Confirm removing {p.Name}")">
                                            <span>Remove it? You can't sign in with it after this.</span>
                                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveAsync(p)" @ref="_confirmRemoveButton" data-testid="passkey-remove-confirm">Remove passkey</button>
                                            <button type="button" class="btn btn-link btn-sm" @onclick="CancelRemove">Cancel</button>
                                        </div>
                                    }
                                    else if (_renamingId != p.CredentialId)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => StartRename(p)" aria-label="@($"Rename passkey {p.Name}")" data-testid="passkey-rename">Rename</button>
                                        <button type="button" class="btn btn-outline-danger btn-sm ms-1" @onclick="() => StartRemove(p)" aria-label="@($"Remove passkey {p.Name}")" data-testid="passkey-remove">Remove</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private enum SupportState { Checking, Supported, Unsupported }

    private ApplicationUser? _user;
    private IReadOnlyList<PasskeySummary>? _passkeys;
    private bool _loadError;
    private SupportState _support = SupportState.Checking;
    private string _unsupportedReason = "";
    private string? _status;
    private string? _error;
    private string? _antiforgeryToken;

    private string? _renamingId;
    private string _renameValue = "";
    private string? _removingId;
    private bool _focusRename;
    private bool _focusConfirm;

    private ElementReference _addCard;
    private ElementReference _renameInput;
    private ElementReference _confirmRemoveButton;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Passkeys>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        _antiforgeryToken = Antiforgery.GetAntiforgeryToken()?.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            _user = await UserManager.GetUserAsync(state.User);
            _passkeys = _user is null ? [] : await PasskeyStore.ListAsync(_user);
            _loadError = false;
        }
        catch (Exception)
        {
            _loadError = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/passkeys.js");
                _selfRef = DotNetObjectReference.Create(this);
                var result = await _module.InvokeAsync<SupportResult>("init", _addCard, _selfRef, Account());
                _support = result.Supported ? SupportState.Supported : SupportState.Unsupported;
                _unsupportedReason = result.Reason ?? "";
            }
            catch (JSException)
            {
                _support = SupportState.Unsupported;
                _unsupportedReason = "Passkeys couldn't be set up in this browser.";
            }
            StateHasChanged();
        }

        if (_focusRename)
        {
            _focusRename = false;
            await _renameInput.FocusAsync();
        }
        if (_focusConfirm)
        {
            _focusConfirm = false;
            await _confirmRemoveButton.FocusAsync();
        }
    }

    /// <summary>Called by passkeys.js as registration moves along. kind: progress, cancelled, error or added.</summary>
    [JSInvokable]
    public async Task ReportAsync(string kind, string message)
    {
        if (kind == "error")
        {
            _status = null;
            _error = message;
        }
        else
        {
            _error = null;
            _status = message;
        }
        if (kind == "added")
        {
            await LoadAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void StartRename(PasskeySummary passkey)
    {
        _removingId = null;
        _renamingId = passkey.CredentialId;
        _renameValue = passkey.Name;
        _focusRename = true;
    }

    private void CancelRename() => _renamingId = null;

    private async Task SaveRenameAsync()
    {
        if (_user is null || _renamingId is null)
        {
            return;
        }
        var result = await PasskeyStore.RenameAsync(_user, _renamingId, _renameValue);
        if (result.Succeeded)
        {
            _error = null;
            _status = $"Passkey renamed to \"{_renameValue.Trim()}\".";
            _renamingId = null;
            await LoadAsync();
        }
        else
        {
            _status = null;
            _error = result.Error;
        }
    }

    private void StartRemove(PasskeySummary passkey)
    {
        _renamingId = null;
        _removingId = passkey.CredentialId;
        _focusConfirm = true;
    }

    private void CancelRemove() => _removingId = null;

    private async Task RemoveAsync(PasskeySummary passkey)
    {
        if (_user is null)
        {
            return;
        }
        var result = await PasskeyStore.RemoveAsync(_user, passkey.CredentialId);
        _removingId = null;
        await LoadAsync();
        if (result.Succeeded)
        {
            _error = null;
            _status = $"Passkey \"{passkey.Name}\" removed. You can no longer sign in with it.";
            if (_module is not null)
            {
                try
                {
                    await _module.InvokeVoidAsync("syncAccepted", Account());
                }
                catch (JSException)
                {
                    // Provider sync is best effort; the server has already removed the passkey.
                }
            }
        }
        else
        {
            _status = null;
            _error = result.Error;
        }
    }

    private object Account()
    {
        var name = _user?.Email ?? _user?.UserName ?? "";
        return new
        {
            // Same RP ID the server puts in its WebAuthn options: the configured domain, or this request's host.
            rpId = string.IsNullOrWhiteSpace(PasskeyOptions.Value.ServerDomain) ? new Uri(Nav.BaseUri).Host : PasskeyOptions.Value.ServerDomain,
            userId = _user is null ? "" : PasskeyService.UserHandle(_user.Id),
            credentialIds = (_passkeys ?? []).Select(p => p.CredentialId).ToArray(),
            name,
            displayName = string.IsNullOrWhiteSpace(_user?.DisplayName) ? name : _user!.DisplayName,
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _addCard);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _selfRef?.Dispose();
    }

    private sealed record SupportResult(bool Supported, string? Reason);
}
