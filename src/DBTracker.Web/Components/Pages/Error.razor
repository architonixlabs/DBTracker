@page "/Error"
@attribute [Authorize]
@using System.Diagnostics

<PageTitle>Something went wrong · DBTracker</PageTitle>

<h1 class="text-danger">Something went wrong</h1>
<p>DBTracker could not finish this request. Check whether your last change appears, then try again, or go back to the <a href="/">dashboard</a>.</p>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<p class="small text-muted">If this keeps happening, send the request ID above to your DBTracker administrator.</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
