@page "/campaigns/{Id:int}/validation"
@attribute [Authorize]
@using DBTracker.Core.Entities
@using DBTracker.Core.Enums
@using DBTracker.Core.Services
@using DBTracker.Infrastructure.ChangeManagement
@using DBTracker.Infrastructure.Identity
@using DBTracker.Infrastructure.MigrationPlanning
@using Microsoft.AspNetCore.Components.Authorization
@inject CampaignService Campaigns
@inject ChangeValidationService Validations
@inject CampaignCompletionGateService CompletionGate
@inject AuthenticationStateProvider AuthProvider
@inject DBTracker.Web.Services.ToastService Toasts

<PageTitle>Validation · @(_campaign?.Name ?? "Campaign") · DBTracker</PageTitle>

@if (!_loaded)
{
    <div class="spinner-ring" role="status"><span class="visually-hidden">Loading</span></div>
}
else if (_campaign is null)
{
    <div class="dbt-card" style="max-width:600px;">
        <div class="empty-state py-4"><i aria-hidden="true" class="bi bi-question-diamond"></i> Campaign #@Id doesn't exist.</div>
        <a class="btn btn-outline-secondary" href="/campaigns">Back to campaigns</a>
    </div>
}
else
{
    <div class="app-topbar">
        <div>
            <h1>Post-change validation</h1>
            <div class="subtitle">
                @_campaign.Name ·
                @if (_canRecord)
                {
                    <a href="/campaigns/@Id">Back to campaign</a> <span>·</span>
                }
                Editing the Version text alone never completes a change. Completion requires the evidence below, every required sign-off from different people, and current rehearsal evidence.
            </div>
        </div>
    </div>

    @if (_gate is not null)
    {
        <div class="dbt-card mb-3" data-testid="validation-gate-banner" role="status" style="border-color:@(_gate.CanComplete ? "var(--dbt-ontrack)" : "var(--dbt-overdue)");">
            @if (_gate.CanComplete)
            {
                <strong style="color:var(--dbt-ontrack);">Ready to complete.</strong>
            }
            else
            {
                <strong style="color:var(--dbt-overdue);">Not ready to complete:</strong>
                <ul class="small mb-0" data-testid="validation-gate-reasons">
                    @foreach (var r in _gate.BlockingReasons)
                    {
                        <li>@r</li>
                    }
                </ul>
            }
        </div>
    }

    <div class="row g-3">
        @if (_canRecord)
        {
        <div class="col-lg-6">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Record validation</h2>
                <div class="mb-2">
                    <label class="form-label small mb-1" for="validation-instance">Instance</label><select id="validation-instance" class="form-select form-select-sm" @bind="_instanceId" @bind:after="LoadCandidates" data-testid="validation-instance-select">
                        <option value="0">Choose instance…</option>
                        @foreach (var link in _campaign.InstanceLinks)
                        {
                            <option value="@link.DatabaseInstanceId">@(link.DatabaseInstance?.Name ?? $"#{link.DatabaseInstanceId}")</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small mb-1" for="campaignvalidation-observed-target-build">Observed target build</label><input class="form-control form-control-sm" placeholder="Observed target build" id="campaignvalidation-observed-target-build" @bind="_observedBuild" @bind:event="oninput" /></div>
                    <div class="col-6"><label class="form-label small mb-1" for="campaignvalidation-observed-compatibility-level">Observed compatibility level</label><input class="form-control form-control-sm" placeholder="Observed compatibility level" id="campaignvalidation-observed-compatibility-level" @bind="_observedCompat" @bind:event="oninput" /></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label for="campaignvalidation-application-tests" class="form-label small">Application tests</label>
                        <select id="campaignvalidation-application-tests" class="form-select form-select-sm" @bind="_appTests" data-testid="app-tests-outcome">
                            @foreach (var o in Enum.GetValues<EvidenceCheckOutcome>())
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label for="campaignvalidation-integrity-checks" class="form-label small">Integrity checks</label>
                        <select id="campaignvalidation-integrity-checks" class="form-select form-select-sm" @bind="_integrity" data-testid="integrity-outcome">
                            @foreach (var o in Enum.GetValues<EvidenceCheckOutcome>())
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-2"><label class="form-label small mb-1" for="campaignvalidation-performance-comparison-notes">Performance comparison notes</label><input class="form-control form-control-sm" placeholder="Performance comparison notes" id="campaignvalidation-performance-comparison-notes" @bind="_perfNotes" @bind:event="oninput" /></div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label for="campaignvalidation-jobs-permissions" class="form-label small">Jobs/permissions</label>
                        <select id="campaignvalidation-jobs-permissions" class="form-select form-select-sm" @bind="_jobsPermissions" data-testid="jobs-permissions-outcome">
                            @foreach (var o in Enum.GetValues<EvidenceCheckOutcome>())
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label for="campaignvalidation-ha-replication-state" class="form-label small">HA/replication state</label>
                        <select id="campaignvalidation-ha-replication-state" class="form-select form-select-sm" @bind="_haState" data-testid="ha-state-outcome">
                            @foreach (var o in Enum.GetValues<EvidenceCheckOutcome>())
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-2">
                    <label for="campaignvalidation-new-successful-backup-restore-evidence" class="form-label small">New successful backup/restore evidence</label>
                    <select id="campaignvalidation-new-successful-backup-restore-evidence" class="form-select form-select-sm" @bind="_backupRestoreEvidence" data-testid="backup-restore-evidence-outcome">
                        @foreach (var o in Enum.GetValues<EvidenceCheckOutcome>())
                        {
                            <option value="@o">@o</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label for="campaignvalidation-linked-backup" class="form-label small">Backup that proves it</label>
                        <select id="campaignvalidation-linked-backup" class="form-select form-select-sm" @bind="_linkedBackupId" disabled="@(_instanceId == 0)" data-testid="linked-backup-select" aria-describedby="campaignvalidation-evidence-help">
                            <option value="0">None</option>
                            @foreach (var b in _candidates?.Backups ?? [])
                            {
                                <option value="@b.Id">#@b.Id @b.Type, @b.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label for="campaignvalidation-linked-restore" class="form-label small">Restore that proves it</label>
                        <select id="campaignvalidation-linked-restore" class="form-select form-select-sm" @bind="_linkedRestoreId" disabled="@(_instanceId == 0)" data-testid="linked-restore-select" aria-describedby="campaignvalidation-evidence-help">
                            <option value="0">None</option>
                            @foreach (var r in _candidates?.Restores ?? [])
                            {
                                <option value="@r.Id">#@r.Id @r.Reason, @r.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC</option>
                            }
                        </select>
                    </div>
                    <div class="form-text" id="campaignvalidation-evidence-help">
                        @if (_candidates?.ChangeStartedUtc is { } started)
                        {
                            <span>Lists successful backups and restores of this instance since the change started (@started.ToString("yyyy-MM-dd HH:mm") UTC). Log a new one on the instance page if none is listed.</span>
                        }
                        else
                        {
                            <span>Lists successful backups and restores of this instance. The change start isn't recorded yet, so older records are listed too.</span>
                        }
                        A Passed outcome needs one of them.
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label for="campaignvalidation-rollback-retention-deadline" class="form-label small">Rollback retention deadline</label>
                        <input id="campaignvalidation-rollback-retention-deadline" type="date" class="form-control form-control-sm" @bind="_rollbackRetentionDeadline" />
                    </div>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveValidation" disabled="@(_instanceId == 0)" data-testid="record-validation-button">Record validation</button>
                @if (_recordError is not null)
                {
                    <p class="small mt-2 mb-0" role="alert" style="color:var(--dbt-failed);" data-testid="record-validation-error">@_recordError</p>
                }
            </div>
        </div>
        }

        <div class="@(_canRecord ? "col-lg-6" : "col-12")">
            <div class="dbt-card">
                <h2 class="h6 text-muted mb-3">Recorded validations &amp; sign-offs</h2>
                @if (_signableScopes.Count > 0)
                {
                    <p class="small text-muted">You sign off as <strong>@_userName</strong>. Your role can sign: @string.Join(", ", _signableScopes).</p>
                }
                else
                {
                    <p class="small text-muted">Your role can't sign off any scope. You can still read the evidence.</p>
                }
                @if (_validations.Count == 0)
                {
                    <EmptyState Icon="clipboard-check" Compact="true">No validations or sign-offs recorded for this campaign yet. Each one recorded appears here with who signed it.</EmptyState>
                }
                else
                {
                    @foreach (var v in _validations)
                    {
                        <div class="mb-2 pb-2" style="border-bottom:1px solid var(--dbt-line);" data-testid="validation-row">
                            <strong class="small">@(v.DatabaseInstance?.Name ?? $"#{v.DatabaseInstanceId}")</strong>
                            <span class="small text-muted"> · build @v.ObservedTargetBuildText, @v.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC by @v.RecordedBy</span>
                            <div class="small">App tests: @v.ApplicationTestsOutcome · Integrity: @v.IntegrityCheckOutcome · Backup/restore evidence: @v.NewBackupRestoreEvidenceOutcome</div>
                            <div class="small text-muted" data-testid="validation-linked-evidence">
                                @if (v.LinkedBackupRecord is { } lb)
                                {
                                    <span>Backup #@lb.Id (@lb.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC). </span>
                                }
                                @if (v.LinkedRestoreEvent is { } lr)
                                {
                                    <span>Restore #@lr.Id (@lr.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC). </span>
                                }
                                @if (v.LinkedBackupRecord is null && v.LinkedRestoreEvent is null)
                                {
                                    <span>No backup or restore linked.</span>
                                }
                            </div>
                            @if (v.BeforeEvidenceJson is not null || v.AfterEvidenceJson is not null)
                            {
                                <details class="small">
                                    <summary>Before and after evidence</summary>
                                    <div class="mt-1"><strong>Before (inventory as recorded):</strong> <code data-testid="before-evidence">@v.BeforeEvidenceJson</code></div>
                                    <div class="mt-1"><strong>After (observed):</strong> <code data-testid="after-evidence">@v.AfterEvidenceJson</code></div>
                                </details>
                            }
                            @foreach (var s in v.Signoffs.OrderBy(s => s.SignedAtUtc))
                            {
                                <div class="small" data-testid="signoff-row">@s.ReviewerScope: @s.Outcome by @s.ReviewerName, @s.SignedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC@(string.IsNullOrWhiteSpace(s.Notes) ? "" : $" ({s.Notes})")</div>
                            }
                            @if (_signableScopes.Count > 0)
                            {
                                <div class="d-flex gap-2 mt-1 flex-wrap">
                                    <label class="visually-hidden" for="validation-signoff-scope-@v.Id">Sign-off scope</label><select id="validation-signoff-scope-@v.Id" class="form-select form-select-sm" style="width:auto;" @bind="_signoffScope" data-testid="signoff-scope-select">
                                        @foreach (var scope in _signableScopes)
                                        {
                                            <option value="@scope">@scope</option>
                                        }
                                    </select>
                                    <label class="visually-hidden" for="validation-signoff-outcome-@v.Id">Sign-off outcome</label><select id="validation-signoff-outcome-@v.Id" class="form-select form-select-sm" style="width:auto;" @bind="_signoffOutcome">
                                        @foreach (var o in Enum.GetValues<SignoffOutcome>())
                                        {
                                            <option value="@o">@o</option>
                                        }
                                    </select>
                                    <label class="visually-hidden" for="validation-signoff-notes-@v.Id">Sign-off notes</label><input id="validation-signoff-notes-@v.Id" class="form-control form-control-sm" style="width:auto;flex:1;" placeholder="Notes (optional)" @bind="_signoffNotes" @bind:event="oninput" />
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => AddSignoff(v.Id)" data-testid="add-signoff-button">Sign off as me</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private MigrationCampaign? _campaign;
    private List<ChangeValidation> _validations = new();
    private CampaignCompletionGateView? _gate;
    private PostChangeEvidenceCandidates? _candidates;
    private bool _loaded, _canRecord;
    private string _userName = "unknown", _userId = "";
    private IReadOnlyCollection<string> _userRoles = [];
    private IReadOnlyList<string> _signableScopes = [];

    private int _instanceId, _linkedBackupId, _linkedRestoreId;
    private string _observedBuild = "", _observedCompat = "", _perfNotes = "";
    private EvidenceCheckOutcome _appTests = EvidenceCheckOutcome.NotPerformed;
    private EvidenceCheckOutcome _integrity = EvidenceCheckOutcome.NotPerformed;
    private EvidenceCheckOutcome _jobsPermissions = EvidenceCheckOutcome.NotPerformed;
    private EvidenceCheckOutcome _haState = EvidenceCheckOutcome.NotPerformed;
    private EvidenceCheckOutcome _backupRestoreEvidence = EvidenceCheckOutcome.NotPerformed;
    private DateTime? _rollbackRetentionDeadline;
    private string? _recordError;

    private string _signoffScope = "", _signoffNotes = "";
    private SignoffOutcome _signoffOutcome = SignoffOutcome.Approved;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "unknown";
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _userRoles = state.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        _canRecord = state.User.IsInRole(Roles.Admin) || state.User.IsInRole(Roles.Dba);
        _signableScopes = ChangeCompletionGateEvaluator.RequiredSignoffScopes
            .Concat(["Security"])
            .Where(s => ChangeWindowApprovalAuthorizer.IsAuthorized(s, _userRoles))
            .ToList();
        _signoffScope = _signableScopes.FirstOrDefault() ?? "";
        await Load();
        _loaded = true;
    }

    private async Task Load()
    {
        _campaign = await Campaigns.GetAsync(Id);
        _validations = await Validations.ListForCampaignAsync(Id);
        _gate = await CompletionGate.EvaluateAsync(Id);
    }

    private async Task LoadCandidates()
    {
        _linkedBackupId = _linkedRestoreId = 0;
        _candidates = _instanceId == 0 ? null : await Validations.ListEvidenceCandidatesAsync(Id, _instanceId);
    }

    private async Task SaveValidation()
    {
        var validation = new ChangeValidation
        {
            MigrationCampaignId = Id,
            DatabaseInstanceId = _instanceId,
            ObservedTargetBuildText = _observedBuild.Trim(),
            ObservedCompatibilityLevel = _observedCompat.Trim(),
            ApplicationTestsOutcome = _appTests,
            IntegrityCheckOutcome = _integrity,
            PerformanceComparisonNotes = _perfNotes.Trim(),
            JobsPermissionsOutcome = _jobsPermissions,
            HaReplicationStateOutcome = _haState,
            NewBackupRestoreEvidenceOutcome = _backupRestoreEvidence,
            LinkedBackupRecordId = _linkedBackupId == 0 ? null : _linkedBackupId,
            LinkedRestoreEventId = _linkedRestoreId == 0 ? null : _linkedRestoreId,
            ValidationTimeUtc = DateTime.UtcNow,
            RollbackRetentionDeadlineUtc = _rollbackRetentionDeadline is { } d ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : null
        };
        var (ok, reason, _) = await Validations.RecordAsync(validation, _userName, _userRoles);
        if (!ok)
        {
            _recordError = reason;
            return;
        }

        _recordError = null;
        Toasts.Success("Validation recorded.");
        _observedBuild = _observedCompat = _perfNotes = "";
        await Load();
    }

    private async Task AddSignoff(int validationId)
    {
        var (ok, reason) = await Validations.AddSignoffAsync(validationId, _signoffScope, _signoffOutcome, _signoffNotes, _userId, _userName, _userRoles);
        if (ok)
        {
            Toasts.Success($"{_signoffScope} sign-off recorded as {_userName}.");
            _signoffNotes = "";
        }
        else
        {
            Toasts.Error($"Not recorded: {reason}");
        }
        await Load();
    }
}
