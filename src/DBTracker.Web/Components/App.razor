<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Self-hosted fonts: no third-party request, and locked-down servers still render. Preload only Inter's latin file. *@
    <link rel="preload" href="fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["fonts/fonts.css"]" />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DBTracker.Web.styles.css"]" />
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="RenderModeForRequest" />
    <ReconnectModal />
    <script nonce="@CspNonce" src="js/dbtracker.js"></script>
    <script nonce="@CspNonce" src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Login writes the auth cookie via SignInManager, which needs a live HTTP response. On an
    // interactive circuit its form submits over SignalR (headers already sent) and its HttpContext
    // is null, so it must stay static SSR. Only Login: the other Account pages (ForgotPassword,
    // ResetPassword, /account/change-password) rely on interactive event dispatch.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Set per request by SecurityHeadersMiddleware; the CSP only runs scripts that carry it.
    private string CspNonce => HttpContext.Items[DBTracker.Web.Services.SecurityHeadersMiddleware.NonceKey] as string ?? "";

    private IComponentRenderMode? RenderModeForRequest =>
        HttpContext.Request.Path.StartsWithSegments("/Account/Login", StringComparison.OrdinalIgnoreCase)
            ? null
            : RenderMode.InteractiveServer;
}
