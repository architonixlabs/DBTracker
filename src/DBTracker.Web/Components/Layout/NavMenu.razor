<div class="app-sidebar">
    <div class="brand">
        <span class="brand-dot"></span>
        <span class="brand-word">DBTracker</span>
        <AuthorizeView>
            <Authorized>
                <div class="ms-auto">
                    <NotificationBell />
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
    <nav>
        <NavLink class="app-nav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </NavLink>
        <NavLink class="app-nav-link" href="instances">
            <i class="bi bi-hdd-stack"></i>
            <span>Instances</span>
        </NavLink>
        <NavLink class="app-nav-link" href="compliance">
            <i class="bi bi-clipboard-check"></i>
            <span>Compliance</span>
        </NavLink>
        <NavLink class="app-nav-link" href="reports">
            <i class="bi bi-file-earmark-bar-graph"></i>
            <span>Reports</span>
        </NavLink>
        <NavLink class="app-nav-link" href="notifications">
            <i class="bi bi-inbox"></i>
            <span>Notifications</span>
        </NavLink>
        <NavLink class="app-nav-link" href="lifecycle/workspace">
            <i class="bi bi-clipboard2-pulse"></i>
            <span>Lifecycle workspace</span>
        </NavLink>
        <NavLink class="app-nav-link" href="exceptions">
            <i class="bi bi-shield-exclamation"></i>
            <span>Exceptions</span>
        </NavLink>
        <AuthorizeView Roles="@Roles.AuditViewPolicy">
            <NavLink class="app-nav-link" href="audit">
                <i class="bi bi-journal-text"></i>
                <span>Audit</span>
            </NavLink>
        </AuthorizeView>
        <AuthorizeView Roles="@Roles.CanEditPolicy">
            <NavLink class="app-nav-link" href="ownership">
                <i class="bi bi-diagram-3"></i>
                <span>Ownership</span>
            </NavLink>
            <NavLink class="app-nav-link" href="lifecycle">
                <i class="bi bi-signpost-split"></i>
                <span>Lifecycle</span>
            </NavLink>
            <NavLink class="app-nav-link" href="campaigns">
                <i class="bi bi-signpost-2"></i>
                <span>Campaigns</span>
            </NavLink>
        </AuthorizeView>
        <AuthorizeView Roles="@Roles.Admin">
            <NavLink class="app-nav-link" href="users">
                <i class="bi bi-people"></i>
                <span>Users</span>
            </NavLink>
            <NavLink class="app-nav-link" href="setup">
                <i class="bi bi-wrench-adjustable"></i>
                <span>Setup</span>
            </NavLink>
        </AuthorizeView>
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="user-chip">
                <span class="name">@context.User.Identity?.Name</span>
                <span class="role">@string.Join(", ", context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</span>
                <a href="/account/change-password" class="d-block small">Change password</a>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@("/Account/Login")" />
                    <button type="submit"><i class="bi bi-box-arrow-right"></i> Log out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
