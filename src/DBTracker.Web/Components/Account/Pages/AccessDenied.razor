@page "/Account/AccessDenied"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Access denied · DBTracker</PageTitle>

<div class="login-card">
    <div class="term-titlebar">
        <span class="term-dots"><span></span><span></span><span></span></span>
        <span>dbtracker:~$ access-control</span>
    </div>
    <div class="term-body">
        <h2 style="color:var(--dbt-failed)">permission denied</h2>
        <p class="text-muted mb-0">Your role doesn't have permission to view this page.</p>
        <a class="btn btn-outline-secondary" href="/">Back to dashboard</a>
    </div>
</div>
