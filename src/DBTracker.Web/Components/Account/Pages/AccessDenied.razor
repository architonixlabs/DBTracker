@page "/Account/AccessDenied"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Access denied · DBTracker</PageTitle>

<div class="auth-panel">
    <div class="auth-brand"><span class="brand-mark" aria-hidden="true"></span> DBTracker</div>
    <h1>You don't have access to this page</h1>
    <p class="text-muted mb-0">Your role doesn't include this page. If you need it, ask an Administrator to change your role.</p>
    <a class="btn btn-outline-secondary align-self-start" href="/">Back to dashboard</a>
</div>
