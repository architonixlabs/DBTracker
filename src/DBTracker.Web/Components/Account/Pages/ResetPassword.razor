@page "/Account/ResetPassword"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using DBTracker.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@attribute [AllowAnonymous]
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>Reset password · DBTracker</PageTitle>

<div class="login-card">
    <div class="term-titlebar">
        <span class="term-dots"><span></span><span></span><span></span></span>
        <span>dbtracker:~$ password-reset --apply</span>
    </div>
    <div class="term-body">
        <h2>set a new password</h2>

        @if (!_linkValid)
        {
            <p class="mb-3" style="color:var(--dbt-failed)">This reset link is invalid or has already been used.</p>
            <a class="btn btn-outline-secondary" href="/Account/ForgotPassword">Request a new link</a>
        }
        else if (_done)
        {
            <p class="mb-3">Your password has been reset.</p>
            <a class="btn btn-primary" href="/Account/Login">Log in</a>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="prompt-field mb-3">
                    <label for="rp-password">new password</label>
                    <InputText id="rp-password" type="password" @bind-Value="_model.NewPassword" class="form-control" />
                    <ValidationMessage For="() => _model.NewPassword" class="text-danger small" />
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="text-danger small mb-2">@_error</div>
                }
                <button type="submit" class="w-100 btn btn-primary">Reset password</button>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private readonly Model _model = new();
    private bool _linkValid = true;
    private bool _done;
    private string? _error;
    private string _decodedCode = "";

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            _linkValid = false;
            return;
        }

        try
        {
            _decodedCode = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            _linkValid = false;
        }
    }

    private async Task Submit()
    {
        var user = await UserManager.FindByIdAsync(UserId!);
        if (user is null)
        {
            _linkValid = false;
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, _decodedCode, _model.NewPassword);
        if (!result.Succeeded)
        {
            // Includes "invalid token" (already used, or expired via the data-protection token
            // provider's lifespan) as well as password-policy failures.
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);
        _done = true;
    }

    private class Model
    {
        [Required, MinLength(8, ErrorMessage = "At least 8 characters.")]
        public string NewPassword { get; set; } = "";
    }
}
