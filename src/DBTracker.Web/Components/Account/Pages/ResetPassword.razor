@page "/Account/ResetPassword"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using DBTracker.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@attribute [AllowAnonymous]
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>Reset password · DBTracker</PageTitle>

<div class="auth-panel">
    <div class="auth-brand"><span class="brand-mark" aria-hidden="true"></span> DBTracker</div>
    <h1>Set a new password</h1>

    @if (!_linkValid)
    {
        <p class="text-danger mb-0" role="alert">This reset link is invalid or has already been used.</p>
        <a class="btn btn-outline-secondary align-self-start" href="/Account/ForgotPassword">Request a new link</a>
    }
    else if (_done)
    {
        <p class="mb-0" role="status">Your password has been reset.</p>
        <a class="btn btn-primary align-self-start" href="/Account/Login">Log in</a>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="auth-field mb-3">
                <label class="form-label" for="rp-password">New password</label>
                <InputText id="rp-password" type="password" @bind-Value="_model.NewPassword" class="form-control" autocomplete="new-password" aria-describedby="rp-password-hint" />
                <div id="rp-password-hint" class="form-text">At least 8 characters.</div>
                <ValidationMessage For="() => _model.NewPassword" class="validation-message" />
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="text-danger small mb-2" role="alert">@_error</div>
            }
            <button type="submit" class="w-100 btn btn-primary">Reset password</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private readonly Model _model = new();
    private bool _linkValid = true;
    private bool _done;
    private string? _error;
    private string _decodedCode = "";

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            _linkValid = false;
            return;
        }

        try
        {
            _decodedCode = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            _linkValid = false;
        }
    }

    private async Task Submit()
    {
        var user = await UserManager.FindByIdAsync(UserId!);
        if (user is null)
        {
            _linkValid = false;
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, _decodedCode, _model.NewPassword);
        if (!result.Succeeded)
        {
            // Includes "invalid token" (already used, or expired via the data-protection token
            // provider's lifespan) as well as password-policy failures.
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);
        _done = true;
    }

    private class Model
    {
        [Required, MinLength(8, ErrorMessage = "At least 8 characters.")]
        public string NewPassword { get; set; } = "";
    }
}
