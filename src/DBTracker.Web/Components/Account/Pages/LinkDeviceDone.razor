@page "/Account/LinkDeviceDone"
@layout AuthLayout
@attribute [Authorize]

<PageTitle>Sign-in request · DBTracker</PageTitle>

<div class="login-card text-center">
    <div class="brand mb-4 justify-content-center">
        <i class="bi bi-hdd-network"></i>
        <span>DBTracker</span>
    </div>

    @if (Outcome == "approved")
    {
        <i class="bi bi-check-circle text-success" style="font-size:2.2rem"></i>
        <h2 class="h5 mt-3 mb-2">Request approved</h2>
        <p class="text-muted small mb-0">The other device is signing in now. You can close this tab.</p>
    }
    else
    {
        <i class="bi bi-x-circle text-danger" style="font-size:2.2rem"></i>
        <h2 class="h5 mt-3 mb-2">Request denied</h2>
        <p class="text-muted small mb-0">That sign-in attempt was not approved.</p>
    }

    <a href="/" class="btn btn-outline-secondary w-100 mt-4">Back to DBTracker</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Outcome { get; set; }
}
