@page "/Account/LinkDeviceDone"
@layout AuthLayout
@attribute [Authorize]

<PageTitle>Sign-in request · DBTracker</PageTitle>

<div class="auth-panel">
    <div class="auth-brand"><span class="brand-mark" aria-hidden="true"></span> DBTracker</div>
    @if (Outcome == "approved")
    {
        <i class="bi bi-check-circle auth-result-icon ok" aria-hidden="true"></i>
        <h1>Request approved</h1>
        <p class="text-muted mb-0">The other device is logging in now. You can close this tab.</p>
    }
    else
    {
        <i class="bi bi-x-circle auth-result-icon no" aria-hidden="true"></i>
        <h1>Request denied</h1>
        <p class="text-muted mb-0">That log-in attempt was not approved. Nothing was signed in.</p>
    }

    <a href="/" class="btn btn-outline-secondary w-100">Back to DBTracker</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Outcome { get; set; }
}
