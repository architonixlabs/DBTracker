@page "/Account/ForgotPassword"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using DBTracker.Infrastructure.Identity
@attribute [AllowAnonymous]
@inject AccountLifecycleService Lifecycle
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Forgot password · DBTracker</PageTitle>

<div class="login-card">
    <div class="term-titlebar">
        <span class="term-dots"><span></span><span></span><span></span></span>
        <span>dbtracker:~$ password-reset --request</span>
    </div>
    <div class="term-body">
        <h2>recover access</h2>

        @if (_submitted)
        {
            <p class="mb-3">If an account exists for that address, a reset link has been sent.</p>
            @if (_emailDisabled)
            {
                <p class="text-muted small mb-3">
                    Email delivery is currently disabled for this deployment (Email:Provider is not configured) — even a
                    valid account won't receive a link. Ask an Administrator to send you a reset link from the Users page,
                    or to configure email on the <a href="/setup">setup diagnostics page</a>.
                </p>
            }
            <a class="btn btn-outline-secondary" href="/Account/Login">Back to login</a>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="prompt-field mb-3">
                    <label for="fp-email">email</label>
                    <InputText id="fp-email" @bind-Value="_model.Email" class="form-control" placeholder="name@architonixlabs.com" />
                    <ValidationMessage For="() => _model.Email" class="text-danger small" />
                </div>
                <button type="submit" class="w-100 btn btn-primary" disabled="@_sending">@(_sending ? "Sending…" : "Send reset link")</button>
            </EditForm>
            <a class="small text-muted d-block mt-3" href="/Account/Login">Back to login</a>
        }
    </div>
</div>

@code {
    private readonly Model _model = new();
    private bool _submitted;
    private bool _sending;
    private bool _emailDisabled;

    private async Task Submit()
    {
        _sending = true;
        var outcome = await Lifecycle.SendPasswordResetLinkAsync(_model.Email, Nav.BaseUri);
        _sending = false;
        _submitted = true;

        // Neutral response (U16): whether the account exists is never revealed. Whether email
        // delivery itself is disabled IS shown — that's a deployment-wide configuration fact, not
        // information about any individual account.
        _emailDisabled = string.Equals(Configuration["Email:Provider"], null, StringComparison.Ordinal) ||
                          string.IsNullOrWhiteSpace(Configuration["Email:Provider"]) ||
                          Configuration["Email:Provider"] == "None";
    }

    private class Model
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";
    }
}
