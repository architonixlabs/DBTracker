@page "/Account/ForgotPassword"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using DBTracker.Infrastructure.Identity
@attribute [AllowAnonymous]
@inject AccountLifecycleService Lifecycle
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Forgot password · DBTracker</PageTitle>

<div class="auth-panel" data-testid="forgot-password-panel">
    <div class="auth-brand"><span class="brand-mark" aria-hidden="true"></span> DBTracker</div>
    <h1>Reset your password</h1>

    @if (_submitted)
    {
        <p class="mb-0" role="status">If an account exists for that address, a reset link has been sent.</p>
        @if (_emailDisabled)
        {
            <p class="text-muted small mb-0">
                Email delivery is turned off for this deployment (Email:Provider is not configured), so no account will
                receive a link. Ask an Administrator to send you a reset link from the Users page, or to configure email.
            </p>
        }
        <a class="btn btn-outline-secondary align-self-start" href="/Account/Login">Back to login</a>
    }
    else
    {
        <p class="auth-lede">Enter the email you log in with and we'll send a link to set a new password.</p>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="auth-field mb-3">
                <label class="form-label" for="fp-email">Email</label>
                <InputText id="fp-email" @bind-Value="_model.Email" class="form-control" autocomplete="username" placeholder="name@architonixlabs.com" />
                <ValidationMessage For="() => _model.Email" class="validation-message" />
            </div>
            <div class="auth-actions">
                <button type="submit" class="w-100 btn btn-primary" disabled="@_sending">@(_sending ? "Sending…" : "Send reset link")</button>
                <a class="auth-secondary-link" href="/Account/Login">Back to login</a>
            </div>
        </EditForm>
    }
</div>

@code {
    private readonly Model _model = new();
    private bool _submitted;
    private bool _sending;
    private bool _emailDisabled;

    private async Task Submit()
    {
        _sending = true;
        var outcome = await Lifecycle.SendPasswordResetLinkAsync(_model.Email, Nav.BaseUri);
        _sending = false;
        _submitted = true;

        // Never reveals whether the account exists. Disabled email is shown because it is a
        // deployment-wide fact, not information about any account.
        _emailDisabled = string.Equals(Configuration["Email:Provider"], null, StringComparison.Ordinal) ||
                          string.IsNullOrWhiteSpace(Configuration["Email:Provider"]) ||
                          Configuration["Email:Provider"] == "None";
    }

    private class Model
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";
    }
}
