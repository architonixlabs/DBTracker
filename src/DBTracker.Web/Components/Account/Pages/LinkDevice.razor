@page "/Account/LinkDevice"
@layout AuthLayout
@attribute [Authorize]
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Approve sign-in · DBTracker</PageTitle>

<div class="login-card">
    <div class="term-titlebar">
        <span class="term-dots"><span></span><span></span><span></span></span>
        <span>dbtracker:~$ device-link request</span>
    </div>
    <div class="term-body">
        @if (string.IsNullOrWhiteSpace(Token))
        {
            <p class="text-danger mb-0">Missing or invalid sign-in request.</p>
        }
        else
        {
            <h2>confirm device</h2>
            <p class="text-muted small mb-0">
                Someone scanned a DBTracker QR code and is waiting to sign in as
                <strong>@_email</strong> (@_role). Only approve this if it's you.
            </p>

            <div class="d-flex gap-2">
                <form action="/device-link/approve" method="post" style="flex:1">
                    <AntiforgeryToken />
                    <input type="hidden" name="token" value="@Token" />
                    <button type="submit" class="btn btn-primary w-100">Approve</button>
                </form>
                <form action="/device-link/deny" method="post" style="flex:1">
                    <AntiforgeryToken />
                    <input type="hidden" name="token" value="@Token" />
                    <button type="submit" class="btn btn-outline-secondary w-100">Deny</button>
                </form>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private string _email = "";
    private string _role = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _email = state.User.Identity?.Name ?? "";
        _role = string.Join(", ", state.User.Claims
            .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
            .Select(c => c.Value));
    }
}
