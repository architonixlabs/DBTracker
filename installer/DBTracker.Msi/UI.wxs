<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- Welcome, license, install folder, IIS site (port and optional SQL login), ready, progress, exit. -->
    <UI Id="DBTrackerUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
      <Property Id="ARPNOMODIFY" Value="1" />
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open the DBTracker setup wizard in my browser" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="SiteDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Publish Dialog="SiteDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="SiteDlg" Control="Next" Event="DoAction" Value="ValidateSettingsUi" Order="1" />
      <Publish Dialog="SiteDlg" Control="Next" Event="SpawnDialog" Value="SettingsErrorDlg" Order="2" Condition="DBT_SETTINGS_ERROR" />
      <Publish Dialog="SiteDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="NOT DBT_SETTINGS_ERROR" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SiteDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Install" Property="WIXUI_EXITDIALOGOPTIONALTEXT" Value="DBTracker runs at http://localhost:[SITE_PORT]/install. The setup wizard asks for a one-time setup key, which DBTracker writes to [APPDATAFOLDER]setup-key.txt when it first starts." Condition="NOT Installed" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWizard" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>

    <InstallUISequence>
      <Custom Action="DefaultSqlServer" Before="CostFinalize" Condition="NOT SQL_SERVER" />
      <Custom Action="CheckLaunchWizardBox" Before="CostFinalize" Condition="LAUNCH_WIZARD = &quot;1&quot;" />
    </InstallUISequence>
    <CustomAction Id="DefaultSqlServer" Property="SQL_SERVER" Value="localhost" />
    <CustomAction Id="CheckLaunchWizardBox" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <UI>
      <Dialog Id="SiteDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="220" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}IIS site and database access" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose the port for the DBTracker site, and whether to give it access to SQL Server." />

        <Control Id="PortLabel" Type="Text" X="20" Y="58" Width="320" Height="12" Text="&amp;Port for the DBTracker site (http):" />
        <Control Id="PortEdit" Type="Edit" X="20" Y="72" Width="60" Height="18" Property="SITE_PORT" Text="{5}" />
        <Control Id="PortHint" Type="Text" X="90" Y="75" Width="265" Height="12" NoPrefix="yes" Text="Architonix app services use the 8xxx and 9xxx ranges." />

        <Control Id="SqlCheck" Type="CheckBox" X="20" Y="104" Width="330" Height="17" Property="SQL_GRANT_LOGIN" CheckBoxValue="1" Text="&amp;Give DBTracker a Windows login on SQL Server (adds it to dbcreator)" />
        <Control Id="SqlLabel" Type="Text" X="36" Y="126" Width="300" Height="12" Text="&amp;SQL Server name:" DisableCondition="NOT SQL_GRANT_LOGIN" EnableCondition="SQL_GRANT_LOGIN" />
        <Control Id="SqlEdit" Type="Edit" X="36" Y="140" Width="200" Height="18" Property="SQL_SERVER" Text="{128}" DisableCondition="NOT SQL_GRANT_LOGIN" EnableCondition="SQL_GRANT_LOGIN" />
        <Control Id="SqlHint" Type="Text" X="36" Y="164" Width="320" Height="54" NoPrefix="yes" Text="Uses your Windows sign-in, so you need permission to create logins on that server. On this computer the login is IIS APPPOOL\[APPPOOL_NAME]; on another computer it is this computer's domain account. You can also skip this and enter a SQL login in the setup wizard." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="SettingsErrorDlg" Width="270" Height="110" Title="!(loc.InstallDirDlg_Title)" ErrorDialog="no">
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Exclam" />
        <Control Id="Message" Type="Text" X="48" Y="15" Width="205" Height="60" NoPrefix="yes" Text="[DBT_SETTINGS_ERROR]" />
        <Control Id="OK" Type="PushButton" X="107" Y="82" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
