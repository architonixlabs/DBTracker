<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Installer loads managed custom actions into the .NET Framework CLR. 4.6.2 ships with
       Windows Server 2016, the oldest server this installer targets. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DBTracker.CustomActions</AssemblyName>
    <RootNamespace>DBTracker.CustomActions</RootNamespace>
    <!-- DTF picks the native SfxCA host from $(Platform), not PlatformTarget, and falls back to x86.
         An x86 host cannot load this x64 assembly (BadImageFormatException at install time), so pin
         the x64 host explicitly. -->
    <SfxCADll>$(NuGetPackageRoot)wixtoolset.dtf.customaction\5.0.2\tools\x64\SfxCA.dll</SfxCADll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
